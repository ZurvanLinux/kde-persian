#, kde-format
msgid "Unnamed"
msgstr "بی‌نام"

#. i18n: ectx: label, entry (id), group (Transport $(transportId))
#: mailtransport.kcfg:12
#, kde-format
msgid "Unique identifier"
msgstr "شناسهٔ یکتا"

#. i18n: ectx: label, entry (name), group (Transport $(transportId))
#: mailtransport.kcfg:16
#, kde-format
msgid "User-visible transport name"
msgstr "نام انتقال قابل‌مشاهده برای کاربر"

#. i18n: ectx: whatsthis, entry (name), group (Transport $(transportId))
#: mailtransport.kcfg:17
#, kde-format
msgid "The name that will be used when referring to this server."
msgstr "نامی که هنگام ارجاع به این کارساز استفاده خواهد شد."

#. i18n: ectx: label, entry (host), group (Transport $(transportId))
#: mailtransport.kcfg:30
#, kde-format
msgid "Host name of the server"
msgstr "نام میزبان کارساز"

#. i18n: ectx: whatsthis, entry (host), group (Transport $(transportId))
#: mailtransport.kcfg:31
#, kde-format
msgid "The domain name or numerical address of the SMTP server."
msgstr "نام دامنه یا نشانی عددی کارساز SMTP."

#. i18n: ectx: label, entry (port), group (Transport $(transportId))
#: mailtransport.kcfg:34
#, kde-format
msgid "Port number of the server"
msgstr "شمارهٔ درگاه کارساز"

#. i18n: ectx: whatsthis, entry (port), group (Transport $(transportId))
#: mailtransport.kcfg:35
#, kde-format
msgid ""
"The port number that the SMTP server is listening on. The default port is "
"465."
msgstr ""
"شمارهٔ درگاهی که کارساز SMTP روی آن گوش می‌دهد. درگاه پیش‌فرض ۴۶۵ است."

#. i18n: ectx: label, entry (userName), group (Transport $(transportId))
#: mailtransport.kcfg:39
#, kde-format
msgid "User name needed for login"
msgstr "نام کاربری موردنیاز برای ورود"

#. i18n: ectx: whatsthis, entry (userName), group (Transport $(transportId))
#: mailtransport.kcfg:40
#, kde-format
msgid "The user name to send to the server for authorization."
msgstr "نام کاربری برای ارسال به کارساز جهت احراز هویت."

#. i18n: ectx: label, entry (precommand), group (Transport $(transportId))
#: mailtransport.kcfg:43
#, kde-format
msgid "Command to execute before sending a mail"
msgstr "فرمان جهت اجرا پیش از ارسال رایانامه"

#. i18n: ectx: whatsthis, entry (precommand), group (Transport $(transportId))
#: mailtransport.kcfg:44
#, kde-format
msgid ""
"A command to run locally, prior to sending email. This can be used to set up"
" SSH tunnels, for example. Leave it empty if no command should be run."
msgstr ""
"فرمانی برای اجرای محلی، قبل از ارسال رایانامه. برای مثال، می‌تواند برای "
"راه‌اندازی تونل‌های SSH استفاده شود. در صورتی که نیازی به اجرای فرمان نیست، "
"آن را خالی بگذارید."

#. i18n: ectx: label, entry (options), group (Transport $(transportId))
#: mailtransport.kcfg:47
#, kde-format
msgid "Options added to mailtransport method"
msgstr "گزینه‌های اضافه‌شده به روش انتقال رایانامه"

#. i18n: ectx: label, entry (requiresAuthentication), group (Transport
#. $(transportId))
#: mailtransport.kcfg:50
#, kde-format
msgid "Server requires authentication"
msgstr "کارساز نیازمند احراز هویت است"

#. i18n: ectx: whatsthis, entry (requiresAuthentication), group (Transport
#. $(transportId))
#: mailtransport.kcfg:51
#, kde-format
msgid ""
"Check this option if your SMTP server requires authentication before "
"accepting mail. This is known as 'Authenticated SMTP' or simply ASMTP."
msgstr ""
"اگر کارساز SMTP شما پیش از پذیرش رایانامه نیاز به احراز هویت دارد، این گزینه"
" را علامت بزنید. این ویژگی با عنوان «SMTP احراز هویت‌شده» یا به‌سادگی ASMTP "
"شناخته می‌شود."

#. i18n: ectx: label, entry (storePassword), group (Transport $(transportId))
#: mailtransport.kcfg:55
#, kde-format
msgid "Store password"
msgstr "ذخیرهٔ گذرواژه"

#. i18n: ectx: whatsthis, entry (storePassword), group (Transport
#. $(transportId))
#: mailtransport.kcfg:58
#, kde-format
msgid ""
"Check this option to have your password stored.\n"
"If KWallet is available the password will be stored there, which is considered safe.\n"
"However, if KWallet is not available, the password will be stored in the configuration file. The password is stored in an obfuscated format, but should not be considered secure from decryption efforts if access to the configuration file is obtained."
msgstr ""
"این گزینه را برای ذخیرهٔ گذرواژه‌تان علامت بزنید.\n"
"اگر KWallet در دسترس باشد، گذرواژه در آن ذخیره خواهد شد که امن تلقی می‌شود.\n"
"با این حال، اگر KWallet در دسترس نباشد، گذرواژه در پروندهٔ پیکربندی ذخیره خواهد شد. گذرواژه در قالبی مبهم ذخیره می‌شود، اما در صورت دسترسی به پروندهٔ پیکربندی، نباید در برابر تلاش‌های رمزگشایی امن در نظر گرفته شود."

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:62
#, kde-format
msgid "Encryption method used for communication"
msgstr "روش رمزنگاری مورد استفاده برای ارتباط"

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:65
#, kde-format
msgid "No encryption"
msgstr "بدون رمزنگاری"

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:68
#, kde-format
msgid "SSL/TLS encryption"
msgstr "رمزنگاری SSL/TLS"

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:71
#, kde-format
msgid "STARTTLS encryption"
msgstr "رمزگذاری STARTTLS"

#. i18n: ectx: label, entry (authenticationType), group (Transport
#. $(transportId))
#: mailtransport.kcfg:77
#, kde-format
msgid "Authentication method"
msgstr "روش احراز هویت"

