#. i18n: ectx: label, entry (CurrentLevel), group (Language)
#: khangman.kcfg:10
#, kde-format
msgid "Level"
msgstr "سطح"

#. i18n: ectx: label, entry (SelectedLanguage), group (Language)
#: khangman.kcfg:17
#, kde-format
msgid "The language selected by the user"
msgstr "زبان انتخاب‌شده توسط کاربر"

#. i18n: ectx: label, entry (Theme), group (Look)
#: khangman.kcfg:33
#, kde-format
msgid "Background theme name"
msgstr "نام پوستهٔ پس‌زمینه"

#. i18n: ectx: label, entry (OneLetter), group (General)
#: khangman.kcfg:40
#, kde-format
msgid ""
"Check this if you do not want to discover each instance of the same letter."
msgstr ""
"اگر نمی‌خواهید هر نمونه از یک حرف یکسان آشکار شود، این گزینه را علامت بزنید."

#. i18n: ectx: label, entry (EnableAnimations), group (General)
#: khangman.kcfg:44
#, kde-format
msgid "Enable Animations"
msgstr "فعال‌سازی پویانمایی‌ها"

#. i18n: ectx: label, entry (Sound), group (General)
#: khangman.kcfg:48
#, kde-format
msgid "If checked, sounds will be played for New Game and Win Game"
msgstr "اگر علامت زده شود، برای بازی جدید و برد در بازی صدا پخش خواهد شد"

#. i18n: ectx: label, entry (Hint), group (General)
#: khangman.kcfg:53
#, kde-format
msgid ""
"If checked, hints will always been displayed. If this is not checked (default)\n"
"            hints will be displayed only per word when the user chooses to show the hint."
msgstr ""
"اگر علامت زده شود، راهنمایی‌ها همیشه نمایش داده می‌شوند. اگر علامت زده نشود (پیش‌فرض)\n"
"            راهنمایی‌ها تنها برای هر کلمه و زمانی که کاربر مایل به دیدن راهنما باشد نمایش می‌یابند."

#. i18n: ectx: label, entry (resolveTime), group (General)
#: khangman.kcfg:57
#, kde-format
msgid ""
"This setting allows you to set in seconds how much time is available for "
"resolving the word."
msgstr ""
"این تنظیم به شما امکان می‌دهد زمان در دسترس برای حل کردن کلمه را به ثانیه "
"تعیین کنید."

#. i18n: ectx: label, entry (AccentedLetters), group (Advanced)
#: khangman.kcfg:64
#, kde-format
msgid "Type accented letters separately from normal letters"
msgstr "نوشتن حروف دارای نشان حرکت به‌صورت مجزا از حروف معمولی"

