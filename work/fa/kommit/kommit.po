#: src/libkommitwidgets/dialogs/mergedialog.ui:184
#, kde-format
msgid ""
"<html><head/><body><p>Treats lines with the indicated type of whitespace "
"change as unchanged for the sake of a three-way merge. Whitespace changes "
"mixed with other changes to a line are not ignored. </p><p><br/></p><p><a "
"href=\"https://git-scm.com/docs/git-merge#Documentation/git-merge.txt-"
"ignore-space-change\"><span style=\" text-decoration: underline; "
"color:#007af4;\">More information</span></a></p></body></html>"
msgstr ""
"<html><head/><body><p>سطرهایی را که نوع تغییرات فاصله خالی مشخص‌شده را "
"دارند، به منظور ادغام سه‌طرفه دست‌نخورده در نظر می‌گیرد. تغییرات فاصله خالی "
"که با تغییرات دیگر در یک سطر آمیخته شده‌اند نادیده گرفته "
"نمی‌شوند.</p><p><br/></p><p><a href=\"https://git-scm.com/docs/git-"
"merge#Documentation/git-merge.txt-ignore-space-change\"><span style=\" text-"
