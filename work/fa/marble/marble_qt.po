#: src/lib/marble/MarbleNavigationSettingsWidget.ui:17
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Dragging and Animation"
msgstr "کشیدن و پویانمایی"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:37
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Drag location:"
msgstr "موقعیت کشیدن:"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:50
msgctxt "MarbleNavigationSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">While dragging the mouse there are two standard behaviours when dealing with a virtual globe:</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The location below mouse pointer will follow the cursor exactly: As a result e.g. the north pole will not stay at the top which can lead to confusion. By default Marble makes sure that north is always up which results in a dragging behaviour where the location below the mouse pointer slightly \"detaches\" from the cursor. </p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">هنگام کشیدن با موشواره در کرهٔ مجازی دو رفتار استاندارد وجود دارد:</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">موقعیت زیر نشانگر موشواره دقیقاً مکان‌نما را دنبال می‌کند: در نتیجه برای نمونه، قطب شمال در بالا باقی نمی‌ماند که ممکن است باعث سردرگمی شود. به‌طور پیش‌فرض، ماربل اطمینان حاصل می‌کند که جهت شمال همیشه بالا بماند، که این امر منجر به رفتاری در کشیدن می‌شود که در آن موقعیت زیر نشانگر موشواره کمی از مکان‌نما «جدا» می‌شود. </p></body></html>"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:58
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Keep Planet Axis Vertically"
msgstr "عمودی نگه‌داشتن محور سیاره"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:63
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Follow Mouse Pointer"
msgstr "پیروی از نشانگر موشواره"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:73
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Use kinetic spinning when dragging the map"
msgstr "استفاده از چرخش جنبشی هنگام کشیدن نقشه"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:76
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Inertial globe rotation"
msgstr "چرخش کروی با اینرسی"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:83
msgctxt "MarbleNavigationSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">When searching for a location Marble can either move instantly to the new location or it can show a travel animation from the previous place to the new place.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">هنگام جستجوی یک مکان، ماربل می‌تواند بلافاصله به مکان جدید برود یا یک پویانمایی پیمایش از مکان قبلی به مکان جدید نمایش دهد.</p></body></html>"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:89
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Animate voyage to the target"
msgstr "پویانمایی سفر به مقصد"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:96
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Use right mouse button to rotate the camera around"
msgstr "استفاده از کلید راست موشواره برای چرخاندن دوربین"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:99
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Mouse view rotation"
msgstr "چرخش نما با موشواره"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:142
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&On startup:"
msgstr "هنگام راه‌اندازی:"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:152
msgctxt "MarbleNavigationSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">By default Marble will display the home location immediately after the application has started. As an alternative it can also show the last position that was active when the user left the application. </p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">به طور پیش‌فرض ماربل بلافاصله پس از شروع برنامه، مکان خانه را نمایش می‌دهد. به عنوان گزینه‌ای دیگر، می‌تواند آخرین موقعیتی را که کاربر پیش از خروج در آن بوده است را نیز نشان دهد. </p></body></html>"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:159
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Show Home Location"
msgstr "نمایش مکان خانه"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:164
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Return to Last Location Visited"
msgstr "بازگشت به آخرین مکان بازدیدشده"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:184
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&External editor:"
msgstr "ویرایشگر خارجی:"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:194
msgctxt "MarbleNavigationSettingsWidget|"
msgid ""
"<p>The application that is launched to edit maps. Potlatch (default) "
"requires a web browser with flash support to be installed. When selecting "
"josm or merkaartor, make sure that the respective application is "
"installed.</p>"
msgstr ""
"<p>برنامه‌ای که برای ویرایش نقشه‌ها اجرا می‌شود. پات‌لچ (پیش‌فرض) به نصب "
"بودن مرورگر وبی با پشتیبانی از فلش نیاز دارد. هنگام انتخاب josm یا "
"merkaartor، مطمئن شوید که برنامهٔ مربوطه نصب باشد.</p>"

