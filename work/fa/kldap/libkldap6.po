#: core/ldapconnection.cpp:129
#, kde-format
msgid "No LDAP Support..."
msgstr "بدون پشتیبانی از LDAP..."

#: core/ldapconnection.cpp:246
#, kde-format
msgid "An error occurred during the connection initialization phase."
msgstr "هنگام مقداردهی اولیه اتصال خطایی رخ داد."

#: core/ldapconnection.cpp:253
#, kde-format
msgid "Cannot set protocol version to %1."
msgstr "تنظیم نسخه پروتکل روی %1 امکان‌پذیر نیست."

#: core/ldapconnection.cpp:264
#, kde-format
msgid "Cannot set timeout to %1 second."
msgid_plural "Cannot set timeout to %1 seconds."
msgstr[0] "تنظیم مهلت زمانی روی %1 ثانیه امکان‌پذیر نیست."
msgstr[1] "تنظیم مهلت زمانی روی %1 ثانیه امکان‌پذیر نیست."

#: core/ldapconnection.cpp:276
#, kde-format
msgid "Could not set CA certificate file."
msgstr "تنظیم پرونده گواهی CA امکان‌پذیر نبود."

#: core/ldapconnection.cpp:301
#, kde-format
msgid "Invalid TLS require certificate mode."
msgstr "حالت الزامی‌بودن گواهی TLS نامعتبر است."

#: core/ldapconnection.cpp:306
#, kde-format
msgid "Could not set TLS require certificate mode."
msgstr "تنظیم حالت الزامی‌بودن گواهی TLS امکان‌پذیر نبود."

#: core/ldapconnection.cpp:315
#, kde-format
msgid "Could not initialize new TLS context."
msgstr "مقداردهی اولیه بافت جدید TLS امکان‌پذیر نبود."

#: core/ldapconnection.cpp:332
#, kde-format
msgid "TLS support not available in the LDAP client libraries."
msgstr "پشتیبانی از TLS در کتابخانه‌های کلاینت LDAP موجود نیست."

#: core/ldapconnection.cpp:342
#, kde-format
msgid "Cannot set size limit."
msgstr "تنظیم محدودیت اندازه امکان‌پذیر نیست."

#: core/ldapconnection.cpp:352
#, kde-format
msgid "Cannot set time limit."
msgstr "تنظیم محدودیت زمانی امکان‌پذیر نیست."

#: core/ldapconnection.cpp:360
#, kde-format
msgid "Cannot initialize the SASL client."
msgstr "راه‌اندازی کارخواه SASL امکان‌پذیر نیست."

#: core/ldapconnection.cpp:437
#, kde-format
msgid ""
"LDAP support not compiled in. Please recompile libkldap with the OpenLDAP "
"(or compatible) client libraries, or complain to your distribution "
"packagers."
msgstr ""
"پشتیبانی LDAP کامپایل نشده است. لطفاً libkldap را با کتابخانه‌های کارخواه "
"OpenLDAP (یا سازگار با آن) دوباره کامپایل کنید، یا به بسته‌بندهای توزیع خود "
"گزارش دهید."

#: core/ldapsearch.cpp:223
#, kde-format
msgid "Cannot access to server. Please reconfigure it."
msgstr "دسترسی به کارساز امکان‌پذیر نیست. لطفاً آن را دوباره پیکربندی کنید."

