#. (itstool) path: component/name
#: org.kde.merkuro.contact.metainfo.xml:10
msgid "Merkuro Contact"
msgstr "مخاطبین مرکورو"

#. (itstool) path: component/summary
#: org.kde.merkuro.contact.metainfo.xml:11
msgid "Manage your contacts with speed and ease"
msgstr "مخاطبین خود را سریع و آسان مدیریت کنید"

#. (itstool) path: description/p
#: org.kde.merkuro.contact.metainfo.xml:18
msgid "Merkuro contact book application."
msgstr "برنامهٔ دفترچه نشانی مرکورو."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:45
msgid ""
"Import and export contacts as vCard files, and share individual contacts."
msgstr ""
"درون‌ریزی و برون‌ریزی مخاطبین به عنوان پرونده‌های vCard و به‌اشتراک‌گذاری "
"مخاطبین تکی."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:46
msgid "Move contacts between address books from the contact list or editor."
msgstr "جابه‌جایی مخاطبین بین دفترچه‌های نشانی از فهرست مخاطبین یا ویرایشگر."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:47
msgid ""
"Find contacts by name, nickname, organization, email address, or phone "
"number, with improved sorting and display of contacts without names."
msgstr ""
"یافتن مخاطبین بر اساس نام، نام مستعار، سازمان، نشانی رایانامه یا شماره تلفن،"
" همراه با بهبود مرتب‌سازی و نمایش مخاطبین بدون نام."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:48
msgid "See upcoming birthdays, including the age each contact will turn."
msgstr "مشاهدهٔ زادروزهای پیش‌رو، شامل سنی که هر مخاطب خواهد داشت."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:49
msgid "View recent emails and events on a contact's page."
msgstr "مشاهدهٔ رایانامه‌ها و رویدادهای اخیر در صفحهٔ مخاطب."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:50
msgid "Add and edit postal addresses and notes."
msgstr "افزودن و ویرایش نشانی‌های پستی و یادداشت‌ها."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:51
msgid "Improve contact avatars with LibreAvatar images."
msgstr "بهبود آواتار مخاطبین با تصاویر LibreAvatar."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:52
msgid "Improve the contact list, sidebar, and address book menus."
msgstr "بهبود فهرست مخاطبان، نوار کناری و منوهای دفترچهٔ نشانی."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:53
msgid ""
"Fix contact editor, deletion dialog, and collection handling issues, "
"including crashes and memory leaks."
msgstr ""
"رفع مشکلات ویرایشگر مخاطب، گفتگوی حذف و مدیریت مجموعه، از جمله خرابی‌ها و "
"نشت‌های حافظه."

#. (itstool) path: screenshot/caption
#: org.kde.merkuro.contact.metainfo.xml:111
msgid "Contact list"
msgstr "فهرست مخاطبان"

#. (itstool) path: screenshot/caption
#: org.kde.merkuro.contact.metainfo.xml:115
msgid "Contact Editor"
msgstr "ویرایشگر مخاطب"
