#: SharedResourcesDialog.cpp:84
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Shared Resource Dialog</title><para>Enables you to decide how to "
"treat shared resources, shared resource groups and shared calendars when "
"they have been deleted from the shared resources file.</para><para>You can "
"select if an item shall be:<list><item><emphasis>Removed:</emphasis> Removes"
" the item from your project too.</item><item><emphasis>Converted:</emphasis>"
" Converts the item to local item.</item><item><emphasis>Kept:</emphasis> "
"Keeps the item as a shared item.</item></list><nl/><link "
"url='%1'>More...</link></para>"
msgstr ""
"<title>گفت‌وگوی منابع هم‌رسانی‌شده</title><para>به شما امکان می‌دهد تصمیم "
"بگیرید که با منابع هم‌رسانی‌شده، گروه‌های منابع هم‌رسانی‌شده و تقویم‌های "
"هم‌رسانی‌شده پس از حذف شدن از پروندهٔ منابع هم‌رسانی‌شده، چگونه برخورد "
"شود.</para><para>می‌توانید انتخاب کنید که یک مورد:<list><item><emphasis>حذف "
"شود:</emphasis> مورد از پروژهٔ شما نیز حذف "
"می‌شود.</item><item><emphasis>تبدیل شود:</emphasis> مورد به یک مورد محلی "
"تبدیل می‌شود.</item><item><emphasis>نگه‌داشته شود:</emphasis> مورد به‌عنوان "
"یک مورد هم‌رسانی‌شده باقی می‌ماند.</item></list><nl/><link "
"url='%1'>بیشتر...</link></para>"

