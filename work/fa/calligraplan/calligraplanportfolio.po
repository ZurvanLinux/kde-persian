#: PortfolioView.cpp:133
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>The Portfolio Content Editor</title><para>This editor enables you to "
"configure the content of your portfolio.</para><para>Select "
"<interface>Edit|Add</interface> or press <interface>Add...</interface> to "
"add projects to your portfolio.<nl/>Select "
"<interface>Edit|Remove</interface> or press <interface>Remove</interface> to"
" remove selected projects.</para><para>Add the projects you are managing and"
" set <emphasis>Portfolio</emphasis> = "
"<emphasis>Yes</emphasis>.</para><para><note>If you have resources that are "
"shared between multiple projects and you want to re-schedule or inspect "
"resource usage, you need to add all relevant projects and then set "
"<emphasis>Portfolio</emphasis> = <emphasis>No</emphasis> for these "
"projects.</note></para><para><link url='%1'>More...</link></para>"
msgstr ""
"<title>ویرایشگر محتوای پوشه‌کار</title><para>این ویرایشگر به شما امکان "
"می‌دهد محتوای پوشه‌کار (پورتفولیو) خود را پیکربندی کنید.</para><para>برای "
"افزودن پروژه‌ها به پوشه‌کارتان، گزینهٔ <interface>ویرایش|افزودن</interface> "
"را انتخاب کنید یا <interface>افزودن...</interface> را فشار دهید.<nl/>برای "
"حذف پروژه‌های انتخاب‌شده، گزینهٔ <interface>ویرایش|حذف</interface> را انتخاب"
" کنید یا <interface>حذف</interface> را فشار دهید.</para><para>پروژه‌هایی را "
"که مدیریت می‌کنید اضافه کرده و <emphasis>پوشه‌کار</emphasis> = "
"<emphasis>بله</emphasis> را تنظیم کنید.</para><para><note>اگر منابعی دارید "
"که بین چند پروژه مشترک هستند و می‌خواهید زمان‌بندی را مجدداً تنظیم کرده یا "
"استفاده از منابع را بررسی کنید، باید همهٔ پروژه‌های مربوطه را اضافه کرده و "
"سپس <emphasis>پوشه‌کار</emphasis> = <emphasis>خیر</emphasis> را برای این "
"پروژه‌ها تنظیم کنید.</note></para><para><link "
"url='%1'>بیشتر...</link></para>"

#: PortfolioView.cpp:152
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<subtitle>Context Help</subtitle><para>Many functions have help and hints "
"that can be displayed with <emphasis>What's "
"this</emphasis>.</para><para>Activate it by selecting the menu item "
"<interface>Help|What's this</interface> or by pressing "
"<shortcut>Shift+F1</shortcut>.</para><para>Try it on this text!</para>"
msgstr ""
"<subtitle>راهنمای زمینه‌ای</subtitle><para>بسیاری از عملکردها دارای راهنما و"
" نکاتی هستند که می‌توان آن‌ها را با <emphasis>این چیست</emphasis> نمایش "
"داد.</para><para>آن را با انتخاب مورد منوی <interface>راهنما|این "
"چیست</interface> یا با فشردن <shortcut>Shift+F1</shortcut> فعال "
"کنید.</para><para>آن را روی همین متن امتحان کنید!</para>"

#: PortfolioView.cpp:161
#, kde-kuit-format
msgctxt "@info"
msgid "<subtitle>Online Resources</subtitle>"
msgstr "<subtitle>منابع برخط</subtitle>"

#: PortfolioView.cpp:165
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Context help</title><para>Help is available many places using "
"<emphasis>What's This</emphasis>.<nl/>It is activated using the menu entry "
"<interface>Help->What's this?</interface> or the keyboard shortcut "
"<shortcut>Shift+F1</shortcut>.</para><para>In dialogs it is available via "
"the <interface>?</interface> in the dialog title bar.</para><para>If you see"
" <link url='%1'>More...</link> in the text, pressing it will display more "
"information from the documentation.</para>"
msgstr ""
"<title>راهنمای زمینه‌ای</title><para>راهنما در بسیاری از جاها با استفاده از "
"<emphasis>این چیست؟</emphasis> در دسترس است.<nl/>این قابلیت با استفاده از "
"گزینهٔ منوی <interface>راهنما->این چیست؟</interface> یا میان‌بر صفحه‌کلید "
"<shortcut>Shift+F1</shortcut> فعال می‌شود.</para><para>در کادرهای محاوره از "
"طریق علامت <interface>؟</interface> در نوار عنوان کادر محاوره در دسترس "
"است.</para><para>اگر <link url='%1'>بیشتر...</link> را در متن می‌بینید، با "
"فشردن آن اطلاعات بیشتری از مستندات نمایش داده خواهد شد.</para>"

