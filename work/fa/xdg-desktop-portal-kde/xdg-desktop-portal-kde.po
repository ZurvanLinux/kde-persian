#: src/background.cpp:137
#, kde-format
msgctxt "@info %1 is the name of an application"
msgid ""
"%1 wants to remain running when it has no visible windows. If you deny this "
"request, the application will quit when its last window is closed."
msgstr ""
"%1 می‌خواهد زمانی که پنجرهٔ قابل مشاهده‌ای ندارد در حال اجرا بماند. اگر این "
"درخواست را رد کنید، برنامه پس از بسته شدن آخرین پنجره‌اش بسته خواهد شد."

#: src/background.cpp:143 src/background.cpp:160
#, kde-format
msgctxt ""
"@action:button Allow the application to keep running with no open windows"
msgid "Allow"
msgstr "مجاز بودن"

#: src/background.cpp:150
#, kde-format
msgctxt ""
"@action:button Don't allow the application to keep running without any open "
"windows"
msgid "Deny"
msgstr "رد کردن"

#: src/background.cpp:154
#, kde-format
msgctxt ""
"@title title of a dialog to confirm whether to allow an application to "
"remain running with no visible windows"
msgid "Deny Background Usage?"
msgstr "استفاده در پس‌زمینه رد شود؟"

#: src/background.cpp:156
#, kde-format
msgctxt "@info %1 is the name of an application"
msgid ""
"This will force %1 to quit when its last window is closed. This could cause "
"data loss if the application has any unsaved changes when it happens."
msgstr ""
"این کار باعث می‌شود با بستن آخرین پنجره، %1 به اجبار بسته شود. در صورت وجود "
"تغییرات ذخیره‌نشده در برنامه، این عمل ممکن است موجب از دست رفتن داده‌ها شود."

#: src/background.cpp:161
#, kde-format
msgctxt ""
"@action:button Don't allow the application to keep running without any open "
"windows"
msgid "Deny Anyway"
msgstr "در هر حال رد شود"

