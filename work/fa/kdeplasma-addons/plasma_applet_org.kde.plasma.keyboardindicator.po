#: config.qml:13
#, kde-format
msgctxt "@title"
msgid "Keys"
msgstr "کلیدها"

#: configAppearance.qml:37
#, kde-format
msgctxt ""
"@label show keyboard indicator when Caps Lock or Num Lock is activated"
msgid "Show when activated:"
msgstr "نمایش در صورت فعال بودن:"

#: configAppearance.qml:40
#, kde-format
msgctxt "@option:check"
msgid "Caps Lock"
msgstr "Caps Lock"

#: configAppearance.qml:47
#, kde-format
msgctxt "@option:check"
msgid "Num Lock"
msgstr "Num Lock"

#: main.qml:114
#, kde-format
msgid "Alt is latched"
msgstr "کلید دگرساز (Alt) چفت شده است"

#: main.qml:116
#, kde-format
msgid "Alt is locked"
msgstr "کلید دگرساز (Alt) قفل شده است"

#: main.qml:120
#, kde-format
msgid "Shift is latched"
msgstr "کلید تبدیل (Shift) چفت شده است"

#: main.qml:122
#, kde-format
msgid "Shift is locked"
msgstr "کلید تبدیل (Shift) قفل شده است"

#: main.qml:126
#, kde-format
msgid "Control is latched"
msgstr "کلید مهار (Control) چفت شده است"

#: main.qml:128
#, kde-format
msgid "Control is locked"
msgstr "کلید مهار (Control) قفل شده است"

#: main.qml:132
#, kde-format
msgid "Meta is latched"
msgstr "کلید متّا موقتاً فعال است"

#: main.qml:134
#, kde-format
msgid "Meta is locked"
msgstr "کلید متّا قفل است"

#: main.qml:138
#, kde-format
msgid "Alt Gr is latched"
msgstr "کلید Alt Gr موقتاً فعال است"

#: main.qml:140
#, kde-format
msgid "Alt Gr is locked"
msgstr "کلید Alt Gr قفل است"

#: main.qml:144
#, kde-format
msgid "Caps Lock activated"
msgstr "کلید Caps Lock فعال شد"

#: main.qml:147
#, kde-format
msgid "Num Lock activated"
msgstr "کلید Num Lock فعال شد"

#: main.qml:155
#, kde-format
msgid "No lock keys activated"
msgstr "هیچ کلید قفلی فعال نیست"
