#: package/contents/ui/WallpaperPreview.qml:57
#, kde-format
msgctxt ""
"@action:inmenu wallpaper preview menu, will open the website of the "
"wallpaper"
msgid "Open Link in Browser…"
msgstr "باز کردن پیوند در مرورگر…"

#: package/contents/ui/WallpaperPreview.qml:60
#, kde-format
