#: config/qml/AlternateCalendarConfig.qml:48
#, kde-format
msgctxt "@label:listbox"
msgid "Calendar system:"
msgstr "سامانهٔ گاه‌شمار:"

#: config/qml/AlternateCalendarConfig.qml:69
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"This calendar is based on pure astronomical calculation. It doesn't consider"
" any crescent visibility criteria."
msgstr ""
"این گاه‌شمار کاملاً بر پایهٔ محاسبات نجومی است و معیارهای رؤیت هلال ماه را "
"در نظر نمی‌گیرد."

#: config/qml/AlternateCalendarConfig.qml:77
#, kde-format
msgctxt "@label:spinbox"
msgid "Date offset:"
msgstr "انحراف تاریخ:"

#: config/qml/AlternateCalendarConfig.qml:88
#, kde-format
msgid "%1 day"
msgid_plural "%1 days"
msgstr[0] "%1 روز"
msgstr[1] "%1 روز"

#: config/qml/AlternateCalendarConfig.qml:91
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"A positive offset signifies a later date, while a negative offset signifies "
"an earlier date."
msgstr ""
"انحراف مثبت نشان‌دهندهٔ تاریخی دیرتر و انحراف منفی نشان‌دهندهٔ تاریخی زودتر "
"است."

#: provider/ethiopiancalendar.cpp:86
#, kde-format
msgctxt ""
"%1 Day number %2 Translated month name in Ethiopian calendar %3 Year number "
"%4 Full date in Ethiopian"
msgid "%1 %2, %3 (%4)"
msgstr "%1 %2، %3 (%4)"

