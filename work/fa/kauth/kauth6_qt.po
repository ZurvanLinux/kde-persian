#: backends/dbus/DBusHelperProxy.cpp:84
#, qt-format
msgctxt "KAuth::DBusHelperProxy|"
msgid "DBus Backend error: service start %1 failed: %2"
msgstr "خطای پشتیبان DBus: شروع سرویس %1 ناموفق بود: %2"

#: backends/dbus/DBusHelperProxy.cpp:99
#, qt-format
msgctxt "KAuth::DBusHelperProxy|"
msgid ""
"DBus Backend error: connection to helper failed. %1\n"
"(application: %2 helper: %3)"
msgstr ""
"خطای پشتیبان DBus: اتصال به کمکی ناموفق بود. %1\n"
"(برنامه: %2 کمکی: %3)"

#: backends/dbus/DBusHelperProxy.cpp:135
#, qt-format
msgctxt "KAuth::DBusHelperProxy|"
msgid ""
"DBus Backend error: could not contact the helper. Connection error: %1. "
"Message error: %2"
msgstr ""
"خطای پشتیبان DBus: برقراری ارتباط با کمکی امکان‌پذیر نبود. خطای اتصال: %1. "
"خطای پیام: %2"

#: executejob.cpp:104
msgctxt "KAuth::ExecuteJob|"
msgid "Tried to start an invalid action"
msgstr "تلاش برای شروع یک کنش نامعتبر"

#: executejob.cpp:122
msgctxt "KAuth::ExecuteJob|"
msgid "Unknown execution mode chosen"
msgstr "حالت اجرای ناشناخته انتخاب شده است"

#: executejob.cpp:171
msgctxt "KAuth::ExecuteJob|"
msgid "Unknown status for the authentication procedure"
msgstr "وضعیت ناشناخته برای فرایند احراز هویت"

#: executejob.cpp:183
msgctxt "KAuth::ExecuteJob|"
msgid ""
"The current backend only allows helper authorization, but this action does "
"not have a helper."
msgstr ""
"پشتیبان فعلی تنها اجازهٔ مجوزدهی کمکی را می‌دهد، اما این کنش دارای کمکی "
"نیست."

#: executejob.cpp:191 executejob.cpp:215
msgctxt "KAuth::ExecuteJob|"
msgid "The backend does not specify how to authorize"
msgstr "پشتیبان نحوهٔ احراز هویت را مشخص نکرده است"
