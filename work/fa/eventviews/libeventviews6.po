#: agenda/timelabels.cpp:328
#, kde-format
msgctxt "@action:inmenu"
msgid "&Add Timezones…"
msgstr "افزودن منطقه‌های زمانی…"

#: agenda/timelabels.cpp:329
#, kde-format
msgctxt "@info:tooltip"
msgid "Add a timelabel display column for a new timezone"
msgstr "افزودن یک ستون نمایش برچسب زمان برای منطقهٔ زمانی جدید"

#: agenda/timelabels.cpp:332
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This menu will show a timezone selection dialog allowing you to select a "
"timezone for showing hour labels alongside your system timezone hour labels."
" This feature is very useful when showing calendar events for people in "
"timezones other than your own."
msgstr ""
"این منو یک کادر گفتگوی انتخاب منطقهٔ زمانی را نشان می‌دهد که به شما امکان "
"می‌دهد یک منطقهٔ زمانی را برای نمایش برچسب‌های ساعت در کنار برچسب‌های ساعت "
"منطقهٔ زمانی سیستم خود انتخاب کنید. این قابلیت هنگام نمایش رویدادهای تقویم "
"برای افرادی در مناطق زمانی غیر از منطقهٔ زمانی خودتان بسیار مفید است."

#: agenda/timelabels.cpp:336
#, kde-format
msgctxt "@action:inmenu"
msgid "&Remove Timezone %1"
msgstr "حذف منطقهٔ زمانی %1"

#: agenda/timelabels.cpp:340
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Remove the hour label column for the currently selected timezone, for non-"
"system timezones only."
msgstr ""
"حذف ستون برچسب ساعت برای منطقهٔ زمانی انتخاب‌شدهٔ کنونی، فقط برای مناطق "
"زمانی غیرسیستمی."

#: agenda/timelabels.cpp:343
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"For non-system timezones, this menu selection removes the time hour labels "
"display column for the currently selected timezone."
msgstr ""
"برای مناطق زمانی غیرسیستمی، این گزینهٔ منو ستون نمایش برچسب‌های ساعت زمان را"
" برای منطقهٔ زمانی انتخاب‌شدهٔ کنونی حذف می‌کند."

#: agenda/timelabels.cpp:347
#, kde-format
msgctxt "@action:inmenu"
msgid "12 Hour Clock"
msgstr "ساعت ۱۲ ساعته"

#: agenda/timelabels.cpp:349
#, kde-format
msgctxt "@action:inmenu"
msgid "24 Hour Clock"
msgstr "ساعت ۲۴ ساعته"

#: agenda/timelabels.cpp:351
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Display the time label hours in 24-hour \"military\" format or according to "
"your locale"
msgstr ""
"نمایش ساعت‌های برچسب زمان در قالب ۲۴ ساعته یا بر اساس زبان و منطقهٔ شما"

#: agenda/timelabels.cpp:353
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This menu selection shows the time hour labels according to 24-hour "
"\"military\" time or your system locale."
msgstr ""
"این گزینهٔ منو برچسب‌های ساعت زمان را بر اساس زمان ۲۴ ساعته یا زبان و منطقهٔ"
" سیستم شما نشان می‌دهد."

#: agenda/timelabels.cpp:358
#, kde-format
msgctxt "@action:inmenu"
msgid "Hide Right-side Time Labels"
msgstr "پنهان کردن برچسب‌های زمان سمت راست"

#: agenda/timelabels.cpp:360
#, kde-format
msgctxt "@action:inmenu"
msgid "Show Right-side Time Labels"
msgstr "نمایش برچسب‌های زمان سمت راست"

#: agenda/timelabels.cpp:364
#, kde-format
msgctxt "@action:inmenu"
msgid "Hide Left-side Time Labels"
msgstr "پنهان کردن برچسب‌های زمان سمت چپ"

#: agenda/timelabels.cpp:366
#, kde-format
msgctxt "@action:inmenu"
msgid "Show Left-side Time Labels"
msgstr "نمایش برچسب‌های زمان سمت چپ"

#: agenda/timelabels.cpp:369
#, kde-format
msgctxt "@info::tooltip"
msgid "Show or hide time labels on both sides of the agenda view"
msgstr "نمایش یا پنهان کردن برچسب‌های زمان در دو طرف نمای دستور کار"

#: agenda/timelabels.cpp:371
#, kde-format
msgctxt "@info::whatsthis"
msgid ""
"This menu selection shows or hides the time labels on both sides of the "
"agenda view. Only the system timezone (and no extra added timezones) is "
"shown on the second side to save screen space. Similarly, the vertical "
"scrollbar is removed when the time labels are shown on both sides."
msgstr ""
"این گزینهٔ منو برچسب‌های زمان را در دو طرف نمای دستور کار نشان می‌دهد یا "
"پنهان می‌کند. برای صرفه‌جویی در فضای صفحه، تنها منطقهٔ زمانی سامانه (و نه "
"مناطق زمانی اضافه شده) در سمت دوم نمایش داده می‌شود. به همین ترتیب، با نمایش"
" برچسب‌های زمان در هر دو طرف، نوار پیمایش عمودی برداشته می‌شود."

