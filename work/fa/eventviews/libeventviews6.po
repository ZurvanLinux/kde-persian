#: eventview.cpp:120
#, kde-format
msgctxt "@title:window"
msgid "Changing Recurring Item"
msgstr "تغییر مورد تکرارشونده"

#: eventview.cpp:121
#, kde-format
msgid "Also &Future Items"
msgstr "موردهای آینده نیز"

#: eventview.cpp:122
#, kde-format
msgid "Only &This Item"
msgstr "فقط این مورد"

#: eventview.cpp:123
#, kde-format
msgid "&All Occurrences"
msgstr "همهٔ موارد وقوع"

#: eventview.cpp:140
#, kde-format
msgid ""
"The item you are trying to change is a recurring item. Should the changes be"
" applied only to this single occurrence, also to future items, or to all "
"items in the recurrence?"
msgstr ""
"موردی که در حال تغییر آن هستید، یک مورد تکرارشونده است. آیا تغییرات فقط روی "
"همین یک مورد اعمال شود، روی موردهای آینده نیز اعمال شود، یا روی همهٔ موردهای"
" تکرار؟"

#: eventview.cpp:151
#, kde-format
msgid ""
"The item you are trying to change is a recurring item. Should the changes be"
" applied only to this single occurrence or to all items in the recurrence?"
msgstr ""
"موردی که در حال تغییر آن هستید، یک مورد تکرارشونده است. آیا تغییرات فقط روی "
"همین یک مورد اعمال شود یا روی همهٔ موردهای تکرار؟"

#. i18n: ectx: label, entry (Confirm), group (Save Settings)
#: eventviews.kcfg:9
#, kde-format
msgid "Confirm deletes"
msgstr "تأیید حذف‌ها"

#. i18n: ectx: tooltip, entry (Confirm), group (Save Settings)
#: eventviews.kcfg:10
#, kde-format
msgid "Always confirm when deleting items"
msgstr "همیشه هنگام حذف موارد تأیید گرفته شود"

#. i18n: ectx: whatsthis, entry (Confirm), group (Save Settings)
#: eventviews.kcfg:11
#, kde-format
msgid "Check this box to display a confirmation dialog when deleting items."
msgstr ""
"این گزینه را علامت بزنید تا هنگام حذف موارد، کادر تأیید نمایش داده شود."

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:15
#, kde-format
msgid "New Events, To-dos and Journal Entries Should"
msgstr "رویدادها، کارها و مدخل‌های یادداشت جدید باید"

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:18
#, kde-format
msgid "Be added to the default calendar"
msgstr "به تقویم پیش‌فرض اضافه شوند"

#. i18n: ectx: tooltip, entry (Destination), group (Save Settings)
#: eventviews.kcfg:19
#, kde-format
msgid "Always save to the default calendar"
msgstr "همیشه در تقویم پیش‌فرض ذخیره شود"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#: eventviews.kcfg:20
#, kde-format
msgid ""
"Select this option to always record new events, to-dos and journal entries "
"using the current default calendar."
msgstr ""
"این گزینه را انتخاب کنید تا رویدادها، کارها و مدخل‌های یادداشت روزانه جدید "
"همیشه با استفاده از تقویم پیش‌فرض فعلی ثبت شوند."

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:23
#, kde-format
msgid "Be asked which calendar to use"
msgstr "پرسیده شود که از کدام تقویم استفاده شود"

#. i18n: ectx: tooltip, entry (Destination), group (Save Settings)
#: eventviews.kcfg:24
#, kde-format
msgid "Always prompt for the calendar to use"
msgstr "همیشه برای انتخاب تقویم سؤال شود"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#: eventviews.kcfg:25
#, kde-format
msgid ""
"Select this option to choose the calendar to be used to record the item each"
" time you create a new event, to-do or journal entry."
msgstr ""
"این گزینه را انتخاب کنید تا هر بار که رویداد، کار یا یادداشت جدیدی ایجاد "
"می‌کنید، تقویم مورد نظر برای ثبت آن مورد را مشخص نمایید."

#. i18n: ectx: label, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:34
#, kde-format
msgid "Weekly start day:"
msgstr "روز آغازین هفته:"

#. i18n: ectx: tooltip, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:35
#, kde-format
msgid "Select the first day of each week"
msgstr "انتخاب اولین روز هر هفته"

#. i18n: ectx: whatsthis, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:36
#, kde-format
msgid ""
"Select the first day of each week. Normally, you can ignore this since it is"
" set in your locale."
msgstr ""
"اولین روز هر هفته را انتخاب کنید. معمولاً می‌توانید از این گزینه صرف‌نظر "
"کنید زیرا در تنظیمات محلی شما مشخص شده است."

#. i18n: ectx: label, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:40
#, kde-format
msgid "Daily starting hour"
msgstr "ساعت شروع روزانه"

#. i18n: ectx: tooltip, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:41
#, kde-format
msgid "Set the time you typically start your day"
msgstr "تنظیم زمانی که معمولاً روزتان را آغاز می‌کنید"

#. i18n: ectx: whatsthis, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:42
#, kde-format
msgid ""
"Enter the start time for your daily schedule here. Your daily schedule hours"
" will be marked with a separate color."
msgstr ""
"زمان شروع برنامهٔ روزانهٔ خود را اینجا وارد کنید. ساعات برنامهٔ روزانهٔ شما "
"با رنگی مجزا مشخص خواهند شد."

#. i18n: ectx: label, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:46
#, kde-format
msgid "Daily ending hour"
msgstr "ساعت پایان روزانه"

#. i18n: ectx: tooltip, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:47
#, kde-format
msgid "Set the time you typically end your day"
msgstr "تنظیم زمانی که معمولاً روزتان را به پایان می‌رسانید"

#. i18n: ectx: whatsthis, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:48
#, kde-format
msgid ""
"Enter the ending time for your daily schedule here. Your daily schedule "
"hours will be marked with a separate color."
msgstr ""
"زمان پایان برنامهٔ روزانهٔ خود را اینجا وارد کنید. ساعات برنامهٔ روزانهٔ شما"
" با رنگی مجزا مشخص خواهند شد."

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:55 viewerapp/settings.kcfg:9
#, kde-format
msgid "Enable tooltips for displaying summaries"
msgstr "فعال‌سازی پیش‌نمایش متنی برای نمایش خلاصه‌ها"

#. i18n: ectx: tooltip, entry, group (General View)
#: eventviews.kcfg:56
#, kde-format
msgid "Show event or to-do item tooltips"
msgstr "نمایش پیش‌نمایش متنی رویداد یا موارد کاری"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:57 viewerapp/settings.kcfg:10
#, kde-format
msgid ""
"Check this box to display summary tooltips when hovering the mouse over an "
"event or a to-do."
msgstr ""
"برای نمایش نکات راهنمای خلاصه‌وار هنگام قرار گرفتن ماوس روی یک رویداد یا "
"کار، این گزینه را علامت بزنید."

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:61
#, kde-format
msgid "To-dos use tag colors"
msgstr "کارهای در دست اقدام از رنگ برچسب استفاده کنند"

#. i18n: ectx: tooltip, entry, group (General View)
#: eventviews.kcfg:62
#, kde-format
msgid "Draw to-do items using tag colors"
msgstr "رسم موارد کار با استفاده از رنگ برچسب‌ها"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:63
#, kde-format
msgid ""
"Check this box so that to-dos will use tag colors and not colors specific to"
" their due, due today or overdue state"
msgstr ""
"این گزینه را علامت بزنید تا کارها به جای استفاده از رنگ‌های مربوط به وضعیت "
"سررسید، سررسید امروز یا معوقه، از رنگ برچسب استفاده کنند"

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:67
#, kde-format
msgid "Next x days"
msgstr "x روز آینده"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:68
#, kde-format
msgid ""
"Select the number of \"x\" days to be displayed in the next days view. To "
"access the next \"x\" days view, choose the \"Next X Days\" menu item from "
"the \"View\" menu."
msgstr ""
"تعداد «x» روز را برای نمایش در نمای روزهای آینده انتخاب کنید. برای دسترسی به"
" نمای «x» روز آینده، مورد «X روز آینده» را از منوی «نمایش» انتخاب کنید."

#. i18n: ectx: tooltip, entry, group (General View)
#: eventviews.kcfg:69
#, kde-format
msgid "Show this many days at a time in the Next \"x\" days view"
msgstr "نمایش هم‌زمان این تعداد روز در نمای «x» روز آینده"

#. i18n: ectx: label, entry (DailyRecur), group (General View)
#: eventviews.kcfg:73
#, kde-format
msgid "Show items that recur daily"
msgstr "نمایش مواردی که روزانه تکرار می‌شوند"

#. i18n: ectx: tooltip, entry (DailyRecur), group (General View)
#: eventviews.kcfg:74
#, kde-format
msgid "Use a bold typeface to more easily identify daily recurring incidences"
msgstr "استفاده از قلم پررنگ برای شناسایی آسان‌تر رخدادهای تکرارشونده روزانه"

#. i18n: ectx: whatsthis, entry (DailyRecur), group (General View)
#: eventviews.kcfg:75
#, kde-format
msgid ""
"Check this box to show the days containing daily recurring incidences in "
"bold typeface in the Date Navigator, or uncheck it to give more prominence "
"to other (non daily recurring) incidences."
msgstr ""
"این گزینه را علامت بزنید تا روزهای دارای رخدادهای تکرارشونده روزانه با قلم "
"پررنگ در «ناوبری تاریخ» نمایش داده شوند، یا علامت آن را بردارید تا رخدادهای "
"دیگر (غیرتکرارشونده روزانه) برجسته‌تر دیده شوند."

#. i18n: ectx: label, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:79
#, kde-format
msgid "Show items that recur weekly"
msgstr "نمایش مواردی که هفتگی تکرار می‌شوند"

#. i18n: ectx: tooltip, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:80
#, kde-format
msgid ""
"Use a bold typeface to more easily identify weekly recurring incidences"
msgstr ""
"استفاده از قلم پررنگ (بولد) برای شناسایی آسان‌تر رخدادهای با تکرار هفتگی"

#. i18n: ectx: whatsthis, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:81
#, kde-format
msgid ""
"Check this box to show the days containing weekly recurring events in bold "
"typeface in the Date Navigator, or uncheck it to give more prominence to "
"other (non weekly recurring) events."
msgstr ""
"این گزینه را علامت بزنید تا در «ناوبری تاریخ»، روزهای دارای رویدادهای با "
"تکرار هفتگی با قلم پررنگ نمایش داده شوند، یا علامت آن را بردارید تا "
"رویدادهای دیگر (غیر هفتگی) بیشتر به چشم بیایند."

#. i18n: ectx: label, entry (HighlightTodos), group (General View)
#: eventviews.kcfg:85
#, kde-format
msgid "Show to-dos instead of events when in Todo View"
msgstr "نمایش کارها به‌جای رویدادها هنگام حضور در «نمای کارها»"

#. i18n: ectx: tooltip, entry (HighlightTodos), group (General View)
#: eventviews.kcfg:86
#, kde-format
msgid "In Todo View, use a bold typeface to more easily identify to-dos"
msgstr "در «نمای کارها»، از قلم پررنگ برای شناسایی آسان‌تر کارها استفاده شود"

#. i18n: ectx: whatsthis, entry (HighlightTodos), group (General View)
#: eventviews.kcfg:87
#, kde-format
msgid ""
"Check this box to show the days containing to-dos in bold typeface in the "
"Date Navigator when in Todo View."
msgstr ""
"این گزینه را علامت بزنید تا در «نمای کارها»، روزهای دارای کار در «ناوبری "
"تاریخ» با قلم پررنگ نمایش داده شوند."

#. i18n: ectx: label, entry (HighlightJournals), group (General View)
#: eventviews.kcfg:91
#, kde-format
msgid "Show journals instead of events when in Journal View"
msgstr ""
"نمایش یادداشت‌های روزانه به‌جای رویدادها هنگام حضور در «نمای یادداشت روزانه»"

#. i18n: ectx: tooltip, entry (HighlightJournals), group (General View)
#: eventviews.kcfg:92
#, kde-format
msgid "In Journal View, use a bold typeface to more easily identify journals"
msgstr ""
"در «نمای یادداشت روزانه»، از قلم پررنگ برای شناسایی آسان‌تر یادداشت‌های "
"روزانه استفاده شود"

#. i18n: ectx: whatsthis, entry (HighlightJournals), group (General View)
#: eventviews.kcfg:93
#, kde-format
msgid ""
"Check this box to show the days containing journals in bold typeface in the "
"Date Navigator when in Journal View."
msgstr ""
"این گزینه را علامت بزنید تا در «نمای یادداشت روزانه»، روزهای دارای یادداشت "
"روزانه در «ناوبری تاریخ» با قلم پررنگ نمایش داده شوند."

#. i18n: ectx: label, entry (WeekNumbersShowWork), group (General View)
#: eventviews.kcfg:97
#, kde-format
msgid "Week numbers select a work week when in work week mode"
msgstr "شماره‌های هفته در حالت «هفتهٔ کاری»، یک هفتهٔ کاری را انتخاب کنند"

#. i18n: ectx: tooltip, entry (WeekNumbersShowWork), group (General View)
#: eventviews.kcfg:98
#, kde-format
msgid ""
"In work week mode, allow selecting a work week rather than the whole week"
msgstr "در حالت هفتهٔ کاری، امکان انتخاب هفتهٔ کاری به جای کل هفته داده شود"

#. i18n: ectx: whatsthis, entry (WeekNumbersShowWork), group (General View)
#: eventviews.kcfg:99
#, kde-format
msgid ""
"Check this box to select a working week when clicking on the Date "
"Navigator's week numbers, or uncheck it to choose the whole week.  Ignored "
"if week numbers are not shown."
msgstr ""
"این گزینه را علامت بزنید تا با کلیک روی شماره‌های هفته در پیمایشگر تاریخ، "
"هفتهٔ کاری انتخاب شود، یا علامت آن را بردارید تا کل هفته انتخاب شود. در "
"صورتی که شماره‌های هفته نمایش داده نشوند، نادیده گرفته می‌شود."

#. i18n: ectx: label, entry, group (Agenda View)
#: eventviews.kcfg:106 viewerapp/settings.kcfg:17
#, kde-format
msgid "Hour size"
msgstr "اندازهٔ ساعت"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:107 viewerapp/settings.kcfg:18
#, kde-format
msgid ""
"Select the height of the hour rows in the agenda grid, in pixels. Increasing"
" this value will make each row in the agenda grid taller."
msgstr ""
"ارتفاع ردیف‌های ساعت را در شبکهٔ تقویم کاری برحسب پیکسل انتخاب کنید. افزایش "
"این مقدار باعث بلندتر شدن هر ردیف در شبکهٔ تقویم کاری می‌شود."

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:108 viewerapp/settings.kcfg:19
#, kde-format
msgid "Set the height (in pixels) for an hour in the agenda grid"
msgstr "تنظیم ارتفاع (به پیکسل) برای یک ساعت در شبکهٔ تقویم کاری"

#. i18n: ectx: label, entry (EnableAgendaItemIcons), group (Agenda View)
#: eventviews.kcfg:114
#, kde-format
msgid "Show icons in Agenda View items"
msgstr "نمایش آیکون‌ها در موارد نمای تقویم کاری"

#. i18n: ectx: whatsthis, entry (EnableAgendaItemIcons), group (Agenda View)
#: eventviews.kcfg:115
#, kde-format
msgid ""
"Check this box to display icons (alarm, recursion, etc.) in Agenda View "
"items."
msgstr ""
"این گزینه را علامت بزنید تا آیکون‌ها (هشدار، تکرار و غیره) در موارد نمای "
"تقویم کاری نمایش داده شوند."

#. i18n: ectx: tooltip, entry (EnableAgendaItemIcons), group (Agenda View)
#: eventviews.kcfg:116
#, kde-format
msgid "Display icons in Agenda View items"
msgstr "نمایش آیکون‌ها در موارد نمای تقویم کاری"

#. i18n: ectx: label, entry (EnableAgendaBoldEvenHours), group (Agenda View)
#: eventviews.kcfg:120
#, kde-format
msgid "Draw bold horizontal grid lines for the even hours"
msgstr "رسم خطوط افقی پررنگ برای ساعت‌های زوج"

#. i18n: ectx: whatsthis, entry (EnableAgendaBoldEvenHours), group (Agenda
#. View)
#: eventviews.kcfg:121
#, kde-format
msgid ""
"Draw a bolder horizontal grid line for the even hours (12am, 2am, 4am, etc)."
msgstr "رسم خط افقی پررنگ‌تر برای ساعت‌های زوج (۱۲ ق.ظ، ۲ ق.ظ، ۴ ق.ظ و غیره)."

#. i18n: ectx: tooltip, entry (EnableAgendaBoldEvenHours), group (Agenda View)
#: eventviews.kcfg:122
#, kde-format
msgid "Draw bolder even hour grid lines"
msgstr "رسم خطوط شبکه ساعت‌های زوج به صورت پررنگ‌تر"

#. i18n: ectx: label, entry (EnableAgendaItemDesc), group (Agenda View)
#: eventviews.kcfg:126
#, kde-format
msgid "Show incidence descriptions in Agenda View items"
msgstr "نمایش شرح رویدادها در موارد نمای دستور کار"

#. i18n: ectx: whatsthis, entry (EnableAgendaItemDesc), group (Agenda View)
#: eventviews.kcfg:127
#, kde-format
msgid ""
"Check this box to display the incidence descriptions in Agenda View items."
msgstr ""
"این گزینه را برای نمایش شرح رویدادها در موارد نمای دستور کار علامت بزنید."

#. i18n: ectx: tooltip, entry (EnableAgendaItemDesc), group (Agenda View)
#: eventviews.kcfg:128
#, kde-format
msgid "Display incidence descriptions in Agenda View items"
msgstr "نمایش شرح رویدادها در موارد نمای دستور کار"

#. i18n: ectx: label, entry (EnableAgendaItemLocation), group (Agenda View)
#: eventviews.kcfg:132
#, kde-format
msgid "Show incidence locations in Agenda View items"
msgstr "نمایش مکان رویدادها در موارد نمای دستور کار"

#. i18n: ectx: whatsthis, entry (EnableAgendaItemLocation), group (Agenda
#. View)
#: eventviews.kcfg:133
#, kde-format
msgid ""
"Check this box to display the incidence locations in Agenda View items."
msgstr ""
"این گزینه را برای نمایش مکان رویدادها در موارد نمای دستور کار علامت بزنید."

#. i18n: ectx: tooltip, entry (EnableAgendaItemLocation), group (Agenda View)
#: eventviews.kcfg:134
#, kde-format
msgid "Display incidence locations in Agenda View items"
msgstr "نمایش مکان رویدادها در موارد نمای دستور کار"

#. i18n: ectx: label, entry (ColorBusyDaysEnabled), group (Agenda View)
#. i18n: ectx: label, entry (ColorMonthBusyDaysEnabled), group (Month View)
#: eventviews.kcfg:138 eventviews.kcfg:246
#, kde-format
msgid "Color busy days with a different background color"
msgstr "رنگ‌آمیزی روزهای پرمشغله با رنگ پس‌زمینهٔ متفاوت"

#. i18n: ectx: tooltip, entry (ColorBusyDaysEnabled), group (Agenda View)
#. i18n: ectx: tooltip, entry (ColorMonthBusyDaysEnabled), group (Month View)
#: eventviews.kcfg:139 eventviews.kcfg:247
#, kde-format
msgid "Use the busy days background color setting for busy days"
msgstr "استفاده از تنظیم رنگ پس‌زمینهٔ روزهای پرمشغله برای روزهای پرمشغله"

#. i18n: ectx: whatsthis, entry (ColorBusyDaysEnabled), group (Agenda View)
#: eventviews.kcfg:140
#, kde-format
msgid ""
"Check this box if you want agenda's background to be filled with a different"
" color on days which have at least one all day event marked as busy. Also, "
"you can change the background color used for this option on the Colors "
"configuration page. Look for the \"Busy days background color\" setting."
msgstr ""
"اگر می‌خواهید پس‌زمینهٔ دستور کار در روزهایی که حداقل یک رویداد تمام‌روزِ "
"پرمشغله دارند با رنگ متفاوتی پر شود، این گزینه را علامت بزنید. همچنین "
"می‌توانید رنگ پس‌زمینهٔ استفاده‌شده برای این گزینه را در صفحهٔ پیکربندی "
"«رنگ‌ها» تغییر دهید. دنبال تنظیم «رنگ پس‌زمینهٔ روزهای پرمشغله» بگردید."

#. i18n: ectx: label, entry (ShowTodosAgendaView), group (Agenda View)
#. i18n: ectx: label, entry (ShowTodosMonthView), group (Month View)
#: eventviews.kcfg:144 eventviews.kcfg:252 viewerapp/settings.kcfg:31
#: viewerapp/settings.kcfg:116
#, kde-format
msgid "Show to-dos"
msgstr "نمایش کارهای انجام‌دادنی"

#. i18n: ectx: whatsthis, entry (ShowTodosAgendaView), group (Agenda View)
#: eventviews.kcfg:145
#, kde-format
msgid "Check this box to display to-dos in the Agenda View."
msgstr ""
"این گزینه را علامت بزنید تا کارهای انجام‌دادنی در نمای دستور کار نمایش داده "
"شوند."

#. i18n: ectx: tooltip, entry (ShowTodosAgendaView), group (Agenda View)
#: eventviews.kcfg:146
#, kde-format
msgid "Display to-dos in the Agenda View"
msgstr "نمایش کارهای انجام‌دادنی در نمای دستور کار"

#. i18n: ectx: label, entry (MarcusBainsEnabled), group (Agenda View)
#: eventviews.kcfg:150 viewerapp/settings.kcfg:37
#, kde-format
msgid "Show current-time (Marcus Bains) line"
msgstr "نمایش خط زمان فعلی (مارکوس بینز)"

#. i18n: ectx: whatsthis, entry (MarcusBainsEnabled), group (Agenda View)
#: eventviews.kcfg:151 viewerapp/settings.kcfg:38
#, kde-format
msgid ""
"Check this box to display a line in the day or week view indicating the "
"current-time line (Marcus Bains line)."
msgstr ""
"این گزینه را علامت بزنید تا خطی در نمای روز یا هفته نمایش داده شود که زمان "
"فعلی (خط مارکوس بینز) را مشخص می‌کند."

#. i18n: ectx: tooltip, entry (MarcusBainsEnabled), group (Agenda View)
#: eventviews.kcfg:152 viewerapp/settings.kcfg:39
#, kde-format
msgid "Display the current-time indicator"
msgstr "نمایش نشانگر زمان فعلی"

#. i18n: ectx: label, entry (MarcusBainsShowSeconds), group (Agenda View)
#: eventviews.kcfg:156
#, kde-format
msgid "Show seconds and timezone on the current-time (Marcus Bains) line"
msgstr "نمایش ثانیه‌ها و منطقه زمانی روی خط زمان فعلی (مارکوس بینز)"

#. i18n: ectx: whatsthis, entry (MarcusBainsShowSeconds), group (Agenda View)
#: eventviews.kcfg:157
#, kde-format
msgid ""
"Check this box if you want to show seconds on the current-time (Marcus "
"Bains) line. Depending on your locale, the timezone will also be displayed."
msgstr ""
"اگر می‌خواهید ثانیه‌ها روی خط زمان فعلی (مارکوس بینز) نمایش داده شوند، این "
"گزینه را علامت بزنید. بسته به محل شما، منطقه زمانی نیز نمایش داده خواهد شد."

#. i18n: ectx: tooltip, entry (MarcusBainsShowSeconds), group (Agenda View)
#: eventviews.kcfg:158
#, kde-format
msgid ""
"Display seconds (possibly with timezone) with the current-time indicator"
msgstr "نمایش ثانیه‌ها (احتمالاً همراه با منطقه زمانی) با نشانگر زمان فعلی"

#. i18n: ectx: label, entry (SelectionStartsEditor), group (Agenda View)
#: eventviews.kcfg:162
#, kde-format
msgid "Time range selection in Agenda View starts event editor"
msgstr "انتخاب محدوده زمانی در نمای دستور کار، ویرایشگر رویداد را باز می‌کند"

#. i18n: ectx: whatsthis, entry (SelectionStartsEditor), group (Agenda View)
#: eventviews.kcfg:163 viewerapp/settings.kcfg:50
#, kde-format
msgid ""
"Check this box to start the event editor automatically when you select a "
"time range in the daily and weekly view. To select a time range, drag the "
"mouse from the start time to the end time of the event you are about to "
"plan."
msgstr ""
"این گزینه را علامت بزنید تا هنگام انتخاب یک بازهٔ زمانی در نمای روزانه و "
"هفتگی، ویرایشگر رویداد به طور خودکار باز شود. برای انتخاب بازهٔ زمانی، "
"موشواره را از زمان شروع تا زمان پایان رویدادی که قصد برنامه‌ریزی آن را دارید"
" بکشید."

#. i18n: ectx: tooltip, entry (SelectionStartsEditor), group (Agenda View)
#: eventviews.kcfg:164 viewerapp/settings.kcfg:51
#, kde-format
msgid "Enable automatic event editor with time range selection"
msgstr "فعال‌سازی ویرایشگر خودکار رویداد با انتخاب بازهٔ زمانی"

#. i18n: ectx: label, entry, group (Agenda View)
#: eventviews.kcfg:168
#, kde-format
msgid "Agenda Item Colors"
msgstr "رنگ‌های موارد دستور کار"

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:171 eventviews.kcfg:280
#, kde-format
msgid "Tag inside, calendar outside"
msgstr "برچسب درون، گاه‌شمار بیرون"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:172
#, kde-format
msgid ""
"Draw agenda items with their tag color inside and calendar color for their "
"border"
msgstr ""
"رسم موارد دستور کار با رنگ برچسب در داخل و رنگ گاه‌شمار برای حاشیهٔ آن‌ها"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#. i18n: ectx: whatsthis, entry, group (Month View)
#: eventviews.kcfg:173 eventviews.kcfg:282
#, kde-format
msgid ""
"Select the \"Tag inside, calendar outside\" option if you would like to draw"
" calendar items using their associated tag color, with the item's border "
"drawn in the color of its calendar.  Please use the Colors and Fonts "
"configuration page for setting these colors."
msgstr ""
"اگر می‌خواهید موارد گاه‌شمار با رنگ برچسب مرتبطشان و حاشیهٔ آن‌ها با رنگ "
"گاه‌شمار رسم شود، گزینهٔ «برچسب درون، گاه‌شمار بیرون» را انتخاب کنید. لطفاً "
"برای تنظیم این رنگ‌ها از صفحهٔ پیکربندی «رنگ‌ها و قلم‌ها» استفاده کنید."

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:176 eventviews.kcfg:285
#, kde-format
msgid "Calendar inside, tag outside"
msgstr "گاه‌شمار درون، برچسب بیرون"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:177
#, kde-format
msgid ""
"Draw agenda items with their calendar color inside and tag color for their "
"border"
msgstr ""
"رسم موارد دستور کار با رنگ گاه‌شمار در داخل و رنگ برچسب برای حاشیهٔ آن‌ها"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#. i18n: ectx: whatsthis, entry, group (Month View)
#: eventviews.kcfg:178 eventviews.kcfg:287
#, kde-format
msgid ""
"Select the \"Calendar inside, tag outside\" option if you would like to draw"
" calendar items using their associated calendar color, with the item's "
"border drawn in the color of its tag.  Please use the Colors and Fonts "
"configuration page for setting these colors."
msgstr ""
"اگر می‌خواهید موارد گاه‌شمار با رنگ گاه‌شمار مرتبطشان و حاشیهٔ آن‌ها با رنگ "
"برچسب رسم شود، گزینهٔ «گاه‌شمار درون، برچسب بیرون» را انتخاب کنید. لطفاً "
"برای تنظیم این رنگ‌ها از صفحهٔ پیکربندی «رنگ‌ها و قلم‌ها» استفاده کنید."

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:181 eventviews.kcfg:290
#, kde-format
msgid "Only tag"
msgstr "فقط برچسب"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:182
#, kde-format
msgid "Draw agenda items using their tag color for the inside and border"
msgstr "رسم موارد دستور کار با استفاده از رنگ برچسب آن‌ها برای داخل و حاشیه"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:183
#, kde-format
msgid ""
"Select the \"Only tag\" option if you would like to draw calendar items "
"(both inside and border) using the color of their associated tag.  Please "
"use the Colors and Fonts configuration page for setting these colors."
msgstr ""
"اگر می‌خواهید موارد تقویم (هم داخل و هم حاشیه) با استفاده از رنگ برچسب "
"مرتبطشان رسم شوند، گزینه «فقط برچسب» را انتخاب کنید. لطفاً برای تنظیم این "
"رنگ‌ها از صفحه پیکربندی «رنگ‌ها و قلم‌ها» استفاده کنید."

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:186 eventviews.kcfg:295 viewerapp/settings.kcfg:73
#: viewerapp/settings.kcfg:151
#, kde-format
msgid "Only calendar"
msgstr "فقط تقویم"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:187 viewerapp/settings.kcfg:75
#, kde-format
msgid "Draw agenda items using their calendar color for the inside and border"
msgstr "رسم موارد دستور کار با استفاده از رنگ تقویم آن‌ها برای داخل و حاشیه"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:188
#, kde-format
msgid ""
"Select the \"Only calendar\" option if you would like to draw calendar items"
" (both inside and border) using the color of their calendar. Please use the "
"Colors and Fonts configuration page for setting these colors."
msgstr ""
"اگر می‌خواهید موارد تقویم (هم داخل و هم حاشیه) با استفاده از رنگ تقویمشان "
"رسم شوند، گزینه «فقط تقویم» را انتخاب کنید. لطفاً برای تنظیم این رنگ‌ها از "
"صفحه پیکربندی «رنگ‌ها و قلم‌ها» استفاده کنید."

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:194 viewerapp/settings.kcfg:81
#, kde-format
msgid "Multiple Calendar Display"
msgstr "نمایش چند تقویم"

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:197 viewerapp/settings.kcfg:84
#, kde-format
msgid "Merge all calendars into one view"
msgstr "ادغام همه تقویم‌ها در یک نما"

#. i18n: ectx: whatsthis, entry (AgendaViewCalendarDisplay), group (Agenda
#. View)
#: eventviews.kcfg:198
#, kde-format
msgid ""
"Select the \"Merge all calendars into one view\" option if you would like "
"all your calendars to be shown together in one Agenda View."
msgstr ""
"اگر می‌خواهید همه تقویم‌هایتان با هم در یک «نمای دستور کار» نمایش داده شوند،"
" گزینه «ادغام همه تقویم‌ها در یک نما» را انتخاب کنید."

#. i18n: ectx: tooltip, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:199 viewerapp/settings.kcfg:86
#, kde-format
msgid "Show all calendars merged together"
msgstr "نمایش همه تقویم‌ها به‌صورت ادغام‌شده با هم"

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:202 viewerapp/settings.kcfg:89
#, kde-format
msgid "Show calendars side by side"
msgstr "نمایش تقویم‌ها در کنار هم"

#. i18n: ectx: whatsthis, entry (AgendaViewCalendarDisplay), group (Agenda
#. View)
#: eventviews.kcfg:203 viewerapp/settings.kcfg:90
#, kde-format
msgid ""
"Select the \"Show calendars side by side\" option if you would like to see "
"two calendars at once, in a side-by-side view."
msgstr ""
"اگر مایلید دو تقویم را به‌طور همزمان در کنار یکدیگر مشاهده کنید، گزینه "
"«نمایش تقویم‌ها کنار هم» را انتخاب کنید."

#. i18n: ectx: tooltip, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:204 viewerapp/settings.kcfg:91
#, kde-format
msgid "Show two calendars side-by-side"
msgstr "نمایش دو تقویم در کنار هم"

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:207 viewerapp/settings.kcfg:94
#, kde-format
msgid "Switch between views with tabs"
msgstr "جابه‌جایی بین نماها با برگه"

#. i18n: ectx: whatsthis, entry (AgendaViewCalendarDisplay), group (Agenda
#. View)
#: eventviews.kcfg:208 viewerapp/settings.kcfg:95
#, kde-format
msgid ""
"Select \"Switch between views with tabs\" if you would like to alternate "
"between calendars using the tab key."
msgstr ""
"اگر مایلید با استفاده از کلید تب بین تقویم‌ها جابه‌جا شوید، «جابه‌جایی بین "
"نماها با برگه» را انتخاب کنید."

#. i18n: ectx: tooltip, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:209 viewerapp/settings.kcfg:96
#, kde-format
msgid "Tab through calendars"
msgstr "جابه‌جایی بین تقویم‌ها با کلید تب"

#. i18n: ectx: label, entry, group (Agenda View)
#: eventviews.kcfg:215
#, kde-format
msgid "Highlight color"
msgstr "رنگ برجسته‌سازی"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:216
#, kde-format
msgid ""
"Select the highlight color here. The highlight color will be used for "
"marking the currently selected area in your agenda and in the date "
"navigator."
msgstr ""
"رنگ برجسته‌سازی را اینجا انتخاب کنید. از این رنگ برای نشانه‌گذاری ناحیهٔ "
"انتخاب‌شده در دستور کار و راهبر تاریخ استفاده می‌شود."

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#. i18n: ectx: label, entry, group (Colors)
#: eventviews.kcfg:220 eventviews.kcfg:314 eventviews.kcfg:367
#: viewerapp/settings.kcfg:197
#, kde-format
msgid "Working hours color"
msgstr "رنگ ساعت کاری"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:221
#, kde-format
msgid "Select the working hours background color for the Agenda View here."
msgstr "رنگ پس‌زمینهٔ ساعت کاری را برای نمای دستور کار اینجا انتخاب کنید."

#. i18n: ectx: label, entry (EnableMonthItemIcons), group (Month View)
#: eventviews.kcfg:228
#, kde-format
msgid "Show icons in Month View items"
msgstr "نمایش آیکون‌ها در موارد نمای ماهانه"

#. i18n: ectx: whatsthis, entry (EnableMonthItemIcons), group (Month View)
#: eventviews.kcfg:229
#, kde-format
msgid ""
"Check this box to display icons (alarm, recursion, etc.) in Month View "
"items."
msgstr ""
"برای نمایش نمادها (هشدار، تکرار و غیره) در موارد نمای ماهانه، این گزینه را "
"علامت بزنید."

#. i18n: ectx: tooltip, entry (EnableMonthItemIcons), group (Month View)
#: eventviews.kcfg:230
#, kde-format
msgid "Display icons in Month View items"
msgstr "نمایش نمادها در موارد نمای ماهانه"

#. i18n: ectx: label, entry (ShowTimeInMonthView), group (Month View)
#: eventviews.kcfg:234
#, kde-format
msgid "Show start-times without end-times in Month View items"
msgstr "نمایش زمان‌های شروع بدون زمان‌های پایان در موارد نمای ماهانه"

#. i18n: ectx: whatsthis, entry (ShowTimeInMonthView), group (Month View)
#: eventviews.kcfg:235
#, kde-format
msgid ""
"Check this box to display the start-time without the end-time in Month View "
"items."
msgstr ""
"برای نمایش زمان شروع بدون زمان پایان در موارد نمای ماهانه، این گزینه را "
"علامت بزنید."

#. i18n: ectx: tooltip, entry (ShowTimeInMonthView), group (Month View)
#: eventviews.kcfg:236
#, kde-format
msgid "Display start-time without the end-time in Month View items"
msgstr "نمایش زمان شروع بدون زمان پایان در موارد نمای ماهانه"

#. i18n: ectx: label, entry (ShowEndTimeInMonthView), group (Month View)
#: eventviews.kcfg:240
#, kde-format
msgid "Show the start-time and the end-time in Month View items"
msgstr "نمایش زمان شروع و زمان پایان در موارد نمای ماهانه"

#. i18n: ectx: whatsthis, entry (ShowEndTimeInMonthView), group (Month View)
#: eventviews.kcfg:241
#, kde-format
msgid "Check this box to display the start and end times in Month View items."
msgstr ""
"برای نمایش زمان‌های شروع و پایان در موارد نمای ماهانه، این گزینه را علامت "
"بزنید."

#. i18n: ectx: tooltip, entry (ShowEndTimeInMonthView), group (Month View)
#: eventviews.kcfg:242
#, kde-format
msgid "Display the start and end times in Month View items"
msgstr "نمایش زمان‌های شروع و پایان در موارد نمای ماهانه"

#. i18n: ectx: whatsthis, entry (ColorMonthBusyDaysEnabled), group (Month
#. View)
#: eventviews.kcfg:248
#, kde-format
msgid ""
"Check this box if you want Month View's background to be filled with a "
"different color on days which have at least one all day event marked as "
"busy. Also, you can change the background color used for this option on the "
"Colors configuration page. Look for the \"Busy days background color\" "
"setting."
msgstr ""
"اگر می‌خواهید پس‌زمینه نمای ماهانه در روزهایی که حداقل یک رویداد تمام‌روزِ "
"مشخص‌شده به‌عنوان مشغول دارند با رنگ دیگری پر شود، این گزینه را علامت بزنید."
" همچنین می‌توانید رنگ پس‌زمینه استفاده‌شده برای این گزینه را در صفحه "
"پیکربندی رنگ‌ها تغییر دهید. به دنبال تنظیم «رنگ پس‌زمینه روزهای مشغول» "
"بگردید."

#. i18n: ectx: whatsthis, entry (ShowTodosMonthView), group (Month View)
#: eventviews.kcfg:253
#, kde-format
msgid "Check this box to display to-dos in the Month View."
msgstr "برای نمایش کارها در نمای ماهانه، این گزینه را علامت بزنید."

#. i18n: ectx: tooltip, entry (ShowTodosMonthView), group (Month View)
#: eventviews.kcfg:254
#, kde-format
msgid "Display to-dos in the Month View"
msgstr "نمایش کارهای انجام‌دادنی در نمای ماهانه"

#. i18n: ectx: label, entry (ShowJournalsMonthView), group (Month View)
#: eventviews.kcfg:258 viewerapp/settings.kcfg:122
#, kde-format
msgid "Show journals"
msgstr "نمایش یادداشت‌های روزانه"

#. i18n: ectx: whatsthis, entry (ShowJournalsMonthView), group (Month View)
#: eventviews.kcfg:259
#, kde-format
msgid "Check this box to display journals in the Month View."
msgstr ""
"برای نمایش یادداشت‌های روزانه در نمای ماهانه، این گزینه را علامت بزنید."

#. i18n: ectx: tooltip, entry (ShowJournalsMonthView), group (Month View)
#: eventviews.kcfg:260
#, kde-format
msgid "Display journals in the Month View"
msgstr "نمایش یادداشت‌های روزانه در نمای ماهانه"

#. i18n: ectx: label, entry (ShowHolidaysMonthView), group (Month View)
#: eventviews.kcfg:264
#, kde-format
msgid "Show holidays"
msgstr "نمایش تعطیلات"

#. i18n: ectx: whatsthis, entry (ShowHolidaysMonthView), group (Month View)
#: eventviews.kcfg:265
#, kde-format
msgid "Check this box to display holidays in the Month View."
msgstr "برای نمایش تعطیلات در نمای ماهانه، این گزینه را علامت بزنید."

#. i18n: ectx: tooltip, entry (ShowHolidaysMonthView), group (Month View)
#. i18n: ectx: tooltip, entry (ShowHolidaysBackgroundMonthView), group (Month
#. View)
#: eventviews.kcfg:266 eventviews.kcfg:273
#, kde-format
msgid "Display holidays in the Month View"
msgstr "نمایش تعطیلات در نمای ماهانه"

#. i18n: ectx: label, entry (ShowHolidaysBackgroundMonthView), group (Month
#. View)
#: eventviews.kcfg:270
#, kde-format
msgid "Use the Holiday background color when a holiday lands on the date"
msgstr "استفاده از رنگ پس‌زمینهٔ تعطیلات هنگامی که تاریخی مصادف با تعطیلی است"

#. i18n: ectx: tooltip, entry (ShowHolidaysBackgroundMonthView), group (Month
#. View)
#: eventviews.kcfg:271
#, kde-format
msgid ""
"Use the custom holiday color as the date's background color if a holiday "
"lands on the date"
msgstr ""
"استفاده از رنگ سفارشی تعطیلات به عنوان رنگ پس‌زمینهٔ تاریخ، در صورت مصادف "
"شدن تاریخ با تعطیلی"

#. i18n: ectx: whatsthis, entry (ShowHolidaysBackgroundMonthView), group
#. (Month View)
#: eventviews.kcfg:272
#, kde-format
msgid ""
"Check this box to use the custom holiday as the date's background color when"
" at least one holiday lands on a date. Configure the holiday color in the "
"Settings->Colors and Fonts."
msgstr ""
"این گزینه را علامت بزنید تا اگر حداقل یک تعطیلی با تاریخی مصادف شد، از رنگ "
"سفارشی تعطیلات به‌عنوان رنگ پس‌زمینهٔ آن تاریخ استفاده شود. رنگ تعطیلات را "
"در تنظیمات->رنگ‌ها و قلم‌ها پیکربندی کنید."

#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:277
#, kde-format
msgid "Month Item Colors"
msgstr "رنگ‌های موارد ماهانه"

#. i18n: ectx: tooltip, entry, group (Month View)
#: eventviews.kcfg:281
#, kde-format
msgid ""
"Draw month items with their tag color inside and calendar color for their "
"border"
msgstr "رسم موارد ماهانه با رنگ برچسب در داخل و رنگ گاه‌شمار برای کادر دور"

#. i18n: ectx: tooltip, entry, group (Month View)
#: eventviews.kcfg:286
#, kde-format
msgid ""
"Draw month items with their calendar color inside and tag color for their "
"border"
msgstr "رسم موارد ماهانه با رنگ گاه‌شمار در داخل و رنگ برچسب برای کادر دور"

#. i18n: ectx: tooltip, entry, group (Month View)
#: eventviews.kcfg:291
#, kde-format
msgid "Draw month items using their tag color for the inside and border"
msgstr "رسم موارد ماهانه با استفاده از رنگ برچسب برای داخل و کادر دور"

#. i18n: ectx: whatsthis, entry, group (Month View)
#: eventviews.kcfg:292
#, kde-format
msgid ""
"Select the \"Only tag\" option if you would like to draw calendar items "
"(both inside and border) in the color of their associated tag.  Please use "
"the Colors and Fonts configuration page for setting these colors."
msgstr ""
"اگر می‌خواهید موارد گاه‌شمار (هم داخل و هم کادر دور) با رنگ برچسب مربوط به "
"آن‌ها رسم شوند، گزینهٔ «فقط برچسب» را انتخاب کنید. لطفاً برای تنظیم این "
"رنگ‌ها از صفحهٔ پیکربندی «رنگ‌ها و قلم‌ها» استفاده کنید."

#. i18n: ectx: tooltip, entry, group (Month View)
#: eventviews.kcfg:296 viewerapp/settings.kcfg:153
#, kde-format
msgid "Draw month items using their calendar color for the inside and border"
msgstr "رسم موارد ماهانه با استفاده از رنگ گاه‌شمار برای داخل و کادر دور"

#. i18n: ectx: whatsthis, entry, group (Month View)
#: eventviews.kcfg:297 viewerapp/settings.kcfg:152
#, kde-format
msgid ""
"Select the \"Only calendar\" option if you would like to draw calendar items"
" (both inside and border) in the color of their calendar.  Please use the "
"Colors and Fonts configuration page for setting these colors."
msgstr ""
"اگر می‌خواهید موارد گاه‌شمار (هم داخل و هم کادر دور) با رنگ گاه‌شمار آن‌ها "
"رسم شوند، گزینهٔ «فقط گاه‌شمار» را انتخاب کنید. لطفاً برای تنظیم این رنگ‌ها "
"از صفحهٔ پیکربندی «رنگ‌ها و قلم‌ها» استفاده کنید."

#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:303
#, kde-format
msgid "Month View uses full window"
msgstr "نمای ماهانه از تمام پنجره استفاده کند"

#. i18n: ectx: tooltip, entry, group (Month View)
#. i18n: ectx: tooltip, entry, group (Todo View)
#: eventviews.kcfg:304 eventviews.kcfg:329
#, kde-format
msgid "Display to-do list in a full KOrganizer window"
msgstr "نمایش فهرست کارهای انجام‌دادنی در پنجرهٔ کامل KOrganizer"

#. i18n: ectx: whatsthis, entry, group (Month View)
#: eventviews.kcfg:305
#, kde-format
msgid ""
"Check this box to use the full KOrganizer window when displaying the Month "
"View. If this box is checked, you will gain some space for the monthly view,"
" but other widgets, such as the date navigator, the item details and the "
"calendars list, will not be displayed."
msgstr ""
"این جعبه را علامت بزنید تا هنگام نمایش نمای ماهانه، از تمام پنجرهٔ "
"KOrganizer استفاده شود. اگر این جعبه علامت زده شود، فضای بیشتری برای نمای "
"ماهانه در اختیارتان قرار می‌گیرد، اما سایر ابزارک‌ها مانند ناوبری تاریخ، "
"جزئیات مورد و فهرست گاه‌شمارها نمایش داده نخواهند شد."

#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:309
#, kde-format
msgid "Month View background color"
msgstr "رنگ پس‌زمینهٔ نمای ماهانه"

#. i18n: ectx: whatsthis, entry, group (Month View)
#: eventviews.kcfg:310
#, kde-format
msgid "Select the Month View background color here."
msgstr "رنگ پس‌زمینهٔ نمای ماهانه را از اینجا انتخاب کنید."

#. i18n: ectx: whatsthis, entry, group (Month View)
#: eventviews.kcfg:315
#, kde-format
msgid "Select the working hours background color for the Month View here."
msgstr "رنگ پس‌زمینهٔ ساعات کاری برای نمای ماهانه را از اینجا انتخاب کنید."

#. i18n: ectx: label, entry, group (Todo View)
#: eventviews.kcfg:322 viewerapp/settings.kcfg:162
#, kde-format
msgid "Always display completed to-dos at the bottom of the list"
msgstr "همیشه کارهای انجام‌شده در انتهای فهرست نمایش داده شوند"

#. i18n: ectx: tooltip, entry, group (Todo View)
#: eventviews.kcfg:323
#, kde-format
msgid ""
"Completed to-dos are displayed at the bottom of the list, regardless of "
"priority"
msgstr ""
"کارهای انجام‌شده بدون در نظر گرفتن اولویت، در انتهای فهرست نمایش داده "
"می‌شوند"

#. i18n: ectx: whatsthis, entry, group (Todo View)
#: eventviews.kcfg:324 viewerapp/settings.kcfg:163
#, kde-format
msgid ""
"Check this box if you want all completed to-dos to be always grouped at the "
"bottom of the to-do list."
msgstr ""
"اگر می‌خواهید همهٔ کارهای انجام‌شده همیشه در انتهای فهرست کارها دسته‌بندی "
"شوند، این گزینه را علامت بزنید."

#. i18n: ectx: label, entry, group (Todo View)
#: eventviews.kcfg:328 viewerapp/settings.kcfg:167
#, kde-format
msgid "To-do list view uses full window"
msgstr "استفادهٔ نمای فهرست کارها از تمام پنجره"

#. i18n: ectx: whatsthis, entry, group (Todo View)
#: eventviews.kcfg:330
#, kde-format
msgid ""
"Check this box to use the full KOrganizer window when displaying the to-do "
"list view. If this box is checked, you will gain some space for the to-do "
"list view, but other widgets, such as the Date Navigator, the to-do details "
"and the calendars list, will not be displayed."
msgstr ""
"این گزینه را علامت بزنید تا هنگام نمایش فهرست کارها، از تمام پنجرهٔ "
"KOrganizer استفاده شود. با انتخاب این گزینه، فضای بیشتری برای نمای فهرست "
"کارها خواهید داشت، اما ابزارهای دیگر مانند ناوبری تاریخ، جزئیات کارها و "
"فهرست گاه‌شمارها نمایش داده نخواهند شد."

#. i18n: ectx: label, entry, group (Todo View)
#: eventviews.kcfg:334
#, kde-format
msgid "Display to-dos in a flat list"
msgstr "نمایش کارها در یک فهرست مسطح"

#. i18n: ectx: tooltip, entry, group (Todo View)
#: eventviews.kcfg:335
#, kde-format
msgid "Display to-dos as a flat list instead of a hierarchical tree"
msgstr "نمایش کارها به‌صورت یک فهرست مسطح به‌جای درخت سلسله‌مراتبی"

#. i18n: ectx: whatsthis, entry, group (Todo View)
#: eventviews.kcfg:336
#, kde-format
msgid ""
"Check this box if you want to see all your to-dos in a flat list instead of "
"being arranged in a hierarchical tree."
msgstr ""
"اگر می‌خواهید کارهای خود را به جای چیدمان در یک درخت سلسله‌مراتبی، در یک "
"فهرست ساده و هم‌سطح ببینید، این گزینه را علامت بزنید."

#. i18n: ectx: label, entry, group (Todo View)
#: eventviews.kcfg:340 viewerapp/settings.kcfg:172
#, kde-format
msgid "Record completed to-dos in journal entries"
msgstr "ثبت کارهای انجام‌شده در ورودی‌های یادداشت روزانه"

#. i18n: ectx: tooltip, entry, group (Todo View)
#: eventviews.kcfg:341
#, kde-format
msgid "Add a journal entry each time a to-do is marked as completed"
msgstr ""
"افزودن یک ورودی یادداشت روزانه هر بار که کاری به عنوان انجام‌شده علامت "
"می‌خورد"

#. i18n: ectx: whatsthis, entry, group (Todo View)
#: eventviews.kcfg:342 viewerapp/settings.kcfg:173
#, kde-format
msgid ""
"Check this box to record the completion of a to-do in a new entry of your "
"journal automatically."
msgstr ""
"این گزینه را علامت بزنید تا تکمیل یک کار به‌طور خودکار در ورودی جدیدی از "
"یادداشت روزانه‌تان ثبت شود."

#. i18n: ectx: label, entry, group (Colors)
#: eventviews.kcfg:349
#, kde-format
msgid "Use system colors for some background colors"
msgstr "استفاده از رنگ‌های سامانه برای برخی از رنگ‌های پس‌زمینه"

#. i18n: ectx: tooltip, entry, group (Colors)
#: eventviews.kcfg:350
#, kde-format
msgid "Use system colors instead of custom colors for some background colors"
msgstr ""
"استفاده از رنگ‌های سامانه به جای رنگ‌های سفارشی برای برخی از رنگ‌های "
"پس‌زمینه"

#. i18n: ectx: whatsthis, entry, group (Colors)
#: eventviews.kcfg:351
#, kde-format
msgid ""
"Use system colors instead of user defined colors for the \"Agenda View "
"background color\", \"Busy days background color\" and the \"Working hours "
"color\" (and possibly others)."
msgstr ""
"استفاده از رنگ‌های سامانه به جای رنگ‌های تعریف‌شده توسط کاربر برای «رنگ "
"پس‌زمینهٔ نمای دستور کار»، «رنگ پس‌زمینهٔ روزهای شلوغ» و «رنگ ساعت‌های کاری»"
" (و احتمالاً موارد دیگر)."

#. i18n: ectx: label, entry, group (Colors)
#. i18n: ectx: label, entry (AgendaBgColor), group (Colors)
#: eventviews.kcfg:355 eventviews.kcfg:403
#, kde-format
msgid "Agenda View background color"
msgstr "رنگ پس‌زمینهٔ نمای دستور کار"

#. i18n: ectx: tooltip, entry, group (Colors)
#: eventviews.kcfg:356
