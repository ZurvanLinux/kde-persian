#: src/org.kde.kapman.desktop:4
msgctxt "Name"
msgid "Kapman"
msgstr "کَپ‌من"

#: src/org.kde.kapman.desktop:62
msgctxt "GenericName"
msgid "Pac-Man Clone"
msgstr "مشابه پک‌من"

#: src/org.kde.kapman.desktop:116
msgctxt "Comment"
msgid "Eat pills escaping ghosts"
msgstr "قرص‌ها را بخورید و از دست ارواح فرار کنید"

#: themes/invisible.desktop:2
msgctxt "Name"
msgid "Invisible"
msgstr "نامرئی"

#: themes/invisible.desktop:59
msgctxt "Description"
msgid ""
"Getting bored with Kapman? More than 100,000 points over level 20? Next "
"step: the invisible maze!"
msgstr ""
"از کَپ‌من خسته شده‌اید؟ بیشتر از ۱۰۰٬۰۰۰ امتیاز بعد از مرحلهٔ ۲۰؟ قدم بعدی: "
"هزارتوی نامرئی!"

#: themes/matches.desktop:2
msgctxt "Name"
msgid "Matches"
msgstr "کبریت‌ها"

#: themes/matches.desktop:59
msgctxt "Description"
msgid "A matches drawn maze"
msgstr "هزارتویی کشیده‌شده با کبریت"

#: themes/mountain.desktop:2
msgctxt "Name"
msgid "Mountain Adventure"
msgstr "ماجراجویی در کوهستان"

#: themes/mountain.desktop:55
msgctxt "Description"
msgid "Default"
msgstr "پیش‌فرض"

#: themes/mummies_crypt.desktop:2
msgctxt "Name"
msgid "Mummies Crypt"
msgstr "دخمهٔ مومیایی‌ها"

#: themes/mummies_crypt.desktop:54
msgctxt "Description"
msgid "Avoid the mummies at all costs!"
msgstr "به هر قیمتی از مومیایی‌ها دوری کنید!"

#: themes/retro.desktop:2
msgctxt "Name"
msgid "Retro"
msgstr "نوستالژی"

#: themes/retro.desktop:58
msgctxt "Description"
msgid "The old game theme revisited"
msgstr "بازآفرینی پوستهٔ بازی قدیمی"
