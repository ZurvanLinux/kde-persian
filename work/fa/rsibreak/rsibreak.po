#: src/rsistats.cpp:45
#, kde-format
msgid "Number of skipped long breaks (idle)"
msgstr "تعداد استراحت‌های طولانی رد شده (بی‌کاری)"

#: src/rsistats.cpp:47
#, kde-format
msgid "Total number of short breaks"
msgstr "تعداد کل استراحت‌های کوتاه"

