#: src/gui/org.kde.ksudoku.desktop:2
msgctxt "Name"
msgid "KSudoku"
msgstr "کی‌سودوکو"

#: src/gui/org.kde.ksudoku.desktop:62
msgctxt "GenericName"
msgid "Sudoku Game"
msgstr "بازی سودوکو"

#: src/gui/org.kde.ksudoku.desktop:119
msgctxt "Comment"
msgid "KSudoku, Sudoku game & more by KDE"
msgstr "کی‌سودوکو، بازی سودوکو و بیشتر از KDE"

#: src/shapes/4x4.desktop:2
msgctxt "Name"
msgid "4x4"
msgstr "۴x۴"

#: src/shapes/4x4.desktop:65
msgctxt "Description"
msgid "4x4 shape puzzle"
msgstr "پازل شکلی ۴x۴"

#: src/shapes/6x6.desktop:2
msgctxt "Name"
msgid "6x6"
msgstr "۶x۶"

#: src/shapes/6x6.desktop:52
msgctxt "Description"
msgid "6x6 puzzle with rectangular blocks"
msgstr "پازل ۶x۶ با بلوک‌های مستطیلی"

#: src/shapes/Aztec.desktop:2
msgctxt "Name"
msgid "Aztec"
msgstr "آزتک"

#: src/shapes/Aztec.desktop:56
msgctxt "Description"
msgid "Jigsaw variant shaped like an Aztec pyramid"
msgstr "گونهٔ پازل به شکل هرم آزتک"

#: src/shapes/DoubleRoxdoku.desktop:2
msgctxt "Name"
msgid "Double Roxdoku"
msgstr "روکس‌دوکوی دوگانه"

#: src/shapes/DoubleRoxdoku.desktop:50
msgctxt "Description"
msgid "Three-dimensional puzzle with two interlocking 3x3x3 cubes"
msgstr "پازل سه‌بعدی با دو مکعب ۳×۳×۳ متداخل"

#: src/shapes/Jigsaw.desktop:2
msgctxt "Name"
msgid "Jigsaw"
msgstr "جیگ‌ساو"

#: src/shapes/Jigsaw.desktop:58
msgctxt "Description"
msgid "Jigsaw shape puzzle"
msgstr "پازل به شکل جیگ‌ساو"

#: src/shapes/Killer_4x4.desktop:2
msgctxt "Name"
msgid "Tiny Killer"
msgstr "کیلر کوچک"

#: src/shapes/Killer_4x4.desktop:44
msgctxt "Description"
msgid "4x4 Sudoku, but cages must add to totals shown"
msgstr ""
"سودوکوی ۴×۴، ولی مجموع قفس‌ها باید برابر با مقادیر نمایش‌داده‌شده باشد"

#: src/shapes/Killer_9x9.desktop:2
msgctxt "Name"
msgid "Killer Sudoku"
msgstr "کیلر سودوکو"

#: src/shapes/Killer_9x9.desktop:44
msgctxt "Description"
msgid "Classic Sudoku, but cages must add to totals shown"
msgstr ""
"سودوکوی کلاسیک، ولی مجموع قفس‌ها باید برابر با مقادیر نمایش‌داده‌شده باشد"

#: src/shapes/Mathdoku_4x4.desktop:2
msgctxt "Name"
msgid "Mathdoku 101"
msgstr "مقدمات مث‌دوکو"

#: src/shapes/Mathdoku_4x4.desktop:44
msgctxt "Description"
msgid "Size 4x4 grid, with calculated cages"
msgstr "شبکه در اندازه ۴×۴، با قفس‌های محاسباتی"

#: src/shapes/Mathdoku_Settable.desktop:2
msgctxt "Name"
msgid "Mathdoku - Settable Size"
msgstr "مث‌دوکو - اندازه قابل تنظیم"

#: src/shapes/Mathdoku_Settable.desktop:44
msgctxt "Description"
msgid "Size 3x3 to 9x9 grid, with calculated cages"
msgstr "شبکهٔ با اندازهٔ ۳×۳ تا ۹×۹، با قفس‌های محاسبه‌شده"

#: src/shapes/Nonomino.desktop:2
msgctxt "Name"
msgid "Nonomino 9x9"
msgstr "نومینوی ۹×۹"

#: src/shapes/Nonomino.desktop:50
msgctxt "Description"
msgid "Jigsaw variant with irregularly shaped Nonomino blocks"
msgstr "گونهٔ اره‌مویی با بلوک‌های نومینوی نامنظم"

#: src/shapes/Pentomino.desktop:2
msgctxt "Name"
msgid "Pentomino 5x5"
msgstr "پنتومینو ۵×۵"

#: src/shapes/Pentomino.desktop:51
msgctxt "Description"
msgid "Jigsaw variant with irregularly shaped Pentomino blocks"
msgstr "گونهٔ اره‌مویی با بلوک‌های پنتومینوی نامنظم"

#: src/shapes/RoxdokuTwin.desktop:2
msgctxt "Name"
msgid "Roxdoku Twin"
msgstr "راکس‌دوکوی دوقلو"

#: src/shapes/RoxdokuTwin.desktop:49
msgctxt "Description"
msgid "Three-dimensional puzzle with two 3x3x3 cubes which share a corner"
msgstr "پازل سه‌بعدی با دو مکعب ۳×۳×۳ با یک گوشهٔ مشترک"

#: src/shapes/Samurai.desktop:2
msgctxt "Name"
msgid "Samurai"
msgstr "سامورایی"

#: src/shapes/Samurai.desktop:59
msgctxt "Description"
msgid "Samurai shape puzzle"
msgstr "پازل به شکل سامورایی"

#: src/shapes/SamuraiRoxdoku.desktop:2
msgctxt "Name"
msgid "Samurai Roxdoku"
msgstr "راکس‌دوکوی سامورایی"

#: src/shapes/SamuraiRoxdoku.desktop:50
msgctxt "Description"
msgid "Samurai three-dimensional puzzle with nine 3x3x3 cubes"
msgstr "پازل سه‌بعدی سامورایی با نه مکعب ۳×۳×۳"

#: src/shapes/Sohei.desktop:2
msgctxt "Name"
msgid "Sohei"
msgstr "سوهِی"

#: src/shapes/Sohei.desktop:52
msgctxt "Description"
msgid "Sohei puzzle with four overlapping 9x9 squares"
msgstr "پازل سوهی با چهار مربع هم‌پوشان ۹×۹"

#: src/shapes/Tetromino.desktop:2
msgctxt "Name"
msgid "Tetromino 4x4"
msgstr "تترومینو ۴×۴"

#: src/shapes/Tetromino.desktop:51
msgctxt "Description"
msgid "Jigsaw with Tetromino blocks (Tetris pieces)"
msgstr "جورچین با بلوک‌های تترومینو (قطعات تتریس)"

#: src/shapes/TinySamurai.desktop:2
msgctxt "Name"
msgid "Tiny Samurai"
msgstr "سامورایی کوچک"

#: src/shapes/TinySamurai.desktop:58
msgctxt "Description"
msgid "A smaller samurai puzzle"
msgstr "پازل سامورایی کوچک‌تر"

#: src/shapes/Windmill.desktop:2
msgctxt "Name"
msgid "Windmill"
msgstr "آسیاب‌بادی"

#: src/shapes/Windmill.desktop:51
msgctxt "Description"
msgid "Windmill puzzle with five overlapping 9x9 squares"
msgstr "پازل آسیاب‌بادی با پنج مربع هم‌پوشان ۹×۹"

#: src/shapes/XSudoku.desktop:2
msgctxt "Name"
msgid "XSudoku"
msgstr "سودوکو X"

#: src/shapes/XSudoku.desktop:58
msgctxt "Description"
msgid "XSudoku shape puzzle"
msgstr "پازل شکلی XSudoku"

#: src/themes/abstraction.desktop:2
msgctxt "Name"
msgid "Abstraction"
msgstr "انتزاع"

#: src/themes/abstraction.desktop:51
msgctxt "Description"
msgid "A ksudoku theme with abstract artwork."
msgstr "یک پوستهٔ KSudoku با طرح‌های انتزاعی."

#: src/themes/default.desktop:2
msgctxt "Name"
msgid "ksudoku_egyptian"
msgstr "ksudoku_egyptian"

#: src/themes/default.desktop:50
msgctxt "Description"
msgid "KSudoku egyptian style theme"
msgstr "پوستهٔ سبک مصری KSudoku"

#: src/themes/ksudoku_scrible.desktop:2
msgctxt "Name"
msgid "Scribble"
msgstr "خط‌خطی"

#: src/themes/ksudoku_scrible.desktop:58
msgctxt "Description"
msgid "KSudoku Scribble theme for KDE 4"
msgstr "پوستهٔ خط‌خطی KSudoku برای KDE 4"
