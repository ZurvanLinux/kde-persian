msgctxt "Name"
msgid "KDE"
msgstr "KDE"

#: daemon/chargethreshold_helper_actions.actions:65
msgctxt "Name"
msgid "Get current battery charge limit"
msgstr "دریافت محدودیت کنونی شارژ باتری"

#: daemon/chargethreshold_helper_actions.actions:117
msgctxt "Description"
msgid "Authenticate to see the current battery charge limit."
msgstr "برای مشاهدهٔ محدودیت کنونی شارژ باتری احراز هویت کنید."

#: daemon/chargethreshold_helper_actions.actions:170
msgctxt "Name"
msgid "Set battery charge limit"
msgstr "تنظیم محدودیت شارژ باتری"

#: daemon/chargethreshold_helper_actions.actions:222
msgctxt "Description"
msgid "Authenticate to set the battery charge limit."
msgstr "برای تنظیم محدودیت شارژ باتری احراز هویت کنید."

#: daemon/chargethreshold_helper_actions.actions:275
msgctxt "Name"
msgid "Check battery conservation mode"
msgstr "بررسی حالت حفاظت از باتری"

#: daemon/chargethreshold_helper_actions.actions:324
msgctxt "Description"
msgid "Authenticate to check the current state of battery conservation mode."
msgstr "برای بررسی وضعیت کنونی حالت حفاظت از باتری احراز هویت کنید."

#: daemon/chargethreshold_helper_actions.actions:377
msgctxt "Name"
msgid "Set battery conservation mode"
msgstr "تنظیم حالت حفاظت از باتری"

#: daemon/chargethreshold_helper_actions.actions:426
msgctxt "Description"
msgid "Authenticate to set the battery conservation mode."
msgstr "برای تنظیم حالت حفاظت از باتری احراز هویت کنید."

#: daemon/controllers/backlight_helper_actions.actions:65
msgctxt "Name"
msgid "Get maximum brightness value"
msgstr "دریافت بیشینهٔ مقدار روشنایی"

#: daemon/controllers/backlight_helper_actions.actions:122
msgctxt "Description"
msgid "Authenticate to see the maximum brightness level."
msgstr "برای مشاهدهٔ بیشینهٔ سطح روشنایی احراز هویت کنید."

#: daemon/controllers/backlight_helper_actions.actions:175
msgctxt "Name"
msgid "Get brightness"
msgstr "دریافت روشنایی"

#: daemon/controllers/backlight_helper_actions.actions:233
msgctxt "Description"
msgid "Authenticate to see the brightness level."
msgstr "برای مشاهدهٔ سطح روشنایی احراز هویت کنید."

#: daemon/controllers/backlight_helper_actions.actions:286
msgctxt "Name"
msgid "Set brightness"
msgstr "تنظیم روشنایی"

#: daemon/controllers/backlight_helper_actions.actions:344
msgctxt "Description"
msgid "Authenticate to set the brightness level."
msgstr "برای تنظیم سطح روشنایی احراز هویت کنید."

#: daemon/controllers/backlight_helper_actions.actions:396
msgctxt "Name"
msgid "Get syspath"
msgstr "دریافت syspath"

#: daemon/controllers/backlight_helper_actions.actions:451
msgctxt "Description"
msgid "Authenticate to see the syspath."
msgstr "برای مشاهدهٔ syspath احراز هویت کنید."

#: daemon/discretegpu_helper_actions.actions:65
msgctxt "Name"
msgid "Check for existence of discrete GPU"
msgstr "بررسی وجود پردازندهٔ گرافیکی مجزا"

#: daemon/discretegpu_helper_actions.actions:114
msgctxt "Description"
msgid "Authenticate to check for the existence of a discrete GPU."
msgstr "برای بررسی وجود پردازندهٔ گرافیکی مجزا احراز هویت کنید."

#: daemon/powerdevil.desktop.cmake:4 powerdevil.notifyrc:2
msgctxt "Name"
msgid "Power Management"
msgstr "مدیریت توان"

#: daemon/powerdevil.desktop.cmake:67
msgctxt "Comment"
msgid "Battery, Display and CPU power management and notification"
msgstr "مدیریت توان و اعلان‌های باتری، نمایشگر و پردازنده"

#: daemon/wakeupsource_helper_actions.actions:65
msgctxt "Name"
msgid "Set the wakeup count"
msgstr "تنظیم شمارندهٔ بیدارشدن"

#: daemon/wakeupsource_helper_actions.actions:108
msgctxt "Description"
msgid ""
"This allows to read wakeup count on next wakeup to identify wakeup source"
msgstr ""
"این امکان خواندن شمارندهٔ بیدارشدن در بیداری بعدی را برای شناسایی منبع "
"بیدارشدن فراهم می‌کند"

#: powerdevil.notifyrc:60
msgctxt "Comment"
msgid "Power Management System"
msgstr "سامانهٔ مدیریت توان"

#: powerdevil.notifyrc:120
msgctxt "Name"
msgid "Warning"
msgstr "هشدار"

#: powerdevil.notifyrc:177
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "برای اعلان‌های هشدار استفاده می‌شود"

#: powerdevil.notifyrc:235
msgctxt "Name"
msgid "Notification"
msgstr "اعلان"

#: powerdevil.notifyrc:294
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "برای اعلان‌های معمولی استفاده می‌شود"

#: powerdevil.notifyrc:353
msgctxt "Name"
msgid "Critical notification"
msgstr "اعلان بحرانی"

#: powerdevil.notifyrc:411
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "یک رویداد بحرانی را اطلاع می‌دهد"

#: powerdevil.notifyrc:470
msgctxt "Name"
msgid "Battery Low"
msgstr "باتری کم"

#: powerdevil.notifyrc:527
msgctxt "Comment"
msgid "Battery has reached low level"
msgstr "باتری به سطح پایین رسیده است"

#: powerdevil.notifyrc:583
msgctxt "Name"
msgid "Battery Critical"
msgstr "باتری بحرانی"

#: powerdevil.notifyrc:640
msgctxt "Comment"
msgid ""
"Battery has reached critical level. This notification triggers a countdown "
"before doing the configured action, hence it is strongly advised to leave it"
" on."
msgstr ""
"باتری به سطح بحرانی رسیده است. این اعلان پیش از انجام کنش پیکربندی‌شده، یک "
"شمارش معکوس را آغاز می‌کند؛ بنابراین اکیداً توصیه می‌شود آن را روشن بگذارید."

#: powerdevil.notifyrc:697
msgctxt "Name"
msgid "Charge Complete"
msgstr "شارژ کامل شد"

#: powerdevil.notifyrc:753
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "باتری به‌طور کامل شارژ شده است"

#: powerdevil.notifyrc:815
msgctxt "Name"
msgid "Peripheral Battery Low"
msgstr "باتری کم دستگاه جانبی"

#: powerdevil.notifyrc:869
msgctxt "Comment"
msgid "The battery in a connected device, such as mouse or keyboard, is low"
msgstr "باتری یک دستگاه متصل، مانند موشی یا صفحه‌کلید، کم است"

#: powerdevil.notifyrc:929
msgctxt "Name"
msgid "Power source connected"
msgstr "منبع تغذیه متصل شد"

#: powerdevil.notifyrc:983
msgctxt "Comment"
msgid "The power source has been connected"
msgstr "منبع تغذیه متصل شده است"

#: powerdevil.notifyrc:1043
msgctxt "Name"
msgid "Power source disconnected"
msgstr "منبع تغذیه قطع شد"

#: powerdevil.notifyrc:1097
msgctxt "Comment"
msgid "The power source has been disconnected"
msgstr "منبع تغذیه قطع شده است"
