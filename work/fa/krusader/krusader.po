#: app/Synchronizer/synchronizergui.cpp:264
#, kde-format
msgid ""
"<p>Ignore date information during the compare process.</p><p><b>Note</b>: "
"useful if the files are located on network filesystems or in archives.</p>"
msgstr ""
"<p>نادیده گرفتن اطلاعات تاریخ در طول فرایند مقایسه.</p><p><b>نکته</b>: در "
"مواردی که پرونده‌ها در سیستم‌های پرونده شبکه‌ای یا در آرشیوها قرار دارند "
"مفید است.</p>"

#: app/Synchronizer/synchronizergui.cpp:266
#, kde-format
msgid "Asymmetric"
msgstr "نامتقارن"

#: app/Synchronizer/synchronizergui.cpp:270
#, kde-format
msgid ""
"<p><b>Asymmetric mode</b></p><p>The left side is the destination, the right "
"is the source folder. Files existing only in the left folder will be "
"deleted, the other differing ones will be copied from right to "
"left.</p><p><b>Note</b>: useful when updating a folder from a file "
"server.</p>"
msgstr ""
"<p><b>حالت نامتقارن</b></p><p>سمت چپ مقصد و سمت راست پوشه مبدأ است. "
"پرونده‌هایی که فقط در پوشه سمت چپ وجود دارند حذف خواهند شد و سایر پرونده‌های"
" متفاوت از راست به چپ کپی می‌شوند.</p><p><b>نکته</b>: برای به‌روزرسانی یک "
"پوشه از یک سرور پرونده مفید است.</p>"

#: app/Synchronizer/synchronizergui.cpp:272
#, kde-format
msgid "Ignore Case"
msgstr "نادیده گرفتن بزرگی و کوچکی حروف"

#: app/Synchronizer/synchronizergui.cpp:275
#, kde-format
msgid ""
"<p>Case insensitive filename compare.</p><p><b>Note</b>: useful when "
"synchronizing Windows filesystems.</p>"
msgstr ""
"<p>مقایسه نام پرونده‌ها بدون حساسیت به بزرگی و کوچکی "
"حروف.</p><p><b>نکته</b>: هنگام همگام‌سازی سیستم‌های پرونده ویندوز مفید "
"است.</p>"

