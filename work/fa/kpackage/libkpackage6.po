msgstr "نمایش اطلاعات بستهٔ <name>"

#: kpackagetool/options.h:50
#, kde-format
msgctxt "Do not translate <path>"
msgid "Upgrade the package at <path>"
msgstr "ارتقای بسته در <path>"

