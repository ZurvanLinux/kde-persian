#. (itstool) path: component/name
#: org.kde.skanpage.appdata.xml:14
msgid "Skanpage"
msgstr "اسکن‌پیج"

#. (itstool) path: component/summary
#: org.kde.skanpage.appdata.xml:15
msgid "Scan multi-page documents and images"
msgstr "پویش اسناد و تصاویر چندصفحه‌ای"

#. (itstool) path: description/p
#: org.kde.skanpage.appdata.xml:17
msgid ""
"Skanpage is a simple scanning application optimized for multi-page document "
"scanning. It can also scan and save single-page documents and images."
msgstr ""
"اسکن‌پیج یک برنامهٔ پویش ساده است که برای اسناد چندصفحه‌ای بهینه‌سازی شده "
"است. همچنین می‌تواند اسناد و تصاویر تک‌صفحه‌ای را پویش و ذخیره کند."

#. (itstool) path: description/p
#: org.kde.skanpage.appdata.xml:18
msgid "Features:"
msgstr "ویژگی‌ها:"

#. (itstool) path: ul/li
#: org.kde.skanpage.appdata.xml:20
msgid "Scanning from flatbed and ADF scanners"
msgstr "پویش از اسکنرهای تخت (Flatbed) و تغذیه‌کنندهٔ خودکار اسناد (ADF)"

#. (itstool) path: ul/li
#: org.kde.skanpage.appdata.xml:21
msgid "Configurable options for scanning device"
msgstr "گزینه‌های قابل تنظیم برای دستگاه پویشگر"

#. (itstool) path: ul/li
#: org.kde.skanpage.appdata.xml:22
msgid "Reordering, rotation, and deletion of scanned pages"
msgstr "تغییر ترتیب، چرخش و حذف صفحه‌های پویش‌شده"

#. (itstool) path: ul/li
