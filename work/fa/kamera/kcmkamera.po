#: kamera.cpp:71
#, kde-format
msgid "Unable to initialize the gPhoto2 libraries."
msgstr "مقداردهی اولیه کتابخانه‌های gPhoto2 امکان‌پذیر نیست."

#: kamera.cpp:108
#, kde-format
msgid "Add"
msgstr "افزودن"

#: kamera.cpp:110
#, kde-format
msgid "Click this button to add a new camera."
msgstr "برای افزودن یک دوربین جدید، روی این دکمه کلیک کنید."

#: kamera.cpp:116
#, kde-format
msgid "Test"
msgstr "آزمایش"

#: kamera.cpp:118
#, kde-format
msgid "Click this button to test the connection to the selected camera."
msgstr "برای آزمایش اتصال به دوربین انتخاب‌شده، روی این دکمه کلیک کنید."

#: kamera.cpp:123
#, kde-format
msgid "Remove"
msgstr "حذف"

#: kamera.cpp:125
#, kde-format
msgid "Click this button to remove the selected camera from the list."
msgstr "برای حذف دوربین انتخاب‌شده از فهرست، روی این دکمه کلیک کنید."

#: kamera.cpp:130
#, kde-format
msgid "Configure..."
msgstr "پیکربندی..."

#: kamera.cpp:133
#, kde-format
msgid ""
"Click this button to change the configuration of the selected "
"camera.<br><br>The availability of this feature and the contents of the "
"Configuration dialog depend on the camera model."
msgstr ""
"برای تغییر پیکربندی دوربین انتخاب‌شده، روی این دکمه کلیک کنید.<br><br>در "
"دسترس بودن این ویژگی و محتویات پنجرهٔ پیکربندی به مدل دوربین بستگی دارد."

#: kamera.cpp:139
#, kde-format
msgid "Information"
msgstr "اطلاعات"

#: kamera.cpp:142
#, kde-format
msgid ""
"Click this button to view a summary of the current status of the selected "
"camera.<br><br>The availability of this feature and the contents of the "
"Information dialog depend on the camera model."
msgstr ""
"برای دیدن خلاصه‌ای از وضعیت کنونی دوربین انتخاب‌شده، روی این دکمه کلیک "
"کنید.<br><br>در دسترس بودن این قابلیت و محتوای گفت‌وگوی اطلاعات به مدل "
"دوربین بستگی دارد."

#: kamera.cpp:149
#, kde-format
msgid "Cancel"
msgstr "لغو"

#: kamera.cpp:151
#, kde-format
msgid "Click this button to cancel the current camera operation."
msgstr "برای لغو عملیات کنونی دوربین، روی این دکمه کلیک کنید."

#: kamera.cpp:355
#, kde-format
msgid "Camera test was successful."
msgstr "آزمایش دوربین موفقیت‌آمیز بود."

#: kameraconfigdialog.cpp:226
#, kde-format
msgid "Button (not supported by KControl)"
msgstr "دکمه (توسط KControl پشتیبانی نمی‌شود)"

#: kameraconfigdialog.cpp:233
#, kde-format
msgid "Date (not supported by KControl)"
msgstr "تاریخ (توسط KControl پشتیبانی نمی‌شود)"

#: kameradevice.cpp:82
#, kde-format
msgid "Could not allocate memory for the abilities list."
msgstr "امکان تخصیص حافظه برای فهرست قابلیت‌ها وجود نداشت."

#: kameradevice.cpp:86
#, kde-format
msgid "Could not load ability list."
msgstr "فهرست قابلیت‌ها بارگیری نشد."

#: kameradevice.cpp:92 kameradevice.cpp:542 kameradevice.cpp:560
#, kde-format
msgid ""
"Description of abilities for camera %1 is not available. Configuration "
"options may be incorrect."
msgstr ""
"توضیحات قابلیت‌ها برای دوربین %1 موجود نیست. ممکن است گزینه‌های پیکربندی "
"نادرست باشند."

#: kameradevice.cpp:117
#, kde-format
msgid "Could not access driver. Check your gPhoto2 installation."
msgstr "دسترسی به راه‌انداز امکان‌پذیر نبود. نصب gPhoto2 خود را بررسی کنید."

#: kameradevice.cpp:136
#, kde-format
msgid ""
"Unable to initialize camera. Check your port settings and camera "
"connectivity and try again."
msgstr ""
"مقداردهی اولیه دوربین انجام نشد. تنظیمات درگاه و اتصال دوربین خود را بررسی "
"کرده و دوباره تلاش کنید."

#: kameradevice.cpp:175
#, kde-format
msgid "No camera summary information is available.\n"
msgstr "هیچ اطلاعات خلاصه‌ای از دوربین موجود نیست.\n"

#: kameradevice.cpp:190 kameradevice.cpp:200
#, kde-format
msgid "Camera configuration failed."
msgstr "پیکربندی دوربین ناموفق بود."

#: kameradevice.cpp:242 kameradevice.cpp:368
#, kde-format
msgid "Serial"
msgstr "سریال"

#: kameradevice.cpp:244 kameradevice.cpp:374
#, kde-format
msgid "USB"
msgstr "USB"

#: kameradevice.cpp:245
#, kde-format
msgid "Unknown port"
msgstr "درگاه ناشناخته"

#: kameradevice.cpp:310
#, kde-format
msgid "Select Camera Device"
msgstr "انتخاب دستگاه دوربین"

#: kameradevice.cpp:328
#, kde-format
msgctxt "@title:column"
msgid "Supported Cameras"
msgstr "دوربین‌های پشتیبانی‌شده"

#: kameradevice.cpp:338
#, kde-format
msgid "Filter by name…"
msgstr "فیلتر بر اساس نام…"

#: kameradevice.cpp:362 kameradevice.cpp:389
#, kde-format
msgid "Port"
msgstr "درگاه"

#: kameradevice.cpp:371
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's serial ports (known as COM ports in Microsoft Windows.)"
msgstr ""
"اگر این گزینه علامت زده شود، دوربین باید به یکی از درگاه‌های سریال رایانه "
"(شناخته‌شده با عنوان درگاه‌های COM در Microsoft Windows) متصل باشد."

#: kameradevice.cpp:377
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's USB ports, or to a USB hub."
msgstr ""
"اگر این گزینه علامت زده شود، دوربین باید به یکی از درگاه‌های USB رایانه یا "
"یک هاب USB متصل باشد."

#: kameradevice.cpp:380
#, kde-format
msgid "Port Settings"
msgstr "تنظیمات درگاه"

#: kameradevice.cpp:398
#, kde-format
msgid "No port type selected."
msgstr "هیچ نوع درگاهی انتخاب نشده است."

#: kameradevice.cpp:405
#, kde-format
msgid "Port:"
msgstr "درگاه:"

#: kameradevice.cpp:409
#, kde-format
msgid "Specify here the serial port to which you connect the camera."
msgstr "درگاه سریالی را که دوربین را به آن متصل می‌کنید اینجا مشخص کنید."

#: kameradevice.cpp:416
#, kde-format
msgid "No further configuration is required for USB cameras."
msgstr "برای دوربین‌های USB به پیکربندی دیگری نیاز نیست."
