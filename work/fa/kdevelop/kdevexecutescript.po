#. (KDevelop::EnvironmentSelectionWidget, environment)
#: scriptappconfig.ui:212
#, kde-format
msgctxt "@info:tooltip"
msgid "Select an environment to be used"
msgstr "محیطی را برای استفاده انتخاب کنید"

#. i18n: ectx: property (text), widget (QLabel, label_6)
#: scriptappconfig.ui:224
#, kde-format
msgctxt "@label:listbox"
msgid "Output filter:"
msgstr "فیلتر خروجی:"

#. i18n: ectx: property (toolTip), widget (QComboBox, outputFilteringMode)
#: scriptappconfig.ui:231
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Select the filter to applied to the output. E.g. to mark errors with red "
"text"
msgstr ""
"فیلتری را برای اعمال روی خروجی انتخاب کنید. مثلاً برای مشخص کردن خطاها با "
"متن قرمز"

#. i18n: ectx: property (text), item, widget (QComboBox, outputFilteringMode)
#: scriptappconfig.ui:235
#, kde-format
msgctxt "@item:inlistbox output filter"
msgid "No Filter"
msgstr "بدون فیلتر"

#. i18n: ectx: property (text), item, widget (QComboBox, outputFilteringMode)
#: scriptappconfig.ui:240
#, kde-format
msgctxt "@item:inlistbox output filter"
msgid "Compiler Filter"
msgstr "فیلتر کامپایلر"

#. i18n: ectx: property (text), item, widget (QComboBox, outputFilteringMode)
#: scriptappconfig.ui:245
#, kde-format
msgctxt "@item:inlistbox output filter"
msgid "Script Error Filter"
msgstr "فیلتر خطای اسکریپت"

#. i18n: ectx: property (text), item, widget (QComboBox, outputFilteringMode)
#: scriptappconfig.ui:250
#, kde-format
msgctxt "@item:inlistbox output filter"
msgid "Static Analysis Filter"
msgstr "فیلتر تحلیل ایستا"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: scriptappconfig.ui:267
#, kde-format
msgctxt "@title:group"
msgid "Execute on Host"
msgstr "اجرا روی میزبان"

#. i18n: ectx: property (text), widget (QCheckBox, remoteHostCheckbox)
#: scriptappconfig.ui:273
#, kde-format
msgctxt "@option:check"
msgid "Execute on remote host"
msgstr "اجرا روی میزبان دوردست"

#. i18n: ectx: property (text), widget (QLabel, remoteHostLabel)
#: scriptappconfig.ui:285
#, kde-format
msgctxt "@label:textbox"
msgid "Remote host (ssh):"
msgstr "میزبان دوردست (ssh):"

#. i18n: ectx: property (placeholderText), widget (QLineEdit, remoteHost)
#: scriptappconfig.ui:298
#, kde-format
msgctxt "@info:placeholder"
msgid "user@host"
msgstr "user@host"

#. i18n: ectx: property (toolTip), widget (QLineEdit, remoteHost)
#: scriptappconfig.ui:301
#, kde-format
msgctxt "@info:tooltip"
msgid "Enter a remote host (user@host)"
msgstr "یک میزبان دوردست وارد کنید (user@host)"

#: scriptappjob.cpp:43
#, kde-format
msgid ""
"No environment profile specified, looks like a broken configuration, please "
"check run configuration '%1'. Using default environment profile."
msgstr ""
"هیچ نمایهٔ محیطی مشخص نشده است، به نظر می‌رسد پیکربندی خراب است، لطفاً "
"پیکربندی اجرای «%1» را بررسی کنید. از نمایهٔ محیط پیش‌فرض استفاده می‌شود."

#: scriptappjob.cpp:90
#, kde-format
msgid "There is no active document to launch."
msgstr "سند فعالی برای راه‌اندازی وجود ندارد."

#: scriptappjob.cpp:165
#, kde-format
msgid "Starting: %1"
msgstr "در حال شروع: %1"

#: scriptappjob.cpp:179
#, kde-format
msgid "*** Killed Application ***"
msgstr "*** برنامه کشته شد ***"

#: scriptappjob.cpp:190
#, kde-format
msgid "*** Exited normally ***"
msgstr "*** خروج به‌طور عادی انجام شد ***"

#: scriptappjob.cpp:192
#, kde-format
msgid "*** Exited with return code: %1 ***"
msgstr "*** با کد بازگشتی %1 خارج شد ***"

#: scriptappjob.cpp:195
#, kde-format
msgid "*** Process aborted ***"
msgstr "*** فرایند لغو شد ***"

#: scriptappjob.cpp:198
#, kde-format
msgid "*** Crashed with return code: %1 ***"
msgstr "*** با کد بازگشت %1 دچار فروپاشی شد ***"

#: scriptappjob.cpp:213
#, kde-format
msgid ""
"*** Could not start program '%1'. Make sure that the path is specified "
"correctly ***"
msgstr ""
"*** اجرای برنامهٔ «%1» ممکن نشد. مطمئن شوید که مسیر به درستی مشخص شده است "
"***"
