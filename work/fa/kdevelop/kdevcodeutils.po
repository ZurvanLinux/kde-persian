#: codeutilsplugin.cpp:49
#, kde-format
msgctxt "@action"
msgid "Document Declaration"
msgstr "مستندسازی اعلان"

#: codeutilsplugin.cpp:50
#, kde-format
msgctxt "default shortcut for \"Document Declaration\""
msgid "Alt+Shift+d"
msgstr "Alt+Shift+d"

#: codeutilsplugin.cpp:52
#, kde-format
msgctxt "@info:tooltip"
msgid "Add Doxygen skeleton for declaration under cursor."
msgstr "افزودن اسکلت داکسیژن (Doxygen) برای اعلان زیر مکان‌نما."

#: codeutilsplugin.cpp:55
#, kde-format
msgctxt "@info:whatthis"
msgid ""
"Adds a basic Doxygen comment skeleton in front of the declaration under the "
"cursor, e.g. with all the parameter of a function."
msgstr ""
"یک اسکلت پایه از توضیحات Doxygen را پیش از اعلان زیر مکان‌نما اضافه می‌کند، "
"مثلاً همراه با همهٔ پارامترهای یک تابع."

