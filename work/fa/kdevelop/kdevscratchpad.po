#: scratchpad.cpp:130 scratchpadview.cpp:88
#, kde-format
msgctxt "@title:window"
msgid "Scratchpad"
msgstr "چرکنویس"

#: scratchpad.cpp:187
#, kde-format
msgid "Failed to remove scratch: %1"
msgstr "حذف چرکنویس شکست خورد: %1"

#: scratchpad.cpp:194
#, kde-format
msgid "Failed to create scratch: Name already in use"
msgstr "ایجاد چرکنویس شکست خورد: نام از قبل استفاده شده است"

#: scratchpad.cpp:206
#, kde-format
msgid "Failed to create new scratch"
msgstr "ایجاد چرکنویس جدید شکست خورد"

#: scratchpad.cpp:215
#, kde-format
msgid "Failed to rename scratch: Names must not include path separator"
msgstr "تغییر نام چرکنویس شکست خورد: نام‌ها نباید شامل جداکنندهٔ مسیر باشند"

#: scratchpad.cpp:256
#, kde-format
msgid "Failed renaming scratch."
msgstr "تغییر نام چرکنویس شکست خورد."

#: scratchpad.cpp:299 scratchpadjob.cpp:33
#, kde-format
msgctxt "prefix to distinguish scratch tabs"
msgid "scratch:%1"
msgstr "چرکنویس:%1"

#: scratchpadjob.cpp:57
#, kde-format
msgid "Running %1..."
msgstr "در حال اجرای %1..."

#: scratchpadjob.cpp:73
#, kde-format
msgid "Process finished with exit code %1."
msgstr "فرایند با کد خروج %1 به پایان رسید."

#: scratchpadjob.cpp:80
#, kde-format
msgid "Failed to run scratch: %1"
msgstr "اجرای چرکنویس شکست خورد: %1"

#: scratchpadview.cpp:101
#, kde-format
msgid ""
"Scratchpad lets you quickly run and experiment with code without a full "
"project, and even store todos. Create a new scratch to start."
msgstr ""
"چرکنویس به شما امکان می‌دهد بدون نیاز به یک پروژه کامل، سریعاً کد را اجرا "
"کرده و آزمایش کنید، و حتی کارهای انجام‌دادنی را ذخیره کنید. برای شروع، یک "
"چرکنویس جدید ایجاد کنید."

#: scratchpadview.cpp:115
#, kde-format
msgctxt "@info:tooltip"
msgid "Command to run this scratch. '$f' will expand to the scratch path."
msgstr ""
"فرمان برای اجرای این چرکنویس. «‎$f» به مسیر چرکنویس بسط داده خواهد شد."

