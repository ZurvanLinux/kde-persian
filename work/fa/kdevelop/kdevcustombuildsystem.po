#: custombuildjob.cpp:95
#, kde-format
msgid "Undefined Build type"
msgstr "نوع ساخت تعریف نشده است"

#: custombuildjob.cpp:99
#, kde-format
msgid "No command given for custom %1 tool in project \"%2\"."
msgstr "هیچ دستوری برای ابزار سفارشی %1 در پروژه «%2» مشخص نشده است."

#: custombuildjob.cpp:104
#, kde-format
msgid "The custom %1 tool in project \"%2\" is disabled"
msgstr "ابزار سفارشی %1 در پروژه «%2» غیرفعال است"

#: custombuildjob.cpp:116
#, kde-format
msgid ""
"The given arguments would need a real shell, this is not supported "
"currently."
msgstr ""
"آرگومان‌های ارائه‌شده به یک شل (shell) واقعی نیاز دارند، این مورد در حال "
"حاضر پشتیبانی نمی‌شود."

#: custombuildjob.cpp:166
#, kde-format
msgid "Failed to start command."
msgstr "شروع دستور ناموفق بود."

#: custombuildjob.cpp:169
#, kde-format
msgid "Command crashed."
msgstr "دستور با خطا متوقف شد (کرش کرد)."

#: custombuildjob.cpp:172
#, kde-format
msgid "Unknown error executing command."
msgstr "خطای ناشناخته در اجرای دستور."

#: custombuildjob.cpp:189
#, kde-format
msgid "*** Failed ***"
msgstr "*** ناموفق ***"

#: custombuildjob.cpp:191
#, kde-format
msgid "*** Finished ***"
msgstr "*** پایان یافت ***"

