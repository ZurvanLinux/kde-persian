#, kde-format
msgctxt "@title:window"
msgid "Address Selector"
msgstr "انتخاب‌گر نشانی"

#: widgets/disassemblewidget.cpp:132
#, kde-format
msgctxt "@action"
msgid "Change &Address"
msgstr "تغییر نشانی"

#: widgets/disassemblewidget.cpp:136
#, kde-format
msgctxt "@action"
msgid "&Jump to Cursor"
msgstr "پرش به مکان‌نما"

#: widgets/disassemblewidget.cpp:137
#, kde-format
msgctxt "@info:whatsthis"
msgid "Sets the execution pointer to the current cursor position."
msgstr "اشاره‌گر اجرا را روی موقعیت فعلی مکان‌نما تنظیم می‌کند."

#: widgets/disassemblewidget.cpp:140
#, kde-format
msgctxt "@action"
msgid "&Run to Cursor"
msgstr "اجرا تا مکان‌نما"

#: widgets/disassemblewidget.cpp:141
#, kde-format
msgctxt "@info:whatsthis"
msgid "Continues execution until the cursor position is reached."
msgstr "اجرا را تا رسیدن به موقعیت مکان‌نما ادامه می‌دهد."

#: widgets/disassemblewidget.cpp:144
#, kde-format
msgctxt "@option:check"
msgid "&AT&&T"
msgstr "AT&&T"

#: widgets/disassemblewidget.cpp:145
#, kde-format
msgctxt "@info:tooltip"
msgid "GDB will use the AT&T disassembly flavor (e.g. mov 0xc(%ebp),%eax)."
msgstr ""
"‏GDB از شیوهٔ دیس‌اسمبلی ATT استفاده خواهد کرد (مانند mov 0xc(%ebp),%eax)."

#: widgets/disassemblewidget.cpp:149
#, kde-format
msgctxt "@option:check"
msgid "&Intel"
msgstr "اینتل"

#: widgets/disassemblewidget.cpp:150
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"GDB will use the Intel disassembly flavor (e.g. mov eax, DWORD PTR "
"[ebp+0xc])."
msgstr ""
"‏GDB از نحوه نگارش دیس‌اسمبلی اینتل استفاده خواهد کرد (مثلاً mov eax, DWORD "
"PTR [ebp+0xc])."

#: widgets/disassemblewidget.cpp:189
#, kde-format
msgctxt "@title:menu"
msgid "Disassembly Flavor"
msgstr "نحوه نگارش دیس‌اسمبلی"

#: widgets/disassemblewidget.cpp:220
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<b>Machine code display</b><p>A machine code view into your running "
"executable with the current instruction highlighted. You can step "
"instruction by instruction using the debuggers toolbar buttons of \"step "
"over\" instruction and \"step into\" instruction."
msgstr ""
"<b>نمایش کد ماشین</b><p>نمای کد ماشین از پرونده اجرایی در حال اجرای شما، که "
"دستورالعمل فعلی در آن برجسته شده است. می‌توانید با استفاده از دکمه‌های «رد "
"شدن از دستورالعمل» (step over) و «ورود به دستورالعمل» (step into) در نوار "
"ابزار اشکال‌زدا، دستور به دستور به جلو بروید."

#: widgets/disassemblewidget.cpp:236
#, kde-format
msgctxt "@title:column"
msgid "Address"
msgstr "نشانی"

#: widgets/disassemblewidget.cpp:237
#, kde-format
msgctxt "@title:column"
msgid "Function"
msgstr "تابع"

#: widgets/disassemblewidget.cpp:238
#, kde-format
msgctxt "@title:column"
msgid "Instruction"
msgstr "دستورالعمل"

#: widgets/disassemblewidget.cpp:258
#, kde-format
msgctxt "@title:window"
msgid "Disassemble/Registers View"
msgstr "نمای دیس‌اسمبل/ثبات‌ها"

