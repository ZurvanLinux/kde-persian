#: midebugger.cpp:319
#, kde-format
msgctxt "<b>Internal debugger error</b>"
msgid ""
"<p>The debugger component encountered an internal error while processing the"
" reply from the debugger. Please submit a bug report. The debug session will"
" now end to prevent potential crash"
msgstr ""
"<p>مؤلفهٔ اشکال‌زدا هنگام پردازش پاسخ از اشکال‌زدا با خطای داخلی مواجه شد. "
"لطفاً یک گزارش اشکال ارسال کنید. نشست اشکال‌زدایی برای جلوگیری از فروپاشی "
"احتمالی اکنون پایان می‌یابد"

#: midebugger.cpp:322
#, kde-format
msgid ""
"The exception is: %1\n"
"The MI response is: %2"
msgstr ""
"استثنا عبارت است از: %1\n"
"پاسخ MI عبارت است از: %2"

