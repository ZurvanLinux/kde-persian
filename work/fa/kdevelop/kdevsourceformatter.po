#. i18n: ectx: property (toolTip), widget (QCheckBox,
#. kcfg_overrideKateIndentation)
#: config/projectconfigpage.ui:42
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Override the editor indentation mode according to the formatting style for "
"documents without a Kate modeline."
msgstr ""
"لغو حالت تورفتگی ویرایشگر بر اساس سبک قالب‌بندی برای سندهای بدون خط حالت کیت"
" (Kate modeline)."

#. i18n: ectx: property (text), widget (QCheckBox,
#. kcfg_overrideKateIndentation)
#: config/projectconfigpage.ui:45
#, kde-format
msgctxt "@option:check"
msgid "Override editor indentation mode"
msgstr "لغو حالت تورفتگی ویرایشگر"

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_modelinesEnabled)
#: config/projectconfigpage.ui:52
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Add a Kate modeline according to the formatting style to formatted "
"documents."
msgstr ""
"افزودن خط حالت کیت (Kate modeline) به سندهای قالب‌بندی‌شده بر اساس سبک "
"قالب‌بندی."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_modelinesEnabled)
#: config/projectconfigpage.ui:55
#, kde-format
msgctxt "@option:check"
msgid "Add Kate modeline"
msgstr "افزودن خط حالت کیت (Kate modeline)"

