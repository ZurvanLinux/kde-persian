msgstr "نخستین مورد"

#: outputwidget.cpp:123
#, kde-format
msgctxt "@action"
msgid "Previous Item"
msgstr "مورد قبلی"

#: outputwidget.cpp:127
#, kde-format
msgctxt "@action"
msgid "Next Item"
msgstr "مورد بعدی"

#: outputwidget.cpp:131
#, kde-format
msgctxt "@action"
msgid "Last Item"
msgstr "آخرین مورد"

#: outputwidget.cpp:144
#, kde-format
msgctxt "@action"
msgid "Clear"
msgstr "پاک‌کردن"

#: outputwidget.cpp:161
#, kde-format
msgctxt "@info:placeholder"
msgid "Search..."
msgstr "جستجو..."

#: outputwidget.cpp:197
#, kde-format
msgctxt "@action %1: output type, e.g. Build or Run"
msgid "Configure %1 Output"
msgstr "پیکربندی خروجی %1"

#: outputwidget.cpp:818
#, kde-format
msgctxt ""
"@info:tooltip %1 - position in the pattern, %2 - textual description of the "
"error"
msgid "Filter regular expression pattern error at offset %1: %2"
msgstr "خطای الگوی عبارت باقاعده برای پالایش در موقعیت %1: %2"

#: outputwidgetconfig.cpp:64
#, kde-format
msgctxt "@title:window %1: output type, e.g. Build or Run"
msgid "Configure %1 Output"
msgstr "پیکربندی خروجی %1"

#: outputwidgetconfig.cpp:74
#, kde-format
msgctxt "@option:check"
msgid "Limit the number of output views"
msgstr "محدود کردن تعداد نماهای خروجی"

#: outputwidgetconfig.cpp:75
#, kde-format
msgctxt "@info:tooltip"
msgid "Automatically close oldest output views"
msgstr "بستن خودکار قدیمی‌ترین نماهای خروجی"

#: outputwidgetconfig.cpp:81
#, kde-format
msgctxt "@label:spinbox"
msgid "Maximum output view count"
msgstr "حداکثر تعداد نمای خروجی"

#: outputwidgetconfig.cpp:83
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"The oldest output view is closed when\n"
