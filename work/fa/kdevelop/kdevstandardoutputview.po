#: outputwidget.cpp:44
#, kde-format
msgctxt "@info:tooltip"
msgid "Enter a case-insensitive regular expression to filter the output view"
msgstr ""
"برای پالایش نمای خروجی، یک عبارت باقاعدهٔ حساس‌نبودن به حروف بزرگ و کوچک "
"وارد کنید"

#: outputwidget.cpp:63
#, kde-format
msgctxt "@title:window"
msgid "Output View"
msgstr "نمای خروجی"

#: outputwidget.cpp:74
#, kde-format
msgctxt "@info:tooltip"
msgid "Close the currently active output view"
msgstr "بستن نمای خروجی فعال فعلی"

#: outputwidget.cpp:80
#, kde-format
msgctxt "@info:tooltip"
msgid "Close all other output views"
msgstr "بستن همهٔ نماهای خروجی دیگر"

#: outputwidget.cpp:91
#, kde-format
msgctxt "@action"
msgid "Previous Output"
msgstr "خروجی قبلی"

#: outputwidget.cpp:94
#, kde-format
msgctxt "@action"
msgid "Next Output"
msgstr "خروجی بعدی"

#: outputwidget.cpp:99
#, kde-format
msgctxt "@action"
msgid "Select Activated Item"
msgstr "انتخاب مورد فعال‌شده"

