#, kde-format
msgctxt "@action"
msgid "Focus when Selecting Item"
msgstr "تمرکز هنگام انتخاب مورد"

#: outputwidget.cpp:110
#, kde-format
msgctxt "@action"
msgid "Word Wrap"
msgstr "پیچش کلمات"

