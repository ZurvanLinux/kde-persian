#. i18n: ectx: label, entry (StartupReadImage), group (Startup)
#: kookasettings.kcfg:50
#, kde-format
msgid "Load the last selected image into the viewer"
msgstr "بارگیری آخرین تصویر انتخاب‌شده در نمایشگر"

#. i18n: ectx: tooltip, entry (StartupReadImage), group (Startup)
#: kookasettings.kcfg:51
#, kde-format
msgid ""
"<div>Check this if you want Kooka to load the last selected image into the "
"viewer on startup.<br/><br/>If your images are large, that might slow down "
"Kooka's startup.</div>"
msgstr ""
"<div>اگر می‌خواهید کوکا هنگام راه‌اندازی، آخرین تصویر انتخاب‌شده را در "
"نمایشگر بارگذاری کند، این گزینه را علامت بزنید.<br/><br/>اگر تصاویرتان بزرگ "
"باشند، این کار ممکن است سرعت راه‌اندازی کوکا را کاهش دهد.</div>"

#. i18n: ectx: label, entry (SaverAskForFormat), group (Files)
#: kookasettings.kcfg:65
#, kde-format
msgid "Always use the Save Assistant"
msgstr "همیشه از دستیار ذخیره استفاده شود"

#. i18n: ectx: tooltip, entry (SaverAskForFormat), group (Files)
#: kookasettings.kcfg:66
#, kde-format
msgid ""
"<div>Check this if you want to always use the image save assistant, even if "
"there is a default format for the image type.</div>"
msgstr ""
"<div>اگر می‌خواهید همیشه از دستیار ذخیرهٔ تصویر استفاده کنید، حتی اگر یک "
"قالب پیش‌فرض برای نوع تصویر وجود داشته باشد، این گزینه را علامت بزنید.</div>"

#. i18n: ectx: label, entry (SaverAskForFilename), group (Files)
#: kookasettings.kcfg:71
#, kde-format
msgid "Ask for file name when saving"
msgstr "هنگام ذخیره، نام پرونده پرسیده شود"

#. i18n: ectx: tooltip, entry (SaverAskForFilename), group (Files)
#: kookasettings.kcfg:72
#, kde-format
msgid ""
"<div>Check this if you want to always enter a file name when scanning an "
"image.</div>"
msgstr ""
"<div>اگر می‌خواهید هنگام پویش تصویر همیشه نام پرونده را وارد کنید، این گزینه"
" را علامت بزنید.</div>"

#. i18n: ectx: label, entry (SaverOnlyRecommendedTypes), group (Files)
#: kookasettings.kcfg:77
#, kde-format
msgid "Only show recommended formats for this image type"
msgstr "فقط قالب‌های توصیه‌شده برای این نوع تصویر نشان داده شوند"

#. i18n: ectx: tooltip, entry (SaverOnlyRecommendedTypes), group (Files)
#: kookasettings.kcfg:78
#, kde-format
msgid ""
"<div>Check this to only show recommended file formats for the scan type. "
"Uncheck it to show all compatible formats.</div>"
msgstr ""
"<div>برای نمایش تنها قالب‌های پروندهٔ توصیه‌شده برای این نوع پویش، این گزینه"
" را علامت بزنید. برای نمایش همهٔ قالب‌های سازگار، علامت آن را بردارید.</div>"

#. i18n: ectx: label, entry (SaverAlwaysUseFormat), group (Files2)
#: kookasettings.kcfg:91
#, kde-format
msgid "Always use this save format for this image type"
msgstr "همیشه از این قالب ذخیره برای این نوع تصویر استفاده شود"

#. i18n: ectx: tooltip, entry (SaverAlwaysUseFormat), group (Files2)
#: kookasettings.kcfg:92
#, kde-format
msgid ""
"<div>Check this to remember the selected file format for the scanned image "
"type and not ask for it again.</div>"
msgstr ""
"<div>این گزینه را علامت بزنید تا قالب پروندهٔ انتخاب‌شده برای نوع تصویر "
"پویش‌شده به‌خاطر سپرده شود و دوباره پرسیده نشود.</div>"

#. i18n: ectx: label, entry (GalleryAllowRename), group (Gallery)
#: kookasettings.kcfg:125
#, kde-format
msgid "Allow click-to-rename"
msgstr "اجازه به تغییر نام با کلیک"

#. i18n: ectx: tooltip, entry (GalleryAllowRename), group (Gallery)
#: kookasettings.kcfg:126
#, kde-format
msgid ""
"<div>Check this if you want to be able to rename gallery items by clicking "
"on them (otherwise, use the \"Rename\" menu option).</div>"
msgstr ""
"<div>اگر می‌خواهید بتوانید با کلیک روی موارد نگارخانه نام آن‌ها را تغییر "
"دهید، این گزینه را علامت بزنید (در غیر این صورت، از گزینهٔ «تغییر نام» در "
"منو استفاده کنید).</div>"

