#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "محمد شفیعی سروستانی"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "muhammad.shafiee@gmail.com"

#: plugins/decryptfileitemaction.cpp:32
#, kde-format
msgctxt "@action:inmenu Decrypt action in Dolphin context menu"
msgid "Decrypt"
msgstr "رمزگشایی"

#: plugins/encryptfileitemaction.cpp:42
#, kde-format
msgctxt "@action:inmenu Encrypt action in Dolphin context menu"
msgid "Encrypt"
msgstr "رمزگذاری"

#: src/compositejob.cpp:61
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Encryption operation failed. Please check whether the <application>gpg-"
"agent</application> process is running."
msgstr ""
"عملیات رمزگذاری ناموفق بود. لطفاً بررسی کنید که فرایند <application>gpg-"
"agent</application> در حال اجرا باشد."

#: src/compositejob.cpp:87
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Decryption operation failed. Please check whether the decryption key is "
"correct.<nl/>You should also check whether the <application>gpg-"
"agent</application> process is running."
msgstr ""
"عملیات رمزگشایی ناموفق بود. لطفاً بررسی کنید که کلید رمزگشایی درست "
"باشد.<nl/>همچنین بررسی کنید که فرایند <application>gpg-agent</application> "
"در حال اجرا باشد."

#: src/compositejob.cpp:90
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Could not decrypt the following ciphertexts.<nl/>Please check whether the "
"decryption key is correct."
msgstr ""
"متن‌های رمزشدهٔ زیر رمزگشایی نشدند.<nl/>لطفاً بررسی کنید که کلید رمزگشایی "
"درست باشد."

#: src/compositejob.cpp:130
#, kde-format
msgid "Asking Passphrase"
msgstr "درخواست عبارت عبور"

#: src/compositejob.cpp:134
#, kde-format
msgid "Please supply a password or passphrase to be used as encryption key."
msgstr ""
"لطفاً گذرواژه یا عبارت عبوری را برای استفاده به عنوان کلید رمزگذاری وارد "
"کنید."

#: src/compositejob.cpp:139
#, kde-format
msgid "Please supply a password or passphrase to be used as decryption key."
msgstr ""
"لطفاً گذرواژه یا عبارت عبوری را برای استفاده به عنوان کلید رمزگشایی وارد "
"کنید."

#: src/compositejob.cpp:160
#, kde-format
msgctxt "description of an encryption job"
msgid "Encrypting"
msgstr "در حال رمزنگاری"

#: src/compositejob.cpp:161
#, kde-format
msgctxt "File used as input of the encryption algorithm"
msgid "Plaintext"
msgstr "متن آشکار"

#: src/compositejob.cpp:162
#, kde-format
msgctxt "File created by the encryption algorithm"
msgid "Ciphertext"
msgstr "متن رمزشده"

#: src/compositejob.cpp:164
#, kde-format
msgctxt "description of a decryption job"
msgid "Decrypting"
msgstr "در حال رمزگشایی"

#: src/compositejob.cpp:165
#, kde-format
msgctxt "File used as input of the decryption algorithm"
msgid "Ciphertext"
msgstr "متن رمزشده"

#: src/compositejob.cpp:166
#, kde-format
msgctxt "File created by the decryption algorithm"
msgid "Plaintext"
msgstr "متن آشکار"

#: src/main.cpp:27
#, kde-format
msgctxt "display name for 'symmy' binary"
msgid "GPG Symmetric Encryption Frontend"
msgstr "رابط کاربری رمزنگاری متقارن GPG"

#: src/main.cpp:28
#, kde-format
msgid "Encrypt/decrypt one ore more files using GPG symmetric encryption."
msgstr "رمزنگاری/رمزگشایی یک یا چند پرونده با استفاده از رمزنگاری متقارن GPG."

#: src/main.cpp:28
#, kde-format
msgid "(c) 2017 Elvis Angelaccio"
msgstr "(c) 2017 Elvis Angelaccio"

#: src/main.cpp:29
#, kde-format
msgid "Elvis Angelaccio"
msgstr "Elvis Angelaccio"

#: src/main.cpp:33
#, kde-format
msgid "List of files to encrypt or decrypt."
msgstr "فهرست پرونده‌ها برای رمزگذاری یا رمزگشایی."

#: src/main.cpp:35
#, kde-format
msgid ""
"Encrypt the given list of files (this is the default if there are no other "
"options)."
msgstr ""
"رمزگذاری فهرست پرونده‌های داده‌شده (در صورت نبود گزینه‌های دیگر، این حالت "
"پیش‌فرض است)."

#: src/main.cpp:37
#, kde-format
msgid "Decrypt the given list of files."
msgstr "رمزگشایی فهرست پرونده‌های داده‌شده."

#: src/main.cpp:46
#, kde-format
msgctxt "--encrypt and --decrypt are CLI args, don't translate them"
msgid "Error: either --encrypt or --decrypt, not both."
msgstr ""
"خطا: یکی از گزینه‌های ‎--encrypt‎ یا ‎--decrypt‎ باید انتخاب شود، نه هر دو."
