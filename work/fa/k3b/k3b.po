#. i18n: ectx: property (toolTip), widget (QComboBox, m_comboSpaceHandling)
#: projects/base_k3bdataimagesettings.ui:147
#, kde-format
msgid "Handling of spaces in filenames"
msgstr "مدیریت فاصله‌ها در نام پرونده‌ها"

#. i18n: ectx: property (whatsThis), widget (QComboBox, m_comboSpaceHandling)
#: projects/base_k3bdataimagesettings.ui:160
#, kde-format
msgid ""
"<p><b>No Change</b><br>\n"
"If this option is checked, K3b will leave all spaces in filenames as they are.\n"
"<p><b>Strip</b><br>\n"
"If this option is checked, K3b will remove all spaces from all filenames.<br>\n"
"Example: 'my good file.ext' becomes 'mygoodfile.ext'\n"
"<p><b>Extended Strip</b><br>\n"
"If this option is checked K3b will remove all spaces in all filenames and capitalize all letters following a space.<br>\n"
"Example: 'my good file.ext' becomes 'myGoodFile.ext'\n"
"<p><b>Replace</b><br>\n"
"If this option is checked, K3b will replace all spaces in all filenames with the specified characters.<br>\n"
"Example: 'my good file.ext' becomes 'my_good_file.ext'"
msgstr ""
"<p><b>بدون تغییر</b><br>\n"
"اگر این گزینه علامت خورده باشد، K3b همهٔ فاصله‌ها را در نام پرونده‌ها همان‌طور که هستند باقی می‌گذارد.\n"
"<p><b>حذف</b><br>\n"
"اگر این گزینه علامت خورده باشد، K3b همهٔ فاصله‌ها را از نام پرونده‌ها حذف می‌کند.<br>\n"
"مثال: «my good file.ext» تبدیل می‌شود به «mygoodfile.ext»\n"
"<p><b>حذف گسترده</b><br>\n"
"اگر این گزینه علامت خورده باشد، K3b همهٔ فاصله‌ها را در نام پرونده‌ها حذف کرده و حروف پس از فاصله را بزرگ می‌نویسد.<br>\n"
"مثال: «my good file.ext» تبدیل می‌شود به «myGoodFile.ext»\n"
"<p><b>جایگزینی</b><br>\n"
"اگر این گزینه علامت خورده باشد، K3b همهٔ فاصله‌ها را در نام پرونده‌ها با نویسه‌های مشخص‌شده جایگزین می‌کند.<br>\n"
"مثال: «my good file.ext» تبدیل می‌شود به «my_good_file.ext»"

