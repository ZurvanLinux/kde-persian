#. i18n: ectx: property (text), widget (QLabel, label)
#: ../plugins/encoder/external/base_k3bexternalencodereditdialog.ui:80
#, no-c-format, kde-format
msgid ""
"Please insert the command used to encode the audio data. The command has to read raw little endian (see <em>Swap Byte Order</em>) 16-bit stereo audio frames from stdin.\n"
"<p>The following strings will be replaced by K3b:<br>\n"
"<b>%f</b> - The filename of the resulting file. This is where the command has to write its output to.<br>\n"
"<em>The following refer to metadata stored for example in the ID3 tag of an mp3 file (Be aware that these values might be empty).</em><br>\n"
"<b>%t</b> - Title<br>\n"
"<b>%a</b> - Artist<br>\n"
"<b>%c</b> - Comment<br>\n"
"<b>%n</b> - Track number<br>\n"
"<b>%m</b> - Album Title<br>\n"
"<b>%r</b> - Album Artist<br>\n"
"<b>%x</b> - Album comment<br>\n"
"<b>%y</b> - Release Year"
msgstr ""
"لطفاً فرمانی را که برای رمزگذاری داده‌های صوتی استفاده می‌شود وارد کنید. این فرمان باید فریم‌های صوتی ۱۶ بیتی استریو خام با ترتیب بایت Little Endian (به <em>جابه‌جایی ترتیب بایت‌ها</em> مراجعه کنید) را از stdin بخواند.\n"
"<p>رشته‌های زیر توسط K3b جایگزین خواهند شد:<br>\n"
"<b>%f</b> - نام پرونده خروجی نهایی. جایی که فرمان باید خروجی خود را در آن بنویسد.<br>\n"
"<em>موارد زیر به فرا‌داده‌های ذخیره‌شده مثلاً در برچسب ID3 یک پرونده mp3 اشاره دارند (توجه داشته باشید که این مقادیر ممکن است خالی باشند).</em><br>\n"
"<b>%t</b> - عنوان<br>\n"
"<b>%a</b> - هنرمند<br>\n"
"<b>%c</b> - توضیح<br>\n"
"<b>%n</b> - شماره قطعه<br>\n"
"<b>%m</b> - عنوان آلبوم<br>\n"
"<b>%r</b> - هنرمند آلبوم<br>\n"
"<b>%x</b> - توضیح آلبوم<br>\n"
"<b>%y</b> - سال انتشار"

