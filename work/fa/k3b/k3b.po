msgstr "320x؟ (ارتفاع خودکار)"

#: rip/videodvd/k3bvideodvdrippingwidget.cpp:178
#: rip/videodvd/k3bvideodvdrippingwidget.cpp:179
#, kde-format
msgid "auto"
msgstr "خودکار"

#: rip/videodvd/k3bvideodvdrippingwidget.cpp:278
#, kde-format
msgid ""
"<p><b>Pattern special strings:</b><p>The following strings will be replaced "
"with their respective meaning in every track name.<br><p><table "
"border=\"0\"><tr><td></td><td><em>Meaning</em></td><td><em>Alternatives</em></td></tr><tr><td>%t</td><td>title"
" number</td><td>%{t} or %{title_number}</td></tr><tr><td>%i</td><td>volume "
"id (mostly the name of the Video DVD)</td><td>%{i} or "
"%{volume_id}</td></tr><tr><td>%b</td><td>beautified volume id</td><td>%{b} "
"or %{beautified_volume_id}</td></tr><tr><td>%l</td><td>two chars language "
"code</td><td>%{l} or %{lang_code}</td></tr><tr><td>%n</td><td>language "
"name</td><td>%{n} or %{lang_name}</td></tr><tr><td>%a</td><td>audio format "
"(on the Video DVD)</td><td>%{a} or "
"%{audio_format}</td></tr><tr><td>%c</td><td>number of audio channels (on the"
" Video DVD)</td><td>%{c} or %{channels}</td></tr><tr><td>%v</td><td>size of "
"the original video</td><td>%{v} or "
"%{orig_video_size}</td></tr><tr><td>%s</td><td>size of the resulting video "
"(<em>Caution: auto-clipping values are not taken into "
"account.</em>)</td><td>%{s} or "
"%{video_size}</td></tr><tr><td>%r</td><td>aspect ratio of the original "
"video</td><td>%{r} or %{aspect_ratio}</td></tr><tr><td>%d</td><td>current "
"date</td><td>%{d} or %{date}</td></tr></table><p><em>Hint: K3b also accepts "
"slight variations of the long special strings. One can, for example, leave "
"out the underscores.</em>"
msgstr ""
"<p><b>رشته‌های ویژهٔ الگو:</b><p>رشته‌های زیر با معنای مربوط به خود در نام "
"هر قطعه جایگزین خواهند شد.<br><p><table "
"border=\"0\"><tr><td></td><td><em>معنی</em></td><td><em>جایگزین‌ها</em></td></tr><tr><td>%t</td><td>شمارهٔ"
" عنوان</td><td>%{t} یا %{title_number}</td></tr><tr><td>%i</td><td>شناسهٔ "
"حجم (معمولاً نام DVD ویدیویی)</td><td>%{i} یا "
"%{volume_id}</td></tr><tr><td>%b</td><td>شناسهٔ حجم "
"زیباسازی‌شده</td><td>%{b} یا "
"%{beautified_volume_id}</td></tr><tr><td>%l</td><td>کد زبان دو "
"حرفی</td><td>%{l} یا %{lang_code}</td></tr><tr><td>%n</td><td>نام "
"زبان</td><td>%{n} یا %{lang_name}</td></tr><tr><td>%a</td><td>قالب صدا (روی "
"DVD ویدیویی)</td><td>%{a} یا "
"%{audio_format}</td></tr><tr><td>%c</td><td>تعداد کانال‌های صدا (روی DVD "
"ویدیویی)</td><td>%{c} یا %{channels}</td></tr><tr><td>%v</td><td>اندازهٔ "
"ویدیوی اصلی</td><td>%{v} یا "
"%{orig_video_size}</td></tr><tr><td>%s</td><td>اندازهٔ ویدیوی حاصل "
"(<em>احتیاط: مقادیر برش خودکار در نظر گرفته نمی‌شوند.</em>)</td><td>%{s} یا "
"%{video_size}</td></tr><tr><td>%r</td><td>نسبت ابعاد ویدیوی "
"اصلی</td><td>%{r} یا %{aspect_ratio}</td></tr><tr><td>%d</td><td>تاریخ "
"کنونی</td><td>%{d} یا %{date}</td></tr></table><p><em>نکته: K3b تغییرات جزئی"
" در رشته‌های ویژهٔ طولانی را نیز می‌پذیرد. برای مثال، می‌توانید خط‌های زیرین"
" (underscore) را حذف کنید.</em>"

#: rip/videodvd/k3bvideodvdrippingwidget.cpp:331
#, kde-format
msgid "Video Picture Size"
msgstr "اندازهٔ تصویر ویدیو"

#: rip/videodvd/k3bvideodvdrippingwidget.cpp:333
#, kde-format
msgid ""
"<p>Please choose the width and height of the resulting video. If one value "
"is set to <em>Auto</em> K3b will choose this value depending on the aspect "
"ratio of the video picture.<br>Be aware that setting both the width and the "
"height to fixed values will result in no aspect ratio correction being "
"performed."
msgstr ""
"<p>لطفاً عرض و ارتفاع ویدیوی خروجی را انتخاب کنید. اگر یک مقدار روی "
"<em>خودکار</em> تنظیم شود، K3b این مقدار را بر اساس نسبت تصویر ویدیو انتخاب "
"خواهد کرد.<br>توجه داشته باشید که تنظیم هر دو مقدار عرض و ارتفاع روی مقادیر "
