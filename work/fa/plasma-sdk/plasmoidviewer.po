#: main.cpp:37
#, kde-format
msgid "Plasmoidviewer"
msgstr "Plasmoidviewer"

#: main.cpp:44
#, kde-format
msgid "Run Plasma widgets in their own window"
msgstr "اجرای ابزارک‌های پلاسما در پنجرهٔ خودشان"

#: main.cpp:47
#, kde-format
msgid "The name of the containment plugin"
msgstr "نام افزایهٔ نگه‌دارنده"

#: main.cpp:51
#, kde-format
msgid "The name of the applet plugin"
msgstr "نام افزایهٔ ابزارک"

#: main.cpp:53
#, kde-format
msgid ""
"The formfactor to use (horizontal, vertical, mediacenter, planar or "
"application)"
msgstr ""
"عامل شکل برای استفاده (horizontal، vertical، mediacenter، planar یا "
"application)"

#: main.cpp:58
#, kde-format
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, topedge, bottomedge, leftedge, rightedge)"
msgstr ""
"قید مکان برای شروع نگه‌دارنده با آن (floating، desktop، fullscreen، topedge،"
" bottomedge، leftedge، rightedge)"

#: main.cpp:63
#, kde-format
msgid "Set the x position of the plasmoidviewer on the Plasma desktop"
msgstr "تنظیم موقعیت x برنامهٔ plasmoidviewer در میزکار پلاسما"

#: main.cpp:66
#, kde-format
msgid "Set the y position of the plasmoidviewer on the Plasma desktop"
msgstr "تنظیم موقعیت y برنامهٔ plasmoidviewer در میزکار پلاسما"

#: main.cpp:69
#, kde-format
msgid "Set the window size of the plasmoidview"
msgstr "تنظیم اندازهٔ پنجرهٔ نمای پلاسموید"

#: main.cpp:72
#, kde-format
msgid "The size in kB to set the pixmap cache to"
msgstr "اندازه به kB برای تنظیم حافظهٔ پنهان نگاشت‌پیکسلی"

#: main.cpp:75
#, kde-format
msgid "The name of the theme which the shell will use"
msgstr "نام پوسته‌ای که پوسته استفاده خواهد کرد"

#: main.cpp:78
#, kde-format
msgid "Data that should be passed to the applet as 'externalData' event"
msgstr "داده‌ای که باید به عنوان رویداد «externalData» به برنامک ارسال شود"

#: view.cpp:118
#, no-c-format, kde-format
msgid "Applet %1 does not exist."
msgstr "برنامک %1 وجود ندارد."

#: view.cpp:135
#, no-c-format, kde-format
msgid "Containment %1 does not exist."
msgstr "نگه‌دارندهٔ %1 وجود ندارد."

#: view.cpp:308
#, kde-format
msgctxt "@title:window"
msgid "Save Screenshot"
msgstr "ذخیرهٔ تصویر صفحه"
