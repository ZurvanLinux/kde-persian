#: greeter/lightdm-kde-greeter.desktop:5
msgctxt "Name"
msgid "LightDM KDE Greeter"
msgstr "خوش‌آمدگوی LightDM KDE"

#: greeter/lightdm-kde-greeter.desktop:44
msgctxt "Comment"
msgid "This runs the KDE greeter, it should only be run from LightDM"
msgstr "این خوش‌آمدگوی KDE را اجرا می‌کند؛ تنها باید از طریق LightDM اجرا شود"

#: greeter/lightdm-kde-greeter-x11.desktop:5
msgctxt "Name"
msgid "LightDM KDE Greeter (X11)"
msgstr "خوش‌آمدگوی LightDM KDE (‏X11)"

#: greeter/lightdm-kde-greeter-x11.desktop:38
msgctxt "Comment"
msgid ""
"This runs the KDE greeter (X11 session), it should only be run from LightDM"
msgstr ""
"این خوش‌آمدگوی KDE (نشست X11) را اجرا می‌کند؛ تنها باید از طریق LightDM اجرا"
" شود"

