#: hashhelper.cpp:66
#, kde-format
msgctxt "@label"
msgid ""
"This file has been signed VS-NfD compliant using the key <a "
"href=\"%1\">%2</a>."
msgstr ""
"این پرونده به شیوه‌ای سازگار با VS-NfD با استفاده از کلید <a "
"href=\"%1\">%2</a> امضا شده است."

#: hashhelper.cpp:71
#, kde-format
msgctxt "@label"
msgid "This file has been signed using the key <a href=\"%1\">%2</a>."
msgstr "این پرونده با استفاده از کلید <a href=\"%1\">%2</a> امضا شده است."

#: hashhelper.cpp:74
#, kde-format
msgctxt "@label"
msgid "The key details are not available."
msgstr "جزئیات کلید در دسترس نیست."

#: hashhelper.cpp:77
#, kde-format
msgctxt "@label"
msgid "This file has been signed VS-NfD compliant by %1."
msgstr "این پرونده به شیوه‌ای سازگار با VS-NfD توسط %1 امضا شده است."

#: hashhelper.cpp:79
#, kde-format
msgctxt "@label"
msgid "This file has been signed by %1."
msgstr "این پرونده توسط %1 امضا شده است."

#: hashhelper.cpp:82
#, kde-format
msgctxt "@label"
msgid "The <a href=\"%1\">key</a> was revoked."
msgstr "<a href=\"%1\">کلید</a> لغو شده است."

#: hashhelper.cpp:85
#, kde-format
msgctxt "@label"
msgid "The <a href=\"%1\">key</a> was expired."
msgstr "<a href=\"%1\">کلید</a> منقضی شده است."

#: hashhelper.cpp:89
#, kde-format
msgctxt "@label"
msgid ""
"The signature is valid, but the <a href=\"%1\">key</a>'s validity is "
"unknown."
msgstr "امضا معتبر است، اما اعتبار <a href=\"%1\">کلید</a> نامشخص است."

#: hashhelper.cpp:91
#, kde-format
msgctxt "@label"
msgid ""
"The signature is valid and the <a href=\"%1\">key</a> is marginally trusted."
msgstr "امضا معتبر است و <a href=\"%1\">کلید</a> تا حدی مورد اعتماد است."

#: hashhelper.cpp:93
#, kde-format
msgctxt "@label"
msgid "The signature is valid and the <a href=\"%1\">key</a> is fully trusted."
msgstr "امضا معتبر است و <a href=\"%1\">کلید</a> کاملاً مورد اعتماد است."

#: hashhelper.cpp:95
#, kde-format
msgctxt "@label"
msgid ""
"The signature is valid and the <a href=\"%1\">key</a> is ultimately trusted."
msgstr "امضا معتبر است و <a href=\"%1\">کلید</a> نهایت اعتماد را دارد."

#: hashhelper.cpp:97
#, kde-format
msgctxt "@label"
msgid "The signature is valid, but the <a href=\"%1\">key</a> is untrusted."
msgstr "امضا معتبر است، اما <a href=\"%1\">کلید</a> غیرقابل اعتماد است."

#: hashhelper.cpp:101
#, kde-format
msgctxt "@label"
msgid "The signature is invalid."
msgstr "امضا نامعتبر است."

#: hashhelper.cpp:159
#, kde-format
msgctxt "list separator"
msgid ", "
msgstr "، "

#: hashhelper.cpp:196
#, kde-format
msgid "Hash-o-matic doesn't support directories."
msgstr "برنامهٔ Hash-o-matic از پوشه‌ها پشتیبانی نمی‌کند."

#: hashhelper.cpp:268
#, kde-format
msgid "The file doesn't exist or is not readable."
msgstr "پرونده وجود ندارد یا خواندنی نیست."

