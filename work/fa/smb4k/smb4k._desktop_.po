#: core/smb4k.notifyrc:3 smb4k/org.kde.smb4k.desktop:3
msgctxt "Name"
msgid "Smb4K"
msgstr "Smb4K"

#: core/smb4k.notifyrc:44 smb4k/org.kde.smb4k.desktop:80
msgctxt "Comment"
msgid "Advanced Network Neighborhood Browser"
msgstr "مرورگر پیشرفته همسایگی شبکه"

#: core/smb4k.notifyrc:87
msgctxt "Name"
msgid "Notification"
msgstr "اعلان"

#: core/smb4k.notifyrc:129
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "به کاربر درباره یک کنش اطلاع داده می‌شود"

#: core/smb4k.notifyrc:170
msgctxt "Name"
msgid "Warning"
msgstr "هشدار"

#: core/smb4k.notifyrc:212
msgctxt "Comment"
msgid "A warning is shown to the user"
msgstr "هشداری به کاربر نشان داده می‌شود"

#: core/smb4k.notifyrc:254
msgctxt "Name"
msgid "Error"
msgstr "خطا"

#: core/smb4k.notifyrc:296
msgctxt "Comment"
msgid "An error message is shown to the user"
msgstr "پیام خطایی به کاربر نشان داده می‌شود"

#: core/smb4k.notifyrc:337
msgctxt "Name"
msgid "Share mounted"
msgstr "اشتراک سوار شد"

#: core/smb4k.notifyrc:376
msgctxt "Comment"
msgid "A share has been mounted"
msgstr "یک اشتراک سوار شده است"

#: core/smb4k.notifyrc:419
msgctxt "Name"
msgid "Share unmounted"
msgstr "اشتراک پیاده شد"

#: core/smb4k.notifyrc:458
msgctxt "Comment"
msgid "A share has been unmounted"
msgstr "یک اشتراک پیاده شده است"

#: core/smb4k.notifyrc:501
msgctxt "Name"
msgid "Shares mounted"
msgstr "اشتراک‌ها سوار شدند"

#: core/smb4k.notifyrc:540
msgctxt "Comment"
msgid "Multiple shares have been mounted"
msgstr "چندین اشتراک سوار شده‌اند"

#: core/smb4k.notifyrc:583
msgctxt "Name"
msgid "Shares unmounted"
msgstr "اشتراک‌ها پیاده شدند"

#: core/smb4k.notifyrc:622
msgctxt "Comment"
msgid "Multiple shares have been unmounted"
msgstr "چندین اشتراک پیاده شده‌اند"

#: core/smb4k.notifyrc:665
msgctxt "Name"
msgid "Migrating login credentials"
msgstr "مهاجرت اطلاعات ورود"

#: core/smb4k.notifyrc:695
msgctxt "Comment"
msgid ""
"The login credentials are migrated to the new format and the active password"
" manager"
msgstr "اطلاعات ورود به قالب جدید و مدیر گذرواژهٔ فعال انتقال می‌یابند"

#: core/smb4k.notifyrc:729
msgctxt "Name"
msgid "Mimetype not supported"
msgstr "Mimetype پشتیبانی نمی‌شود"

#: core/smb4k.notifyrc:768
msgctxt "Comment"
msgid "The mimetype of the file that is to be printed is not supported"
msgstr "نوع رسانه‌ای (Mimetype) فایلی که قرار است چاپ شود پشتیبانی نمی‌شود"

#: core/smb4k.notifyrc:811
msgctxt "Name"
msgid "Bookmark exists"
msgstr "نشانک وجود دارد"

#: core/smb4k.notifyrc:850
msgctxt "Comment"
msgid "The bookmark exists"
msgstr "نشانک وجود دارد"

#: core/smb4k.notifyrc:894
msgctxt "Name"
msgid "Bookmark label in use"
msgstr "برچسب نشانک در حال استفاده است"

#: core/smb4k.notifyrc:933
msgctxt "Comment"
msgid "The label for the bookmark already exists"
msgstr "برچسب این نشانک از قبل وجود دارد"

#: core/smb4k.notifyrc:977
msgctxt "Name"
msgid "Mounting failed"
msgstr "سوار کردن ناموفق بود"

#: core/smb4k.notifyrc:1016
msgctxt "Comment"
msgid "Mounting a share failed"
msgstr "سوار کردن اشتراک ناموفق بود"

#: core/smb4k.notifyrc:1060
msgctxt "Name"
msgid "Unmounting failed"
msgstr "پیاده کردن ناموفق بود"

#: core/smb4k.notifyrc:1099
msgctxt "Comment"
msgid "Unmounting a share failed"
msgstr "پیاده کردن اشتراک ناموفق بود"

#: core/smb4k.notifyrc:1143
msgctxt "Name"
msgid "Unmounting not allowed"
msgstr "پیاده کردن مجاز نیست"

#: core/smb4k.notifyrc:1182
msgctxt "Comment"
msgid "The unmounting of a certain share is not allowed"
msgstr "پیاده کردن یک اشتراک خاص مجاز نیست"

#: core/smb4k.notifyrc:1226
msgctxt "Name"
msgid "Synchronization failed"
msgstr "همگام‌سازی ناموفق بود"

#: core/smb4k.notifyrc:1265
msgctxt "Comment"
msgid "The synchronization of a share and a local copy failed"
msgstr "همگام‌سازی یک اشتراک و نسخهٔ محلی ناموفق بود"

#: core/smb4k.notifyrc:1308
msgctxt "Name"
msgid "Command not found"
msgstr "فرمان پیدا نشد"

#: core/smb4k.notifyrc:1350
msgctxt "Comment"
msgid "A required command could not be found"
msgstr "یک فرمان لازم پیدا نشد"

#: core/smb4k.notifyrc:1394
msgctxt "Name"
msgid "Cannot bookmark printer"
msgstr "نشانک‌گذاری چاپگر امکان‌پذیر نیست"

#: core/smb4k.notifyrc:1433
msgctxt "Comment"
msgid "A printer cannot be bookmarked"
msgstr "امکان نشانک‌گذاری چاپگر وجود ندارد"

#: core/smb4k.notifyrc:1477
msgctxt "Name"
msgid "File not found"
msgstr "پرونده پیدا نشد"

#: core/smb4k.notifyrc:1519
msgctxt "Comment"
msgid "A file could not be found"
msgstr "پرونده پیدا نشد"

#: core/smb4k.notifyrc:1563
msgctxt "Name"
msgid "Opening file failed"
msgstr "باز کردن پرونده ناموفق بود"

#: core/smb4k.notifyrc:1602
msgctxt "Comment"
msgid "A file could not be opened"
msgstr "پرونده باز نشد"

#: core/smb4k.notifyrc:1646
msgctxt "Name"
msgid "Reading file failed"
msgstr "خواندن پرونده شکست خورد"

#: core/smb4k.notifyrc:1685
msgctxt "Comment"
msgid "A file could not be read"
msgstr "پرونده خوانده نشد"

#: core/smb4k.notifyrc:1729
msgctxt "Name"
msgid "mkdir failed"
msgstr "mkdir شکست خورد"

#: core/smb4k.notifyrc:1769
msgctxt "Comment"
msgid "A directory could not be created"
msgstr "شاخه ایجاد نشد"

#: core/smb4k.notifyrc:1813
msgctxt "Name"
msgid "Process error"
msgstr "خطای فرایند"

#: core/smb4k.notifyrc:1854
msgctxt "Comment"
msgid "A process error occurred"
msgstr "یک خطای فرایند رخ داد"

#: core/smb4k.notifyrc:1898
msgctxt "Name"
msgid "Action failed"
msgstr "کنش شکست خورد"

#: core/smb4k.notifyrc:1939
msgctxt "Comment"
msgid "A KAuth action failed"
msgstr "یک کنش KAuth شکست خورد"

#: core/smb4k.notifyrc:1982
msgctxt "Name"
msgid "Invalid URL"
msgstr "نشانی نامعتبر"

#: core/smb4k.notifyrc:2023
msgctxt "Comment"
msgid "An invalid URL was passed"
msgstr "یک نشانی نامعتبر ارسال شد"

#: core/smb4k.notifyrc:2066
msgctxt "Name"
msgid "Network communication failed"
msgstr "ارتباط شبکه‌ای ناموفق بود"

#: core/smb4k.notifyrc:2101
msgctxt "Comment"
msgid "A network related action could not be performed or failed"
msgstr "یک کنش مرتبط با شبکه انجام نشد یا با شکست مواجه شد"

#: core/smb4k.notifyrc:2141
msgctxt "Name"
msgid "Zeroconf error"
msgstr "خطای Zeroconf"

#: core/smb4k.notifyrc:2175
msgctxt "Comment"
msgid "An error with the Zeroconf daemon occurred"
msgstr "خطایی در دیمن Zeroconf رخ داد"

#: core/smb4k.notifyrc:2213
msgctxt "Name"
msgid "Keychain error"
msgstr "خطای دسته‌کلید"

#: core/smb4k.notifyrc:2244
msgctxt "Comment"
msgid ""
"An error occurred while reading the login credentials from the secure "
"storage"
msgstr "هنگام خواندن اطلاعات ورود از فضای ذخیره‌سازی امن خطایی رخ داد"

#: helpers/smb4kmounthelper.actions:2
msgctxt "Name"
msgid "Mount action"
msgstr "کنش وصل کردن"

#: helpers/smb4kmounthelper.actions:40
msgctxt "Description"
msgid "Mounts a share"
msgstr "یک اشتراک را وصل می‌کند"

#: helpers/smb4kmounthelper.actions:82
msgctxt "Name"
msgid "Unmount action"
msgstr "کنش جدا کردن"

#: helpers/smb4kmounthelper.actions:120
msgctxt "Description"
msgid "Unmounts a share"
msgstr "یک اشتراک را جدا می‌کند"

#: smb4k/org.kde.smb4k.desktop:44
msgctxt "GenericName"
msgid "Advanced Network Browser for SAMBA"
msgstr "مرورگر پیشرفتهٔ شبکه برای سامبا (SAMBA)"
