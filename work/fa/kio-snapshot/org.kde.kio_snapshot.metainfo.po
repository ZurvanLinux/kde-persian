#. (itstool) path: component/name
#: org.kde.kio_snapshot.metainfo.xml:8
msgid "KIO Snapshot"
msgstr "عکس‌لحظه‌ای KIO"

#. (itstool) path: component/summary
#: org.kde.kio_snapshot.metainfo.xml:19
msgid "Filesystem snapshot integration for KDE applications"
msgstr "یکپارچه‌سازی عکس‌لحظه‌ای سامانهٔ پرونده برای برنامه‌های KDE"

#. (itstool) path: description/p
#: org.kde.kio_snapshot.metainfo.xml:21
msgid ""
"KIO Snapshot enables KDE applications to view snapshot history of files and "
"folders."
msgstr ""
"عکس‌لحظه‌ای KIO به برنامه‌های KDE امکان مشاهدهٔ تاریخچهٔ عکس‌های لحظه‌ای "
"پرونده‌ها و پوشه‌ها را می‌دهد."

#. (itstool) path: screenshot/caption
#: org.kde.kio_snapshot.metainfo.xml:27
msgid "Dolphin showing snapshots of a single file."
msgstr "دلفین در حال نمایش عکس‌های لحظه‌ای یک پرونده."

#. (itstool) path: screenshot/caption
#: org.kde.kio_snapshot.metainfo.xml:31
msgid "Dolphin showing snapshots of a folder."
msgstr "دلفین در حال نمایش عکس‌های لحظه‌ای یک پوشه."
