#: core/dplugins/bqm/convert/converttoheif/converttoheifplugin.cpp:42
#, kde-format
msgctxt "@title"
msgid "Convert To HEIF"
msgstr "تبدیل به HEIF"

#: core/dplugins/bqm/convert/converttoheif/converttoheifplugin.cpp:57
#, kde-format
msgctxt "@info"
msgid "A tool to convert images to HEIF format"
msgstr "ابزاری برای تبدیل تصاویر به قالب HEIF"

#: core/dplugins/bqm/convert/converttoheif/converttoheifplugin.cpp:62
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>This Batch Queue Manager tool can convert images data to HEIF "
"format.</para><para>High Efficiency Image File Format (HEIF), also known as "
"High Efficiency Image Coding (HEIC), is a file format for individual images "
"and image sequences. It was developed by the Moving Picture Experts Group "
"(MPEG) and it claims that twice as much information can be stored in a HEIF "
"image as in a JPEG image of the same size, resulting in a better quality "
"image. HEIF also supports animation, and is capable of storing more "
"information than an animated GIF at a small fraction of the "
"size.</para><para>See <link "
"url='https://en.wikipedia.org/wiki/High_Efficiency_Image_File_Format'>High "
"Efficiency Image File Format</link> for details.</para>"
msgstr ""
"<para>این ابزار «مدیر صف دسته‌ای» می‌تواند داده‌های تصویر را به قالب HEIF "
"تبدیل کند.</para><para>قالب پروندهٔ تصویری با کارایی بالا (HEIF) که با نام "
"کدگذاری تصویر با کارایی بالا (HEIC) نیز شناخته می‌شود، یک قالب پرونده برای "
"تصاویر تک و توالی‌های تصویری است. این قالب توسط گروه کارشناسان تصویر متحرک "
"(MPEG) توسعه یافته است و ادعا می‌کند که در اندازه‌ای برابر با یک تصویر JPEG،"
" اطلاعاتی دو برابر بیشتر را می‌توان در یک تصویر HEIF ذخیره کرد که منجر به "
"کیفیت تصویر بهتری می‌شود. همچنین HEIF از پویانمایی پشتیبانی می‌کند و "
"می‌تواند اطلاعات بسیار بیشتری را در مقایسه با یک GIF پویانما با کسری ناچیز "
"از اندازهٔ آن ذخیره کند.</para><para>برای جزئیات بیشتر <link "
"url='https://en.wikipedia.org/wiki/High_Efficiency_Image_File_Format'>قالب "
"پروندهٔ تصویری با کارایی بالا</link> را ببینید.</para>"

#: core/dplugins/bqm/convert/converttojp2/converttojp2plugin.cpp:42
#, kde-format
msgctxt "@title"
msgid "Convert To JP2"
msgstr "تبدیل به JP2"

#: core/dplugins/bqm/convert/converttojp2/converttojp2plugin.cpp:57
#, kde-format
msgctxt "@info"
msgid "A tool to convert images to JPEG-2000 format"
msgstr "ابزاری برای تبدیل تصاویر به قالب JPEG-2000"

#: core/dplugins/bqm/convert/converttojp2/converttojp2plugin.cpp:62
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>This Batch Queue Manager tool can convert images data to JPEG-2000 "
"format.</para><para>This is an image compression standard and coding system."
" It was created by the Joint Photographic Experts Group committee in 2000 "
"with the intention of superseding their original discrete cosine transform-"
"based JPEG standard (created in 1992) with a newly designed, wavelet-based "
"method.</para><para>See details about this format from <link "
"url='https://en.wikipedia.org/wiki/JPEG_2000'>this page</link>.</para>"
msgstr ""
"<para>این ابزار «مدیر صف دسته‌ای» می‌تواند داده‌های تصویر را به قالب "
"JPEG-2000 تبدیل کند.</para><para>این یک استاندارد فشرده‌سازی تصویر و سامانهٔ"
" کدگذاری است. این استاندارد توسط کمیتهٔ گروه مشترک کارشناسان عکاسی در سال "
"۲۰۰۰ با هدف جایگزینی استاندارد اصلی JPEG مبتنی بر تبدیل کسینوسی گسسته (ایجاد"
" شده در سال ۱۹۹۲) با روشی نوین مبتنی بر موجک ایجاد شد.</para><para>جزئیات "
"مربوط به این قالب را در <link "
"url='https://en.wikipedia.org/wiki/JPEG_2000'>این صفحه</link> ببینید.</para>"

#: core/dplugins/bqm/convert/converttojpeg/converttojpegplugin.cpp:42
