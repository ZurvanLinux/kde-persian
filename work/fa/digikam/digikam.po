#: core/libs/rawengine/drawdecoderwidget.cpp:510
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Noise Reduction</title><para>Select here the noise reduction method "
"to apply during RAW decoding.</para><para><list><item><emphasis "
"strong='true'>None</emphasis>: no noise reduction.</item><item><emphasis "
"strong='true'>Wavelets</emphasis>: wavelets correction to erase noise while "
"preserving real detail. It is applied after "
"interpolation.</item><item><emphasis strong='true'>FBDD</emphasis>: Fake "
"Before Demosaicing Denoising noise reduction. It is applied before "
"interpolation.</item></list></para>"
msgstr ""
"<title>کاهش نویز</title><para>روش کاهش نویز مورد نظر برای اعمال هنگام "
"رمزگشایی RAW را در اینجا انتخاب کنید.</para><para><list><item><emphasis "
"strong='true'>هیچ‌کدام</emphasis>: بدون کاهش نویز.</item><item><emphasis "
"strong='true'>موجک‌ها</emphasis>: تصحیح موجک‌ها برای حذف نویز هم‌زمان با حفظ"
" جزئیات واقعی. این روش پس از درون‌یابی اعمال می‌شود.</item><item><emphasis "
"strong='true'>FBDD</emphasis>: کاهش نویز Fake Before Demosaicing Denoising. "
"این روش پیش از درون‌یابی اعمال می‌شود.</item></list></para>"

