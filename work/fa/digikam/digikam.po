#: core/utilities/geolocation/engine/projections/AzimuthalEquidistantProjection.cpp:73
#, kde-format
msgid "Azimuthal Equidistant"
msgstr "سمتی هم‌فاصله"

#: core/utilities/geolocation/engine/projections/AzimuthalEquidistantProjection.cpp:78
#, kde-format
msgid ""
"<p><b>Azimuthal Equidistant Projection</b> (\"fish "
"eye\")</p><p>Applications: Display of seismic and radio data and for use in "
"digital planetariums.</p>"
msgstr ""
"<p><b>تصویر سمتی هم‌فاصله</b> («چشم ماهی»)</p><p>کاربردها: نمایش داده‌های "
"لرزه‌ای و رادیویی و استفاده در آسمان‌نماهای دیجیتال.</p>"

#: core/utilities/geolocation/engine/projections/EquirectProjection.cpp:49
#, kde-format
msgid "Flat Map"
msgstr "نقشه مسطح"

#: core/utilities/geolocation/engine/projections/EquirectProjection.cpp:54
#, kde-format
msgid ""
"<p><b>Equirectangular Projection</b> (\"Plate carrée\")</p><p>Applications: "
"De facto standard for global texture data sets for computer software.</p>"
msgstr ""
"<p><b>تصویر استوانه‌ای متساوی‌المستطیلات</b> («Plate "
"carrée»)</p><p>کاربردها: استاندارد بالفعل برای مجموعه‌داده‌های بافت جهانی در"
" نرم‌افزارهای رایانه‌ای.</p>"

#: core/utilities/geolocation/engine/projections/GnomonicProjection.cpp:78
#, kde-format
msgid "Gnomonic"
msgstr "مرکزی (گنومونیک)"

#: core/utilities/geolocation/engine/projections/GnomonicProjection.cpp:83
#, kde-format
msgid ""
"<p><b>Gnomonic Projection</b> (\"rectilinear\")</p><p>Applications: Used for"
" displaying panorama photography. Also used for navigation, radio and "
"seismic work.</p>"
msgstr ""
"<p><b>تصویر مرکزی</b> («مستقیم‌الخط»)</p><p>کاربردها: برای نمایش عکاسی "
"سراسرنما (پانوراما). همچنین برای ناوبری، رادیو و فعالیت‌های لرزه‌نگاری "
"استفاده می‌شود.</p>"

#: core/utilities/geolocation/engine/projections/LambertAzimuthalProjection.cpp:78
#, kde-format
msgid "Lambert Azimuthal Equal-Area"
msgstr "سمتی هم‌مساحت لمبرت"

#: core/utilities/geolocation/engine/projections/LambertAzimuthalProjection.cpp:83
#, kde-format
msgid ""
"<p><b>Lambert Azimuthal Equal-Area Projection</b></p><p>Applications: Used "
"in structural geology to plot directional data.</p>"
msgstr ""
"<p><b>تصویر سمتی هم‌مساحت لامبرت</b></p><p>کاربردها: در زمین‌شناسی ساختاری "
"برای ترسیم داده‌های جهتی استفاده می‌شود.</p>"

#: core/utilities/geolocation/engine/projections/MercatorProjection.cpp:56
#: core/utilities/geolocation/geoiface/backends/backendmarble.cpp:357
#, kde-format
msgid "Mercator"
msgstr "مرکاتور"

#: core/utilities/geolocation/engine/projections/MercatorProjection.cpp:61
#, kde-format
msgid ""
"<p><b>Mercator Projection</b></p><p>Applications: popular standard map "
"projection for navigation.</p>"
msgstr ""
"<p><b>تصویر مرکاتور</b></p><p>کاربردها: تصویر نقشهٔ استاندارد و محبوب برای "
"ناوبری.</p>"

#: core/utilities/geolocation/engine/projections/SphericalProjection.cpp:77
#, kde-format
msgid "Globe"
msgstr "کره"

#: core/utilities/geolocation/engine/projections/SphericalProjection.cpp:82
#, kde-format
msgid ""
"<p><b>Orthographic Projection</b> (\"orthogonal\")</p><p>Applications: A "
"perspective projection that is used to display the hemisphere of a globe as "
"it appears from outer space.</p>"
msgstr ""
"<p><b>تصویر ارتوگرافیک</b> («متعامد»)</p><p>کاربردها: یک تصویر پرسپکتیو که "
"برای نمایش نیمکره‌ای از یک کره، آن‌گونه که از فضا دیده می‌شود، به کار "
"می‌رود.</p>"

#: core/utilities/geolocation/engine/projections/StereographicProjection.cpp:79
#, kde-format
msgid "Stereographic"
msgstr "استریوگرافیک"

#: core/utilities/geolocation/engine/projections/StereographicProjection.cpp:84
#, kde-format
msgid ""
"<p><b>Stereographic Projection</b> (\"orthogonal\")</p><p>Applications: Used"
" for planetary cartography, geology and panorama photography.</p>"
msgstr ""
"<p><b>تصویر استریوگرافیک</b> («متعامد»)</p><p>کاربردها: در نقشه‌نگاری "
"سیاره‌ای، زمین‌شناسی و عکاسی سراسرنما (پانوراما) استفاده می‌شود.</p>"

#: core/utilities/geolocation/engine/projections/VerticalPerspectiveProjection.cpp:94
#, kde-format
msgid "Vertical Perspective Projection"
msgstr "تصویر پرسپکتیو عمودی"

#: core/utilities/geolocation/engine/projections/VerticalPerspectiveProjection.cpp:99
#, kde-format
msgid ""
"<p><b>Vertical Perspective Projection</b> (\"orthogonal\")</p><p> Shows the "
"earth as it appears from a relatively short distance above the surface. "
"Applications: Used for Virtual Globes.</p>"
msgstr ""
"<p><b>تصویر پرسپکتیو عمودی</b> («متعامد»)</p><p> زمین را آن‌گونه که از "
"فاصله‌ای نسبتاً کوتاه بالای سطح دیده می‌شود، نشان می‌دهد. کاربردها: برای "
"کره‌های مجازی استفاده می‌شود.</p>"

