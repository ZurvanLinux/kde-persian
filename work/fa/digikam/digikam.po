#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:153
#, kde-format
msgid "Camera time zone:"
msgstr "منطقهٔ زمانی دوربین:"

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:156
#, kde-format
msgid ""
"<p>Sets the time zone the camera was set to during photo shooting, so that "
"the time stamps of the images can be converted to GMT to match the GPS time "
"reference.</p><p>Note: positive offsets count eastwards from zero longitude "
"(GMT), they are 'ahead of time'.</p>"
msgstr ""
"<p>منطقهٔ زمانی تنظیم‌شده روی دوربین هنگام عکس‌برداری را تعیین می‌کند تا "
"برچسب‌های زمانی تصاویر بتوانند با مرجع زمانی GPS (به وقت گرینویچ - GMT) "
"مطابقت داده شوند.</p><p>نکته: اختلاف‌های زمانی مثبت به سمت شرق از نصف‌النهار"
" مبدأ (GMT) شمرده می‌شوند و «جلوتر از زمان» هستند.</p>"

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:163
#, kde-format
msgid "Offset of pictures (hh:mm:ss):"
msgstr "اختلاف زمانی تصاویر (hh:mm:ss):"

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:165
#, kde-format
msgid ""
"Sets the offset between picture times and track times. E.g. to correct wrong"
" camera clock or different time zone."
msgstr ""
"اختلاف زمانی بین زمان تصاویر و زمان ردپاها را تعیین می‌کند. مثلاً برای تصحیح"
" ساعت اشتباه دوربین یا منطقهٔ زمانی متفاوت."

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:172
#, kde-format
msgid "Set whether picture time is ahead or behind the track time."
msgstr "مشخص کنید که زمان تصویر از زمان ردپا جلوتر است یا عقب‌تر."

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:191
#, kde-format
msgid "Interpolate"
msgstr "درونیابی"

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:192
#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:203
#, kde-format
msgid "Max. time gap (hh:mm:ss):"
msgstr "حداکثر فاصلهٔ زمانی (hh:mm:ss):"

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:196
#, kde-format
msgid ""
"Sets the maximum time difference to interpolate GPX file points to image "
"time data. If the time difference exceeds this setting, no match will be "
"attempted."
msgstr ""
"حداکثر اختلاف زمانی را برای درونیابی نقاط پروندهٔ GPX با داده‌های زمانی "
"تصویر تنظیم می‌کند. اگر اختلاف زمانی از این مقدار بیشتر شود، تلاشی برای "
"تطبیق انجام نخواهد شد."

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:202
#, kde-format
msgid "Match directly"
msgstr "تطبیق مستقیم"

#: core/utilities/geolocation/geoiface/correlator/gpscorrelatorwidget.cpp:207
#, kde-format
msgid ""
"Sets the maximum time difference from a GPS track point to the image time to"
" be matched. If the time difference exceeds this setting, no match will be "
