#, kde-format
msgid "<b>Power</b>: How strong the effect is applied."
msgstr "<b>شدت</b>: میزان اعمال جلوه."

#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:187
#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:218
#: core/libs/dimg/filters/lc/localcontrastsettings.cpp:249
