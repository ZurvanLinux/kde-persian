#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:378
#, kde-format
msgid "YOLOv11 Nano"
msgstr "YOLOv11 Nano"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:380
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p><b>YOLOv11 Nano</b>: small, lightweight neural network offering "
"exceptional speed, but may miss identifying more objects in images. YOLO can"
" detect multiple objects in an image. It is trained to recognize 80 "
"different objects using the COCO dataset.</p>"
msgstr ""
"<p><b>YOLOv11 Nano</b>: یک شبکه عصبی کوچک و سبک که سرعت فوق‌العاده‌ای ارائه "
"می‌دهد، اما ممکن است اشیاء بیشتری را در تصاویر تشخیص ندهد. YOLO می‌تواند "
"چندین شیء را در یک تصویر شناسایی کند. این مدل برای شناسایی ۸۰ شیء مختلف با "
"استفاده از مجموعه‌داده COCO آموزش دیده است.</p>"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:385
#, kde-format
msgid "YOLOv11 XLarge"
msgstr "YOLOv11 XLarge"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:387
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p><b>YOLOv11 XLarge</b>: large, robust neural network offering good "
"accuracy. It will detect more objects in images than YOLOv11 Nano, but is "
"slower. YOLO can detect multiple objects in an image. It is trained to "
"recognize 80 different objects using the COCO dataset.</p>"
msgstr ""
"<p><b>YOLOv11 XLarge</b>: یک شبکه عصبی بزرگ و قدرتمند که دقت خوبی ارائه "
"می‌دهد. این مدل نسبت به YOLOv11 Nano اشیاء بیشتری را در تصاویر تشخیص می‌دهد،"
" اما کندتر است. YOLO می‌تواند چندین شیء را در یک تصویر شناسایی کند. این مدل "
"برای شناسایی ۸۰ شیء مختلف با استفاده از مجموعه‌داده COCO آموزش دیده است.</p>"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:392
#, kde-format
msgid "EfficientNet B7"
msgstr "EfficientNet B7"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:394
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p><b>EfficientNet B7</b>: large and powerful convoluted neural network. It "
"will detect a single object in an image with high accuracy. EfficientNet B7 "
"was trained to recognize 1,000 different objects using the ImageNet "
"dataset.</p>"
msgstr ""
"<p><b>EfficientNet B7</b>: یک شبکه عصبی پیچشی بزرگ و قدرتمند. این مدل یک شیء"
" واحد را در تصویر با دقت بالایی تشخیص می‌دهد. EfficientNet B7 برای شناسایی "
"۱٬۰۰۰ شیء مختلف با استفاده از مجموعه‌داده ImageNet آموزش دیده است.</p>"

