#: core/libs/rawengine/drawdecoderwidget.cpp:179
#, kde-format
msgctxt "@option:check"
msgid "16 bits color depth"
msgstr "عمق رنگ ۱۶ بیتی"

#: core/libs/rawengine/drawdecoderwidget.cpp:180
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>If enabled, all RAW files will be decoded in 16-bit color depth using "
"a linear gamma curve. To prevent dark picture rendering in the editor, it is"
" recommended to use Color Management in this mode.</para><para>If disabled, "
"all RAW files will be decoded in 8-bit color depth with a BT.709 gamma curve"
" and a 99th-percentile white point. This mode is faster than 16-bit "
"decoding.</para>"
msgstr ""
"<para>در صورت فعال بودن، تمام پرونده‌های RAW با عمق رنگ ۱۶ بیتی و با استفاده"
" از منحنی گامای خطی رمزگشایی می‌شوند. برای جلوگیری از رندر تیرهٔ تصویر در "
"ویرایشگر، توصیه می‌شود در این حالت از مدیریت رنگ استفاده "
"کنید.</para><para>در صورت غیرفعال بودن، تمام پرونده‌های RAW با عمق رنگ ۸ "
"بیتی با منحنی گامای BT.709 و نقطهٔ سفید صدک ۹۹ رمزگشایی می‌شوند. این حالت "
"سریع‌تر از رمزگشایی ۱۶ بیتی است.</para>"

#: core/libs/rawengine/drawdecoderwidget.cpp:199
#, kde-format
msgctxt "@option:check"
msgid "Interpolate RGB as four colors"
msgstr "درون‌یابی RGB به‌عنوان چهار رنگ"

#: core/libs/rawengine/drawdecoderwidget.cpp:200
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Interpolate RGB as four colors</title><para>The default is to assume "
"that all green pixels are the same. If even-row green pixels are more "
"sensitive to ultraviolet light than odd-row this difference causes a mesh "
"pattern in the output; using this option solves this problem with minimal "
"loss of detail.</para><para>To resume, this option blurs the image a little,"
" but it eliminates false 2x2 mesh patterns with VNG quality method or mazes "
"with AHD quality method.</para>"
msgstr ""
"<title>درون‌یابی RGB به‌عنوان چهار رنگ</title><para>حالت پیش‌فرض بر این فرض "
"است که همهٔ پیکسل‌های سبز یکسان هستند. اگر پیکسل‌های سبز ردیف‌های زوج نسبت "
"به ردیف‌های فرد به نور فرابنفش حساس‌تر باشند، این تفاوت باعث ایجاد الگوی "
"شبکه‌ای در خروجی می‌شود؛ استفاده از این گزینه این مشکل را با کمترین افت "
"جزئیات حل می‌کند.</para><para>به‌طور خلاصه، این گزینه تصویر را کمی محو "
"می‌کند، اما الگوهای شبکه‌ای کاذب ۲×۲ را در روش کیفی VNG یا الگوهای ماز را در"
" روش کیفی AHD از بین می‌برد.</para>"

#: core/libs/rawengine/drawdecoderwidget.cpp:214
#, kde-format
msgctxt "@info:tooltip"
msgid "Visit LibRaw project website"
msgstr "بازدید از وبگاه پروژهٔ LibRaw"

#: core/libs/rawengine/drawdecoderwidget.cpp:224
#, kde-format
msgctxt "@option:check"
msgid "Do not stretch or rotate pixels"
msgstr "پیکسل‌ها کشیده یا چرخانده نشوند"

#: core/libs/rawengine/drawdecoderwidget.cpp:226
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Do not stretch or rotate pixels</title><para>For Fuji Super CCD "
"cameras, show the image tilted 45 degrees. For cameras with non-square "
"pixels, do not stretch the image to its correct aspect ratio. In any case, "
"this option guarantees that each output pixel corresponds to one RAW "
"pixel.</para>"
msgstr ""
"<title>پیکسل‌ها کشیده یا چرخانده نشوند</title><para>برای دوربین‌های فوجی "
"Super CCD، تصویر را با چرخش ۴۵ درجه نشان دهید. برای دوربین‌هایی با پیکسل‌های"
" غیرمربعی، تصویر را به نسبت ابعاد صحیح آن نکشید. در هر صورت، این گزینه تضمین"
" می‌کند که هر پیکسل خروجی دقیقاً با یک پیکسل RAW مطابقت دارد.</para>"

