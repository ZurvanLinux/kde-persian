#, kde-format
msgid "Compute the sum of all values"
msgstr "محاسبهٔ مجموع همهٔ مقادیر"

#. i18n: ectx: (Loaded from Descriptive Statistics) <settings> <setting>
#. (refers to element labelled "prod")
#: rkward/plugins/descriptive/descriptive_statistics.rkh:37
