msgstr "پیراستن میانگین. مشاهده کنید: <link href=\"rkward://rhelp/mean\"/>"

#. i18n: ectx: (Loaded from Descriptive Statistics) <settings> <setting>
#. (refers to element labelled "Geometric mean")
#: rkward/plugins/descriptive/descriptive_statistics.rkh:26
#, kde-format
msgid "Should the geometric mean value be computed?"
msgstr "آیا مقدار میانگین هندسی محاسبه شود؟"

#. i18n: ectx: (Loaded from Descriptive Statistics) <settings> <setting>
#. (refers to element labelled "Interquantile mean")
#: rkward/plugins/descriptive/descriptive_statistics.rkh:27
#, kde-format
msgid "Should the interquantile mean value be computed?"
msgstr "آیا مقدار میانگین بین چندکی محاسبه شود؟"

#. i18n: ectx: (Loaded from Descriptive Statistics) <settings> <setting>
#. (refers to element labelled "Standard deviation")
#: rkward/plugins/descriptive/descriptive_statistics.rkh:28
#, kde-format
