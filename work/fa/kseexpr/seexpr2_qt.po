#: KSeExpr/ExprBuiltins.cpp:260
msgctxt "builtin|"
msgid ""
"color  hsi(color x, float h, float s, float i, float map=1)\n"
"The hsi function shifts the hue by h\n"
"(in degrees) and scales the saturation and intensity by s and i\n"
"respectively.&nbsp; A map may be supplied which will control the shift\n"
"- the full shift will happen when the map is one and no shift will\n"
"happen when the map is zero.&nbsp; The shift will be scaled back for\n"
"values between zero and one."
msgstr ""
"color  hsi(color x, float h, float s, float i, float map=1)\n"
"تابع hsi فام (hue) را به اندازه h (بر حسب درجه) تغییر می‌دهد\n"
"و غلظت رنگ (saturation) و شدت (intensity) را به ترتیب با مقادیر s و i مقیاس‌بندی می‌کند.&nbsp; می‌توان نقشه‌ای تعیین کرد که این تغییر را کنترل کند\n"
"- تغییر کامل زمانی رخ می‌دهد که نقشه یک باشد و در صورت صفر بودن نقشه،\n"
"هیچ تغییری اعمال نمی‌شود.&nbsp; برای مقادیر بین صفر و یک، میزان تغییر کاهش می‌یابد."

#: KSeExpr/ExprBuiltins.cpp:306
msgctxt "builtin|"
msgid ""
"color midhsi(color x, float h, float s, float i, float map, float falloff=1, int interp=0)\n"
"The midhsi function is just like the hsi function except that\n"
"the control map is centered around the mid point (value of 0.5)\n"
"and can scale the shift in both directions."
msgstr ""
"color midhsi(color x, float h, float s, float i, float map, float falloff=1, int interp=0)\n"
"تابع midhsi دقیقاً مانند تابع hsi است، با این تفاوت که\n"
"نقشه کنترل در نقطه میانی (مقدار 0.5) متمرکز است\n"
"و می‌تواند تغییر را در هر دو جهت مقیاس‌بندی کند."

#: KSeExpr/ExprBuiltins.cpp:358
msgctxt "builtin|"
msgid ""
"color rgbtohsl(color rgb)\n"
"RGB to HSL color space conversion.\n"
"HSL is Hue, Saturation, Lightness (all in range [0..1] )\n"
"These functions have also been extended to support rgb and hsl values\n"
"outside of the range [0..1] in a reasonable way.&nbsp; For any rgb or\n"
"hsl value (except for negative s values), the conversion is\n"
"well-defined and reversible."
msgstr ""
"color rgbtohsl(color rgb)\n"
"تبدیل فضای رنگی RGB به HSL.\n"
"‏HSL مخفف فام (Hue)، غلظت (Saturation) و روشنایی (Lightness) است (همگی در بازه [0..1] )\n"
"این توابع همچنین گسترش یافته‌اند تا از مقادیر rgb و hsl خارج از بازه [0..1] به شیوه‌ای منطقی پشتیبانی کنند.&nbsp; برای هر مقدار rgb یا hsl (به‌جز مقادیر منفی s)، تبدیل کاملاً تعریف‌شده و برگشت‌پذیر است."

#: KSeExpr/ExprBuiltins.cpp:413
msgctxt "builtin|"
msgid ""
"color hsltorgb(color hsl)\n"
"HSL to RGB color space conversion.\n"
"HSL is Hue, Saturation, Lightness (all in range [0..1] )\n"
"These functions have also been extended to support rgb and hsl values\n"
"outside of the range [0..1] in a reasonable way.&nbsp; For any rgb or\n"
"hsl value (except for negative s values), the conversion is\n"
"well-defined and reversible."
msgstr ""
"color hsltorgb(color hsl)\n"
"تبدیل فضای رنگی HSL به RGB.\n"
"‏HSL مخفف فام (Hue)، غلظت (Saturation) و روشنایی (Lightness) است (همگی در بازه [0..1] )\n"
"این توابع همچنین گسترش یافته‌اند تا از مقادیر rgb و hsl خارج از بازه [0..1] به شیوه‌ای منطقی پشتیبانی کنند.&nbsp; برای هر مقدار rgb یا hsl (به‌جز مقادیر منفی s)، تبدیل کاملاً تعریف‌شده و برگشت‌پذیر است."

#: KSeExpr/ExprBuiltins.cpp:441
msgctxt "builtin|"
msgid ""
"color saturate(color val, float amt)\n"
"Scale saturation of color by amt.\n"
"The color is scaled around the rec709 luminance value,\n"
"and negative results are clamped at zero.\n"
msgstr ""
"color saturate(color val, float amt)\n"
"مقیاس‌بندی غلظت رنگ به میزان amt.\n"
"رنگ حول مقدار درخشندگی rec709 مقیاس‌بندی می‌شود\n"
"و نتایج منفی روی صفر محدود می‌شوند (clamp).\n"

#: KSeExpr/ExprBuiltins.cpp:499
msgctxt "builtin|"
msgid ""
"float rand ( [float min, float max], [float seed] )\n"
"Random number between [min, max] (or [0, 1] if unspecified).\n"
"If a seed is supplied, it will be used in addition to the internal seeds and may be used to create multiple distinct generators."
msgstr ""
"float rand ( [float min, float max], [float seed] )\n"
"عدد تصادفی بین [min, max] (یا [0, 1] در صورت مشخص نشدن).\n"
"در صورت ارائه seed، علاوه بر سیدهای داخلی استفاده می‌شود و می‌توان از آن برای ایجاد چندین مولد مجزا بهره برد."

#: KSeExpr/ExprBuiltins.cpp:553
msgctxt "builtin|"
msgid ""
"float hash(float seed1,[float seed2, ...])\n"
"Like rand, but with no internal seeds. Any number of seeds may be given\n"
"and the result will be a random function based on all the seeds."
msgstr ""
"float hash(float seed1,[float seed2, ...])\n"
"مانند rand، اما بدون هیچ سید داخلی. هر تعداد سید را می‌توان تعیین کرد\n"
"و نتیجه یک تابع تصادفی بر اساس تمام سیدها خواهد بود."

#: KSeExpr/ExprBuiltins.cpp:596
msgctxt "builtin|"
msgid ""
"float noise ( vector v )\n"
"float noise ( float x, float y )\n"
"float noise ( float x, float y, float z )\n"
"float noise ( float x, float y, float z, float w )\n"
"Original perlin noise at location (C2 interpolant)"
msgstr ""
"float noise ( vector v )\n"
"float noise ( float x, float y )\n"
"float noise ( float x, float y, float z )\n"
"float noise ( float x, float y, float z, float w )\n"
"نویز پرلین اصلی در موقعیت (درون‌یابی C2)"

#: KSeExpr/ExprBuiltins.cpp:610
msgctxt "builtin|"
msgid ""
"float snoise ( vector v)\n"
"signed noise w/ range -1 to 1 formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"float snoise ( vector v)\n"
"نویز علامت‌دار با بازهٔ ‎-1 تا 1 تشکیل‌شده با نویز پرلین اصلی در موقعیت (درون‌یابی C2)"

#: KSeExpr/ExprBuiltins.cpp:621
msgctxt "builtin|"
msgid ""
"vector vnoise ( vector v)\n"
"vector noise formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"vector vnoise ( vector v)\n"
"نویز برداری تشکیل‌شده با نویز پرلین اصلی در موقعیت (درون‌یابی C2)"

#: KSeExpr/ExprBuiltins.cpp:629
msgctxt "builtin|"
msgid ""
"color cnoise ( vector v)\n"
"color noise formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"color cnoise ( vector v)\n"
"نویز رنگ تشکیل‌شده با نویز پرلین اصلی در موقعیت (درون‌یابی C2)"

#: KSeExpr/ExprBuiltins.cpp:640
msgctxt "builtin|"
msgid ""
"float snoise4 ( vector v,float t)\n"
"4D signed noise w/ range -1 to 1 formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"float snoise4 ( vector v,float t)\n"
"نویز علامت‌دار چهاربعدی با بازهٔ ‎-1 تا 1 تشکیل‌شده با نویز پرلین اصلی در موقعیت (درون‌یابی C2)"

#: KSeExpr/ExprBuiltins.cpp:651
msgctxt "builtin|"
msgid ""
"vector vnoise4 ( vector v,float t)\n"
"4D vector noise formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"vector vnoise4 ( vector v,float t)\n"
"نویز برداری چهاربعدی تشکیل‌شده با نویز پرلین اصلی در موقعیت (درون‌یابی C2)"

#: KSeExpr/ExprBuiltins.cpp:659
msgctxt "builtin|"
msgid ""
"color cnoise4 ( vector v,float t)\n"
"4D color noise formed with original perlin noise at location (C2 interpolant)"
msgstr ""
"color cnoise4 ( vector v,float t)\n"
"نویز رنگ چهاربعدی تشکیل‌شده با نویز پرلین اصلی در موقعیت (درون‌یابی C2)"

#: KSeExpr/ExprBuiltins.cpp:751
msgctxt "builtin|"
msgid ""
"float fbm(vector v,int octaves=6,float lacunarity=2,float gain=.5)\n"
"fbm (Fractal Brownian Motion) is a multi-frequency noise function. \n"
"The base frequency is the same as the \"noise\" function. The total number of frequencies is controlled by octaves. The lacunarity is the spacing between the frequencies - a value of 2 means each octave is twice the previous frequency. The gain controls how much each frequency is scaled relative to the previous frequency."
msgstr ""
"float fbm(vector v,int octaves=6,float lacunarity=2,float gain=.5)\n"
"تابع fbm (حرکت براونی فراکتالی) یک تابع نویز چندفرکانسی است.\n"
"فرکانس پایه همانند تابع \"noise\" است. تعداد کل فرکانس‌ها توسط octaves کنترل می‌شود. پارامتر lacunarity فاصلهٔ بین فرکانس‌ها است - مقدار 2 به این معنی است که هر اکتاو دو برابر فرکانس قبلی است. پارامتر gain مقیاس هر فرکانس را نسبت به فرکانس قبلی کنترل می‌کند."

#: KSeExpr/ExprBuiltins.cpp:787
msgctxt "builtin|"
msgid "vector vfbm(vector vint octaves=6,float lacunarity=2,float gain=.5)"
msgstr "vector vfbm(vector vint octaves=6,float lacunarity=2,float gain=.5)"

#: KSeExpr/ExprBuiltins.cpp:820
msgctxt "builtin|"
msgid ""
"float fbm4(vector v,float time,int octaves=6,float lacunarity=2,float gain=.5)\n"
"fbm (Fractal Brownian Motion) is a multi-frequency noise function. \n"
"The base frequency is the same as the \"noise\" function. The total \n"
"number of frequencies is controlled by octaves. The lacunarity is the \n"
"spacing between the frequencies - a value of 2 means each octave is \n"
"twice the previous frequency. The gain controls how much each \n"
"frequency is scaled relative to the previous frequency."
msgstr ""
"float fbm4(vector v,float time,int octaves=6,float lacunarity=2,float gain=.5)\n"
"تابع fbm (حرکت براونی فراکتالی) یک تابع نویز چندفرکانسی است.\n"
"فرکانس پایه همانند تابع \"noise\" است. تعداد کل فرکانس‌ها توسط octaves کنترل می‌شود. پارامتر lacunarity فاصلهٔ بین فرکانس‌ها است - مقدار 2 به این معنی است که هر اکتاو دو برابر فرکانس قبلی است. پارامتر gain مقیاس هر فرکانس را نسبت به فرکانس قبلی کنترل می‌کند."

#: KSeExpr/ExprBuiltins.cpp:860
msgctxt "builtin|"
msgid ""
"vector vfbm4(vector v,float time,int octaves=6,float lacunarity=2,float "
"gain=.5)"
msgstr ""
"vector vfbm4(vector v,float time,int octaves=6,float lacunarity=2,float "
"gain=.5)"

#: KSeExpr/ExprBuiltins.cpp:866
msgctxt "builtin|"
msgid "color cfbm(vector vint octaves=6,float lacunarity=2,float gain=.5)"
msgstr "color cfbm(vector vint octaves=6,float lacunarity=2,float gain=.5)"

#: KSeExpr/ExprBuiltins.cpp:872
msgctxt "builtin|"
msgid ""
"color cfbm4(vector v,float time,int octaves=6,float lacunarity=2,float "
"gain=.5)"
msgstr ""
"color cfbm4(vector v,float time,int octaves=6,float lacunarity=2,float "
"gain=.5)"

#: KSeExpr/ExprBuiltins.cpp:881
msgctxt "builtin|"
msgid ""
"float cellnoise(vector v)\n"
"cellnoise generates a field of constant colored cubes based on the integer location.\n"
"This is the same as the prman cellnoise function."
msgstr ""
"float cellnoise(vector v)\n"
"تابع cellnoise میدانی از مکعب‌های رنگی ثابت را بر اساس موقعیت صحیح (integer) تولید می‌کند.\n"
"این تابع مشابه تابع cellnoise در prman است."

#: KSeExpr/ExprBuiltins.cpp:893
msgctxt "builtin|"
msgid ""
"color cellnoise(vector v)\n"
"cellnoise generates a field of constant colored cubes based on the integer location.\n"
"This is the same as the prman cellnoise function."
msgstr ""
"color cellnoise(vector v)\n"
"تابع cellnoise میدانی از مکعب‌های رنگی ثابت را بر اساس موقعیت صحیح (integer) تولید می‌کند.\n"
"این تابع مشابه تابع cellnoise در prman است."

#: KSeExpr/ExprBuiltins.cpp:906
msgctxt "builtin|"
msgid ""
"float pnoise ( vector v, vector period )\n"
"periodic noise"
msgstr ""
"float pnoise ( vector v, vector period )\n"
"نویز دوره‌ای"

#: KSeExpr/ExprBuiltins.cpp:1050
msgctxt "builtin|"
msgid ""
"float voronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"voronoi is a cellular noise pattern. It is a jittered variant of cellnoise."
msgstr ""
"float voronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"ورونوی یک الگوی نویز سلولی است. این یک گونه با لرزش (jittered) از cellnoise است."

#: KSeExpr/ExprBuiltins.cpp:1126
msgctxt "builtin|"
msgid ""
"color cvoronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"returns color in cellular pattern. It is a jittered variant of cellnoise."
msgstr ""
"color cvoronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"رنگ را در الگوی سلولی بازمی‌گرداند. این یک گونه با لرزش (jittered) از cellnoise است."

#: KSeExpr/ExprBuiltins.cpp:1175
msgctxt "builtin|"
msgid ""
"color pvoronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"returns center of voronoi cell."
msgstr ""
"color pvoronoi(vector v, int type=1,float jitter=0.5, float fbmScale=0, int fbmOctaves=4,float fbmLacunarity=2, float fbmGain=.5)\n"
"مرکز سلول ورونوی را بازمی‌گرداند."

#: KSeExpr/ExprBuiltins.cpp:1238
msgctxt "builtin|"
msgid ""
"float dist(vector a, vector b)\n"
"distance between two points"
msgstr ""
"float dist(vector a, vector b)\n"
"فاصله بین دو نقطه"

#: KSeExpr/ExprBuiltins.cpp:1246
msgctxt "builtin|"
msgid ""
"float length(vector v)\n"
"length of vector"
msgstr ""
"float length(vector v)\n"
"طول بردار"

#: KSeExpr/ExprBuiltins.cpp:1254
msgctxt "builtin|"
msgid ""
"float hypot(vector v)\n"
"length of 2d vector [x,y]"
msgstr ""
"float hypot(vector v)\n"
"طول بردار دوبعدی [x,y]"

#: KSeExpr/ExprBuiltins.cpp:1262
msgctxt "builtin|"
msgid ""
"float dot(vector a,vector b)\n"
"vector dot product"
msgstr ""
"float dot(vector a,vector b)\n"
"ضرب داخلی بردارها"

#: KSeExpr/ExprBuiltins.cpp:1274
msgctxt "builtin|"
msgid ""
"vector norm(vector v)\n"
"vector scaled to unit length"
msgstr ""
"vector norm(vector v)\n"
"بردار مقیاس‌شده به طول واحد"

#: KSeExpr/ExprBuiltins.cpp:1282
msgctxt "builtin|"
msgid ""
"vector cross(vector a,vector b)\n"
"vector cross product"
msgstr ""
"vector cross(vector a,vector b)\n"
"ضرب خارجی بردارها"

#: KSeExpr/ExprBuiltins.cpp:1293
msgctxt "builtin|"
msgid ""
"float angle(vector a,vector b)\n"
"angle between two vectors (in radians)"
msgstr ""
"float angle(vector a,vector b)\n"
"زاویه بین دو بردار (برحسب رادیان)"

#: KSeExpr/ExprBuiltins.cpp:1301
msgctxt "builtin|"
msgid ""
"vector angle(vector a,vector b)\n"
"normalized vector orthogonal to a and b scaled to unit length"
msgstr ""
"vector angle(vector a,vector b)\n"
"بردار نرمال‌شدهٔ عمود بر a و b که به طول واحد مقیاس شده است"

#: KSeExpr/ExprBuiltins.cpp:1317
msgctxt "builtin|"
msgid ""
"vector rotate(vector v,vector axis,float angle)\n"
"rotates v around axis by given angle (in radians)"
msgstr ""
"vector rotate(vector v,vector axis,float angle)\n"
"بردار v را به اندازه زاویه مشخص‌شده (برحسب رادیان) حول axis می‌چرخاند"

#: KSeExpr/ExprBuiltins.cpp:1327
msgctxt "builtin|"
msgid ""
"vector up(vector P,vector upvec)\n"
"rotates v such that the Y axis points in the given up direction"
msgstr ""
"vector up(vector P,vector upvec)\n"
"بردار v را طوری می‌چرخاند که محور Y به سمت جهت بالای مشخص‌شده باشد"

#: KSeExpr/ExprBuiltins.cpp:1343
msgctxt "builtin|"
msgid ""
"int cycle(int index, int loRange, int hiRange )\n"
"Cycles through values between loRange and hiRange based on supplied index.\n"
"This is an offset \"mod\" function. The result is computed as ``loRange + value % (hiRange-loRange+1)``."
msgstr ""
"int cycle(int index, int loRange, int hiRange )\n"
"بر اساس اندیس ارائه‌شده بین مقادیر loRange و hiRange گردش می‌کند.\n"
"این یک تابع «mod» با افست است. نتیجه به صورت ``loRange + value % (hiRange-loRange+1)`` محاسبه می‌شود."

#: KSeExpr/ExprBuiltins.cpp:1405
msgctxt "builtin|"
msgid ""
"int pick(float index, int loRange, int hiRange, [float weights, ...] )\n"
"Picks values randomly between loRange and hiRange based on supplied index (which is\n"
"automatically hashed).&nbsp; The values will be distributed according\n"
"to the supplied weights.&nbsp; Any weights not supplied are assumed to\n"
"be 1.0."
msgstr ""
"int pick(float index, int loRange, int hiRange, [float weights, ...] )\n"
"بر اساس نمایهٔ ارائه‌شده (که به‌طور خودکار هش می‌شود)، مقادیری را به‌صورت تصادفی بین loRange و hiRange انتخاب می‌کند.&nbsp; مقادیر طبق وزن‌های ارائه‌شده توزیع خواهند شد.&nbsp; هر وزنی که ارائه نشود، ۱٫۰ فرض می‌شود."

#: KSeExpr/ExprBuiltins.cpp:1416
msgctxt "builtin|"
msgid ""
"color swatch(float index, color choice0, color choice1, color choice2, [...])\n"
"Chooses one of the supplied color choices based on the index (assumed to be in range [0..1])."
msgstr ""
"color swatch(float index, color choice0, color choice1, color choice2, [...])\n"
"یکی از گزینه‌های رنگ ارائه‌شده را بر اساس نمایه (که فرض می‌شود در بازهٔ [0..1] باشد) انتخاب می‌کند."

#: KSeExpr/ExprBuiltins.cpp:1431
msgctxt "builtin|"
msgid ""
"float choose(float index,float choice1, float choice2, [...])\n"
"Chooses one of the supplied choices based on the index (assumed to be in range [0, 1])."
msgstr ""
"float choose(float index,float choice1, float choice2, [...])\n"
"یکی از گزینه‌های ارائه‌شده را بر اساس نمایه (که فرض می‌شود در بازهٔ [0, 1] باشد) انتخاب می‌کند."

#: KSeExpr/ExprBuiltins.cpp:1487
msgctxt "builtin|"
msgid ""
"float wchoose(float index,float choice1, float weight1, float choice2, float weight2, [...] )\n"
"Chooses one of the supplied choices based on the index (assumed to be in range [0..1]).\n"
"The values will be distributed according to the supplied weights."
msgstr ""
"float wchoose(float index,float choice1, float weight1, float choice2, float weight2, [...] )\n"
"یکی از گزینه‌های ارائه‌شده را بر اساس نمایه (که فرض می‌شود در بازهٔ [0..1] باشد) انتخاب می‌کند.\n"
"مقادیر طبق وزن‌های ارائه‌شده توزیع خواهند شد."

#: KSeExpr/ExprBuiltins.cpp:1509
msgctxt "builtin|"
msgid ""
"float spline(float param,float y1,float y2,float y3,float y4,[...])\n"
"\n"
"Interpolates a set of values to the parameter specified where y1, ..., yn are\n"
"distributed evenly from [0..1]"
msgstr ""
"float spline(float param,float y1,float y2,float y3,float y4,[...])\n"
"\n"
"مجموعه‌ای از مقادیر را برای پارامتر مشخص‌شده درون‌یابی می‌کند، به‌طوری‌که y1، ...، yn به‌طور یکنواخت در بازهٔ [0..1] توزیع شده‌اند."

#: KSeExpr/ExprBuiltins.cpp:1550 KSeExpr/ExprBuiltins.cpp:1615
msgctxt "builtin|"
msgid "Unable to validate the interpolant type"
msgstr "امکان اعتبارسنجی نوع متغیر درون‌یاب وجود ندارد"

#: KSeExpr/ExprBuiltins.cpp:1554 KSeExpr/ExprBuiltins.cpp:1618
msgctxt "builtin|"
msgid "Invalid interpolant type"
msgstr "نوع متغیر درون‌یاب نامعتبر است"

#: KSeExpr/ExprBuiltins.cpp:1588
msgctxt "builtin|"
msgid ""
"float curve(float param,float pos0,float val0,int interp0,float pos1,float val1,int interp1,[...])\n"
"\n"
"Interpolates a 1D ramp defined by control points at 'param'. Control points are specified \n"
"by triples of parameters pos_i, val_i, and interp_i. Interpolation codes are \n"
"0 - none, 1 - linear, 2 - smooth, 3 - spline, \n"
"4 - monotone (non oscillating spline)"
msgstr ""
"float curve(float param,float pos0,float val0,int interp0,float pos1,float val1,int interp1,[...])\n"
"\n"
"یک شیب یک‌بعدی تعریف‌شده با نقاط کنترلی را در «param» درون‌یابی می‌کند. نقاط کنترلی با سه‌گانه‌های پارامتر pos_i، val_i و interp_i مشخص می‌شوند. کدهای درون‌یابی عبارتند از:\n"
"0 - هیچ، 1 - خطی، 2 - هموار، 3 - اسپلاین،\n"
"4 - یکنوا (اسپلاین بدون نوسان)"

#: KSeExpr/ExprBuiltins.cpp:1660
msgctxt "builtin|"
msgid ""
"color curve(float param,float pos0,color val0,int interp0,float pos1,color val1,int interp1,[...])\n"
"\n"
"Interpolates color ramp given by control points at 'param'. Control points are specified \n"
"by triples of parameters pos_i, val_i, and interp_i. Interpolation codes are \n"
"0 - none, 1 - linear, 2 - smooth, 3 - spline, \n"
"4 - monotone (non oscillating spline)"
msgstr ""
"color curve(float param,float pos0,color val0,int interp0,float pos1,color val1,int interp1,[...])\n"
"\n"
"طیف رنگ ارائه‌شده توسط نقاط کنترلی را در «param» درون‌یابی می‌کند. نقاط کنترلی با سه‌گانه‌های پارامتر pos_i، val_i و interp_i مشخص می‌شوند. کدهای درون‌یابی عبارتند از:\n"
"0 - هیچ، 1 - خطی، 2 - هموار، 3 - اسپلاین،\n"
"4 - یکنوا (اسپلاین بدون نوسان)"

#: KSeExpr/ExprBuiltins.cpp:1732
msgctxt "builtin|"
msgid ""
"getVar(string varName,vector defaultValue)\n"
"return value of varName if variable exists, otherwise return defaultValue"
msgstr ""
"getVar(string varName,vector defaultValue)\n"
"در صورت وجود متغیر، مقدار varName را برمی‌گرداند؛ در غیر این صورت defaultValue را برمی‌گرداند"

#: KSeExpr/ExprBuiltins.cpp:1879
msgctxt "builtin|"
msgid ""
"float printf(string format,[vec0, vec1,  ...])\n"
"Prints out a string to STDOUT, Format parameters allowed are \"%v\" and \"%f\".\n"
"Return parameter is empty, but must be assigned to a variable."
msgstr ""
"float printf(string format,[vec0, vec1,  ...])\n"
"یک رشته را در STDOUT چاپ می‌کند، پارامترهای مجاز قالب «%v» و «%f» هستند.\n"
"پارامتر بازگشتی خالی است، اما باید به یک متغیر اختصاص داده شود."

#: KSeExpr/ExprBuiltins.cpp:1992
msgctxt "builtin|"
msgid ""
"sprintf(string format, [double|string, double|string, ...])\n"
"Returns a string formatted from the given values.  See 'man sprintf' for format details."
msgstr ""
"sprintf(string format, [double|string, double|string, ...])\n"
"رشته‌ای قالب‌بندی‌شده از مقادیر ارائه‌شده را بازمی‌گرداند. برای جزئیات قالب «man sprintf» را ببینید."

#: KSeExprUI/ECMQmLoader-seexpr2_qt.cpp:62
#: KSeExprUI/ECMQmLoader-seexpr2_qt.cpp:122
#: KSeExprUI/ExprControlCollection.cpp:27
msgctxt "ExprControlCollection|"
msgid "Add new variable"
msgstr "افزودن متغیر جدید"

#: KSeExprUI/ErrorMessages.cpp:15
msgctxt "ErrorMessages|"
msgid "Expected string or float[d]"
msgstr "رشته یا float[d] مورد انتظار بود"

#: KSeExprUI/ErrorMessages.cpp:17
msgctxt "ErrorMessages|"
msgid "Expected float[d]"
