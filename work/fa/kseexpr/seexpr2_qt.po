#: KSeExpr/ExprBuiltins.cpp:113
msgctxt "builtin|"
msgid ""
"float bias(float x, float g)\n"
"Variation of gamma where values less than 0.5 pull the curve down\n"
"and values greater than 0.5 pull the curve up\n"
"pow(x,log(b)/log(0.5))"
msgstr ""
"float bias(float x, float g)\n"
"نوعی از گاما که در آن مقادیر کمتر از 0.5 منحنی را به پایین می‌کشند\n"
"و مقادیر بزرگتر از 0.5 منحنی را به بالا می‌کشند\n"
"pow(x,log(b)/log(0.5))"

#: KSeExpr/ExprBuiltins.cpp:124
msgctxt "builtin|"
msgid ""
"float contrast(float x, float c)\n"
"Adjust the contrast.&nbsp; For c from 0 to 0.5, the contrast is decreased.&nbsp; For c &gt; 0.5, the contrast is increased."
msgstr ""
"float contrast(float x, float c)\n"
"کنتراست را تنظیم می‌کند.&nbsp; برای c از 0 تا 0.5، کنتراست کاهش می‌یابد.&nbsp; برای c &gt; 0.5، کنتراست افزایش می‌یابد."

#: KSeExpr/ExprBuiltins.cpp:132
msgctxt "builtin|"
msgid ""
"float boxstep(float x,float a)\n"
" if x < a then 0 otherwise 1"
msgstr ""
"float boxstep(float x,float a)\n"
