#: job.cpp:60
#, kde-format
msgid "Service not available"
msgstr "سرویس در دسترس نیست"

#: job.cpp:62
#, kde-format
msgid "Mailbox unavailable. The server said: %1"
msgstr "صندوق پستی در دسترس نیست. پیام سرور: %1"

#: job.cpp:64
#, kde-format
msgid "Insufficient storage space on server. The server said: %1"
msgstr "فضای ذخیره‌سازی سرور کافی نیست. پیام سرور: %1"

#: job.cpp:66
#, kde-format
msgid "Server error: %1"
msgstr "خطای سرور: %1"

#: job.cpp:75
#, kde-format
msgid "Connection to server lost."
msgstr "اتصال به سرور قطع شد."

#: loginjob.cpp:78
#, kde-format
msgid "Login"
msgstr "ورود"

#: loginjob.cpp:169
#, kde-format
msgid ""
"Could not authenticate to the SMTP server because no matching authentication"
" method has been found"
msgstr ""
"امکان احراز هویت در سرور SMTP وجود ندارد زیرا هیچ روش احراز هویت منطبقی یافت"
" نشد"

#: loginjob.cpp:228
#, kde-format
msgid "Token expired"
msgstr "توکن منقضی شده است"

#: loginjob.cpp:272
#, kde-format
msgid "Login failed, cannot initialize the SASL library"
msgstr "ورود ناموفق بود، امکان مقداردهی اولیه کتابخانهٔ SASL وجود ندارد"

#: sendjob.cpp:58
#, kde-format
msgid "SendJob"
msgstr "عملیات ارسال"

#: sendjob.cpp:107
#, kde-format
msgid ""
"Could not send the message because either the sender or recipient field is "
"missing or invalid"
msgstr ""
"امکان ارسال پیام وجود ندارد زیرا فیلد فرستنده یا گیرنده وجود ندارد یا "
"نامعتبر است"

#: sendjob.cpp:115
#, kde-format
msgid ""
"Could not send the message because it exceeds the maximum allowed size of %1"
" bytes. (Message size: %2 bytes.)"
msgstr ""
"امکان ارسال پیام وجود ندارد زیرا حجم آن از حداکثر اندازه مجاز (%1 بایت) "
"بیشتر است. (اندازه پیام: %2 بایت.)"

#: sendjob.cpp:124
#, kde-format
msgid ""
"The message requires UTF-8 email addresses, which the server does not "
"support."
msgstr ""
"پیام نیازمند نشانی‌های رایانامه UTF-8 است که توسط کارساز پشتیبانی نمی‌شود."
