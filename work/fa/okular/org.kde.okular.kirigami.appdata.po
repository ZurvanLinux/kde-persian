#. (itstool) path: component/summary
#: org.kde.okular.kirigami.appdata.xml:7
msgid "Document Viewer"
msgstr "نمایشگر سند"

#. (itstool) path: description/p
#: org.kde.okular.kirigami.appdata.xml:13
msgid ""
"Okular is a universal document viewer developed by KDE. Okular works on "
"multiple platforms, including but not limited to Linux, Windows, macOS, "
"*BSD, etc."
msgstr ""
"اوکولار یک نمایشگر سند همگانی است که توسط کی‌دی‌ای توسعه یافته است. اوکولار "
"روی بسترهای متعددی از جمله لینوکس، ویندوز، macOS، *BSD و غیره کار می‌کند."

#. (itstool) path: description/p
#: org.kde.okular.kirigami.appdata.xml:16
msgid "Features:"
msgstr "ویژگی‌ها:"

#. (itstool) path: ul/li
#: org.kde.okular.kirigami.appdata.xml:18
msgid ""
"Supported Formats: PDF, PS, Tiff, DjVu, Images, DVI, XPS, Fiction Book, "
"Comic Book, Plucker, EPub, Fax"
msgstr ""
"قالب‌های پشتیبانی‌شده: PDF، PS، Tiff، DjVu، تصاویر، DVI، XPS، Fiction Book، "
"Comic Book، Plucker، EPub، فکس"

#. (itstool) path: ul/li
