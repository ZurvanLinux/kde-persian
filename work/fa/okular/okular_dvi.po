msgstr "TexFont_PK::operator[]: نویسهٔ %1 در قلم %2 تعریف نشده است"

#: TeXFont_PK.cpp:419
#, kde-format
msgid "Unexpected %1 in PK file %2"
msgstr "‏%1 نامنتظره در پروندهٔ PK %2"

#: TeXFont_PK.cpp:485
#, kde-format
msgid "The character %1 is too large in file %2"
msgstr "نویسهٔ %1 در پروندهٔ %2 بیش از حد بزرگ است"

#: TeXFont_PK.cpp:590 TeXFont_PK.cpp:680
#, kde-format
msgid "Wrong number of bits stored:  char. %1, font %2"
