#: phabricatorjobs.cpp:59 phabricatorjobs.cpp:195
#, kde-format
msgid "Could not find the 'arc' command"
msgstr "دستور «arc» پیدا نشد"

#: phabricatorjobs.cpp:117
#, kde-format
msgid "Could not create the new \"differential diff\""
msgstr "ایجاد «تغییر تفاضلی» (differential diff) جدید ممکن نشد"

#: phabricatorjobs.cpp:154
#, kde-format
msgid "Patch upload to Phabricator failed"
msgstr "بارگذاری وصله در Phabricator ناموفق بود"

#: phabricatorjobs.cpp:206
#, kde-format
msgid "Could not get list of differential revisions in %1"
msgstr "دریافت فهرست بازبینی‌های تفاضلی در %1 ممکن نشد"

#: phabricatorplugin.cpp:41
#, kde-format
msgid "Phabricator refuses empty patchfiles"
msgstr "‏Phabricator پرونده‌های وصلهٔ خالی را نمی‌پذیرد"

#: phabricatorplugin.cpp:46 phabricatorplugin_config.qml:60
#, kde-format
msgid "unknown"
msgstr "ناشناخته"

#: phabricatorplugin.cpp:48
#, kde-format
msgid ""
"Please choose between creating a new revision or updating an existing one"
msgstr ""
"لطفاً بین ایجاد یک بازبینی جدید یا به‌روزرسانی بازبینی موجود، یکی را انتخاب "
"کنید"

#: phabricatorplugin_config.qml:28
#, kde-format
msgid "Update differential revision %1"
msgstr "به‌روزرسانی بازبینی تفاضلی %1"

#: phabricatorplugin_config.qml:30
#, kde-format
msgid "Update differential revision"
msgstr "به‌روزرسانی بازبینی تفاضلی"

#: phabricatorplugin_config.qml:33
#, kde-format
msgid "Create new \"differential diff\""
msgstr "ایجاد «تغییر تفاضلی» جدید"

#: phabricatorplugin_config.qml:35
#, kde-format
msgid "Create or update?"
msgstr "ایجاد یا به‌روزرسانی؟"

#: phabricatorplugin_config.qml:70
#, kde-format
msgid "New Diff"
msgstr "تفاوت (Diff) جدید"

#: phabricatorplugin_config.qml:71
#, kde-format
msgid ""
"tick this to create a new \"differential diff\" which can\n"
"be converted online to a new differential revision"
msgstr ""
"برای ایجاد یک «تفاوت تفاضلی» (differential diff) جدید که می‌تواند\n"
"به‌صورت آنلاین به یک بازبینی تفاضلی جدید تبدیل شود، این گزینه را علامت بزنید"

#: phabricatorplugin_config.qml:78
#, kde-format
msgid "Update Diff"
msgstr "به‌روزرسانی تفاوت (Diff)"

#: phabricatorplugin_config.qml:79
#, kde-format
msgid ""
"tick this to update an existing revision,\n"
"select one from the list below."
msgstr ""
"برای به‌روزرسانی یک بازبینی موجود، این گزینه را علامت بزنید؛\n"
"یکی از موارد را از فهرست زیر انتخاب کنید."

#: phabricatorplugin_config.qml:107
#, kde-format
msgid "Open Diff in browser"
msgstr "باز کردن تفاوت (Diff) در مرورگر"

#: phabricatorplugin_config.qml:116
#, kde-format
msgid "Summary of the update to %1:"
msgstr "خلاصهٔ به‌روزرسانی در %1:"

#: phabricatorplugin_config.qml:117
#, kde-format
msgid "Summary of the update"
msgstr "خلاصهٔ به‌روزرسانی"

#: phabricatorplugin_config.qml:126
#, kde-format
msgid "patch updated through %1 and the Purpose/Phabricator plugin"
msgstr "وصله از طریق %1 و افزونهٔ Purpose/Phabricator به‌روزرسانی شد"
