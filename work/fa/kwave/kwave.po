#. i18n: ectx: property (toolTip), widget (QSlider, slBufferSize)
#: plugins/playback/PlayBackDlg.ui:187
#, kde-format
msgid "Size of the playback buffer in bytes"
msgstr "اندازهٔ بافر پخش به بایت"

#. i18n: ectx: property (whatsThis), widget (QSlider, slBufferSize)
#: plugins/playback/PlayBackDlg.ui:190
#, kde-format
msgid ""
"<b>Buffer size:</b><p>Select a buffer size for the playback. You should set "
"this number as small as possible to reduce the playback latency. The latency"
" is the delay between user interface actions like starting/stopping "
"playback, update of the playback position and the real sound output. If you "
"encounter dropouts you should increase this setting a bit.</p>"
msgstr ""
"<b>اندازهٔ بافر:</b><p>اندازهٔ بافر را برای پخش انتخاب کنید. بهتر است این "
"مقدار را تا حد امکان کم تنظیم کنید تا تاخیر پخش کاهش یابد. تاخیر عبارت است "
"از فاصلهٔ زمانی میان کنش‌های رابط کاربری مانند شروع/توقف پخش، به‌روزرسانی "
"موقعیت پخش و خروجی واقعی صدا. در صورت مواجهه با قطعی صدا، باید این مقدار را "
"کمی افزایش دهید.</p>"

