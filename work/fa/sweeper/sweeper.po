msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "محمد شفیعی سروستانی"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "muhammad.shafiee@gmail.com"

#: main.cpp:25
#, kde-format
msgid "Sweeper"
msgstr "جاروب‌گر"

#: main.cpp:27
#, kde-format
msgid "Helps clean unwanted traces the user leaves on the system."
msgstr ""
"به پاک کردن ردپاهای ناخواسته‌ای که کاربر روی سامانه به جا می‌گذارد کمک "
"می‌کند."

#: main.cpp:29
#, kde-format
msgid "© 2003-2005, Ralf Hoelzer"
msgstr "© 2003-2005, Ralf Hoelzer"

#: main.cpp:33
#, kde-format
msgid "Ralf Hoelzer"
msgstr "Ralf Hoelzer"

#: main.cpp:33
#, kde-format
msgid "Original author"
msgstr "نویسندهٔ اصلی"

#: main.cpp:34
#, kde-format
msgid "Brian S. Stephan"
msgstr "Brian S. Stephan"

#: main.cpp:34
#, kde-format
msgid "Maintainer"
msgstr "نگه‌دارنده"

#: main.cpp:35
#, kde-format
msgid "Benjamin Meyer"
msgstr "Benjamin Meyer"

#: main.cpp:35 privacyfunctions.h:65
#, kde-format
msgid "Thumbnail Cache"
msgstr "حافظهٔ نهان بندانگشتی‌ها"

#: main.cpp:43
#, kde-format
msgid "Sweeps without user interaction"
msgstr "پاک‌سازی بدون تعامل کاربر"

#: privacyfunctions.cpp:44 privacyfunctions.cpp:53 privacyfunctions.cpp:62
#, kde-format
msgid "A thumbnail could not be removed."
msgstr "تصویر بندانگشتی حذف نشد."

#: privacyfunctions.cpp:131
#, kde-format
msgid "The file exists but could not be removed."
msgstr "پرونده وجود دارد اما حذف نشد."

#: privacyfunctions.cpp:210
#, kde-format
msgid "A favicon could not be removed."
msgstr "نماد تارنما (فاوآیکون) حذف نشد."

#: privacyfunctions.h:22
#, kde-format
msgid "Cookies"
msgstr "کوکی‌ها"

#: privacyfunctions.h:22
#, kde-format
msgid "Clears all stored cookies set by websites"
msgstr "همهٔ کوکی‌های ذخیره‌شده توسط وب‌گاه‌ها را پاک می‌کند"

#: privacyfunctions.h:37
#, kde-format
msgid "Cookie Policies"
msgstr "سیاست‌های کوکی"

#: privacyfunctions.h:37
#, kde-format
msgid "Clears the cookie policies for all visited websites"
msgstr "سیاست‌های کوکی را برای همهٔ وب‌گاه‌های بازدیدشده پاک می‌کند"

#: privacyfunctions.h:51
#, kde-format
msgid "Saved Clipboard Contents"
msgstr "محتویات ذخیره‌شدهٔ تخته‌گیره"

#: privacyfunctions.h:51
#, kde-format
msgid "Clears the clipboard contents stored by Klipper"
msgstr "محتوای تخته‌گیره ذخیره‌شده توسط کلیپر (Klipper) را پاک می‌کند"

#: privacyfunctions.h:65
#, kde-format
msgid "Clears all cached thumbnails"
msgstr "تمام تصاویر بندانگشتی ذخیره‌شده در حافظهٔ پنهان را پاک می‌کند"

#: privacyfunctions.h:79
#, kde-format
msgid "Run Command History"
msgstr "تاریخچهٔ اجرای دستور"

#: privacyfunctions.h:79
#, kde-format
msgid ""
"Clears the history of commands run through the Run Command tool on the "
"desktop"
msgstr ""
"تاریخچهٔ دستورهای اجراشده از طریق ابزار اجرای دستور در میزکار را پاک می‌کند"

#: privacyfunctions.h:93
#, kde-format
msgid "Form Completion Entries"
msgstr "ورودی‌های تکمیل فرم"

#: privacyfunctions.h:93
#, kde-format
msgid "Clears values which were entered into forms on websites"
msgstr "مقدارهایی را که در فرم‌های وبگاه‌ها وارد شده‌اند پاک می‌کند"

#: privacyfunctions.h:107
#, kde-format
msgid "Web History"
msgstr "تاریخچهٔ وب"

#: privacyfunctions.h:107
#, kde-format
msgid "Clears the history of visited websites"
msgstr "تاریخچهٔ وبگاه‌های بازدیدشده را پاک می‌کند"

#: privacyfunctions.h:121
#, kde-format
msgid "Web Cache"
msgstr "حافظهٔ پنهان وب"

#: privacyfunctions.h:121
#, kde-format
msgid "Clears the temporary cache of websites visited"
msgstr "حافظهٔ پنهان موقت وبگاه‌های بازدیدشده را پاک می‌کند"

#: privacyfunctions.h:135
#, kde-format
msgid "Recent Documents"
msgstr "اسناد اخیر"

#: privacyfunctions.h:135
#, kde-format
msgid ""
"Clears the list of recently used documents from the KDE applications menu"
msgstr "فهرست سندهای اخیراً استفاده‌شده را از منوی برنامه‌های KDE پاک می‌کند"

#: privacyfunctions.h:149
#, kde-format
msgid "Favorite Icons"
msgstr "نمادهای مورد علاقه (Favicons)"

#: privacyfunctions.h:149
#, kde-format
msgid "Clears the FavIcons cached from visited websites"
msgstr ""
"فاوآیکون‌های (Favicons) ذخیره‌شده در حافظهٔ موقت از وبگاه‌های بازدیدشده را "
"پاک می‌کند"

#: privacyfunctions.h:163
#, kde-format
msgid "Recent Applications"
msgstr "برنامه‌های اخیر"

#: privacyfunctions.h:163
#, kde-format
msgid "Clears the list of recently used applications from KDE menu"
msgstr "فهرست برنامه‌های اخیراً استفاده‌شده را از منوی KDE پاک می‌کند"

#: sweeper.cpp:22
#, kde-format
msgctxt "General system content"
msgid "General"
msgstr "عمومی"

#: sweeper.cpp:23
#, kde-format
msgctxt "Web browsing content"
msgid "Web Browsing"
msgstr "مرور وب"

#: sweeper.cpp:100
#, kde-format
msgid ""
"You are deleting data that is potentially valuable to you. Are you sure?"
msgstr ""
"در حال حذف داده‌هایی هستید که ممکن است برایتان ارزشمند باشند. آیا مطمئنید؟"

#: sweeper.cpp:107
#, kde-format
msgid "Starting cleanup..."
msgstr "در حال شروع پاک‌سازی..."

#: sweeper.cpp:111
#, kde-format
msgid "Clearing %1..."
msgstr "در حال پاک کردن %1..."

#: sweeper.cpp:116
#, kde-format
msgid "Clearing of %1 failed: %2"
msgstr "پاک‌سازی %1 ناموفق بود: %2"

#: sweeper.cpp:122
#, kde-format
msgid "Clean up finished."
msgstr "پاک‌سازی پایان یافت."

#. i18n: ectx: property (whatsThis), widget (QTreeWidget, privacyListView)
#: sweeperdialog.ui:27
#, kde-format
msgid ""
"Check all cleanup actions you would like to perform. These will be executed "
"by pressing the button below."
msgstr ""
"تمام اقدام‌های پاک‌سازی که مایل به انجامشان هستید را علامت بزنید. این "
"اقدام‌ها با فشردن دکمهٔ زیر اجرا خواهند شد."

#. i18n: ectx: property (text), widget (QTreeWidget, privacyListView)
#: sweeperdialog.ui:37
#, kde-format
msgid "Privacy Settings"
msgstr "تنظیمات حریم خصوصی"

#. i18n: ectx: property (text), widget (QTreeWidget, privacyListView)
#: sweeperdialog.ui:42
#, kde-format
msgid "Description"
msgstr "توضیحات"

#. i18n: ectx: property (text), widget (QPushButton, selectAllButton)
#: sweeperdialog.ui:58
#, kde-format
msgid "Select &All"
msgstr "انتخاب همه"

#. i18n: ectx: property (text), widget (QPushButton, selectNoneButton)
#: sweeperdialog.ui:65
#, kde-format
msgid "Select &None"
msgstr "انتخاب هیچ‌کدام"

#. i18n: ectx: property (whatsThis), widget (QPushButton, cleanupButton)
#: sweeperdialog.ui:88
#, kde-format
msgid "Immediately performs the cleanup actions selected above"
msgstr "اقدام‌های پاک‌سازی انتخاب‌شده در بالا را فوراً انجام می‌دهد"

#. i18n: ectx: property (text), widget (QPushButton, cleanupButton)
#: sweeperdialog.ui:91
#, kde-format
msgid "&Clean Up"
msgstr "پاک‌سازی"
