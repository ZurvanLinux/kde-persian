#: src/iconsidepane.cpp:275
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Choose this option if you want the sidebar items to have icons without text."
msgstr ""
"اگر می‌خواهید موارد نوار کناری فقط شمایل داشته باشند و بدون متن باشند، این "
"گزینه را انتخاب کنید."

#: src/iconsidepane.cpp:277
#, kde-format
msgctxt "@action:inmenu"
msgid "Show Text Only"
msgstr "فقط نمایش متن"

#: src/iconsidepane.cpp:281
#, kde-format
msgctxt "@info:status"
msgid "Show sidebar items with text and without icons"
msgstr "نمایش موارد نوار کناری با متن و بدون نقشک"

#: src/iconsidepane.cpp:282
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Choose this option if you want the sidebar items to have text without icons."
msgstr ""
"اگر می‌خواهید موارد نوار کناری فقط دارای متن و بدون نقشک باشند، این گزینه را"
" انتخاب کنید."

#: src/iconsidepane.cpp:284
#, kde-format
msgctxt "@action:inmenu"
msgid "Show Icons && Text"
msgstr "نمایش نقشک‌ها و متن"

#: src/iconsidepane.cpp:288
#, kde-format
msgctxt "@info:status"
msgid "Show sidebar items with icons and text"
msgstr "نمایش موارد نوار کناری با نقشک‌ها و متن"

#: src/iconsidepane.cpp:289
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Choose this option if you want the sidebar items to have icons and text."
msgstr ""
"اگر می‌خواهید موارد نوار کناری دارای نقشک و متن باشند، این گزینه را انتخاب "
"کنید."

#: src/iconsidepane.cpp:294
#, kde-format
msgctxt "@action:inmenu"
msgid "Big Icons"
msgstr "نقشک‌های بزرگ"

#: src/iconsidepane.cpp:298
#, kde-format
msgctxt "@info:status"
msgid "Show large size sidebar icons"
msgstr "نمایش نقشک‌های نوار کناری با اندازهٔ بزرگ"

#: src/iconsidepane.cpp:299
#, kde-format
msgctxt "@info:whatsthis"
msgid "Choose this option if you want the sidebar icons to be extra big."
msgstr ""
"اگر می‌خواهید نقشک‌های نوار کناری بسیار بزرگ باشند، این گزینه را انتخاب "
"کنید."

#: src/iconsidepane.cpp:301
#, kde-format
msgctxt "@action:inmenu"
msgid "Normal Icons"
msgstr "نقشک‌های عادی"

#: src/iconsidepane.cpp:305
#, kde-format
msgctxt "@info:status"
msgid "Show normal size sidebar icons"
msgstr "نمایش نقشک‌های نوار کناری با اندازهٔ عادی"

#: src/iconsidepane.cpp:306
#, kde-format
msgctxt "@info:whatsthis"
msgid "Choose this option if you want the sidebar icons to be normal size."
msgstr ""
"اگر می‌خواهید اندازهٔ نقشک‌های نوار کناری عادی باشد، این گزینه را انتخاب "
"کنید."

#: src/iconsidepane.cpp:308
#, kde-format
msgctxt "@action:inmenu"
msgid "Small Icons"
msgstr "نقشک‌های کوچک"

#: src/iconsidepane.cpp:312
#, kde-format
msgctxt "@info:status"
msgid "Show small size sidebar icons"
msgstr "نمایش نقشک‌های کوچک نوار کناری"

#: src/iconsidepane.cpp:313
#, kde-format
msgctxt "@info:whatsthis"
msgid "Choose this option if you want the sidebar icons to be extra small."
msgstr ""
"اگر می‌خواهید نقشک‌های نوار کناری خیلی کوچک باشند، این گزینه را انتخاب کنید."

#: src/iconsidepane.cpp:315
#, kde-format
msgctxt "@action:inmenu"
msgid "Hide Sidebar"
msgstr "پنهان‌سازی نوار کناری"

#: src/iconsidepane.cpp:318
#, kde-format
msgctxt "@info:status"
msgid "Hide the icon sidebar"
msgstr "پنهان‌سازی نوار کناری نقشک‌ها"

#: src/iconsidepane.cpp:319
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Choose this option if you want to hide the icon sidebar. Press F9 to unhide."
msgstr ""
"اگر می‌خواهید نوار کناری نقشک‌ها را پنهان کنید، این گزینه را انتخاب کنید. "
"برای نمایان شدن، F9 را فشار دهید."

#: src/kcmkontact.cpp:38
#, kde-format
msgctxt "@info:tooltip"
msgid "Select the initial plugin to use on each start"
msgstr "انتخاب افزایهٔ اولیه برای استفاده در هر بار راه‌اندازی"

#: src/kcmkontact.cpp:40
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select the plugin from this drop down list to be used as the initial plugin "
"each time Kontact is started. Otherwise, Kontact will restore the last "
"active plugin from the previous usage."
msgstr ""
"از این فهرست کشویی، افزایه‌ای را انتخاب کنید که در هر بار راه‌اندازی Kontact"
" به‌عنوان افزایهٔ اولیه استفاده شود. در غیر این صورت، Kontact آخرین افزایهٔ "
"فعال از استفادهٔ پیشین را بازیابی خواهد کرد."

#. i18n: ectx: tooltip, entry (ActivePlugin), group (View)
#. i18n: ectx: whatsthis, entry (ActivePlugin), group (View)
#: src/kontact.kcfg:7 src/kontact.kcfg:8
#, kde-format
msgid "The currently active plugin"
msgstr "افزایهٔ فعال فعلی"

#. i18n: ectx: label, entry (ForceStartupPlugin), group (View)
#: src/kontact.kcfg:12
#, kde-format
msgid "Always start with plugin:"
msgstr "همیشه با این افزونه آغاز شود:"

#. i18n: ectx: tooltip, entry (ForceStartupPlugin), group (View)
#: src/kontact.kcfg:13
#, kde-format
msgid "Set the initial plugin on each start"
msgstr "تنظیم افزونهٔ اولیه در هر بار راه‌اندازی"

#. i18n: ectx: whatsthis, entry (ForceStartupPlugin), group (View)
#: src/kontact.kcfg:14
#, kde-format
msgid ""
"Usually Kontact will come up with the plugin used before shutdown. Check "
"this box if you would like the specified plugin to come up on start instead."
msgstr ""
"معمولاً کنتاکت با همان افزونه‌ای باز می‌شود که پیش از خاموش‌کردن استفاده شده"
" بود. اگر می‌خواهید در عوض افزونهٔ مشخص‌شده هنگام راه‌اندازی باز شود، این "
"گزینه را علامت بزنید."

#. i18n: ectx: label, entry (SideBarOpen), group (View)
#: src/kontact.kcfg:20
#, kde-format
msgid "Show the Kontact component sidebar"
msgstr "نمایش نوار کناری اجزای کنتاکت"

#. i18n: ectx: tooltip, entry (SideBarOpen), group (View)
#: src/kontact.kcfg:21
#, kde-format
msgid "Show/Hide the Kontact component sidebar"
msgstr "نمایش/نهفتن نوار کناری اجزای کنتاکت"

#. i18n: ectx: whatsthis, entry (SideBarOpen), group (View)
#: src/kontact.kcfg:22
#, kde-format
msgid ""
"To save screen real estate you might choose to hide Kontact's component "
"sidebar. Uncheck this box to hide the component sidebar. Note that the F9 "
"key will hide/show the component sidebar."
msgstr ""
"برای صرفه‌جویی در فضای صفحه، می‌توانید نوار کناری اجزای کنتاکت را پنهان "
"کنید. برای پنهان‌کردن نوار کناری، علامت این گزینه را بردارید. توجه داشته "
"باشید که کلید F9 نوار کناری اجزا را پنهان/آشکار می‌کند."

