#: common/daverror.cpp:79
#, kde-format
msgid "Invalid username/password"
msgstr "نام کاربری/گذرواژه نامعتبر است"

#: common/daverror.cpp:81
#, kde-format
msgid "Access forbidden"
msgstr "دسترسی ممنوع است"

#: common/daverror.cpp:83
#, kde-format
msgid "Resource not found"
msgstr "منبع پیدا نشد"

#: common/daverror.cpp:85
#, kde-format
msgid "HTTP error"
msgstr "خطای HTTP"

#: common/daverror.cpp:87
#, kde-format
msgid ""
"There was a problem with the request.\n"
"%1 (%2)."
msgstr ""
"مشکلی در درخواست وجود داشت.\n"
"%1 (%2)."

#: common/daverror.cpp:90
#, kde-format
msgid "Protocol for the collection does not support MULTIGET"
msgstr "پروتکلِ این مجموعه از MULTIGET پشتیبانی نمی‌کند"

#: common/daverror.cpp:93
#, kde-format
msgid ""
"The server encountered an error that prevented it from completing your "
"request: %1 (%2)"
msgstr "سرور با خطایی مواجه شد که مانع از تکمیل درخواست شما گردید: %1 (%2)"

#: common/daverror.cpp:96
#, kde-format
msgid ""
"There was a problem with the request. The collection has not been deleted from the server.\n"
"%1 (%2)."
msgstr ""
"مشکلی در درخواست وجود داشت. مجموعه از سرور حذف نشد.\n"
"%1 (%2)."

#: common/daverror.cpp:99
#, kde-format
msgid ""
"There was a problem with the request. The collection has not been created on the server.\n"
"%1 (%2)."
msgstr ""
"مشکلی در درخواست وجود داشت. مجموعه روی سرور ایجاد نشد.\n"
"%1 (%2)."

#: common/daverror.cpp:102
#, kde-format
msgid "Invalid responses from backend"
msgstr "پاسخ‌های نامعتبر از سرور پشتیبان (backend)"

#: common/daverror.cpp:105
#, kde-format
msgid "Error setting focus for XQuery"
msgstr "خطا در تنظیم تمرکز برای XQuery"

#: common/daverror.cpp:108
#, kde-format
msgid "Invalid XQuery submitted by DAV implementation"
msgstr "XQuery نامعتبر ارسال‌شده توسط پیاده‌سازی DAV"

#: common/daverror.cpp:112
#, kde-format
msgid ""
"There was a problem with the request. The collection has not been modified on the server.\n"
"%1 (%2)."
msgstr ""
"مشکلی در درخواست وجود داشت. مجموعه روی سرور تغییر نیافته است.\n"
"%1 (%2)."

#: common/daverror.cpp:118
#, kde-format
msgid "No properties to change or remove"
msgstr "ویژگی‌ای برای تغییر یا حذف وجود ندارد"

#: common/daverror.cpp:121
#, kde-format
msgid "There was an error when modifying the properties"
msgstr "هنگام تغییر ویژگی‌ها خطایی رخ داد"

#: common/daverror.cpp:123
#, kde-format
msgid ""
"\n"
"The server returned more information:\n"
"%1"
msgstr ""
"\n"
"سرور اطلاعات بیشتری برگرداند:\n"
"%1"

#: common/daverror.cpp:127
#, kde-format
msgid ""
"There was a problem with the request. The item has not been created on the server.\n"
"%1 (%2)."
msgstr ""
"مشکلی در درخواست وجود داشت. مورد روی سرور ایجاد نشده است.\n"
"%1 (%2)."

#: common/daverror.cpp:130
#, kde-format
msgid ""
"There was a problem with the request. The item has not been deleted from the server.\n"
"%1 (%2)."
msgstr ""
"مشکلی در درخواست وجود داشت. مورد از روی سرور حذف نشده است.\n"
"%1 (%2)."

#: common/daverror.cpp:133
#, kde-format
msgid ""
"There was a problem with the request. The item was not modified on the server.\n"
"%1 (%2)."
msgstr ""
"مشکلی در درخواست وجود داشت. مورد روی سرور تغییر داده نشد.\n"
"%1 (%2)."

#: common/daverror.cpp:136 common/daverror.cpp:148 common/daverror.cpp:151
#, kde-format
msgid "There was a problem with the request."
msgstr "مشکلی در درخواست وجود داشت."

#: common/daverror.cpp:139
#, kde-format
msgid ""
"There was a problem with the request. The item was not moved.\n"
"%1 (%2)."
msgstr ""
"در درخواست مشکلی پیش آمد. مورد جابه‌جا نشد.\n"
"%1 (%2)."

#: common/daverror.cpp:142
#, kde-format
msgid ""
"There was a problem with the request. The requested MIME types are not "
"supported."
msgstr "در درخواست مشکلی پیش آمد. نوع‌های MIME درخواستی پشتیبانی نمی‌شوند."

#: common/daverror.cpp:145
#, kde-format
msgid "The server returned a malformed response payload."
msgstr "سرور بار دادهٔ پاسخ بدریختی را بازگرداند."

#: common/davitemssyncjob.cpp:210
#, kde-format
msgid "Invalid server response payload, response item missing HREF element"
msgstr "بار دادهٔ پاسخ سرور نامعتبر است، مورد پاسخ فاقد عنصر HREF است"

#: common/davitemssyncjob.cpp:240
#, kde-format
msgid ""
"Invalid server response payload, response item missing PROPSTAT element"
msgstr "بار دادهٔ پاسخ سرور نامعتبر است، مورد پاسخ فاقد عنصر PROPSTAT است"
