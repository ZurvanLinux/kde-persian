#: kwrited-autostart.desktop:2
msgctxt "Name"
msgid "KDE Write Daemon"
msgstr "شبح نوشتن KDE"

#: kwrited-autostart.desktop:91
msgctxt "Comment"
msgid "Watch for messages from local users sent with write(1) or wall(1)"
msgstr "پایش پیام‌های کاربران محلی ارسال‌شده با write(1) یا wall(1)"

#: kwrited.notifyrc:3
msgctxt "Name"
msgid "Local System Message Service"
msgstr "خدمت پیام سیستم محلی"

#: kwrited.notifyrc:52
msgctxt "Comment"
msgid "Local system message service"
msgstr "خدمت پیام سیستم محلی"

#: kwrited.notifyrc:121
msgctxt "Name"
msgid "New message received"
msgstr "پیام جدید دریافت شد"

#: kwrited.notifyrc:196
msgctxt "Comment"
msgid "The daemon received a new message sent with wall(1) or write(1)"
msgstr "شبح، پیام جدید ارسال‌شده با wall(1) یا write(1) را دریافت کرد"
