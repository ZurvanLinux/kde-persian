#: csv/import/csvimportdialog.cpp:169
#, kde-format
msgctxt "@title:window"
msgid "CSV Import Dialog"
msgstr "گفت‌وگوی درون‌ریزی CSV"

#: csv/import/csvimportdialog.cpp:224
#, kde-format
msgctxt "@label"
msgid "Importing contacts"
msgstr "در حال درون‌ریزی مخاطبان"

#: csv/import/csvimportdialog.cpp:295
#, kde-format
msgctxt "@label"
msgid "File to import:"
msgstr "پرونده برای وارد کردن:"

#: csv/import/csvimportdialog.cpp:303
#, kde-format
msgctxt "@info:tooltip"
msgid "Select a csv file to import"
msgstr "انتخاب یک پروندهٔ csv برای وارد کردن"

#: csv/import/csvimportdialog.cpp:305
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Click this button to start a file chooser that will allow you to select a "
"csv file to import."
msgstr ""
"روی این دکمه کلیک کنید تا گزینشگر پرونده‌ای باز شود که به شما امکان انتخاب "
"پروندهٔ csv برای وارد کردن را می‌دهد."

#: csv/import/csvimportdialog.cpp:312
#, kde-format
msgctxt "@title:group"
msgid "Delimiter"
msgstr "جداکننده"

#: csv/import/csvimportdialog.cpp:322
#, kde-format
msgctxt "@option:radio Field separator"
msgid "Comma"
msgstr "کاما"

#: csv/import/csvimportdialog.cpp:323
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the field separator to a comma"
msgstr "تنظیم جداکنندهٔ فیلد روی کاما"

#: csv/import/csvimportdialog.cpp:324
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option if your csv file uses the comma as a field separator."
msgstr ""
"اگر پروندهٔ csv شما از کاما به‌عنوان جداکنندهٔ فیلد استفاده می‌کند، این "
"گزینه را انتخاب کنید."

#: csv/import/csvimportdialog.cpp:329
#, kde-format
msgctxt "@option:radio Field separator"
msgid "Semicolon"
msgstr "نقطه‌ویرگول"

#: csv/import/csvimportdialog.cpp:330
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the field separator to a semicolon"
msgstr "تنظیم جداکنندهٔ فیلد روی نقطه‌ویرگول"

#: csv/import/csvimportdialog.cpp:331
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option if your csv file uses the semicolon as a field separator."
msgstr ""
"اگر پروندهٔ csv شما از نقطه‌ویرگول به‌عنوان جداکنندهٔ فیلد استفاده می‌کند، "
"این گزینه را انتخاب کنید."

#: csv/import/csvimportdialog.cpp:335
#, kde-format
msgctxt "@option:radio Field separator"
msgid "Tabulator"
msgstr "تب"

#: csv/import/csvimportdialog.cpp:336
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the field separator to a tab character"
msgstr "تنظیم جداکنندهٔ ستون روی نویسهٔ تب"

#: csv/import/csvimportdialog.cpp:337
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option if your csv file uses the tab character as a field "
"separator."
msgstr ""
"اگر پروندهٔ csv شما از نویسهٔ تب به عنوان جداکنندهٔ ستون استفاده می‌کند، این"
" گزینه را انتخاب کنید."

#: csv/import/csvimportdialog.cpp:341
#, kde-format
msgctxt "@option:radio Field separator"
msgid "Space"
msgstr "فاصله"

#: csv/import/csvimportdialog.cpp:342
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the field separator to a space character"
msgstr "تنظیم جداکنندهٔ ستون روی نویسهٔ فاصله"

#: csv/import/csvimportdialog.cpp:343
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option if your csv file uses the space character as a field "
"separator."
msgstr ""
"اگر پروندهٔ csv شما از نویسهٔ فاصله به عنوان جداکنندهٔ ستون استفاده می‌کند، "
"این گزینه را انتخاب کنید."

#: csv/import/csvimportdialog.cpp:347
#, kde-format
msgctxt "@option:radio Custom field separator"
msgid "Other"
msgstr "سایر"

#: csv/import/csvimportdialog.cpp:348
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the field separator to a custom character"
msgstr "تنظیم جداکنندهٔ ستون روی یک نویسهٔ سفارشی"

#: csv/import/csvimportdialog.cpp:350
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option if to use some other character as the field delimiter for"
" the data in your csv file."
msgstr ""
"اگر می‌خواهید از نویسهٔ دیگری به عنوان جداکنندهٔ ستون‌ها برای داده‌های "
"پروندهٔ csv خود استفاده کنید، این گزینه را انتخاب کنید."

#: csv/import/csvimportdialog.cpp:356
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the custom delimiter character"
msgstr "تنظیم نویسهٔ جداکنندهٔ سفارشی"

#: csv/import/csvimportdialog.cpp:358
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Enter a custom character to use as the delimiter character. If you enter "
"more than 1 character, only the first will be used and the remaining "
"characters will be ignored."
msgstr ""
"یک نویسهٔ سفارشی را برای استفاده به عنوان نویسهٔ جداکننده وارد کنید. اگر بیش"
" از ۱ نویسه وارد کنید، فقط اولین نویسه استفاده خواهد شد و بقیه نویسه‌ها "
"نادیده گرفته می‌شوند."

#: csv/import/csvimportdialog.cpp:364
#, kde-format
msgctxt "@label:listbox"
msgid "Text quote:"
msgstr "نقل‌قول متن:"

#: csv/import/csvimportdialog.cpp:370
#, kde-format
msgctxt "@info:tooltip"
msgid "Select the quote character"
msgstr "نویسهٔ نقل‌قول را انتخاب کنید"

#: csv/import/csvimportdialog.cpp:372
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Choose the character that your csv data uses to \"quote\" the field "
"delimiter if that character happens to occur within the data.  For example, "
"if the comma is the field delimiter, then any comma occurring with the data "
"will be \"quoted\" by the character specified here."
msgstr ""
"نویسه‌ای را انتخاب کنید که داده‌های csv شما برای «نقل‌قول کردن» جداکنندهٔ "
"فیلد استفاده می‌کنند (در صورتی که آن نویسه تصادفاً درون داده‌ها وجود داشته "
"باشد). برای مثال، اگر کاما جداکنندهٔ فیلد باشد، هر کامایی که در داده‌ها باشد"
" با نویسه‌ای که در اینجا مشخص شده «نقل‌قول» خواهد شد."

#: csv/import/csvimportdialog.cpp:377
#, kde-format
msgctxt "@item:inlistbox Quote character option"
msgid "\""
msgstr "\""

#: csv/import/csvimportdialog.cpp:378
#, kde-format
msgctxt "@item:inlistbox Quote character option"
msgid "'"
msgstr "'"

#: csv/import/csvimportdialog.cpp:379
#, kde-format
msgctxt "@item:inlistbox Quote character option"
msgid "None"
msgstr "هیچ‌کدام"

#: csv/import/csvimportdialog.cpp:383
#, kde-format
msgctxt "@label:listbox"
msgid "Date format:"
msgstr "قالب تاریخ:"

#: csv/import/csvimportdialog.cpp:391
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid ""
"<para><list><item>y: year with 2 digits</item><item>Y: year with 4 "
"digits</item><item>m: month with 1 or 2 digits</item><item>M: month with 2 "
"digits</item><item>d: day with 1 or 2 digits</item><item>D: day with 2 "
"digits</item><item>H: hours with 2 digits</item><item>I: minutes with 2 "
"digits</item><item>S: seconds with 2 digits</item></list></para>"
msgstr ""
"<para><list><item>y: سال دو رقمی</item><item>Y: سال چهار رقمی</item><item>m:"
" ماه یک یا دو رقمی</item><item>M: ماه دو رقمی</item><item>d: روز یک یا دو "
"رقمی</item><item>D: روز دو رقمی</item><item>H: ساعت دو رقمی</item><item>I: "
"دقیقه دو رقمی</item><item>S: ثانیه دو رقمی</item></list></para>"

#: csv/import/csvimportdialog.cpp:402
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Specify a format to use for dates included in your csv data. Use the "
"following sequences to help you define the "
"format:</para><para><list><item>y: year with 2 digits</item><item>Y: year "
"with 4 digits</item><item>m: month with 1 or 2 digits</item><item>M: month "
"with 2 digits</item><item>d: day with 1 or 2 digits</item><item>D: day with "
"2 digits</item><item>H: hours with 2 digits</item><item>I: minutes with 2 "
"digits</item><item>S: seconds with 2 "
"digits</item></list></para><para>Example: \"Y-M-D\" corresponds to a date "
"like \"2012-01-04\"</para>"
msgstr ""
"<para>قالبی را برای استفاده در تاریخ‌های موجود در داده‌های csv خود مشخص "
"کنید. از دنباله‌های زیر برای کمک به تعیین قالب استفاده "
"کنید:</para><para><list><item>y: سال دو رقمی</item><item>Y: سال چهار "
"رقمی</item><item>m: ماه یک یا دو رقمی</item><item>M: ماه دو "
"رقمی</item><item>d: روز یک یا دو رقمی</item><item>D: روز دو "
"رقمی</item><item>H: ساعت دو رقمی</item><item>I: دقیقه دو رقمی</item><item>S:"
" ثانیه دو رقمی</item></list></para><para>مثال: «Y-M-D» متناظر با تاریخی "
"مانند «2012-01-04» است</para>"

