#: sessionrunner.cpp:22
#, kde-format
msgctxt ""
"KRunner keywords (split by semicolons without whitespace) to log out of the "
"session"
msgid "logout;log out"
msgstr "خروج از نشست;خروج;خروج از سیستم"

#: sessionrunner.cpp:25
#, kde-format
msgid "Logs out, exiting the current desktop session"
msgstr "از نشست خارج می‌شود و به نشست کنونی میزکار پایان می‌دهد"

#: sessionrunner.cpp:29
#, kde-format
msgctxt ""
"KRunner keywords (split by semicolons without whitespace) to shut down the "
"computer"
msgid "shutdown;shut down;power;poweroff;power off"
msgstr "خاموش کردن;خاموش;خاموشی"

#: sessionrunner.cpp:32
#, kde-format
msgid "Turns off the computer"
msgstr "رایانه را خاموش می‌کند"

#: sessionrunner.cpp:35
#, kde-format
msgctxt ""
"KRunner keywords (split by semicolons without whitespace) to restart the "
"computer"
msgid "restart;reboot"
msgstr "راه‌اندازی مجدد;راه‌اندازی دوباره"

#: sessionrunner.cpp:38
#, kde-format
msgid "Reboots the computer"
msgstr "رایانه را مجدداً راه‌اندازی می‌کند"

#: sessionrunner.cpp:42
#, kde-format
msgctxt ""
"KRunner keywords (split by semicolons without whitespace) to lock the screen"
msgid "lock;lock screen"
msgstr "قفل;قفل صفحه;قفل کردن"

#: sessionrunner.cpp:44
#, kde-format
msgid "Locks the current sessions and starts the screen saver"
msgstr "نشست‌های کنونی را قفل می‌کند و محافظ صفحه را فعال می‌کند"

#: sessionrunner.cpp:47
#, kde-format
msgctxt ""
"KRunner keywords (split by semicolons without whitespace) to save the "
"desktop session"
msgid "save;save session"
msgstr "ذخیره;ذخیرهٔ نشست;ذخیره نشست"

#: sessionrunner.cpp:50
#, kde-format
msgid "Saves the current session for session restoration"
msgstr "نشست کنونی را برای بازیابی نشست ذخیره می‌کند"

#: sessionrunner.cpp:53
#, kde-format
msgctxt ""
"KRunner keywords (split by semicolons without whitespace) to switch user "
"sessions"
msgid "switch user;new session"
msgstr "تعویض کاربر;تغییر کاربر;نشست جدید"

#: sessionrunner.cpp:56
#, kde-format
msgid "Switch to a session as a different user"
msgstr "تغییر به نشستی با کاربری دیگر"

#: sessionrunner.cpp:101
#, kde-format
msgctxt "log out command"
msgid "Log Out"
msgstr "خروج از نشست"

#: sessionrunner.cpp:102
#, kde-format
msgctxt "turn off computer command"
msgid "Shut Down"
msgstr "خاموش کردن"

#: sessionrunner.cpp:103
#, kde-format
msgctxt "restart computer command"
msgid "Restart"
msgstr "راه‌اندازی مجدد"

#: sessionrunner.cpp:104
#, kde-format
msgctxt "lock screen command"
msgid "Lock"
msgstr "قفل کردن"

#: sessionrunner.cpp:105
#, kde-format
msgid "Save Session"
msgstr "ذخیرهٔ نشست"

#: sessionrunner.cpp:106
#, kde-format
msgid "Switch User"
msgstr "تعویض کاربر"
