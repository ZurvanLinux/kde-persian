#: actions/checkaction.cpp:71
#, kde-format
msgctxt "@action:button check a storageAccess (i.e disk) for error"
msgid "Check for Errors"
msgstr "بررسی خطاها"

#: actions/mountaction.cpp:93
#, kde-format
msgid "Mount"
msgstr "سوار کردن"

#: actions/mountandopenaction.cpp:177
#, kde-format
msgid "Open in File Manager"
msgstr "باز کردن در مدیر پرونده"

#: actions/mountandopenaction.cpp:180
#, kde-format
msgid "Try to Fix"
msgstr "تلاش برای تعمیر"

#: actions/mountandopenaction.cpp:180
#, kde-format
msgid "Mount and Open"
msgstr "سوار کردن و باز کردن"

#: actions/mountandopenaction.cpp:182
#, kde-format
msgid "Eject"
msgstr "بیرون دادن"

#: actions/mountandopenaction.cpp:184
#, kde-format
msgid "Safely remove"
msgstr "جداسازی ایمن"

#: messageinfo.cpp:108
#, kde-format
msgid "This device has file system errors."
msgstr "این دستگاه دارای خطاهای سامانهٔ پرونده است."

#: messageinfo.cpp:110
#, kde-format
msgctxt "@label device is a storage disk"
msgid "This device has no errors"
msgstr "این دستگاه هیچ خطایی ندارد"

#: messageinfo.cpp:113
#, kde-format
msgid "Successfully repaired!"
msgstr "با موفقیت تعمیر شد!"

#: messageinfo.cpp:117
#, kde-format
msgid "Device Status"
msgstr "وضعیت دستگاه"

#: messageinfo.cpp:118
#, kde-format
msgid "A device can now be safely removed"
msgstr "اکنون می‌توان یک دستگاه را با ایمنی جدا کرد"

#: messageinfo.cpp:122
#, kde-format
msgid "This device can now be safely removed."
msgstr "اکنون می‌توان این دستگاه را با ایمنی جدا کرد."

#: messageinfo.cpp:129
#, kde-format
msgid "You are not authorized to mount this device."
msgstr "شما مجاز به سوار کردن این دستگاه نیستید."

#: messageinfo.cpp:133
#, kde-format
msgid "You are not authorized to eject this disc."
msgstr "شما مجاز به بیرون دادن این دیسک نیستید."

#: messageinfo.cpp:136
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "You are not authorized to remove this device."
msgstr "شما مجاز به جدا کردن این دستگاه نیستید."

#: messageinfo.cpp:139
#, kde-format
msgid "You are not authorized to repair this device."
msgstr "شما مجاز به تعمیر این دستگاه نیستید."

#: messageinfo.cpp:141 messageinfo.cpp:208
#, kde-format
msgid "Unknown error type"
msgstr "نوع خطای ناشناخته"

#: messageinfo.cpp:145
#, kde-format
msgid "Could not mount this device as it is busy."
msgstr "سوار کردن این دستگاه ممکن نشد، زیرا مشغول است."

#: messageinfo.cpp:173
#, kde-format
msgid "One or more files on this device are open within an application."
msgstr "یک یا چند پرونده در این دستگاه در یک برنامه باز هستند."

#: messageinfo.cpp:175
#, kde-format
msgid "One or more files on this device are opened in application \"%2\"."
msgid_plural ""
"One or more files on this device are opened in following applications: %2."
msgstr[0] "یک یا چند پرونده در این دستگاه در برنامهٔ «%2» باز هستند."
msgstr[1] "یک یا چند پرونده در این دستگاه در برنامه‌های زیر باز هستند: %2."

#: messageinfo.cpp:178
#, kde-format
msgctxt "separator in list of apps blocking device unmount"
msgid ", "
msgstr "، "

#: messageinfo.cpp:197
#, kde-format
msgid "Could not mount this device."
msgstr "سوار کردن این دستگاه ممکن نشد."

#: messageinfo.cpp:201
#, kde-format
msgid "Could not eject this disc."
msgstr "بیرون دادن این دیسک ممکن نشد."

#: messageinfo.cpp:203
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "Could not remove this device."
msgstr "جدا کردن این دستگاه ممکن نشد."

#: messageinfo.cpp:206
#, kde-format
msgid "Could not repair this device: %1"
msgstr "امکان تعمیر این دستگاه وجود نداشت: %1"

#: qml/DeviceItem.qml:98
#, kde-format
msgctxt ""
"Translation should be short and mean 'Currently checking the device for "
"filesystem errors'"
msgid "Checking…"
msgstr "در حال بررسی…"

#: qml/DeviceItem.qml:100
#, kde-format
msgctxt ""
"Translation should be short and mean 'The storage device contains filesystem"
" errors and is being repaired'"
msgid "Repairing…"
msgstr "در حال تعمیر…"

#: qml/DeviceItem.qml:103
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free of %2"
msgstr "%1 آزاد از %2"

#: qml/DeviceItem.qml:107
#, kde-format
msgctxt ""
"Accessing is a less technical word for Mounting; translation should be short"
" and mean 'Currently mounting this device'"
msgid "Accessing…"
msgstr "در حال دسترسی…"

#: qml/DeviceItem.qml:110
#, kde-format
msgctxt ""
"Removing is a less technical word for Unmounting; translation should be "
"short and mean 'Currently unmounting this device'"
msgid "Removing…"
msgstr "در حال جدا کردن…"

#: qml/DeviceItem.qml:113
#, kde-format
msgid "Don't unplug yet! Files are still being transferred…"
msgstr "هنوز جدا نکنید! پرونده‌ها هنوز در حال انتقال هستند…"

#: qml/FullRepresentation.qml:47 qml/main.qml:127
#, kde-format
msgid "Remove All"
msgstr "جدا کردن همه"

#: qml/FullRepresentation.qml:48
#, kde-format
msgid "Click to safely remove all devices"
msgstr "برای جدا کردن ایمن همهٔ دستگاه‌ها کلیک کنید"

#: qml/FullRepresentation.qml:163
#, kde-format
msgid "No removable devices attached"
msgstr "هیچ دستگاه جداشدنی متصل نیست"

#: qml/FullRepresentation.qml:163
#, kde-format
msgid "No disks available"
msgstr "هیچ دیسکی در دسترس نیست"

#: qml/main.qml:76
#, kde-format
msgid "Most Recent Device"
msgstr "جدیدترین دستگاه"

#: qml/main.qml:76
#, kde-format
msgid "No Devices Available"
msgstr "هیچ دستگاهی در دسترس نیست"

#: qml/main.qml:113
#, kde-format
msgctxt "Open auto mounter kcm"
msgid "Configure Removable Devices…"
msgstr "پیکربندی دستگاه‌های جداشدنی…"

#: qml/main.qml:135
#, kde-format
msgid "Removable Devices"
msgstr "دستگاه‌های جداشدنی"

#: qml/main.qml:150
#, kde-format
msgid "Non Removable Devices"
msgstr "دستگاه‌های جدانشدنی"

#: qml/main.qml:165
#, kde-format
msgid "All Devices"
msgstr "همهٔ دستگاه‌ها"

#: qml/main.qml:182
#, kde-format
msgid "Show popup when new device is plugged in"
msgstr "نمایش پنجرهٔ بازشو هنگام اتصال دستگاه جدید"
