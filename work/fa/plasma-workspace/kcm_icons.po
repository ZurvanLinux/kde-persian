#. i18n: ectx: label, entry (Theme), group (Icons)
#: iconssettingsbase.kcfg:9
#, kde-format
msgid "Name of the current icon theme"
msgstr "نام پوستهٔ شمایل کنونی"

#: main.cpp:147
#, kde-format
msgid "Unable to create a temporary file."
msgstr "ایجاد پروندهٔ موقت ممکن نیست."

#: main.cpp:158
#, kde-format
msgid "Unable to download the icon theme archive: %1"
msgstr "بارگیری بایگانی پوستهٔ شمایل ممکن نیست: %1"

#: main.cpp:172
#, kde-format
msgid "The file is not a valid icon theme archive."
msgstr "پرونده یک بایگانی معتبر پوستهٔ شمایل نیست."

#: main.cpp:177
#, kde-format
msgid ""
"A problem occurred during the installation process; however, most of the "
"themes in the archive have been installed"
msgstr ""
"مشکلی در فرایند نصب رخ داد؛ با این حال، بیشتر پوسته‌های موجود در بایگانی نصب"
" شده‌اند"

#: main.cpp:181
#, kde-format
msgid "Theme installed successfully."
msgstr "پوسته با موفقیت نصب شد."

#: main.cpp:227
#, kde-format
msgid "Installing icon themes…"
msgstr "در حال نصب پوسته‌های شمایل…"

#: main.cpp:239
#, kde-format
msgid "Installing %1 theme…"
msgstr "در حال نصب پوستهٔ %1…"

#: ui/main.qml:67
#, kde-format
msgid "Install from File…"
msgstr "نصب از پرونده…"

#: ui/main.qml:72
#, kde-format
msgid "Get New…"
msgstr "دریافت موارد جدید…"

#: ui/main.qml:189
#, kde-format
msgctxt "@info:tooltip"
msgid "Remove icon theme"
msgstr "حذف پوستهٔ شمایل"

#: ui/main.qml:191
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete the active icon theme"
msgstr "پوستهٔ شمایل فعال را نمی‌توان حذف کرد"

#: ui/main.qml:193
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete system-installed icon themes"
msgstr "پوسته‌های شمایل نصب‌شده توسط سامانه را نمی‌توان حذف کرد"

#: ui/main.qml:201
#, kde-format
msgctxt "@info:tooltip"
msgid "Don’t delete this icon theme"
msgstr "این پوستهٔ شمایل را حذف نکن"

#: ui/main.qml:250
#, kde-format
msgid "Open Theme"
msgstr "باز کردن پوسته"

#: ui/main.qml:252
#, kde-format
msgid "Theme Files (*.tar.gz *.tar.bz2)"
msgstr "پرونده‌های پوسته (*.tar.gz *.tar.bz2)"
