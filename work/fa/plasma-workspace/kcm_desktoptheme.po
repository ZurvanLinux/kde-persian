#. i18n: ectx: label, entry (name), group (Theme)
#: desktopthemesettings.kcfg:9
#, kde-format
msgid "Name of the current Plasma Style"
msgstr "نام سبک کنونی پلاسما"

#: kcm.cpp:111
#, kde-format
msgid "Unable to create a temporary file."
msgstr "امکان ایجاد پروندهٔ موقت وجود ندارد."

#: kcm.cpp:122
#, kde-format
msgid "Unable to download the theme: %1"
msgstr "امکان بارگیری پوسته وجود ندارد: %1"

#: kcm.cpp:147
#, kde-format
msgid "Theme installed successfully."
msgstr "پوسته با موفقیت نصب شد."

#: kcm.cpp:150 kcm.cpp:156
#, kde-format
msgid "Theme installation failed."
msgstr "نصب پوسته ناموفق بود."

#: kcm.cpp:250
#, kde-format
msgid "Removing theme failed: %1"
msgstr "حذف پوسته ناموفق بود: %1"

#: plasma-apply-desktoptheme.cpp:33
#, kde-format
msgid ""
"This tool allows you to set the theme of the current Plasma session, without"
" accidentally setting it to one that is either not available, or which is "
"already set."
msgstr ""
"این ابزار به شما امکان می‌دهد پوستهٔ نشست کنونی پلاسما را تنظیم کنید، بدون "
"آن‌که به‌طور تصادفی آن را روی پوسته‌ای تنظیم کنید که موجود نیست یا از پیش "
"تنظیم شده است."

#: plasma-apply-desktoptheme.cpp:37
#, kde-format
msgid ""
"The name of the theme you wish to set for your current Plasma session "
"(passing a full path will only use the last part of the path)"
msgstr ""
"نام پوسته‌ای که می‌خواهید برای نشست کنونی پلاسمای خود تنظیم کنید (اگر مسیر "
"کامل وارد شود، فقط بخش پایانی مسیر استفاده خواهد شد)"

#: plasma-apply-desktoptheme.cpp:38
#, kde-format
msgid ""
"Show all the themes available on the system (and which is the current theme)"
msgstr ""
"نمایش همهٔ پوسته‌های موجود در سامانه (و این‌که کدام‌یک پوستهٔ کنونی است)"

#: plasma-apply-desktoptheme.cpp:55
#, kde-format
msgid ""
"The requested theme \"%1\" is already set as the theme for the current "
"Plasma session."
msgstr ""
"پوستهٔ درخواستی «%1» از پیش به عنوان پوستهٔ نشست کنونی پلاسما تنظیم شده است."

#: plasma-apply-desktoptheme.cpp:76
#, kde-format
msgid "The current Plasma session's theme has been set to %1"
msgstr "پوستهٔ نشست کنونی پلاسما روی %1 تنظیم شد"

#: plasma-apply-desktoptheme.cpp:78
#, kde-format
msgid ""
"Could not find theme \"%1\". The theme should be one of the following "
"options: %2"
msgstr "پوستهٔ «%1» یافت نشد. پوسته باید یکی از گزینه‌های زیر باشد: %2"

#: plasma-apply-desktoptheme.cpp:86
#, kde-format
msgid "You have the following Plasma themes on your system:"
msgstr "پوسته‌های پلاسمای زیر در سامانهٔ شما موجود هستند:"

#: ui/main.qml:101
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "All themes"
msgstr "همهٔ پوسته‌ها"

#: ui/main.qml:102
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "Light themes"
msgstr "پوسته‌های روشن"

#: ui/main.qml:103
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "Dark themes"
msgstr "پوسته‌های تیره"

#: ui/main.qml:104
#, kde-format
msgctxt "@item:inlistbox filters displayed themes"
msgid "Color scheme compatible"
msgstr "سازگار با طرح رنگ"

#: ui/main.qml:114
#, kde-format
msgid "Install from File…"
msgstr "نصب از پرونده…"

#: ui/main.qml:119
#, kde-format
msgid "Get New…"
msgstr "دریافت جدید…"

#: ui/main.qml:132
#, kde-format
msgid "Follows color scheme"
msgstr "پیروی از طرح رنگ"

#: ui/main.qml:150
#, kde-format
msgid "Edit Theme…"
msgstr "ویرایش پوسته…"

#: ui/main.qml:158
#, kde-format
msgctxt "@info:tooltip"
msgid "Remove Plasma style"
msgstr "حذف سبک پلاسما"

#: ui/main.qml:160
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete the active Plasma style"
msgstr "امکان حذف سبک فعال پلاسما وجود ندارد"

#: ui/main.qml:162
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete system-installed Plasma styles"
msgstr "امکان حذف سبک‌های پلاسمای نصب‌شده توسط سامانه وجود ندارد"

#: ui/main.qml:170
#, kde-format
msgctxt "@info:tooltip"
msgid "Don’t delete this Plasma style"
msgstr "این سبک پلاسما را حذف نکنید"

#: ui/main.qml:189
#, kde-format
msgid "Open Theme"
msgstr "باز کردن پوسته"

#: ui/main.qml:191
#, kde-format
msgid "Theme Files (*.zip *.tar.gz *.tar.bz2)"
msgstr "پرونده‌های پوسته (*.zip *.tar.gz *.tar.bz2)"
