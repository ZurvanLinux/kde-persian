msgstr "طلوع خورشید در %1 آغاز می‌شود و در %2 پایان می‌یابد"

#: ui/SunPath.qml:57
#, kde-format
msgctxt "@label"
msgid "Sunrise"
msgstr "طلوع خورشید"

#: ui/SunPath.qml:77
#, kde-format
msgctxt "@info:tooltip; the variables are times of day, e.g. 07:30"
msgid "Sunset starts at %1 and ends at %2"
msgstr "غروب خورشید در %1 آغاز می‌شود و در %2 پایان می‌یابد"

