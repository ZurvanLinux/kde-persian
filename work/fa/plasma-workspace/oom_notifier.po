#: module.cpp:68
#, kde-format
msgctxt "@title"
msgid "Memory Shortage Avoided"
msgstr "از کمبود حافظه جلوگیری شد"

#: module.cpp:71
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<command>%1</command> has been terminated by the Linux kernel because the "
"system is low on memory. Consider closing unused applications or browser "
"tabs."
msgstr ""
"<command>%1</command> توسط هستهٔ لینوکس خاتمه یافت، زیرا سامانه با کمبود "
"حافظه مواجه است. بستن برنامه‌ها یا زبانه‌های استفاده‌نشدهٔ مرورگر را در نظر "
"بگیرید."

#: module.cpp:77
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The background service <command>%1</command> has been terminated by the "
"Linux kernel because the system is low on memory. Consider closing unused "
"applications or browser tabs."
msgstr ""
"سرویس پس‌زمینهٔ <command>%1</command> توسط هستهٔ لینوکس خاتمه یافت، زیرا "
"سامانه با کمبود حافظه مواجه است. بستن برنامه‌ها یا زبانه‌های استفاده‌نشدهٔ "
"مرورگر را در نظر بگیرید."

#: module.cpp:85
#, kde-format
msgctxt "@action"
msgid "Restart Application"
msgstr "راه‌اندازی مجدد برنامه"
