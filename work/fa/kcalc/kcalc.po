#. i18n: ectx: label, entry (BinaryGrouping), group (Grouping)
#: kcalc.kcfg:194
#, kde-format
msgid ""
"Binary figures will be separated by a whitespace after every Xth digit."
msgstr "ارقام دودویی پس از هر X رقم با یک فاصله جدا می‌شوند."

#. i18n: ectx: whatsthis, entry (BinaryGrouping), group (Grouping)
#: kcalc.kcfg:199
#, kde-format
msgid ""
"\n"
"            For easier reading it's possible to visually group the individual digits into pairs\n"
"            for example instead of 10111001 you can display 1011 1001, by setting the setting to\n"
"            4, thus inserting a whitespace after every 4th digit.\n"
"        "
msgstr ""
"\n"
"            برای خوانایی آسان‌تر، امکان گروه‌بندی بصری ارقام به صورت جفت وجود دارد؛\n"
"            مثلاً می‌توانید به جای ۱۰۱۱۱۰۰۱، با تنظیم مقدار روی ۴ و درج یک فاصله پس از هر ۴ رقم،\n"
"            آن را به صورت ۱۰۱۱ ۱۰۰۱ نمایش دهید.\n"
"        "

#. i18n: ectx: label, entry (OctalGrouping), group (Grouping)
#: kcalc.kcfg:203
#, kde-format
msgid "Octal figures will be separated by a whitespace after every Xth digit."
msgstr "ارقام هشت‌هشتی پس از هر X رقم با یک فاصله جدا می‌شوند."

#. i18n: ectx: whatsthis, entry (OctalGrouping), group (Grouping)
#: kcalc.kcfg:208
#, kde-format
msgid ""
"\n"
"            For easier reading it's possible to visually group the individual digits into pairs\n"
"            for example instead of 42140213 you can display 4214 0213, by setting the setting to\n"
"            4, thus inserting a whitespace after every 4th digit.\n"
"        "
msgstr ""
"\n"
"            برای خوانایی آسان‌تر، امکان گروه‌بندی بصری ارقام به صورت جفت وجود دارد؛\n"
"            مثلاً می‌توانید به جای ۴۲۱۴۰۲۱۳، با تنظیم مقدار روی ۴ و درج یک فاصله پس از هر ۴ رقم،\n"
"            آن را به صورت ۴۲۱۴ ۰۲۱۳ نمایش دهید.\n"
"        "

#. i18n: ectx: label, entry (HexadecimalGrouping), group (Grouping)
#: kcalc.kcfg:212
#, kde-format
msgid ""
"Hexadecimal figures will be separated by a whitespace after every Xth digit."
msgstr "ارقام شانزده‌شانزدهی پس از هر X رقم با یک فاصله جدا می‌شوند."

#. i18n: ectx: whatsthis, entry (HexadecimalGrouping), group (Grouping)
#: kcalc.kcfg:217
#, kde-format
msgid ""
"\n"
"            For easier reading it's possible to visually group the individual digits into pairs\n"
"            for example instead of AF1C42 you can display AF 1C 42, by setting the setting to\n"
"            2, thus inserting a whitespace after every 2nd digit.\n"
"        "
msgstr ""
"\n"
"            برای خوانایی آسان‌تر، امکان گروه‌بندی بصری ارقام به صورت جفت وجود دارد؛\n"
"            مثلاً می‌توانید به جای AF1C42، با تنظیم مقدار روی ۲ و درج یک فاصله پس از هر ۲ رقم،\n"
"            آن را به صورت AF 1C 42 نمایش دهید.\n"
"        "

