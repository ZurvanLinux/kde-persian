#. i18n: ectx: property (toolTip), widget (QLabel, m_lbOptions)
#: widgets/processtoolconfigwidget.ui:80
#, no-c-format, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Consider the file <span style=\" font-style:italic;\">myBestBook.tex</span> with full path <span style=\" font-style:italic;\">/home/archimedes/latex/</span><span style=\" font-style:italic;\">myBestBook.tex</span>, compiled with pdflatex to <span style=\" font-style:italic;\">myBestBook.pdf</span>.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The variables have the following meanings:</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%source</span>: filename with suffix but without path &lt;-&gt; <span style=\" font-style:italic;\">myBestBook.tex</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%S:</span> filename without suffix and without path &lt;-&gt; <span style=\" font-style:italic;\">myBestBook</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%dir_base</span>: path of the source file without filename  &lt;-&gt;<span style=\" font-style:italic;\"> /home/archimedes/latex</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600;\">%dir_target<span style=\" font-weight:400;\">: path of the target file without filename, same as %dir_base if no relative path has been set &lt;-&gt; </span><span style=\" font-weight:400; font-style:italic;\">/home/archimedes/latex</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%target:</span> target filename without path &lt;-&gt; <span style=\" font-style:italic;\">myBestBook.pdf</span></p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600; font-style:italic;\"></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%res:</span> resolution of the quickpreview action set in configure kile-&gt;tools-&gt;preview</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%AFL</span>: List of all files in a project marked for archiving. Set the archive flag in the \"Files and projects\" sidebar using the context menu.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">پروندهٔ <span style=\" font-style:italic;\">myBestBook.tex</span> را با مسیر کامل <span style=\" font-style:italic;\">/home/archimedes/latex/</span><span style=\" font-style:italic;\">myBestBook.tex</span>، همگردانی‌شده با pdflatex به <span style=\" font-style:italic;\">myBestBook.pdf</span> در نظر بگیرید.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">متغیرها معانی زیر را دارند:</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%source</span>: نام پرونده با پسوند اما بدون مسیر &lt;-&gt; <span style=\" font-style:italic;\">myBestBook.tex</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%S:</span> نام پرونده بدون پسوند و بدون مسیر &lt;-&gt; <span style=\" font-style:italic;\">myBestBook</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%dir_base</span>: مسیر پروندهٔ مبدأ بدون نام پرونده  &lt;-&gt;<span style=\" font-style:italic;\"> /home/archimedes/latex</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600;\">%dir_target<span style=\" font-weight:400;\">: مسیر پروندهٔ مقصد بدون نام پرونده، یکسان با %dir_base در صورت تعیین نشدن مسیر نسبی &lt;-&gt; </span><span style=\" font-weight:400; font-style:italic;\">/home/archimedes/latex</span></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%target:</span> نام پروندهٔ مقصد بدون مسیر &lt;-&gt; <span style=\" font-style:italic;\">myBestBook.pdf</span></p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-weight:600; font-style:italic;\"></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%res:</span> تفکیک‌پذیری کنش پیش‌نمایش سریع تنظیم‌شده در پیکربندی کایل-&gt;ابزارها-&gt;پیش‌نمایش</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">%AFL</span>: فهرست تمام پرونده‌های پروژه که برای بایگانی علامت‌گذاری شده‌اند. نشان بایگانی را در نوار کناری «پرونده‌ها و پروژه‌ها» با استفاده از منوی زمینه تنظیم کنید.</p></body></html>"

