#, kde-format
msgid "Open scan dialog"
msgstr "باز کردن پنجرهٔ پویش"

#: i18n-hplip.cpp:3
#, kde-format
msgid "None"
msgstr "هیچ‌کدام"

#: i18n-hplip.cpp:4
#, kde-format
