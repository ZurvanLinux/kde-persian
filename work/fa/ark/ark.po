#: plugins/clirarplugin/cliplugin.cpp:154
#: plugins/clirarplugin/cliplugin.cpp:294
#: plugins/clirarplugin/cliplugin.cpp:541
#, kde-format
msgid "Failed to find all archive volumes."
msgstr "یافتن همهٔ جلدهای بایگانی شکست خورد."

#: plugins/clirarplugin/cliplugin.cpp:315
#, kde-format
msgid ""
"Your unrar executable is version %1, which is too old to handle this "
"archive. Please update to a more recent version."
msgstr ""
"نگارش پروندهٔ اجرایی unrar شما %1 است که برای کار با این بایگانی بیش از حد "
"قدیمی است. لطفاً آن را به نگارشی تازه‌تر به‌روزرسانی کنید."

#: plugins/clirarplugin/cliplugin.cpp:321
#, kde-format
msgid ""
"Unrar reported a non-RAR archive. The installed unrar version (%1) is old. "
"Try updating your unrar."
msgstr ""
"برنامهٔ unrar گزارش داد که بایگانی از نوع RAR نیست. نگارش نصب‌شدهٔ unrar "
"(%1) قدیمی است. به‌روزرسانی unrar خود را امتحان کنید."

#: plugins/clirarplugin/cliplugin.cpp:536
#, kde-format
msgid "One or more wrong checksums"
msgstr "یک یا چند مجموع مقابله‌ای نادرست"

#: plugins/cliunarchiverplugin/cliplugin.cpp:104
#, kde-format
msgid "Extraction failed."
msgstr "استخراج شکست خورد."

#: plugins/cliunarchiverplugin/cliplugin.cpp:138
