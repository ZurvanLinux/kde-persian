msgstr[1] "حذف پرونده‌ها"

#: part/part.cpp:1649
#, kde-format
msgctxt "@title:window"
msgid "Save Copy As"
msgstr "ذخیرهٔ رونوشت به نام"

#: part/part.cpp:1664
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The archive could not be saved as <filename>%1</filename>. Try saving it to "
"another location."
msgstr ""
"ذخیرهٔ بایگانی با نام <filename>%1</filename> ممکن نبود. ذخیره‌اش در مکانی "
"دیگر را امتحان کنید."

#: part/part.cpp:1669
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The archive <filename>%1</filename> does not exist anymore, therefore it "
"cannot be copied to the specified location."
msgstr ""
"بایگانی <filename>%1</filename> دیگر وجود ندارد، بنابراین نمی‌توان آن را در "
"مکان مشخص‌شده رونوشت کرد."

#: plugins/cli7zplugin/cliplugin.cpp:133
#: plugins/cliunarchiverplugin/cliplugin.cpp:92
#, kde-format
msgid "Listing the archive failed."
msgstr "فهرست کردن بایگانی شکست خورد."

#: plugins/cli7zplugin/cliplugin.cpp:305
#, kde-format
msgid "Extraction failed due to an unknown error."
msgstr "استخراج به دلیل خطایی ناشناخته شکست خورد."

#: plugins/cli7zplugin/cliplugin.cpp:310
#: plugins/clizipplugin/cliplugin.cpp:192
#, kde-format
msgid ""
"Extraction failed due to one or more corrupt files. Any extracted files may "
"be damaged."
msgstr ""
"استخراج به دلیل وجود یک یا چند پروندهٔ خراب شکست خورد. هر پروندهٔ "
"استخراج‌شده‌ای ممکن است آسیب دیده باشد."

#: plugins/cli7zplugin/cliplugin.cpp:320
#, kde-format
msgid ""
"Delete operation failed. Try upgrading 7z or disabling the 7z plugin in the "
"configuration dialog."
msgstr ""
"عملیات حذف شکست خورد. ارتقای 7z یا از کار انداختن افزونهٔ 7z در گفت‌وگوی "
"پیکربندی را امتحان کنید."

