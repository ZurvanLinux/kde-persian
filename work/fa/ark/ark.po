#: plugins/libarchive/libarchiveplugin.cpp:123
#, kde-format
msgctxt "@info"
msgid ""
"The archive may be corrupt or has header-encryption, which is currently not "
"supported."
msgstr ""
"بایگانی ممکن است خراب باشد یا دارای رمزنگاری سرآیند باشد که در حال حاضر "
"پشتیبانی نمی‌شود."

#: plugins/libarchive/libarchiveplugin.cpp:526
#, kde-format
msgctxt "@info"
msgid "Fatal error, extraction aborted."
msgstr "خطای مهلک، استخراج لغو شد."

#: plugins/libarchive/libarchiveplugin.cpp:552
#, kde-format
msgctxt "@info"
msgid "Extraction of encrypted 7-zip entries is currently not supported."
msgstr "استخراج ورودی‌های رمزنگاری‌شدهٔ 7-zip در حال حاضر پشتیبانی نمی‌شود."

