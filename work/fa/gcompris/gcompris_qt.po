msgid ""
"Tab: toggle navigation between the panel and the board without any other "
"action"
msgstr "تب: جابه‌جایی ناوبری بین تابلو و تخته بدون هیچ اقدام دیگری"

#: activities/babymatch/ActivityInfo.qml:32
#: activities/babyshapes/ActivityInfo.qml:32
#: activities/chronos/ActivityInfo.qml:33
#: activities/details/ActivityInfo.qml:31
#: activities/geo-country/ActivityInfo.qml:32
#: activities/geography/ActivityInfo.qml:32
#: activities/imagename/ActivityInfo.qml:32
