msgid "Select the image where the child is under the box."
msgstr "تصویری را که در آن کودک زیر جعبه است انتخاب کنید."

#: activities/positions/resource/2/Data.qml:14
msgctxt "Data|"
msgid "All positions (with left and right)."
msgstr "همهٔ موقعیت‌ها (شامل چپ و راست)."

#. it refers to the position on the right side
#: activities/positions/resource/2/Data.qml:20
msgctxt "Data|"
