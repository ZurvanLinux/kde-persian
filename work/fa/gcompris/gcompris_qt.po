#. Activity title
#: activities/ordering_sentences/ActivityInfo.qml:20
msgctxt "ActivityInfo|"
msgid "Ordering sentences"
msgstr "مرتب‌سازی جمله‌ها"

#. Help title
#: activities/ordering_sentences/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid "Arrange the given words to form a meaningful sentence."
msgstr "کلمه‌های داده‌شده را مرتب کنید تا یک جملهٔ معنادار ساخته شود."

#. Help goal
#: activities/ordering_sentences/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "Practice ordering words to form a meaningful sentence."
msgstr "مرتب کردن کلمه‌ها برای ساخت یک جملهٔ معنادار را تمرین کنید."

#. Help manual
#: activities/ordering_sentences/ActivityInfo.qml:29
msgctxt "ActivityInfo|"
msgid ""
"You are provided with some words. Drag and drop them to the upper area to "
"form a meaningful sentence."
msgstr ""
"چند کلمه در اختیار شما قرار گرفته است. آن‌ها را به ناحیهٔ بالایی بکشید و رها"
" کنید تا یک جملهٔ معنادار تشکیل شود."

#: activities/ordering_sentences/resource/1/Data.qml:13
msgctxt "Data|"
msgid "Below 5 words."
msgstr "کمتر از ۵ کلمه."

#. These sentences should not need to be translated word by word. Please add
#. at least 10 sentences, each one being between 3 and 5 words. Use | to
#. separate group of words. The aim of the string is to shuffle the group of
#. words and let the child reorder them correctly. We should not be able to
#. form a correct sentence by shuffling some words in the final sentence.
#: activities/ordering_sentences/resource/1/Data.qml:18
msgctxt "Data|"
msgid ""
"The|dog|barks.\n"
"The|house|is|red.\n"
"The|boy|reads|a book.\n"
"My|friend|is|nice.\n"
"What|a|beautiful|sight!\n"
"Steve|jumps|into|the|pool.\n"
"Jessica|wants|a|new|book.\n"
"Mom|made|me|a|sandwich.\n"
"Tigers|live|in|forests.\n"
"Football|is|a|team|game."
msgstr ""
"سگ|پارس|می‌کند.\n"
"خانه|قرمز|است.\n"
"پسر|یک|کتاب|می‌خواند.\n"
"دوست|من|مهربان|است.\n"
"چه|منظره|زیبایی!\n"
"استیو|داخل|استخر|می‌پرد.\n"
"جسیکا|یک|کتاب|جدید|می‌خواهد.\n"
"مامان|برای|من|ساندویچ|درست|کرد.\n"
"ببرها|در|جنگل‌ها|زندگی|می‌کنند.\n"
"فوتبال|یک|بازی|گروهی|است."

#: activities/ordering_sentences/resource/2/Data.qml:13
msgctxt "Data|"
msgid "Below 10 words."
msgstr "کمتر از ۱۰ کلمه."

#. These sentences should not need to be translated word by word. Please add
#. at least 10 sentences, each one being between 6 and 10 words. Use | to
#. separate group of words. The aim of the string is to shuffle the group of
#. words and let the child reorder them correctly. We should not be able to
#. form a correct sentence by shuffling some words in the final sentence.
#: activities/ordering_sentences/resource/2/Data.qml:18
msgctxt "Data|"
msgid ""
"The|sun|is|shining|in|the|sky.\n"
"Kids|enjoy|playing|outside|in|the|evening.\n"
"Are|you|going|out|for|lunch?\n"
"The|girl|tied|her|tennis|shoes|and|went|outside.\n"
"Sam|felt|sick|after|eating|five|huge|candy|bars.\n"
"Our|family|takes|a|vacation|to|the|beach|every|year.\n"
"Uncle|Joe|gave|me|a|red|toy|truck.\n"
"When|you|finish|your|rice|you|can|eat|dessert.\n"
"Mom|has|asked|me|to|play|in|the|room.\n"
"I|think|we|are|going|to|have|a|good|day."
msgstr ""
"خورشید|در|آسمان|می‌درخشد.\n"
"بچه‌ها|از|بازی|بیرون|از|خانه|در|عصر|لذت|می‌برند.\n"
"آیا|برای|ناهار|بیرون|می‌روی؟\n"
"دختر|بند|کفش‌های|کتانی‌اش|را|بست|و|بیرون|رفت.\n"
"سام|پس|از|خوردن|پنج|شکلات|تخته‌ای|بزرگ|حالت|تهوع|گرفت.\n"
"خانواده|ما|هر|سال|برای|تعطیلات|به|ساحل|می‌روند.\n"
"عمو|جو|یک|کامیون|اسباب‌بازی|قرمز|به|من|داد.\n"
"وقتی|برنجت|را|تمام|کردی|می‌توانی|دسر|بخوری.\n"
"مامان|از|من|خواسته|در|اتاق|بازی|کنم.\n"
"فکر|می‌کنم|روز|خوبی|خواهیم|داشت."

#. Activity title
#: activities/oware/ActivityInfo.qml:14
msgctxt "ActivityInfo|"
msgid "Play oware (against Tux)"
msgstr "بازی اواری (در برابر توکس)"

#. Help title
#: activities/oware/ActivityInfo.qml:16
