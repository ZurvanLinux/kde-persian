msgctxt "ActivityInfo|"
msgid "Delete or Backspace: remove item from selected spot"
msgstr "حذف یا پس‌بر: برداشتن مورد از نقطهٔ انتخاب‌شده"

#: activities/babymatch/resource/board/board1_0.qml:14
msgctxt "board1_0|"
