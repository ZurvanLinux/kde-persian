#. Activity title
#: activities/adjacent_numbers/ActivityInfo.qml:14
msgctxt "ActivityInfo|"
msgid "Find the adjacent numbers"
msgstr "یافتن اعداد مجاور"

#. Help title
#: activities/adjacent_numbers/ActivityInfo.qml:16
msgctxt "ActivityInfo|"
msgid "Find the missing adjacent numbers."
msgstr "اعداد مجاور ناموجود را بیابید."

#. Help goal
#: activities/adjacent_numbers/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid "Learn to order numbers."
msgstr "یادگیری مرتب کردن اعداد."

#. Help manual
#: activities/adjacent_numbers/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid "Find the requested numbers and drag them to the corresponding spot."
msgstr "اعداد خواسته‌شده را پیدا کنید و به جایگاه مربوط بکشید."

#. One or more numbers to find, all at the beginning of the list. Don't
#. display the %n in the translation if possible (actual English strings are
#. "Find the previous number" and "Find the previous numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:60
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n previous number(s)."
msgid_plural "Find the %n previous number(s)."
msgstr[0] "%n عدد قبلی را پیدا کنید."
msgstr[1] "%n عدد قبلی را پیدا کنید."

#. One or more numbers to find, at the end of the list. Don't display the %n
#. in the translation if possible (actual English strings are "Find the next
#. number" and "Find the next numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:64
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n next number(s)."
msgid_plural "Find the %n next number(s)."
msgstr[0] "%n عدد بعدی را پیدا کنید."
msgstr[1] "%n عدد بعدی را پیدا کنید."

#. One or more numbers to find, not at the beginning nor at the end of the
#. list. Don't display the %n in the translation if possible (actual English
#. strings are "Find the in-between number" and "Find the in-between numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:68
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n in-between number(s)"
msgid_plural "Find the %n in-between number(s)"
msgstr[0] "%n عدد بین این‌ها را پیدا کنید"
msgstr[1] "%n عدد بین این‌ها را پیدا کنید"

#. More than one number to find, with at least one number at the beginning or
#. at the end of the list. Don't display the %n in the translation if possible
#. (actual English string is "Find the missing numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:72
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n missing numbers"
msgid_plural "Find the %n missing numbers"
msgstr[0] "%n عدد گمشده را پیدا کنید"
msgstr[1] "%n عدد گمشده را پیدا کنید"

#: activities/adjacent_numbers/resource/1/Data.qml:9
msgctxt "Data|"
msgid "Find numbers between 1 and 10."
msgstr "اعداد بین ۱ تا ۱۰ را پیدا کنید."

#: activities/adjacent_numbers/resource/2/Data.qml:9
msgctxt "Data|"
msgid "Find numbers between 0 and 20."
msgstr "اعداد بین ۰ تا ۲۰ را پیدا کنید."

#: activities/adjacent_numbers/resource/3/Data.qml:9
msgctxt "Data|"
msgid "Find numbers between 0 and 100."
msgstr "اعداد بین ۰ تا ۱۰۰ را پیدا کنید."

#: activities/adjacent_numbers/resource/4/Data.qml:9
msgctxt "Data|"
msgid "Find numbers between -10 and -1."
msgstr "اعداد بین ‎-۱۰ و ‎-۱ را پیدا کنید."

#: activities/adjacent_numbers/resource/5/Data.qml:9
msgctxt "Data|"
msgid "Find numbers between -10 and 10."
msgstr "اعداد بین ‎-۱۰ تا ۱۰ را پیدا کنید."

#. Activity title
#: activities/advanced_colors/ActivityInfo.qml:15
msgctxt "ActivityInfo|"
msgid "Advanced colors"
msgstr "رنگ‌های پیشرفته"

#. Help title
#: activities/advanced_colors/ActivityInfo.qml:17
msgctxt "ActivityInfo|"
msgid "Select the butterfly of the correct color."
msgstr "پروانه‌ای با رنگ درست را انتخاب کنید."

