#: src/helper/systemdgenie.actions:2
msgctxt "Name"
msgid "Systemd Genie"
msgstr "جنی سیستم‌دی"

#: src/helper/systemdgenie.actions:50
msgctxt "Name"
msgid "Save a systemd unit file"
msgstr "ذخیرهٔ پروندهٔ واحد systemd"

#: src/helper/systemdgenie.actions:96
msgctxt "Description"
msgid "Administrator authorization is required to save the systemd unit file"
msgstr "برای ذخیرهٔ پروندهٔ واحد systemd به مجوز مدیر سیستم نیاز است"

#: src/helper/systemdgenie.actions:145
msgctxt "Name"
msgid "Manipulate systemd over D-Bus"
msgstr "دست‌کاری systemd از طریق D-Bus"

#: src/helper/systemdgenie.actions:190
msgctxt "Description"
msgid "Administrator authorization is required to manipulate systemd"
msgstr "برای دست‌کاری systemd به مجوز مدیر سیستم نیاز است"

#: src/org.kde.systemdgenie.desktop:2
msgctxt "Name"
msgid "systemdGenie"
msgstr "systemdGenie"

#: src/org.kde.systemdgenie.desktop:38
msgctxt "GenericName"
msgid "systemd Management Tool"
msgstr "ابزار مدیریت systemd"

#: src/org.kde.systemdgenie.desktop:75
msgctxt "Comment"
msgid "Manage systemd units, timers, sessions and config files"
msgstr "مدیریت واحدها، زمان‌سنج‌ها، نشست‌ها و پرونده‌های پیکربندی systemd"
