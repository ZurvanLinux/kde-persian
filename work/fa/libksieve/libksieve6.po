"پاسخ سرور:\n"
"%1"

#: ksievecore/managescriptsjob/parseuserscriptjob.cpp:64
#: ksieveui/debug/sievedebugdialog.cpp:188
#: ksieveui/managesievescriptsdialog.cpp:182
#, kde-format
msgid ""
"Retrieving the script failed.\n"
"The server responded:\n"
