#: kmanagesieve/session.cpp:91
#, kde-format
msgid "Cannot use TLS since the underlying Qt library does not support it."
msgstr ""
"نمی‌توان از TLS استفاده کرد زیرا کتابخانهٔ زیربنایی Qt از آن پشتیبانی "
"نمی‌کند."

#: kmanagesieve/session.cpp:98
#, kde-format
msgid ""
"TLS encryption was requested, but your Sieve server does not advertise TLS in its capabilities.\n"
"You can choose to try to initiate TLS negotiations nonetheless, or cancel the operation."
msgstr ""
"رمزنگاری TLS درخواست شده است، اما کارساز Sieve شما TLS را در قابلیت‌هایش اعلام نمی‌کند.\n"
"می‌توانید با این وجود شروع مذاکرات TLS را امتحان کنید، یا عملیات را لغو نمایید."

#: kmanagesieve/session.cpp:100
#, kde-format
msgctxt "@title:window"
msgid "Sieve Server Does Not Advertise TLS"
msgstr "کارساز Sieve از TLS پشتیبانی اعلام نمی‌کند"

#: kmanagesieve/session.cpp:101
#, kde-format
msgctxt "@action:button"
msgid "&Start TLS nonetheless"
msgstr "با این وجود TLS شروع شود"

#: kmanagesieve/session.cpp:105
#, kde-format
msgid "TLS encryption requested, but not supported by server."
msgstr "رمزنگاری TLS درخواست شد، اما توسط کارساز پشتیبانی نمی‌شود."

#: kmanagesieve/session.cpp:147
#, kde-format
msgid ""
"The server does not seem to support TLS. Disable TLS if you want to connect "
"without encryption."
msgstr ""
"به نظر نمی‌رسد کارساز از TLS پشتیبانی کند. اگر می‌خواهید بدون رمزنگاری متصل "
"شوید، TLS را غیرفعال کنید."

#: kmanagesieve/session.cpp:259
#, kde-format
msgid "Sieve Authentication Details"
msgstr "جزئیات احراز هویت Sieve"

#: kmanagesieve/session.cpp:261
#, kde-format
msgid ""
"Please enter your authentication details for your sieve account \"%1\" "
"(usually the same as your email password):"
msgstr ""
"لطفاً جزئیات احراز هویت خود را برای حساب sieve «%1» وارد کنید (معمولاً همان "
"گذرواژهٔ رایانامه‌تان است):"

#: kmanagesieve/session.cpp:322
#, kde-format
msgid ""
"The Sieve server on %1 has reported an error:\n"
"%2"
msgstr ""
"کارساز Sieve روی %1 خطایی را گزارش کرده است:\n"
"%2"

#: kmanagesieve/session.cpp:322
#, kde-format
msgctxt "@title:window"
msgid "Sieve Manager"
msgstr "مدیر Sieve"

#: kmanagesieve/sessionthread.cpp:301
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"احراز هویت ناموفق بود.\n"
"احتمالاً گذرواژه اشتباه است.\n"
"پاسخ سرور:\n"
"%1"

#: kmanagesieve/sievejob.cpp:144 kmanagesieve/sievejob.cpp:151
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"This is probably due to errors in the script.\n"
"The server responded:\n"
"%1"
msgstr ""
"اسکریپت با موفقیت بارگذاری نشد.\n"
"احتمالاً به دلیل وجود خطا در اسکریپت است.\n"
"پاسخ سرور:\n"
"%1"

#: kmanagesieve/sievejob.cpp:156
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"The script may contain errors."
msgstr ""
"اسکریپت با موفقیت بارگذاری نشد.\n"
"ممکن است اسکریپت حاوی خطا باشد."

#: ksieve/error.cpp:91
#, kde-format
msgid "Parse error: Carriage Return (CR) without Line Feed (LF)"
msgstr "خطای تجزیه: بازگشت به ابتدای سطر (CR) بدون سطر جدید (LF)"

#: ksieve/error.cpp:95
#, kde-format
msgid ""
"Parse error: Unquoted Slash ('/') without Asterisk ('*'). Broken Comment?"
msgstr ""
"خطای تجزیه: اسلش بدون نقل‌قول ('/') بدون علامت ستاره ('*'). آیا کامنت ناقص "
"است؟"

#: ksieve/error.cpp:99
#, kde-format
msgid "Parse error: Illegal Character"
msgstr "خطای تجزیه: نویسه غیرمجاز"

#: ksieve/error.cpp:102
#, kde-format
msgid "Parse error: Unexpected Character, probably a missing space?"
msgstr "خطای تجزیه: نویسه غیرمنتظره، احتمالاً یک فاصله جا افتاده است؟"

#: ksieve/error.cpp:105
#, kde-format
msgid "Parse error: Tag Name has leading Digits"
msgstr "خطای تجزیه: نام برچسب با رقم شروع شده است"

#: ksieve/error.cpp:109
#, kde-format
msgid ""
"Parse error: Only whitespace and #comments may follow \"text:\" on the same "
"line"
msgstr "خطای تجزیه: در همان خط پس از «:text» فقط فاصله و #کامنت مجاز است"

#: ksieve/error.cpp:113
#, kde-format
msgid "Parse error: Number out of Range (must be smaller than %1)"
msgstr "خطای تجزیه: عدد خارج از محدوده است (باید کوچک‌تر از %1 باشد)"

#: ksieve/error.cpp:116
#, kde-format
msgid "Parse error: Invalid UTF-8 sequence"
msgstr "خطای تجزیه: دنباله نامعتبر UTF-8"

#: ksieve/error.cpp:119
#, kde-format
msgid ""
"Parse error: Premature end of Multiline String (did you forget the '.'?)"
msgstr "خطای تجزیه: پایان زودهنگام رشته چندخطی (آیا '.' را فراموش کرده‌اید؟)"

#: ksieve/error.cpp:122
#, kde-format
msgid "Parse error: Premature end of Quoted String (missing closing '\"')"
msgstr ""
"خطای تجزیه: پایان زودهنگام رشته نقل‌قول‌شده (علامت بستن '\"' وجود ندارد)"

#: ksieve/error.cpp:125
#, kde-format
msgid "Parse error: Premature end of String List (missing closing ']')"
msgstr "خطای تجزیه: پایان زودهنگام فهرست رشته‌ها (علامت بستن ']' وجود ندارد)"

#: ksieve/error.cpp:128
#, kde-format
msgid "Parse error: Premature end of Test List (missing closing ')')"
msgstr "خطای تجزیه: پایان زودهنگام فهرست آزمون‌ها (علامت بستن ')' وجود ندارد)"

#: ksieve/error.cpp:131
#, kde-format
msgid "Parse error: Premature end of Block (missing closing '}')"
msgstr "خطای تجزیه: پایان زودهنگام بلوک (علامت بستن '}' وجود ندارد)"

#: ksieve/error.cpp:134
#, kde-format
msgid "Parse error: Missing Whitespace"
msgstr "خطای تجزیه: فاصله خالی (Whitespace) وجود ندارد"

#: ksieve/error.cpp:137
#, kde-format
msgid "Parse error: Missing ';' or Block"
msgstr "خطای تجزیه: ';' یا بلوک وجود ندارد"

#: ksieve/error.cpp:140
#, kde-format
msgid "Parse error: Expected ';' or '{', got something else"
msgstr "خطای تجزیه: انتظار ';' یا '{' می‌رفت، اما چیز دیگری دریافت شد"

#: ksieve/error.cpp:143 ksieve/error.cpp:158
#, kde-format
msgid "Parse error: Expected Command, got something else"
msgstr "خطای تجزیه: انتظار دستور (Command) می‌رفت، اما چیز دیگری دریافت شد"

#: ksieve/error.cpp:146
#, kde-format
msgid "Parse error: Trailing, Leading or Duplicate Commas in String List"
msgstr "خطای تجزیه: ویرگول در ابتدا، انتها یا تکراری در فهرست رشته‌ها"

#: ksieve/error.cpp:149
#, kde-format
msgid "Parse error: Trailing, Leading or Duplicate Commas in Test List"
msgstr "خطای تجزیه: ویرگول در ابتدا، انتها یا تکراری در فهرست آزمون‌ها"

#: ksieve/error.cpp:152
#, kde-format
msgid "Parse error: Missing ',' between Strings in String List"
msgstr "خطای تجزیه: نبود «,» بین رشته‌ها در فهرست رشته‌ها"

#: ksieve/error.cpp:155
#, kde-format
msgid "Parse error: Missing ',' between Tests in Test List"
msgstr "خطای تجزیه: نبود «,» بین آزمون‌ها در فهرست آزمون‌ها"

#: ksieve/error.cpp:161
#, kde-format
msgid "Parse error: Only Strings allowed in String Lists"
msgstr "خطای تجزیه: فقط استفاده از رشته در فهرست رشته‌ها مجاز است"

#: ksieve/error.cpp:164
#, kde-format
msgid "Parse error: Only Tests allowed in Test Lists"
msgstr "خطای تجزیه: فقط استفاده از آزمون در فهرست آزمون‌ها مجاز است"

#: ksieve/error.cpp:169
#, kde-format
msgid "\"require\" must be first command"
msgstr "دستور «require» باید نخستین دستور باشد"

#: ksieve/error.cpp:172
#, kde-format
msgid "\"require\" missing for command \"%1\""
msgstr "«require» برای دستور «%1» وجود ندارد"

#: ksieve/error.cpp:175
#, kde-format
msgid "\"require\" missing for test \"%1\""
msgstr "«require» برای آزمون «%1» وجود ندارد"

#: ksieve/error.cpp:178
#, kde-format
msgid "\"require\" missing for comparator \"%1\""
msgstr "«require» برای مقایسه‌گر «%1» وجود ندارد"

#: ksieve/error.cpp:181
#, kde-format
msgid "Command \"%1\" not supported"
msgstr "دستور «%1» پشتیبانی نمی‌شود"

#: ksieve/error.cpp:184
#, kde-format
msgid "Test \"%1\" not supported"
msgstr "آزمون «%1» پشتیبانی نمی‌شود"

#: ksieve/error.cpp:187
#, kde-format
msgid "Comparator \"%1\" not supported"
msgstr "مقایسه‌گر «%1» پشتیبانی نمی‌شود"

#: ksieve/error.cpp:190
#, kde-format
msgid "Site Policy Limit Violation: Test nesting too deep (max. %1)"
msgstr "نقض محدودیت خط‌مشی سایت: تو در تویی بیش از حد آزمون (حداکثر %1)"

#: ksieve/error.cpp:193
#, kde-format
msgid "Site Policy Limit Violation: Block nesting too deep (max. %1)"
msgstr "نقض محدودیت خط‌مشی سایت: تو در تویی بیش از حد بلوک (حداکثر %1)"

#: ksieve/error.cpp:196
#, kde-format
msgid "Invalid Argument \"%1\" to \"%2\""
msgstr "آرگومان نامعتبر «%1» برای «%2»"

#: ksieve/error.cpp:199
#, kde-format
msgid "Conflicting Arguments: \"%1\" and \"%2\""
msgstr "آرگومان‌های متناقض: «%1» و «%2»"

#: ksieve/error.cpp:202
#, kde-format
msgid "Argument \"%1\" Repeated"
msgstr "آرگومان «%1» تکرار شده است"

#: ksieve/error.cpp:205
#, kde-format
msgid "Command \"%1\" violates command ordering constraints"
msgstr "دستور «%1» محدودیت‌های ترتیب دستورها را نقض می‌کند"

#: ksieve/error.cpp:210
#, kde-format
msgid "Incompatible Actions \"%1\" and \"%2\" requested"
msgstr "کنش‌های ناسازگار «%1» و «%2» درخواست شده‌اند"

#: ksieve/error.cpp:213
#, kde-format
msgid "Mail Loop detected"
msgstr "حلقهٔ ایمیل شناسایی شد"

#: ksieve/error.cpp:216
#, kde-format
msgid "Site Policy Limit Violation: Too many Actions requested (max. %1)"
msgstr ""
"نقض محدودیت خط‌مشی سایت: کنش‌های بیش از حد مجاز درخواست شده است (حداکثر %1)"

#: ksieve/error.cpp:219
#, kde-format
msgid "Unknown error"
msgstr "خطای ناشناخته"

#: ksievecore/managescriptsjob/checkscriptjob.cpp:65
#, kde-format
msgid "No errors found."
msgstr "هیچ خطایی پیدا نشد."

#: ksievecore/managescriptsjob/checkscriptjob.cpp:68
#, kde-format
msgid "An unknown error was encountered."
msgstr "خطای ناشناخته‌ای رخ داد."

#: ksievecore/managescriptsjob/generateglobalscriptjob.cpp:53
#: ksievecore/managescriptsjob/parseuserscriptjob.cpp:42
#, kde-format
msgid "Path is not specified."
msgstr "مسیر مشخص نشده است."

#: ksievecore/managescriptsjob/generateglobalscriptjob.cpp:97
#, kde-format
msgid ""
"Error writing \"MASTER\" script on server.\n"
