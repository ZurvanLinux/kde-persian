#: org.kde.tokodon.desktop:4 src/tokodon.notifyrc:5
msgctxt "Name"
msgid "Tokodon"
msgstr "توکودون"

#: org.kde.tokodon.desktop:44
msgctxt "GenericName"
msgid "Browse the Fediverse"
msgstr "مرور فدیورس"

#: org.kde.tokodon.desktop:78
msgctxt "Comment"
msgid "Client for the Mastodon"
msgstr "کلاینت مستودون"

#: src/tokodon.notifyrc:46
msgctxt "Comment"
msgid "A client for Mastodon, the decentralized social media"
msgstr "کلاینتی برای مستودون، رسانهٔ اجتماعی نامتمرکز"

#: src/tokodon.notifyrc:83
msgctxt "Name"
msgid "Favorite"
msgstr "نشان کردن"

#: src/tokodon.notifyrc:120
msgctxt "Comment"
msgid "Someone favorited your post"
msgstr "کسی پست شما را نشان کرد"

#: src/tokodon.notifyrc:158
msgctxt "Name"
msgid "Boost"
msgstr "بازتمرکز"

#: src/tokodon.notifyrc:194
msgctxt "Comment"
msgid "Someone boosted your post"
msgstr "کسی پست شما را بازنشر کرد"

#: src/tokodon.notifyrc:233 src/tokodon.notifyrc:368
msgctxt "Name"
msgid "Follow"
msgstr "دنبال کردن"

#: src/tokodon.notifyrc:271
msgctxt "Comment"
msgid "Someone followed you"
msgstr "کسی شما را دنبال کرد"

#: src/tokodon.notifyrc:309
msgctxt "Name"
msgid "Follow Request"
msgstr "درخواست دنبال کردن"

#: src/tokodon.notifyrc:343
msgctxt "Comment"
msgid "Someone requested to follow you"
msgstr "کسی درخواست دنبال کردن شما را داد"

#: src/tokodon.notifyrc:406
msgctxt "Comment"
msgid "Someone mentioned you"
msgstr "کسی به شما اشاره کرد"

#: src/tokodon.notifyrc:445
msgctxt "Name"
msgid "Update"
msgstr "به‌روزرسانی"

#: src/tokodon.notifyrc:482
msgctxt "Comment"
msgid "Someone edited a post"
msgstr "کسی پستی را ویرایش کرد"

#: src/tokodon.notifyrc:520
msgctxt "Name"
msgid "Poll"
msgstr "نظرسنجی"

#: src/tokodon.notifyrc:554
msgctxt "Comment"
msgid "Someone's poll ended"
msgstr "نظرسنجی کسی به پایان رسید"

#: src/tokodon.notifyrc:590
msgctxt "Name"
msgid "Status"
msgstr "وضعیت"

#: src/tokodon.notifyrc:625
msgctxt "Comment"
msgid "Someone posted a new status"
msgstr "کسی وضعیت جدیدی فرستاد"

#: src/tokodon.notifyrc:662
msgctxt "Name"
msgid "Quote"
msgstr "نقل‌قول"

#: src/tokodon.notifyrc:689
msgctxt "Comment"
msgid "Someone quoted you"
msgstr "کسی از شما نقل‌قول کرد"

#: src/tokodon.notifyrc:719
msgctxt "Name"
msgid "Annual Report"
msgstr "گزارش سالانه"

#: src/tokodon.notifyrc:750
msgctxt "Comment"
msgid "Unveil your year's highlights and memorable moments on the Fediverse!"
msgstr "از نکات برجسته و لحظات به‌یادماندنی سال خود در فدیورس رونمایی کنید!"

#: src/tokodon.notifyrc:784
msgctxt "Name"
msgid "Added to Collection"
msgstr "افزوده شده به مجموعه"

#: src/tokodon.notifyrc:806
msgctxt "Comment"
msgid "Someone added you to their collection"
msgstr "کسی شما را به مجموعهٔ خود افزود"

#: src/tokodon.notifyrc:831
msgctxt "Name"
msgid "Collection Update"
msgstr "به‌روزرسانی مجموعه"

#: src/tokodon.notifyrc:853
msgctxt "Comment"
msgid "Someone updated their collection"
msgstr "کسی مجموعهٔ خود را به‌روزرسانی کرد"

#: src/tokodon.notifyrc:878
msgctxt "Name"
msgid "Other"
msgstr "سایر"

#: src/tokodon.notifyrc:909
msgctxt "Comment"
msgid "Notifications that do not fit in other categories"
msgstr "اعلان‌هایی که در دسته‌های دیگر قرار نمی‌گیرند"
