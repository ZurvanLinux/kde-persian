#: Thesaurus.cpp:582
#, kde-format
msgid "Meronyms - %1 has a ..."
msgstr "جزء‌نام‌ها - %1 شامل یک ... است"

#: Thesaurus.cpp:584
#, kde-format
msgid "Holonyms - ... has a %1"
msgstr "کل‌نام‌ها - ... شامل یک %1 است"

#: Thesaurus.cpp:585
#, kde-format
