#: kcm/ui/main.qml:40
#, kde-format
msgid "Update software:"
msgstr "به‌روزرسانی نرم‌افزار:"

#: kcm/ui/main.qml:41
#, kde-format
msgid "Manually"
msgstr "دستی"

#: kcm/ui/main.qml:56
#, kde-format
msgid "Automatically"
msgstr "خودکار"

#: kcm/ui/main.qml:68
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Software updates will be downloaded automatically when they become "
"available. Updates for applications will be installed immediately, while "
"updates for the system will be installed the next time it’s restarted."
msgstr ""
"به‌روزرسانی‌های نرم‌افزار پس از دردسترس قرار گرفتن، به‌طور خودکار بارگیری "
"می‌شوند. به‌روزرسانی‌های برنامه‌ها بلافاصله نصب خواهند شد، در حالی که "
"به‌روزرسانی‌های سیستم در راه‌اندازی مجدد بعدی نصب می‌شوند."

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Update frequency:"
msgstr "دورهٔ به‌روزرسانی:"

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Notification frequency:"
msgstr "دورهٔ اعلان:"

#: kcm/ui/main.qml:79
#, kde-format
msgctxt "@item:inlistbox"
msgid "Daily"
msgstr "روزانه"

#: kcm/ui/main.qml:80
#, kde-format
msgctxt "@item:inlistbox"
msgid "Weekly"
msgstr "هفتگی"

#: kcm/ui/main.qml:81
#, kde-format
msgctxt "@item:inlistbox"
msgid "Monthly"
msgstr "ماهانه"

#: kcm/ui/main.qml:82
#, kde-format
msgctxt "@item:inlistbox"
msgid "Never"
msgstr "هرگز"

#: kcm/ui/main.qml:120
#, kde-format
msgid "Apply system updates:"
msgstr "اعمال به‌روزرسانی‌های سامانه:"

#: kcm/ui/main.qml:127
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates after "
"rebooting'"
msgid "After rebooting"
msgstr "پس از راه‌اندازی دوباره"

#: kcm/ui/main.qml:139
#, kde-format
msgctxt ""
"@label The thing being recommended is to use the 'apply updates when "
"rebooting' setting"
msgid "Recommended to maximize system stability"
msgstr "توصیه‌شده برای به حداکثر رساندن پایداری سامانه"

#: kcm/ui/main.qml:145
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates "
"immediately'"
msgid "Immediately"
msgstr "بلافاصله"
