#: discover/qml/ApplicationPage.qml:79
#, kde-kuit-format
msgctxt "@info"
msgid ""
"%1 uses one or more licenses not certified as “Free Software” by either the "
"<link url='%2'>Free Software Foundation</link> or the <link url='%3'>Open "
"Source Initiative</link>. This means your freedom to use, study, modify, and"
" share it may be restricted in some ways.<nl/><nl/>Make sure to read the "
"license text and understand any restrictions before using the "
"software.<nl/><nl/>If the license does not even grant access to read the "
"source code, make sure you fully trust the authors, as no one else can "
"verify the trustworthiness and security of its code to ensure that it is not"
" acting against you in hidden ways. More information may be available on "
"<link url='%4'>the application’s website</link>.<nl/><nl/>Learn more at "
"<link url='%5'>%5</link>."
msgstr ""
"%1 از یک یا چند مجوز استفاده می‌کند که توسط <link url='%2'>بنیاد نرم‌افزار "
"آزاد</link> یا <link url='%3'>پیشگامان متن‌باز (OSI)</link> به عنوان "
"«نرم‌افزار آزاد» تأیید نشده‌اند. این بدان معناست که آزادی شما برای استفاده، "
"مطالعه، تغییر و به‌اشتراک‌گذاری آن ممکن است از جهاتی محدود "
"باشد.<nl/><nl/>حتماً متن مجوز را بخوانید و پیش از استفاده از نرم‌افزار، از "
"محدودیت‌های آن آگاه شوید.<nl/><nl/>اگر مجوز حتی دسترسی به خواندن کد منبع را "
"هم نمی‌دهد، اطمینان حاصل کنید که به پدیدآورندگان آن کاملاً اعتماد دارید، چرا"
" که هیچ‌کس دیگری نمی‌تواند قابل اعتماد بودن و امنیت کد آن را راستی‌آزمایی "
"کند تا مطمئن شود که به روش‌های پنهانی علیه شما عمل نمی‌کند. اطلاعات بیشتر "
"ممکن است در <link url='%4'>وب‌سایت برنامه</link> موجود "
"باشد.<nl/><nl/>اطلاعات بیشتر را در <link url='%5'>%5</link> کسب کنید."

