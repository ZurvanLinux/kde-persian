#. i18n: ectx: property (whatsThis), widget (QCheckBox,
#. kcfg_details_on_remote_listing)
#: src/settings/subversion_settings.ui:61
#, kde-format
msgid ""
"<p align=\"left\">When checked, kdesvn fetches more detailed info about file items when making a listing to remote repositories so that you may see remote locks in overview.\n"
"</p>\n"
"<p align=\"left\"><i>Be careful: This may let listings become REAL slow.</i></p>"
msgstr ""
"<p align=\"left\">در صورت انتخاب، kdesvn اطلاعات دقیق‌تری درباره موارد پرونده هنگام فهرست‌کردن مخازن دوردست دریافت می‌کند تا بتوانید قفل‌های دوردست را در نمای کلی مشاهده کنید.\n"
"</p>\n"
"<p align=\"left\"><i>احتیاط: این کار ممکن است سرعت فهرست‌کردن را به شدت کُند کند.</i></p>"

#. i18n: ectx: property (text), widget (QCheckBox,
