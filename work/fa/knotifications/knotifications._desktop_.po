#: src/android_defaults.notifyrc:2
msgctxt "Name"
msgid "Fatal Error"
msgstr "خطای مهلک"

#: src/android_defaults.notifyrc:62
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "خطای جدی رخ داد که باعث خروج از برنامه شد"

#: src/android_defaults.notifyrc:123
msgctxt "Name"
msgid "Notification"
msgstr "اعلان"

#: src/android_defaults.notifyrc:182
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "اتفاق خاصی در برنامه رخ داد"

#: src/android_defaults.notifyrc:242
msgctxt "Name"
msgid "Warning"
msgstr "هشدار"

#: src/android_defaults.notifyrc:301
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "خطایی در برنامه رخ داد که ممکن است باعث بروز مشکلاتی شود"

#: src/android_defaults.notifyrc:361
msgctxt "Name"
msgid "Catastrophe"
msgstr "فاجعه"

#: src/android_defaults.notifyrc:419
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "خطای بسیار جدی رخ داد که دست‌کم باعث خروج از برنامه شد"
