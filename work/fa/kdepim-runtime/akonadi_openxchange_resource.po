msgid "Connection error"
msgstr "خطای اتصال"

#: configwidget.cpp:74
#, kde-format
msgid "Tested connection successfully."
msgstr "آزمایش اتصال با موفقیت انجام شد."

#: configwidget.cpp:74
#, kde-format
msgctxt "@title:window"
msgid "Connection success"
msgstr "اتصال موفق"

