#: addcollectiontask.cpp:31
#, kde-format
msgid "Cannot add IMAP folder '%1' for a non-existing parent folder '%2'."
msgstr "امکان افزودن پوشهٔ IMAP «%1» برای پوشهٔ والد ناموجود «%2» وجود ندارد."

#: addcollectiontask.cpp:65
#, kde-format
msgid "Failed to create the folder '%1' on the IMAP server. "
msgstr "ایجاد پوشهٔ «%1» روی کارساز IMAP ناموفق بود. "

#: addcollectiontask.cpp:85 movecollectiontask.cpp:119
#, kde-format
msgid ""
"Failed to subscribe to the folder '%1' on the IMAP server. It will disappear"
" on next sync. Use the subscription dialog to overcome that"
msgstr ""
"اشتراک در پوشهٔ «%1» روی کارساز IMAP ناموفق بود. این پوشه در همگام‌سازی بعدی"
" ناپدید خواهد شد. برای رفع این مشکل از پنجرهٔ اشتراک‌ها استفاده کنید"

#: addcollectiontask.cpp:126 changecollectiontask.cpp:276
#, kde-format
msgid "Failed to write some annotations for '%1' on the IMAP server. %2"
msgstr "نوشتن برخی از یادداشت‌ها برای «%1» روی کارساز IMAP ناموفق بود. %2"

#: additemtask.cpp:115 changeitemtask.cpp:181 changeitemtask.cpp:205
#: moveitemstask.cpp:255
#, kde-format
msgid ""
"Could not determine the UID for the newly created message on the server"
msgstr "امکان تشخیص UID برای پیام تازه ایجادشده روی کارساز وجود نداشت"

#: changecollectiontask.cpp:39
#, kde-format
msgid "Cannot modify IMAP folder '%1', it does not exist on the server."
msgstr ""
"امکان تغییر پوشهٔ IMAP «%1» وجود ندارد، این پوشه روی کارساز موجود نیست."

#: changecollectiontask.cpp:51
#, kde-format
msgid ""
"ACLs for '%1' need to be retrieved from the IMAP server first. Skipping ACL "
"change"
msgstr ""
"ابتدا باید ACLهای «%1» از کارساز IMAP دریافت شوند. صرف‌نظر از تغییر ACL"

#: changecollectiontask.cpp:237
#, kde-format
msgid "Failed to rename the folder, restoring folder list."
msgstr "تغییر نام پوشه ناموفق بود، در حال بازیابی فهرست پوشه‌ها."

#: changecollectiontask.cpp:256
#, kde-format
msgid ""
"Failed to subscribe to the renamed folder '%1' on the IMAP server. It will "
"disappear on next sync. Use the subscription dialog to overcome that"
msgstr ""
"اشتراک در پوشهٔ تغییرنام‌یافتهٔ «%1» روی کارساز IMAP ناموفق بود. این پوشه در"
" همگام‌سازی بعدی ناپدید خواهد شد. برای رفع این مشکل از پنجرهٔ اشتراک‌ها "
"استفاده کنید"

#: changecollectiontask.cpp:267
#, kde-format
msgid "Failed to write some ACLs for '%1' on the IMAP server. %2"
msgstr "نوشتن برخی از ACLها برای «%1» روی کارساز IMAP ناموفق بود. %2"

#: imapresource.cpp:235
#, kde-format
msgid "No server configured yet."
msgstr "هنوز کارسازی پیکربندی نشده است."

#: imapresource.cpp:255
#, kde-format
msgid "Connection established."
msgstr "اتصال برقرار شد."

#: imapresource.cpp:272
#, kde-format
msgid "Server is not available."
msgstr "کارساز در دسترس نیست."

#: imapresource.cpp:323
#, kde-format
msgctxt "@info:status"
