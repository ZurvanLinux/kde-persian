msgstr "در حال افزودن مورد در «%1»"

#: imapresource.cpp:330
#, kde-format
msgctxt "@info:status"
msgid "Updating item in '%1'"
msgstr "در حال به‌روزرسانی مورد در «%1»"

#: imapresource.cpp:337
#, kde-format
msgctxt "@info:status"
msgid "Updating items"
msgstr "در حال به‌روزرسانی موارد"

#: imapresource.cpp:351
#, kde-format
msgctxt "@info:status"
msgid "Removing items"
msgstr "در حال حذف موارد"

#: imapresource.cpp:367
#, kde-format
msgctxt "@info:status"
msgid "Moving items from '%1' to '%2'"
msgstr "در حال انتقال موارد از «%1» به «%2»"

#: imapresource.cpp:376
#, kde-format
msgctxt "@info:status"
msgid "Retrieving folders"
msgstr "در حال دریافت پوشه‌ها"

#: imapresource.cpp:383
#, kde-format
msgctxt "@info:status"
msgid "Retrieving extra folder information for '%1'"
msgstr "در حال دریافت اطلاعات اضافی پوشه برای «%1»"

#: imapresource.cpp:401
#, kde-format
msgctxt "@info:status"
msgid "Creating folder '%1'"
msgstr "در حال ایجاد پوشهٔ «%1»"

#: imapresource.cpp:407
#, kde-format
msgctxt "@info:status"
msgid "Updating folder '%1'"
msgstr "در حال به‌روزرسانی پوشهٔ «%1»"

#: imapresource.cpp:420
#, kde-format
msgctxt "@info:status"
msgid "Removing folder '%1'"
msgstr "در حال حذف پوشهٔ «%1»"

#: imapresource.cpp:427
#, kde-format
msgctxt "@info:status"
msgid "Moving folder '%1' from '%2' to '%3'"
msgstr "در حال انتقال پوشهٔ «%1» از «%2» به «%3»"

#: imapresource.cpp:457
#, kde-format
msgctxt "@info:status"
msgid "Searching…"
msgstr "در حال جست‌وجو…"

#: imapresource.cpp:729
#, kde-format
msgid "IMAP Account"
msgstr "حساب IMAP"

#. i18n: ectx: label, entry (ImapServer), group (network)
#: imapresource.kcfg:14
#, kde-format
msgid "IMAP server"
msgstr "سرور IMAP"

#. i18n: ectx: label, entry (ImapPort), group (network)
#: imapresource.kcfg:17
#, kde-format
msgid "Defines the port the IMAP service is running on"
msgstr "درگاهی را که سرویس IMAP روی آن اجرا می‌شود مشخص می‌کند"

#. i18n: ectx: label, entry (UserName), group (network)
#: imapresource.kcfg:21
#, kde-format
msgid "Username"
msgstr "نام کاربری"

#. i18n: ectx: label, entry (Safety), group (network)
#: imapresource.kcfg:24
#, kde-format
msgid "Defines the encryption type to use"
msgstr "نوع رمزگذاری مورد استفاده را مشخص می‌کند"

#. i18n: ectx: label, entry (OverrideEncryption), group (network)
#: imapresource.kcfg:28
#, kde-format
msgid "Override configured encryption mode"
msgstr "نادیده‌گرفتن حالت رمزگذاری پیکربندی‌شده"

#. i18n: ectx: label, entry (Authentication), group (network)
#: imapresource.kcfg:31
#, kde-format
msgid "Defines the authentication type to use"
msgstr "نوع احراز هویت مورد استفاده را مشخص می‌کند"

#. i18n: ectx: label, entry (SubscriptionEnabled), group (network)
#: imapresource.kcfg:35
#, kde-format
msgid "Defines if the server side subscription is enabled"
msgstr "مشخص می‌کند که آیا اشتراک سمت سرور فعال باشد یا خیر"

#. i18n: ectx: property (text), widget (QCheckBox, useProxyCheck)
#. i18n: ectx: label, entry (UseProxy), group (network)
#: imapresource.kcfg:42 setupserverview_desktop.ui:560
#, kde-format
msgid "Connect using the system proxy settings"
msgstr "اتصال با استفاده از تنظیمات پیشکار سیستم"

#. i18n: ectx: whatsthis, entry (UseProxy), group (network)
#: imapresource.kcfg:43
#, kde-format
msgid ""
"If checked, the system proxy settings will be used to connect to the mail "
"server."
msgstr ""
"در صورت انتخاب، از تنظیمات پیشکار سیستم برای اتصال به کارساز رایانامه "
"استفاده خواهد شد."

#. i18n: ectx: label, entry (DisconnectedModeEnabled), group (cache)
#: imapresource.kcfg:49
#, kde-format
msgid "Defines if all the IMAP data should be cached locally all the time"
msgstr ""
"مشخص می‌کند که آیا تمام داده‌های IMAP همیشه باید به‌صورت محلی در حافظهٔ "
"پنهان ذخیره شوند یا خیر"

#. i18n: ectx: label, entry (IntervalCheckEnabled), group (cache)
#: imapresource.kcfg:53
#, kde-format
msgid "Defines if interval checking is enabled."
msgstr "مشخص می‌کند که آیا بررسی دوره‌ای فعال است یا خیر."

#. i18n: ectx: label, entry (IntervalCheckTime), group (cache)
#: imapresource.kcfg:57
#, kde-format
msgid "Check interval in minutes"
msgstr "بازهٔ زمانی بررسی به دقیقه"

#. i18n: ectx: label, entry (RetrieveMetadataOnFolderListing), group (cache)
#: imapresource.kcfg:62
#, kde-format
msgid ""
"Defines if the annotations, ACLs and quota information of mailboxes should\n"
"             also be retrieved when the mailboxes get listed."
msgstr ""
"مشخص می‌کند که آیا یادداشت‌ها، ACLها و اطلاعات سهمیهٔ جعبه‌های پستی نیز "
"هنگام فهرست شدن آن‌ها دریافت شوند یا خیر."

#. i18n: ectx: label, entry (AutomaticExpungeEnabled), group (cache)
#: imapresource.kcfg:67
#, kde-format
msgid ""
"Defines if the expunge command is issued automatically, otherwise it should be\n"
"             triggered manually through the D-Bus interface."
msgstr ""
"مشخص می‌کند که آیا دستور پاکسازی به‌طور خودکار صادر شود، در غیر این صورت "
"باید به‌صورت دستی از طریق رابط D-Bus فعال گردد."

#. i18n: ectx: label, entry (TrashCollection), group (cache)
#: imapresource.kcfg:71
#, kde-format
msgid "Define which folder is used for trash"
msgstr "تعیین این‌که کدام پوشه برای سطل زباله استفاده شود"

#. i18n: ectx: label, entry (TrashCollectionMigrated), group (cache)
#: imapresource.kcfg:75
#, kde-format
msgid "Define if the trash collection received the special attribute"
msgstr "تعیین این‌که آیا مجموعه سطل زباله ویژگی خاص را دریافت کرده است یا خیر"

#. i18n: ectx: label, entry (UseDefaultIdentity), group (cache)
#: imapresource.kcfg:79
#, kde-format
msgid "Define if account uses the default identity"
msgstr "تعیین این‌که آیا حساب از هویت پیش‌فرض استفاده کند یا خیر"

#. i18n: ectx: label, entry (AccountIdentity), group (cache)
#: imapresource.kcfg:83
#, kde-format
msgid "Identity account"
msgstr "حساب هویتی"

#. i18n: ectx: label, entry (KnownMailBoxes), group (cache)
#: imapresource.kcfg:86
#, kde-format
msgid "List of mailbox names reported by the server the last time"
msgstr "فهرست نام‌های صندوق پستی که آخرین بار توسط کارساز گزارش شده است"

#. i18n: ectx: label, entry (IdleRidPath), group (idle)
#: imapresource.kcfg:91
#, kde-format
msgid "RID path to the mailbox to watch for changes"
msgstr "مسیر RID به صندوق پستی برای نظارت بر تغییرات"

#. i18n: ectx: label, entry (SieveSupport), group (siever)
#: imapresource.kcfg:96
#, kde-format
msgid "Define if server supports sieve"
msgstr "تعیین این‌که آیا کارساز از Sieve پشتیبانی می‌کند یا خیر"

#. i18n: ectx: label, entry (SieveReuseConfig), group (siever)
#: imapresource.kcfg:100
#, kde-format
msgid "Define if we reuse host and login configuration"
msgstr "تعیین این‌که آیا از پیکربندی میزبان و ورود مجدداً استفاده شود یا خیر"

#. i18n: ectx: label, entry (SievePort), group (siever)
#: imapresource.kcfg:104
#, kde-format
msgid "Define sieve port"
msgstr "تعیین درگاه Sieve"

#. i18n: ectx: label, entry (SieveAlternateUrl), group (siever)
#: imapresource.kcfg:108
#, kde-format
msgid "Define alternate URL"
msgstr "تعیین نشانی اینترنتی جایگزین"

#. i18n: ectx: label, entry (AlternateAuthentication), group (siever)
#: imapresource.kcfg:111
#, kde-format
msgid "Defines the authentication type to use for alternate server"
msgstr "نوع احراز هویت برای استفاده در سرور جایگزین را مشخص می‌کند"

#. i18n: ectx: label, entry (SieveVacationFilename), group (siever)
#: imapresource.kcfg:115
#, kde-format
msgid "Define default sieve vacation filename"
msgstr "تعیین نام پرونده پیش‌فرض پاسخ خودکار sieve"

#. i18n: ectx: label, entry (SieveCustomUsername), group (siever)
#: imapresource.kcfg:119
#, kde-format
msgid "Define username used from custom server sieve url"
msgstr "تعیین نام کاربری استفاده‌شده از نشانی اینترنتی sieve سرور سفارشی"

#. i18n: ectx: label, entry (SieveCustomAuthentification), group (siever)
#: imapresource.kcfg:123
#, kde-format
msgid "Defines the type of identification used by custom sieve server"
msgstr "نوع شناسایی مورد استفاده توسط سرور سفارشی sieve را مشخص می‌کند"

#. i18n: ectx: label, entry (ActivitiesEnabled), group (Activities)
#: imapresource.kcfg:129
#, kde-format
msgid "Whether the activities support of the agent is enabled"
msgstr "این‌که آیا پشتیبانی از کنش‌های عامل فعال است یا خیر"

#. i18n: ectx: label, entry (Activities), group (Activities)
#: imapresource.kcfg:133
#, kde-format
msgid "The activities of the agent"
msgstr "کنش‌های عامل"

#: movecollectiontask.cpp:29
#, kde-format
msgid "Cannot move IMAP folder '%1', it does not exist on the server."
msgstr "نمی‌توان پوشهٔ IMAP «%1» را جابه‌جا کرد، این پوشه در سرور وجود ندارد."

#: movecollectiontask.cpp:35
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' out of '%2', '%2' does not exist on the server."
msgstr ""
"نمی‌توان پوشهٔ IMAP «%1» را از «%2» خارج کرد، «%2» در سرور وجود ندارد."

#: movecollectiontask.cpp:41
#, kde-format
msgid ""
"Cannot move IMAP folder '%1' to '%2', '%2' does not exist on the server."
msgstr ""
"نمی‌توان پوشهٔ IMAP «%1» را به «%2» منتقل کرد، «%2» در سرور وجود ندارد."

#: moveitemstask.cpp:41
#, kde-format
msgid "Cannot move message, it does not exist on the server."
msgstr "نمی‌توان پیام را جابه‌جا کرد، در سرور وجود ندارد."

#: moveitemstask.cpp:48
#, kde-format
msgid "Cannot move message out of '%1', '%1' does not exist on the server."
msgstr ""
"امکان انتقال پیام به خارج از «%1» وجود ندارد، «%1» روی کارساز وجود ندارد."

#: moveitemstask.cpp:55
#, kde-format
msgid "Cannot move message to '%1', '%1' does not exist on the server."
msgstr "امکان انتقال پیام به «%1» وجود ندارد، «%1» روی کارساز وجود ندارد."

#: moveitemstask.cpp:113
#, kde-format
msgid "Failed to move item, it has no message payload. Remote id: %1"
msgstr "انتقال مورد ناموفق بود، هیچ بار پیام ندارد. شناسه دوردست: %1"

#: moveitemstask.cpp:190
#, kde-format
msgid ""
"Failed to mark the message from '%1' for deletion on the IMAP server. It "
"will reappear on next sync."
msgstr ""
"علامت‌گذاری پیام از طرف «%1» برای حذف روی کارساز IMAP ناموفق بود. این پیام "
"در همگام‌سازی بعدی دوباره ظاهر خواهد شد."

#: outlookpasswordrequester.cpp:67 outlookpasswordrequester.cpp:76
#, kde-format
msgctxt "@status"
msgid "Failed to read password from keychain."
msgstr "خواندن گذرواژه از دسته کلید ناموفق بود."

#: removecollectionrecursivetask.cpp:113 removecollectionrecursivetask.cpp:129
#: removecollectionrecursivetask.cpp:142
#, kde-format
msgid "Failed to delete the folder, restoring folder list."
msgstr "حذف پوشه ناموفق بود، در حال بازیابی فهرست پوشه‌ها."

#: removecollectionrecursivetask.cpp:147
#, kde-format
msgid "Failed to find the folder to be deleted, restoring folder list."
msgstr ""
"یافتن پوشهٔ مورد نظر برای حذف ناموفق بود، در حال بازیابی فهرست پوشه‌ها."

#: resourcestate.cpp:263
#, kde-format
