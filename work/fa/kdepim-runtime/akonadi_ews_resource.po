#. i18n: ectx: property (text), widget (QLabel, passwordLabel)
#: ewsconfigdialog.ui:179
#, kde-format
msgid "Password:"
msgstr "گذرواژه:"

#. i18n: ectx: property (whatsThis), widget (KPasswordLineEdit, passwordEdit)
#: ewsconfigdialog.ui:186
#, kde-format
msgid ""
"<html><head/><body><p>The password used to login to the Exchange "
"server.</p><p><span style=\" font-weight:600;\">Note:</span> This can be "
"left empty when using Kerberos authentication.</p></body></html>"
msgstr ""
"<html><head/><body><p>گذرواژه‌ای که برای ورود به سرور Exchange استفاده "
"می‌شود.</p><p><span style=\" font-weight:600;\">نکته:</span> هنگام استفاده "
"از احراز هویت کربروس (Kerberos)، این فیلد می‌تواند خالی "
"بماند.</p></body></html>"

#. i18n: ectx: property (whatsThis), widget (QLineEdit, kcfg_Username)
#: ewsconfigdialog.ui:193
#, kde-format
msgid ""
"<html><head/><body><p>The username used to login to the Exchange "
"server.</p><p><span style=\" font-weight:600;\">Note:</span> This can be "
"left empty when using Kerberos authentication.</p></body></html>"
msgstr ""
"<html><head/><body><p>نام کاربری‌ای که برای ورود به سرور Exchange استفاده "
"می‌شود.</p><p><span style=\" font-weight:600;\">نکته:</span> هنگام استفاده "
"از احراز هویت کربروس (Kerberos)، این فیلد می‌تواند خالی "
"بماند.</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, kerberosNoteLabel)
#: ewsconfigdialog.ui:203
#, kde-format
msgid ""
"<html><head/><body><p><span style=\" font-weight:600;\">Note:</span> "
"Username and password are not needed (can be empty) when Kerberos is "
"properly configured on your system.</p></body></html>"
msgstr ""
"<html><head/><body><p><span style=\" font-weight:600;\">نکته:</span> هنگامی "
"که کربروس (Kerberos) به‌درستی روی سیستم شما پیکربندی شده باشد، نیازی به نام "
"کاربری و گذرواژه نیست (می‌تواند خالی باشد).</p></body></html>"

#. i18n: ectx: property (whatsThis), widget (QRadioButton,
#. authOAuth2RadioButton)
#: ewsconfigdialog.ui:222
#, kde-format
msgid ""
"<html><head/><body><p>Enables more modern and stronger authentication based "
"on OAuth2.</p><p>This type of authentication will open an organization-"
"supplied webpage, where the user will be able to enter authentication "
"information, which may also include multifactor authentication in form of "
"one-time-passwords generated by tokens.</p><p>This method is mostly used for"
" hosted Office 365 instances.</p></body></html>"
msgstr ""
"<html><head/><body><p>احراز هویت نوین‌تر و قوی‌تری را بر پایهٔ OAuth2 فعال "
"می‌کند.</p><p>این نوع احراز هویت یک صفحهٔ وب ارائه‌شده توسط سازمان را باز "
"می‌کند که کاربر در آن می‌تواند اطلاعات احراز هویت را وارد کند، که ممکن است "
"شامل احراز هویت چندعاملی در قالب گذرواژه‌های یک‌بارمصرف تولیدشده توسط "
"توکن‌ها نیز باشد.</p><p>این روش اغلب برای نمونه‌های میزبانی‌شدهٔ Office 365 "
"استفاده می‌شود.</p></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, authOAuth2RadioButton)
#: ewsconfigdialog.ui:225
#, kde-format
msgid "OAuth&2 (Office 365)"
msgstr "OAuth2 (Office 365)"

#. i18n: ectx: property (whatsThis), widget (QRadioButton,
#. authInTuneRadioButton)
#: ewsconfigdialog.ui:232
#, kde-format
msgid ""
"<html><head/><body><p>Enables authentication using Microsoft InTune MDM "
"software. This is required in many corporate environments, which mandate "
"strong authentication using device credentials and thereby require the "
"system to be joined to the organization and managed using "
"InTune.</p></body></html>"
msgstr ""
"<html><head/><body><p>احراز هویت را با استفاده از نرم‌افزار Microsoft InTune"
" MDM فعال می‌کند. این قابلیت در بسیاری از محیط‌های سازمانی که احراز هویت قوی"
" با استفاده از اطلاعات هویتی دستگاه را الزامی می‌دانند، مورد نیاز است و بدین"
" ترتیب نیازمند اتصال سیستم به سازمان و مدیریت آن از طریق InTune "
"است.</p></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, authInTuneRadioButton)
#: ewsconfigdialog.ui:235
#, kde-format
msgid "&Microsoft InTune"
msgstr "Microsoft InTune"

