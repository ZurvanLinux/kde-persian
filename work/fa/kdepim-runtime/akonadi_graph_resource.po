msgstr "‏%1 از %2 درخواست ناموفق بود، اولین خطا: %3"

#: jobs/graphfetchfoldersjob.cpp:49
#, kde-format
msgid "Could not resolve the mailbox root folder"
msgstr "پوشه ریشه صندوق پستی پیدا نشد"

