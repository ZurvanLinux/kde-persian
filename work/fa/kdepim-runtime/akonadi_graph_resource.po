msgstr "مخاطبان"

#: graphresource.cpp:732 graphresource.cpp:759
#, kde-format
msgid "The requested items no longer exist"
msgstr "موردهای درخواستی دیگر وجود ندارند"

#: graphresource.cpp:1031
#, kde-format
msgid "Cannot move task %1: no payload"
msgstr "نمی‌توان کار %1 را منتقل کرد: بدون بار داده"

#: graphresource.cpp:1039
#, kde-format
msgid "Cannot move event %1: no payload"
msgstr "نمی‌توان رویداد %1 را منتقل کرد: بدون بار داده"

#: graphresource.cpp:1154
#, kde-format
msgid "Moving contacts between folders is not supported"
msgstr "انتقال مخاطبین بین پوشه‌ها پشتیبانی نمی‌شود"

#. i18n: ectx: label, entry (Email), group (General)
#: graphresource.kcfg:10
#, kde-format
msgid "Primary email / UPN of the Microsoft 365 account."
msgstr "رایانامهٔ اصلی / UPN حساب مایکروسافت ۳۶۵."

#. i18n: ectx: label, entry (TenantId), group (General)
#: graphresource.kcfg:13
#, kde-format
msgid "Azure AD tenant: \"common\", \"organizations\", \"consumers\" or a tenant GUID."
msgstr ""
"مستأجر Azure AD: «عمومی»، «سازمان‌ها»، «مصرف‌کنندگان» یا یک GUID مستأجر."

#. i18n: ectx: label, entry (ClientId), group (General)
#: graphresource.kcfg:17
#, kde-format
msgid ""
"Azure app registration Application (client) ID. Configure your own in the "
"account dialog — see README.md / docs."
msgstr ""
"شناسهٔ برنامه (کلاینت) ثبت‌شده در Azure. شناسهٔ خود را در گفت‌وگوی حساب "
"پیکربندی کنید — README.md / docs را ببینید."

#. i18n: ectx: label, entry (FolderDeltaLink), group (General)
#: graphresource.kcfg:20
#, kde-format
msgid "Persisted top-level mailFolders @odata.deltaLink (sync state)."
msgstr ""
"پیوند @odata.deltaLink پایدارشدهٔ mailFolders سطح بالا (وضعیت همگام‌سازی)."

#. i18n: ectx: label, entry (PollInterval), group (General)
#: graphresource.kcfg:23
#, kde-format
msgid "Delta poll interval in minutes (no push on Graph for desktop)."
msgstr ""
"فاصلهٔ زمانی نظرسنجی دلتا برحسب دقیقه (عدم وجود اعلان فشاری در Graph برای "
"دسکتاپ)."

#. i18n: ectx: label, entry (ImmutableIdsMigrated), group (General)
#: graphresource.kcfg:27
#, kde-format
msgid "Whether stored remoteIds have been migrated to Graph immutable ids."
msgstr ""
"این که آیا remoteIdهای ذخیره‌شده به شناسه‌های تغییرناپذیر Graph مهاجرت "
"کرده‌اند یا خیر."

#: jobs/graphbatchjob.cpp:138
#, kde-format
msgid "The server did not answer this request"
msgstr "سرور به این درخواست پاسخ نداد"

#: jobs/graphbatchjob.cpp:171
#, kde-format
msgid "HTTP %1"
msgstr "‏HTTP %1"

#: jobs/graphbatchjob.cpp:193
#, kde-format
