#: lunarphases/configdialog.cpp:26
#, kde-format
msgctxt "@title:window"
msgid "Configure Lunar Phases"
msgstr "پیکربندی وضعیت‌های ماه"

#: lunarphases/configdialog.cpp:41
#, kde-format
msgctxt "@title:group"
msgid "Choose your hemisphere"
msgstr "نیم‌کرهٔ خود را انتخاب کنید"

#: lunarphases/configdialog.cpp:46
#, kde-format
msgctxt "@option:radio"
msgid "Northern Hemisphere"
msgstr "نیم‌کرهٔ شمالی"

#: lunarphases/configdialog.cpp:47
#, kde-format
msgctxt "@info:tooltip"
msgid "Show the lunar phases for the northern hemisphere"
msgstr "نمایش وضعیت‌های ماه برای نیم‌کرهٔ شمالی"

#: lunarphases/configdialog.cpp:48
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option to show the moon phases if you live in the northern "
"hemisphere."
msgstr ""
"اگر در نیم‌کرهٔ شمالی زندگی می‌کنید، این گزینه را برای نمایش وضعیت‌های ماه "
"انتخاب کنید."

#: lunarphases/configdialog.cpp:51
#, kde-format
msgctxt "@option:radio"
msgid "Southern Hemisphere"
msgstr "نیم‌کرهٔ جنوبی"

#: lunarphases/configdialog.cpp:52
#, kde-format
msgctxt "@info:tooltip"
msgid "Show the lunar phases for the southern hemisphere"
msgstr "نمایش وضعیت‌های ماه برای نیم‌کرهٔ جنوبی"

#: lunarphases/configdialog.cpp:53
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option to show the moon phases if you live in the southern "
"hemisphere."
msgstr ""
"اگر در نیم‌کرهٔ جنوبی زندگی می‌کنید، این گزینه را برای نمایش وضعیت‌های ماه "
"انتخاب کنید."

#: lunarphases/lunarphases.cpp:99
#, kde-format
msgid ""
"This plugin displays the day's lunar phase (New, First, Last, Full). The "
"phase is computed for noon in the system timezone. Crescent and Gibbous "
"phases are not displayed."
msgstr ""
"این افزونه وضعیت ماه در روز جاری (ماه نو، تربیع اول، تربیع آخر، بدر) را "
"نمایش می‌دهد. این وضعیت برای ظهر در منطقهٔ زمانی سامانه محاسبه می‌شود. "
"وضعیت‌های هلال و کوژپشت نمایش داده نمی‌شوند."

#: picoftheday/configdialog.cpp:28
#, kde-format
msgctxt "@title:window"
msgid "Configure Picture of the Day"
msgstr "پیکربندی تصویر روز"

#: picoftheday/configdialog.cpp:42
#, kde-format
msgctxt "@title:group"
msgid "Thumbnail Aspect Ratio Mode"
msgstr "حالت نسبت ابعاد بندانگشتی"

#: picoftheday/configdialog.cpp:46
#, kde-format
msgctxt "@option:radio"
msgid "Ignore aspect ratio"
msgstr "نادیده‌گرفتن نسبت ابعاد"

#: picoftheday/configdialog.cpp:47
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Scale the thumbnail as needed to fill the space, ignoring the aspect ratio"
msgstr ""
"تغییر مقیاس تصویر بندانگشتی در صورت نیاز برای پر کردن فضا، با نادیده‌گرفتن "
"نسبت ابعاد"

#: picoftheday/configdialog.cpp:49
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"The thumbnail will be scaled freely. The aspect ratio will not be preserved."
msgstr ""
"تصویر بندانگشتی آزادانه تغییر مقیاس خواهد یافت. نسبت ابعاد حفظ نخواهد شد."

#: picoftheday/configdialog.cpp:53
#, kde-format
msgctxt "@option:radio"
msgid "Keep aspect ratio"
msgstr "حفظ نسبت ابعاد"

#: picoftheday/configdialog.cpp:54
#, kde-format
msgctxt "@info:tooltip"
msgid "Scale the thumbnail as large as possible with the same aspect ratio"
msgstr "تغییر مقیاس بندانگشتی تا حد امکان بزرگ با حفظ همان نسبت ابعاد"

#: picoftheday/configdialog.cpp:56
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"The thumbnail will be scaled to a rectangle as large as possible inside a "
"given rectangle, preserving the aspect ratio."
msgstr ""
"تصویر بندانگشتی با حفظ نسبت ابعاد، تا حد امکان در بزرگ‌ترین مستطیل ممکن درون"
" مستطیل داده‌شده مقیاس‌بندی می‌شود."

#: picoftheday/configdialog.cpp:61
#, kde-format
msgctxt "@option:radio"
msgid "Keep aspect ratio by expanding"
msgstr "حفظ نسبت ابعاد با گسترش"

#: picoftheday/configdialog.cpp:62
#, kde-format
msgctxt "@info:tooltip"
msgid "Scale the thumbnail to fill the space, possibly cropping the image"
msgstr "تغییر مقیاس تصویر بندانگشتی برای پر کردن فضا، احتمالاً با برش تصویر"

#: picoftheday/configdialog.cpp:64
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"The thumbnail will be scaled to a rectangle as small as possible outside a "
"given rectangle, preserving the aspect ratio."
msgstr ""
"تصویر بندانگشتی با حفظ نسبت ابعاد، در کوچک‌ترین مستطیل ممکن در بیرون از "
"مستطیل مشخص‌شده مقیاس‌بندی می‌شود."

