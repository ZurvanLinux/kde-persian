#, kde-format
msgctxt "@option:check"
msgid "Show weekly parsha"
msgstr "نمایش پاراشای هفتگی"

#: hebrewcalendar/configdialog.cpp:49
#, kde-format
msgctxt "@info:tooltip"
msgid "Include weekly parsha days"
msgstr "شامل کردن روزهای پاراشای هفتگی"

