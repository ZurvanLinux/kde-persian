msgstr "نمایش حول هاموئد"

#: hebrewcalendar/configdialog.cpp:61
#, kde-format
msgctxt "@info:tooltip"
msgid "Include days of the Chol HaMoed"
msgstr "شامل روزهای حول هاموئد"

