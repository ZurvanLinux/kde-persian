#, kde-format
msgctxt "@info:whatsthis"
msgid "Select this option to show days of the Omer period."
msgstr "برای نمایش روزهای دورهٔ اومِر، این گزینه را انتخاب کنید."

#: hebrewcalendar/configdialog.cpp:60
#, kde-format
msgctxt "@option:check"
