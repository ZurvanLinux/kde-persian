#. i18n: ectx: label, entry (TodoDueTodayColor), group (Colors)
#: settings/korganizer.kcfg:373
#, kde-format
msgid "To-do due today color"
msgstr "رنگ کارهای موعد امروز"

#. i18n: ectx: tooltip, entry (TodoDueTodayColor), group (Colors)
#: settings/korganizer.kcfg:374
#, kde-format
msgid "Set the color for to-dos that are due today"
msgstr "تنظیم رنگ برای کارهایی که موعد آن‌ها امروز است"

#. i18n: ectx: whatsthis, entry (TodoDueTodayColor), group (Colors)
#: settings/korganizer.kcfg:375
#, kde-format
msgid "Select the to-do due today color here."
msgstr "رنگ کارهای موعد امروز را اینجا انتخاب کنید."

#. i18n: ectx: label, entry (TodoOverdueColor), group (Colors)
#: settings/korganizer.kcfg:379
#, kde-format
msgid "To-do overdue color"
msgstr "رنگ کارهای عقب‌افتاده"

#. i18n: ectx: tooltip, entry (TodoOverdueColor), group (Colors)
#: settings/korganizer.kcfg:380
#, kde-format
msgid "Set the color for overdue to-dos"
msgstr "تنظیم رنگ کارهای موعدگذشته"

#. i18n: ectx: whatsthis, entry (TodoOverdueColor), group (Colors)
#: settings/korganizer.kcfg:381
#, kde-format
msgid "Select the to-do overdue color here."
msgstr "رنگ کارهای موعدگذشته را اینجا انتخاب کنید."

#. i18n: ectx: label, entry (MonthTodayColor), group (Colors)
#: settings/korganizer.kcfg:385
#, kde-format
msgid "Month View today background color"
msgstr "رنگ پس‌زمینهٔ امروز در نمای ماهانه"

#. i18n: ectx: tooltip, entry (MonthTodayColor), group (Colors)
#: settings/korganizer.kcfg:386
#, kde-format
msgid "Set the background color for today's date in Month View"
msgstr "تنظیم رنگ پس‌زمینه برای تاریخ امروز در نمای ماهانه"

#. i18n: ectx: whatsthis, entry (MonthTodayColor), group (Colors)
#: settings/korganizer.kcfg:387
#, kde-format
msgid "In Month View, select the background color for today's date."
msgstr "در نمای ماهانه، رنگ پس‌زمینه را برای تاریخ امروز انتخاب کنید."

#. i18n: ectx: label, entry, group (Colors)
#: settings/korganizer.kcfg:391
#, kde-format
msgid "Month View holiday color"
msgstr "رنگ تعطیلات در نمای ماهانه"

#. i18n: ectx: tooltip, entry, group (Colors)
#: settings/korganizer.kcfg:392
#, kde-format
msgid "Set the color for holidays in Month View"
msgstr "تنظیم رنگ تعطیلات در نمای ماهانه"

#. i18n: ectx: whatsthis, entry, group (Colors)
#: settings/korganizer.kcfg:393
#, kde-format
msgid ""
"In Month View, select the color for holidays. This color will be used for "
"the holiday backgrounds in the Month View and the holiday dates in the Date "
"Navigator."
msgstr ""
"در نمای ماهانه، رنگ تعطیلات را انتخاب کنید. این رنگ برای پس‌زمینهٔ تعطیلات "
"در نمای ماهانه و تاریخ‌های تعطیل در راه‌بر تاریخ استفاده خواهد شد."

#. i18n: ectx: label, entry, group (Colors)
#: settings/korganizer.kcfg:397
#, kde-format
msgid "Date Navigator grid highlight color"
msgstr "رنگ برجسته‌سازی شبکهٔ راه‌بر تاریخ"

#. i18n: ectx: tooltip, entry, group (Colors)
#: settings/korganizer.kcfg:398
#, kde-format
msgid "Set the Date Navigator grid highlight color here"
msgstr "رنگ برجسته‌سازی شبکهٔ راه‌بر تاریخ را اینجا تنظیم کنید"

#. i18n: ectx: whatsthis, entry, group (Colors)
#: settings/korganizer.kcfg:399
#, kde-format
msgid ""
"Select the color for highlighting the currently selected date range in the "
"Date Navigator."
msgstr "انتخاب رنگ برای برجسته‌سازی بازهٔ تاریخی انتخاب‌شده در ناوبری تاریخ."

#. i18n: ectx: label, entry, group (Fonts)
#: settings/korganizer.kcfg:406
#, kde-format
msgid "Time bar"
msgstr "نوار زمان"

#. i18n: ectx: tooltip, entry, group (Fonts)
#: settings/korganizer.kcfg:407
#, kde-format
msgid "Set the Agenda View time bar labels font"
msgstr "تنظیم قلم برچسب‌های نوار زمان در نمای دستور کار"

#. i18n: ectx: whatsthis, entry, group (Fonts)
#: settings/korganizer.kcfg:408
#, kde-format
msgid ""
"Press this button to configure the time bar font. The time bar is the widget"
" that shows the hours in the Agenda View. This button will open the \"Select"
" Font\" dialog, allowing you to choose the hour font for the time bar."
msgstr ""
"برای پیکربندی قلم نوار زمان این دکمه را فشار دهید. نوار زمان ابزارکی است که "
"ساعت‌ها را در نمای دستور کار نشان می‌دهد. این دکمه پنجرهٔ «انتخاب قلم» را "
"باز می‌کند و به شما امکان می‌دهد قلم ساعت را برای نوار زمان انتخاب کنید."

#. i18n: ectx: label, entry, group (Fonts)
#: settings/korganizer.kcfg:411
#, kde-format
msgid "Month View"
msgstr "نمای ماهانه"

#. i18n: ectx: tooltip, entry, group (Fonts)
#: settings/korganizer.kcfg:412
#, kde-format
msgid "Set the font for Month View items"
msgstr "تنظیم قلم برای موارد نمای ماهانه"

#. i18n: ectx: whatsthis, entry, group (Fonts)
#: settings/korganizer.kcfg:413
#, kde-format
msgid ""
"Press this button to configure the Month View font. This button will open "
"the \"Select Font\" dialog, allowing you to choose the font for the items in"
" the Month View."
msgstr ""
"برای پیکربندی قلم نمای ماهانه این دکمه را فشار دهید. این دکمه پنجرهٔ «انتخاب"
" قلم» را باز می‌کند و به شما اجازه می‌دهد قلم موارد را در نمای ماهانه انتخاب"
" کنید."

#. i18n: ectx: label, entry, group (Fonts)
#: settings/korganizer.kcfg:416
#, kde-format
msgid "Agenda View"
msgstr "نمای دستور کار"

#. i18n: ectx: tooltip, entry, group (Fonts)
#: settings/korganizer.kcfg:417
#, kde-format
msgid "Set the font for Agenda View items"
msgstr "تنظیم قلم برای موارد نمای دستور کار"

#. i18n: ectx: whatsthis, entry, group (Fonts)
#: settings/korganizer.kcfg:418
#, kde-format
msgid ""
"Press this button to configure the Agenda View font. This button will open "
"the \"Select Font\" dialog, allowing you to choose the font for the events "
"in the Agenda View."
msgstr ""
"برای پیکربندی قلم نمای دستور کار این دکمه را فشار دهید. این دکمه پنجرهٔ "
"«انتخاب قلم» را باز می‌کند و به شما اجازه می‌دهد قلم رویدادها را در نمای "
"دستور کار انتخاب کنید."

#. i18n: ectx: label, entry, group (Fonts)
#: settings/korganizer.kcfg:421
#, kde-format
msgid "Current-time (Marcus Bains) line"
msgstr "خط زمان کنونی (مارکوس بینز)"

#. i18n: ectx: tooltip, entry, group (Fonts)
#: settings/korganizer.kcfg:422
#, kde-format
msgid "Set the font for the current-time (Marcus Bains) line in Agenda View"
msgstr "تنظیم قلم خط زمان کنونی (مارکوس بینز) در نمای دستور کار"

#. i18n: ectx: whatsthis, entry, group (Fonts)
#: settings/korganizer.kcfg:423
#, kde-format
msgid ""
"Press this button to configure the current-time (Marcus Bains) line font. "
"This button will open the \"Select Font\" dialog, allowing you to choose the"
" font for the current-time line in the Agenda View."
msgstr ""
"برای پیکربندی قلم خط زمان کنونی (مارکوس بینز) این دکمه را فشار دهید. این "
"دکمه کادر گفتگوی «انتخاب قلم» را باز می‌کند و به شما اجازه می‌دهد قلم خط "
"زمان کنونی را در نمای دستور کار انتخاب کنید."

#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#: settings/korganizer.kcfg:436
#, kde-format
msgid "Default todo attachment method"
msgstr "روش پیش‌فرض پیوست کار"

#. i18n: ectx: whatsthis, entry (DefaultTodoAttachMethod), group (Hidden
#. Options)
#: settings/korganizer.kcfg:437
#, kde-format
msgid "The default way of attaching dropped emails to a task"
msgstr "روش پیش‌فرض پیوست‌کردن رایانامه‌های رهاشده به یک وظیفه"

#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#: settings/korganizer.kcfg:440
#, kde-format
msgid "Always ask"
msgstr "همیشه پرسیده شود"

#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#: settings/korganizer.kcfg:443
#, kde-format
msgid "Only attach link to message"
msgstr "فقط پیوند به پیام پیوست شود"

#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#: settings/korganizer.kcfg:446
#, kde-format
msgid "Attach complete message"
msgstr "پیوست‌کردن کامل پیام"

#. i18n: ectx: property (placeholderText), widget (KListWidgetSearchLine,
#. searchline)
#: ui/filteredit_base.ui:35
#, kde-format
msgctxt "Displayed grayed-out inside the textbox, verb to search"
msgid "Search"
msgstr "جستجو"

#. i18n: ectx: property (text), widget (QPushButton, mNewButton)
#: ui/filteredit_base.ui:49
#, kde-format
msgid "&New"
msgstr "جدید"

#. i18n: ectx: property (text), widget (QPushButton, mDeleteButton)
#: ui/filteredit_base.ui:56
#, kde-format
msgid "&Delete"
msgstr "حذف"

#. i18n: ectx: property (title), widget (QGroupBox, mDetailsFrame)
#: ui/filteredit_base.ui:67
#, kde-format
msgid "Filter Details"
msgstr "جزئیات فیلتر"

#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#: ui/filteredit_base.ui:105
#, kde-format
msgctxt "filter name"
msgid "Name:"
msgstr "نام:"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, mRecurringCheck)
#: ui/filteredit_base.ui:121
#, kde-format
msgid ""
"Select this option if you do not want to show recurring events and to-dos in"
" your views. Daily and weekly recurring items may take a lot of space, so it"
" might be handy to hide them."
msgstr ""
"اگر نمی‌خواهید رویدادها و کارهای تکرارشونده در نماهای شما نشان داده شوند، "
"این گزینه را انتخاب کنید. موارد تکرارشوندهٔ روزانه و هفتگی ممکن است فضای "
"زیادی اشغال کنند، بنابراین پنهان کردن آن‌ها می‌تواند مفید باشد."

#. i18n: ectx: property (text), widget (QCheckBox, mRecurringCheck)
#: ui/filteredit_base.ui:124
#, kde-format
msgid "Hide &recurring events and to-dos"
msgstr "پنهان‌سازی رویدادها و کارهای تکرارشونده"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, mCompletedCheck)
#: ui/filteredit_base.ui:131
#, kde-format
msgid ""
"If this box is checked, the filter will hide all to-do items from the list, "
"that have been completed. Optionally, only items that have been completed a "
"given number of days are hidden."
msgstr ""
"اگر این گزینه علامت زده شود، فیلتر تمام کارهای انجام‌شده را از فهرست پنهان "
"می‌کند. به صورت اختیاری، فقط مواردی پنهان می‌شوند که تعداد روز مشخصی از "
"انجام آن‌ها گذشته باشد."

#. i18n: ectx: property (text), widget (QCheckBox, mCompletedCheck)
#: ui/filteredit_base.ui:134
#, kde-format
msgid "Hide co&mpleted to-dos"
msgstr "پنهان‌سازی کارهای انجام‌شده"

#. i18n: ectx: property (whatsThis), widget (QLabel, mCompletedTimeSpanLabel)
#: ui/filteredit_base.ui:177
#, kde-format
msgid ""
"This option will allow you to select which completed to-dos should be "
"hidden. When you choose <i>Immediately</i>, it will hide the to-do as soon "
"as you check it. You can increase or decrease the number of days in the "
"spinbox."
msgstr ""
"این گزینه به شما امکان می‌دهد انتخاب کنید کدام کارهای انجام‌شده پنهان شوند. "
"با انتخاب <i>بلافاصله</i>، به محض علامت زدن کار، پنهان خواهد شد. می‌توانید "
"تعداد روزها را در جعبهٔ چرخشی افزایش یا کاهش دهید."

#. i18n: ectx: property (text), widget (QLabel, mCompletedTimeSpanLabel)
#: ui/filteredit_base.ui:180
#, kde-format
msgid "Da&ys after completion:"
msgstr "روزهای پس از تکمیل:"

#. i18n: ectx: property (whatsThis), widget (QSpinBox, mCompletedTimeSpan)
#: ui/filteredit_base.ui:193
#, kde-format
msgid ""
"Here you can give the number of days a to-do item has to be completed to be "
"hidden from the to-do list. If you select \"Immediately\", all completed to-"
"dos will be hidden. If you, for example, choose a value of 1, all to-do "
"items will be hidden, that have been marked finished longer than 24 hours "
"ago."
msgstr ""
"در اینجا می‌توانید تعداد روزهایی را تعیین کنید که باید از تکمیل یک کار بگذرد"
" تا از فهرست کارها پنهان شود. اگر «بلافاصله» را انتخاب کنید، همهٔ کارهای "
"انجام‌شده پنهان خواهند شد. برای مثال اگر مقدار ۱ را انتخاب کنید، تمام "
"کارهایی که بیش از ۲۴ ساعت پیش به عنوان انجام‌شده علامت خورده‌اند، پنهان "
"می‌شوند."

#. i18n: ectx: property (whatsThis), widget (QCheckBox,
#. mHideInactiveTodosCheck)
#: ui/filteredit_base.ui:218
#, kde-format
msgid ""
"This option hides all to-dos from your list, where the start date has not "
"been reached. (Note that the start date is not the due date of the to-do "
"item.)"
msgstr ""
"این گزینه تمام کارهای فهرست شما را که تاریخ شروعشان هنوز نرسیده است پنهان "
"می‌کند. (توجه داشته باشید که تاریخ شروع، همان موعد مقرر انجام کار نیست.)"

#. i18n: ectx: property (text), widget (QCheckBox, mHideInactiveTodosCheck)
#: ui/filteredit_base.ui:221
#, kde-format
msgid "Hide &inactive to-dos"
msgstr "پنهان کردن کارهای غیرفعال"

#. i18n: ectx: property (title), widget (QGroupBox, mCategoriesButtonGroup)
#: ui/filteredit_base.ui:228
#, kde-format
msgid "Tags"
msgstr "برچسب‌ها"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, mCatHideCheck)
#: ui/filteredit_base.ui:272
#, kde-format
msgid ""
"When this option is chosen, this filter will show all items which do "
"<i>not</i> contain any of the selected tags."
msgstr ""
"وقتی این گزینه انتخاب شود، این صافی همه مواردی را که <i>شامل هیچ‌یک</i> از "
"برچسب‌های انتخاب‌شده نیستند نشان می‌دهد."

#. i18n: ectx: property (text), widget (QRadioButton, mCatHideCheck)
#: ui/filteredit_base.ui:275
#, kde-format
msgid "Show all except selected"
msgstr "نمایش همه به جز موارد انتخاب‌شده"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, mCatShowCheck)
#: ui/filteredit_base.ui:288
#, kde-format
msgid ""
"When this option is chosen, this filter will show all items containing any "
"of the selected tags."
msgstr ""
"وقتی این گزینه انتخاب شود، این صافی همه موارد حاوی هر یک از برچسب‌های "
"انتخاب‌شده را نشان می‌دهد."

#. i18n: ectx: property (text), widget (QRadioButton, mCatShowCheck)
#: ui/filteredit_base.ui:291
#, kde-format
msgid "Show only selected"
msgstr "نمایش فقط موارد انتخاب‌شده"

#. i18n: ectx: property (text), widget (QPushButton, mCatEditButton)
#: ui/filteredit_base.ui:301
#, kde-format
msgid "Change…"
msgstr "تغییر…"

#. i18n: ectx: property (whatsThis), widget (QCheckBox,
#. mHideTodosNotAssignedToMeCheck)
#: ui/filteredit_base.ui:315
#, kde-format
msgid ""
"This option hides all to-dos from your list which are assigned to someone else.<br>\n"
"Only to-dos which have least one attendee will be checked.  If you are not in the list of attendees the to-do will be hidden."
msgstr ""
"این گزینه تمام کارهایی را که به فرد دیگری واگذار شده از فهرست شما پنهان می‌کند.<br>\n"
"تنها کارهایی که حداقل یک شرکت‌کننده دارند بررسی خواهند شد. اگر در فهرست شرکت‌کنندگان نباشید، کار پنهان خواهد شد."

#. i18n: ectx: property (text), widget (QCheckBox,
#. mHideTodosNotAssignedToMeCheck)
#: ui/filteredit_base.ui:318
#, kde-format
msgid "Hide to-dos not assigned to me"
msgstr "پنهان کردن کارهایی که به من واگذار نشده‌اند"

#. i18n: ectx: attribute (title), widget (QWidget, tabPublish)
#: ui/kogroupwareprefspage.ui:39
#, kde-format
msgid "P&ublish"
msgstr "انتشار"

#. i18n: ectx: property (text), widget (QLabel, TextLabel1)
#: ui/kogroupwareprefspage.ui:60
#, kde-format
msgid ""
"By publishing Free/Busy information, you allow others to take your calendar "
"into account when inviting you for a meeting. Only the times you have "
"already busy are published, not why they are busy."
msgstr ""
"با انتشار اطلاعات آزاد/مشغول، به دیگران اجازه می‌دهید هنگام دعوت شما به "
"جلسه، تقویمتان را در نظر بگیرند. فقط زمان‌هایی که مشغول هستید منتشر می‌شوند،"
" نه دلیل مشغول بودنتان."

#. i18n: ectx: property (whatsThis), widget (QCheckBox, publishEnable)
#: ui/kogroupwareprefspage.ui:72
#, kde-format
msgid ""
"Check this box to upload your Free/Busy information automatically.\n"
"It is possible to skip this option and mail or upload your Free/Busy information using the Schedule menu of KOrganizer.\n"
"Note: If KOrganizer is acting as a KDE Kolab client, this is not required, as the Kolab2 server taking care of publishing your Free/Busy information and manages the access to it from other users."
msgstr ""
"این گزینه را علامت بزنید تا اطلاعات آزاد/مشغول شما به‌طور خودکار بارگذاری شود.\n"
"می‌توانید از این گزینه صرف‌نظر کرده و اطلاعات آزاد/مشغول خود را از طریق منوی زمان‌بندی KOrganizer ایمیل یا بارگذاری کنید.\n"
"نکته: اگر KOrganizer به‌عنوان کارخواه KDE Kolab عمل می‌کند، نیازی به این کار نیست، زیرا سرور Kolab2 انتشار اطلاعات آزاد/مشغول شما و مدیریت دسترسی سایر کاربران به آن را بر عهده می‌گیرد."

#. i18n: ectx: property (text), widget (QCheckBox, publishEnable)
#: ui/kogroupwareprefspage.ui:75
#, kde-format
msgid "Publish your free/&busy information automatically"
msgstr "انتشار خودکار اطلاعات آزاد/مشغول شما"

#. i18n: ectx: property (whatsThis), widget (QLabel, publishDelayLabel)
#. i18n: ectx: property (whatsThis), widget (QSpinBox, publishDelay)
#: ui/kogroupwareprefspage.ui:99 ui/kogroupwareprefspage.ui:112
#, kde-format
msgid ""
"Configure minimum the interval of time in minutes between each upload here. "
"This configuration is only effective in case you choose to publish your "
"information automatically."
msgstr ""
"حداقل فاصله زمانی بین هر بارگذاری را به دقیقه در اینجا پیکربندی کنید. این "
"پیکربندی تنها در صورتی مؤثر است که انتشار خودکار اطلاعات را انتخاب کرده "
"باشید."

#. i18n: ectx: property (text), widget (QLabel, publishDelayLabel)
#: ui/kogroupwareprefspage.ui:102
#, kde-format
msgid "Minimum time between uploads (in minutes):"
msgstr "حداقل زمان بین بارگذاری‌ها (به دقیقه):"

#. i18n: ectx: property (whatsThis), widget (QLabel, TextLabel3)
#. i18n: ectx: property (whatsThis), widget (QSpinBox, publishDays)
#. i18n: ectx: property (whatsThis), widget (QLabel, TextLabel4)
#: ui/kogroupwareprefspage.ui:141 ui/kogroupwareprefspage.ui:154
#: ui/kogroupwareprefspage.ui:170
#, kde-format
msgid ""
"Configure the number of calendar days you wish to be published and available"
" to others here."
msgstr ""
"تعداد روزهای تقویمی را که می‌خواهید منتشر شده و در دسترس دیگران قرار گیرد، "
"در اینجا پیکربندی کنید."

#. i18n: ectx: property (text), widget (QLabel, TextLabel3)
#: ui/kogroupwareprefspage.ui:144
#, kde-format
msgid "Publish"
msgstr "انتشار"

#. i18n: ectx: property (text), widget (QLabel, TextLabel4)
#: ui/kogroupwareprefspage.ui:173
#, kde-format
msgid "days of free/busy information"
msgstr "روز از اطلاعات آزاد/مشغول"

#. i18n: ectx: property (title), widget (QGroupBox, ButtonGroup2)
#. i18n: ectx: property (title), widget (QGroupBox, ButtonGroup2_2)
#: ui/kogroupwareprefspage.ui:198 ui/kogroupwareprefspage.ui:395
#, kde-format
msgid "Server Information"
msgstr "اطلاعات سرور"

#. i18n: ectx: property (whatsThis), widget (QLineEdit, publishUrl)
#. i18n: ectx: property (whatsThis), widget (QLabel, TextLabel7)
#: ui/kogroupwareprefspage.ui:226 ui/kogroupwareprefspage.ui:298
#, kde-format
msgid ""
"Enter the URL for the server on which your Free/Busy information shall be published here.\n"
"Ask the server administrator for this information."
msgstr ""
"نشانی وب سروری را که اطلاعات آزاد/مشغول شما باید روی آن منتشر شود در اینجا وارد کنید.\n"
"این اطلاعات را از مدیر سرور بخواهید."

#. i18n: ectx: property (whatsThis), widget (QLineEdit, publishPassword)
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel2)
#. i18n: ectx: property (whatsThis), widget (QLineEdit, retrievePassword)
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel4)
#: ui/kogroupwareprefspage.ui:233 ui/kogroupwareprefspage.ui:243
#: ui/kogroupwareprefspage.ui:416 ui/kogroupwareprefspage.ui:489
#, kde-format
msgid "Enter your groupware server login password here."
msgstr "گذرواژهٔ ورود به سرور گروهواره‌تان را اینجا وارد کنید."

#. i18n: ectx: property (text), widget (QLabel, textLabel2)
#: ui/kogroupwareprefspage.ui:246
#, kde-format
msgid "Password:"
msgstr "گذرواژه:"

#. i18n: ectx: property (whatsThis), widget (QLabel, TextLabel6)
#. i18n: ectx: property (whatsThis), widget (QLineEdit, publishUser)
#. i18n: ectx: property (whatsThis), widget (QLineEdit, retrieveUser)
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel3)
#: ui/kogroupwareprefspage.ui:258 ui/kogroupwareprefspage.ui:279
#: ui/kogroupwareprefspage.ui:428 ui/kogroupwareprefspage.ui:476
#, kde-format
msgid ""
"Enter the login information relative to your account on the server here.\n"
"\n"
"A Kolab2 server specificity: Registered your UID (Unique IDentifier). By default your UID would be your email address on the Kolab2 server but it may also be different. In the last case enter your UID."
msgstr ""
"اطلاعات ورود مربوط به حسابتان در سرور را اینجا وارد کنید.\n"
"\n"
"یکی از ویژگی‌های سرور Kolab2: شناسهٔ یکتا (UID) خود را ثبت کنید. به‌طور پیش‌فرض UID شما همان نشانی رایانامه‌تان در سرور Kolab2 است، اما ممکن است متفاوت باشد. در حالت دوم، UID خود را وارد کنید."

#. i18n: ectx: property (text), widget (QLabel, TextLabel6)
#: ui/kogroupwareprefspage.ui:261
#, kde-format
msgctxt "login name on the Kolab server"
msgid "Username:"
msgstr "نام کاربری:"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, publishSavePassword)
#. i18n: ectx: property (whatsThis), widget (QCheckBox, retrieveSavePassword)
#: ui/kogroupwareprefspage.ui:287 ui/kogroupwareprefspage.ui:509
#, kde-format
msgid ""
"Check this box to make KOrganizer remember your password and skip asking you each time it uploads your Free/Busy information, by storing it in the configuration file.\n"
"For security reasons, it is not recommended to store your password in the configuration file."
msgstr ""
"این گزینه را علامت بزنید تا KOrganizer با ذخیره کردن گذرواژه در پروندهٔ پیکربندی، آن را به خاطر بسپارد و هربار هنگام بارگذاری اطلاعات آزاد/مشغول از شما نپرسد.\n"
"به دلایل امنیتی، ذخیرهٔ گذرواژه در پروندهٔ پیکربندی توصیه نمی‌شود."

#. i18n: ectx: property (text), widget (QCheckBox, publishSavePassword)
#: ui/kogroupwareprefspage.ui:290
#, kde-format
msgid "Remember p&assword"
msgstr "به‌خاطرسپاری گذرواژه"

#. i18n: ectx: property (text), widget (QLabel, TextLabel7)
#. i18n: ectx: property (text), widget (QLabel, TextLabel7_2)
#: ui/kogroupwareprefspage.ui:301 ui/kogroupwareprefspage.ui:464
#, kde-format
msgid "Server URL:"
msgstr "نشانی وب سرور:"

#. i18n: ectx: property (text), widget (QLabel, label)
#: ui/kogroupwareprefspage.ui:311
#, kde-format
msgid "(No need if using Kolab server version 2)"
msgstr "(در صورت استفاده از سرور Kolab نسخهٔ ۲ نیازی نیست)"

#. i18n: ectx: attribute (title), widget (QWidget, tabRetrieve)
#: ui/kogroupwareprefspage.ui:338
#, kde-format
msgid "&Retrieve"
msgstr "بازیابی"

#. i18n: ectx: property (text), widget (QLabel, TextLabel2)
#: ui/kogroupwareprefspage.ui:359
#, kde-format
msgid ""
"By retrieving Free/Busy information that others have published, you can take"
" their calendar into account when inviting them to a meeting."
msgstr ""
"با دریافت اطلاعات آزاد/مشغول منتشرشده توسط دیگران، می‌توانید هنگام دعوت "
"آن‌ها به یک جلسه، تقویمشان را در نظر بگیرید."

#. i18n: ectx: property (whatsThis), widget (QCheckBox, retrieveEnable)
#: ui/kogroupwareprefspage.ui:369
#, kde-format
msgid ""
"Check this box to retrieve other people's Free/Busy information "
"automatically. Note that you have to fill the correct server information to "
"make this possible."
msgstr ""
"این گزینه را برای دریافت خودکار اطلاعات آزاد/مشغول دیگران علامت بزنید. توجه "
"داشته باشید که برای امکان‌پذیر شدن این کار باید اطلاعات سرور را به‌درستی "
"وارد کنید."

#. i18n: ectx: property (text), widget (QCheckBox, retrieveEnable)
#: ui/kogroupwareprefspage.ui:372
#, kde-format
msgid "Retrieve other people's free/&busy information automatically"
msgstr "دریافت خودکار اطلاعات آزاد/مشغول دیگران"

#. i18n: ectx: property (toolTip), widget (QCheckBox, fullDomainRetrieval)
#: ui/kogroupwareprefspage.ui:382
#, kde-format
msgid ""
"Set this to retrieve user@domain.ifb instead of user.ifb from the server"
msgstr ""
"این گزینه را تنظیم کنید تا به‌جای user.ifb، فایل user@domain.ifb از سرور "
"دریافت شود"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, fullDomainRetrieval)
#: ui/kogroupwareprefspage.ui:385
#, kde-format
msgid ""
"Check this box to download a free/busy file in the format "
"\"user@domain.ifb\" (for example joe@company.com.ifb). Otherwise, it will "
"download a free/busy file in the format user.ifb (for example joe.ifb). Ask "
"the server Administrator if you are not sure about how to configure this "
"option."
msgstr ""
"این گزینه را علامت بزنید تا فایل آزاد/مشغول با قالب «user@domain.ifb» "
"بارگیری شود (برای نمونه joe@company.com.ifb). در غیر این صورت، فایل با قالب "
"user.ifb بارگیری خواهد شد (برای نمونه joe.ifb). اگر درباره نحوه پیکربندی این"
" گزینه مطمئن نیستید، از مدیر سرور بپرسید."

#. i18n: ectx: property (text), widget (QCheckBox, fullDomainRetrieval)
#: ui/kogroupwareprefspage.ui:388
#, kde-format
msgid "Use full email &address for retrieval"
msgstr "استفاده از نشانی رایانامه کامل برای بازیابی"

#. i18n: ectx: property (whatsThis), widget (QLineEdit, retrieveUrl)
#. i18n: ectx: property (whatsThis), widget (QLabel, TextLabel7_2)
#: ui/kogroupwareprefspage.ui:446 ui/kogroupwareprefspage.ui:461
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Enter the URL for the server on which the Free/Busy information is published here.\n"
"Ask the server administrator for this information.\n"
"Here is a Kolab2 Server URL example:\n"
"\n"
"https://kolab2.example.com/freebusy/\n"
"\n"
"Alternatively, you can specify a full path to the Free/Busy. For example:\n"
"\n"
"https://kolab2.example.com/freebusy/user.xfb"
msgstr ""
"نشانی وب سروری را که اطلاعات آزاد/مشغول روی آن منتشر شده است اینجا وارد کنید.\n"
"این اطلاعات را از مدیر سرور بخواهید.\n"
"در اینجا نمونه‌ای از نشانی وب سرور Kolab2 آورده شده است:\n"
"\n"
"https://kolab2.example.com/freebusy/\n"
"\n"
"همچنین می‌توانید یک مسیر کامل به اطلاعات آزاد/مشغول مشخص کنید. برای نمونه:\n"
"\n"
"https://kolab2.example.com/freebusy/user.xfb"

