msgstr "رنگ خط زمان کنونی (مارکوس بینز) در نمای دستور کار"

#. i18n: ectx: tooltip, entry, group (Colors)
#: settings/korganizer.kcfg:368
#, kde-format
msgid "Set the color for the Agenda View current-time (Marcus Bains) line"
msgstr "تنظیم رنگ خط زمان کنونی (مارکوس بینز) در نمای دستور کار"

#. i18n: ectx: whatsthis, entry, group (Colors)
#: settings/korganizer.kcfg:369
#, kde-format
