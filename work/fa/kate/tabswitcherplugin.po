#: tabswitcher.cpp:57
#, kde-format
msgid "Document Switcher"
msgstr "تعویض‌کنندهٔ سند"

#: tabswitcher.cpp:102
#, kde-format
msgid "Last Used Views"
msgstr "آخرین نماهای استفاده‌شده"

#: tabswitcher.cpp:105
#, kde-format
msgid "Opens a list to walk through the list of last used views."
msgstr "فهرستی را برای پیمایش در فهرست آخرین نماهای استفاده‌شده باز می‌کند."

#: tabswitcher.cpp:106 tabswitcher.cpp:114
#, kde-format
msgid "Walk through the list of last used views"
msgstr "پیمایش در فهرست آخرین نماهای استفاده‌شده"

#: tabswitcher.cpp:110
#, kde-format
msgid "Last Used Views (Reverse)"
msgstr "آخرین نماهای استفاده‌شده (معکوس)"

#: tabswitcher.cpp:113
#, kde-format
msgid "Opens a list to walk through the list of last used views in reverse."
msgstr ""
"فهرستی را برای پیمایش معکوس در فهرست آخرین نماهای استفاده‌شده باز می‌کند."

#: tabswitcher.cpp:118
#, kde-format
msgid "Close View"
msgstr "بستن نما"

#: tabswitcher.cpp:121 tabswitcher.cpp:122
#, kde-format
msgid "Closes the selected view in the list of last used views."
msgstr "نمای انتخاب‌شده در فهرست آخرین نماهای استفاده‌شده را می‌بندد."

