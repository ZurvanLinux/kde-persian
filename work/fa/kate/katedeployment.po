msgstr "باز کردن پروندهٔ محلی نگاشت‌شده"

#: deploymentplugin.cpp:905
#, kde-format
msgctxt "@action:inmenu"
msgid "Upload Mapped Local File"
msgstr "بارگذاری پروندهٔ محلی نگاشت‌شده"

#: deploymentplugin.cpp:915
#, kde-format
msgctxt "@action:inmenu"
