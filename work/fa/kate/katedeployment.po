#: deploymentconfig.cpp:102
#, kde-format
msgid "deployment must be an object"
msgstr "استقرار باید یک شیء باشد"

#: deploymentconfig.cpp:118
#, kde-format
msgid "deployment host must not be empty"
msgstr "میزبان استقرار نباید خالی باشد"

#: deploymentconfig.cpp:122 deploymentconfig.cpp:126 deploymentconfig.cpp:196
#, kde-format
msgid "deployment host is invalid"
msgstr "میزبان استقرار نامعتبر است"

#: deploymentconfig.cpp:136
#, kde-format
msgid "deployment port must be between 1 and 65535"
msgstr "درگاه استقرار باید بین ۱ و ۶۵۵۳۵ باشد"

#: deploymentconfig.cpp:142
#, kde-format
msgid "project base must not be empty"
msgstr "پایهٔ پروژه نباید خالی باشد"

#: deploymentconfig.cpp:148
#, kde-format
msgid "project base must be an existing directory"
msgstr "پایهٔ پروژه باید یک پوشهٔ موجود باشد"

#: deploymentconfig.cpp:157
#, kde-format
msgid "deployment localRoot must not contain traversal"
msgstr "localRoot استقرار نباید شامل پیمایش مسیر باشد"

#: deploymentconfig.cpp:165
#, kde-format
msgid ""
"deployment localRoot must be an existing directory inside the project base"
msgstr "localRoot استقرار باید یک پوشهٔ موجود درون پایهٔ پروژه باشد"

#: deploymentconfig.cpp:171
#, kde-format
msgid "deployment remoteRoot must be an absolute path without traversal"
msgstr "remoteRoot استقرار باید یک مسیر مطلق بدون پیمایش مسیر باشد"

#: deploymentconfig.cpp:184
#, kde-format
msgid "deployment exclude entries must be strings"
msgstr "ورودی‌های exclude استقرار باید رشته باشند"

#: deploymentconfig.cpp:190
#, kde-format
msgid "deployment exclude must be a list of strings"
msgstr "exclude استقرار باید فهرستی از رشته‌ها باشد"

#: deploymentplugin.cpp:116
#, kde-format
msgctxt "@title:window"
msgid "Configure Deployment"
msgstr "پیکربندی استقرار"

#: deploymentplugin.cpp:121
#, kde-format
msgid ""
"Configure the SFTP destination for <filename>%1</filename>. Authentication "
"is handled by KIO."
msgstr ""
"پیکربندی مقصد SFTP برای <filename>%1</filename>. احراز هویت توسط KIO انجام "
"می‌شود."

#: deploymentplugin.cpp:138
#, kde-format
msgid "One project-relative glob per line"
msgstr "در هر سطر یک الگوی glob نسبت به پروژه"

#: deploymentplugin.cpp:140
#, kde-format
msgctxt "@label:textbox"
msgid "Host:"
msgstr "میزبان:"

#: deploymentplugin.cpp:141
#, kde-format
msgctxt "@label:spinbox"
msgid "Port:"
msgstr "درگاه:"

#: deploymentplugin.cpp:142
#, kde-format
