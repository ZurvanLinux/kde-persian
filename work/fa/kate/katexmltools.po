#: plugin_katexmltools.cpp:117
#, kde-format
msgid "XML Tools"
msgstr "ابزارهای XML"

#: plugin_katexmltools.cpp:120
#, kde-format
msgid "&Insert Element..."
msgstr "درج عنصر..."

#: plugin_katexmltools.cpp:124
#, kde-format
msgid "&Close Element"
msgstr "بستن عنصر"

#: plugin_katexmltools.cpp:128
#, kde-format
msgid "Assign Meta &DTD..."
msgstr "تخصیص فرا‌DTD..."

#: plugin_katexmltools.cpp:440
#, kde-format
msgid "Assign Meta DTD in XML Format"
msgstr "تخصیص فرا‌DTD در قالب XML"

#: plugin_katexmltools.cpp:446
#, kde-format
msgid ""
"The current file has been identified as a document of type \"%1\". The meta "
"DTD for this document type will now be loaded."
msgstr ""
"پروندهٔ فعلی به عنوان سندی از نوع «%1» شناسایی شده است. اکنون فرا‌DTD برای "
"این نوع سند بارگذاری خواهد شد."

#: plugin_katexmltools.cpp:450
#, kde-format
msgid "Loading XML Meta DTD"
msgstr "بارگذاری فرا‌DTD مربوط به XML"

#: plugin_katexmltools.cpp:483
#, kde-format
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "پروندهٔ «%1» باز نشد. کارساز خطایی بازگرداند."

#: plugin_katexmltools.cpp:486 pseudo_dtd.cpp:46 pseudo_dtd.cpp:58
#, kde-format
msgid "XML Plugin Error"
msgstr "خطای افزونهٔ XML"

#: plugin_katexmltools.cpp:993
#, kde-format
msgid "XML entities"
msgstr "موجودیت‌های XML"

#: plugin_katexmltools.cpp:995
#, kde-format
msgid "XML attribute values"
msgstr "مقادیر ویژگی‌های XML"

#: plugin_katexmltools.cpp:997
#, kde-format
msgid "XML attributes"
msgstr "ویژگی‌های XML"

#: plugin_katexmltools.cpp:1000
#, kde-format
msgid "XML elements"
msgstr "عناصر XML"

#: plugin_katexmltools.cpp:1039
#, kde-format
msgid "Insert XML Element"
msgstr "درج عنصر XML"

#: plugin_katexmltools.cpp:1044
#, kde-format
msgid ""
"Enter XML tag name and attributes (\"<\", \">\" and closing tag will be "
"supplied):"
msgstr ""
"نام برچسب و ویژگی‌های XML را وارد کنید (\"<\", \">\" و برچسب پایانی افزوده "
"خواهند شد):"

#: pseudo_dtd.cpp:43
#, kde-format
msgid ""
"The file '%1' could not be parsed. Please check that the file is well-formed"
" XML."
msgstr ""
"پروندهٔ «%1» تجزیه نشد. لطفاً بررسی کنید که پرونده یک XML خوش‌ساخت باشد."

#: pseudo_dtd.cpp:52
#, kde-format
msgid ""
"The file '%1' is not in the expected format. Please check that the file is of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation for more information."
msgstr ""
"پروندهٔ «%1» در قالب مورد انتظار نیست. لطفاً بررسی کنید که پرونده از این نوع باشد:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"می‌توانید چنین پرونده‌هایی را با dtdparse ایجاد کنید. برای اطلاعات بیشتر، مستندات افزونهٔ Kate را ببینید."

#: pseudo_dtd.cpp:68
#, kde-format
msgid "Analyzing meta DTD..."
msgstr "در حال تحلیل فرا‌DTD..."

#: pseudo_dtd.cpp:68
#, kde-format
msgid "Cancel"
msgstr "لغو"

#. i18n: ectx: Menu (xml)
#: ui.rc:6
#, kde-format
msgid "&XML"
msgstr "XML"
