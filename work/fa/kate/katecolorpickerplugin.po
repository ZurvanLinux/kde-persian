#: colorpickerconfigpage.cpp:34
#, kde-format
msgid "Show preview for known color names"
msgstr "نمایش پیش‌نمایش برای نام رنگ‌های شناخته‌شده"

#: colorpickerconfigpage.cpp:36
#, kde-format
msgid ""
"Also show the color picker for known color names (e.g. skyblue).\n"
"See https://www.w3.org/TR/SVG11/types.html#ColorKeywords for the list of colors."
msgstr ""
"همچنین انتخاب‌گر رنگ برای نام رنگ‌های شناخته‌شده (مانند skyblue) نمایش داده شود.\n"
"برای مشاهدهٔ فهرست رنگ‌ها https://www.w3.org/TR/SVG11/types.html#ColorKeywords را ببینید."

#: colorpickerconfigpage.cpp:39
#, kde-format
msgid "Place preview after text color"
msgstr "قرار دادن پیش‌نمایش پس از رنگ متن"

#: colorpickerconfigpage.cpp:53
#, kde-format
msgid "Hex color matching"
msgstr "تطبیق رنگ هگز"

#: colorpickerconfigpage.cpp:56
#, kde-format
msgid "12 digits (#RRRRGGGGBBBB)"
msgstr "۱۲ رقم (#RRRRGGGGBBBB)"

#: colorpickerconfigpage.cpp:57
#, kde-format
msgid "9 digits (#RRRGGGBBB)"
msgstr "۹ رقم (#RRRGGGBBB)"

#: colorpickerconfigpage.cpp:58
#, kde-format
msgid "8 digits (#AARRGGBB)"
msgstr "۸ رقم (#AARRGGBB)"

#: colorpickerconfigpage.cpp:59
#, kde-format
msgid "6 digits (#RRGGBB)"
msgstr "۶ رقم (#RRGGBB)"

#: colorpickerconfigpage.cpp:60
#, kde-format
msgid "3 digits (#RGB)"
msgstr "۳ رقم (#RGB)"

#: colorpickerconfigpage.cpp:84
