#: kateconsole.cpp:123 kateconsole.cpp:155 kateconsole.cpp:796
#, kde-format
msgid "Terminal"
msgstr "پایانه"

#: kateconsole.cpp:164
#, kde-format
msgctxt "@action"
msgid "&Pipe to Terminal"
msgstr "هدایت به پایانه"

#: kateconsole.cpp:168
#, kde-format
msgctxt "@action"
msgid "S&ynchronize Terminal with Current Document"
msgstr "همگام‌سازی پایانه با سند کنونی"

#: kateconsole.cpp:172
#, kde-format
msgctxt "@action"
msgid "Run Current Document"
msgstr "اجرای سند کنونی"

#: kateconsole.cpp:177 kateconsole.cpp:580
#, kde-format
msgctxt "@action"
msgid "S&how Terminal Panel"
msgstr "نمایش تابلوی پایانه"

#: kateconsole.cpp:183
#, kde-format
msgctxt "@action"
msgid "&Focus Terminal Panel"
msgstr "تمرکز بر تابلوی پایانه"

#: kateconsole.cpp:189
#, kde-format
msgctxt "@action"
msgid "&Split Terminal Vertically"
msgstr "تقسیم عمودی پایانه"

#: kateconsole.cpp:194
#, kde-format
msgctxt "@action"
msgid "&Split Terminal Horizontally"
msgstr "تقسیم افقی پایانه"

#: kateconsole.cpp:199
#, kde-format
msgctxt "@action"
msgid "&New Terminal Tab"
msgstr "زبانهٔ جدید پایانه"

#: kateconsole.cpp:363
#, kde-format
msgid ""
"Konsole not installed. Please install konsole to be able to use the "
"terminal."
msgstr ""
"کنسول نصب نیست. لطفاً برای امکان استفاده از پایانه، konsole را نصب کنید."

#: kateconsole.cpp:439
#, kde-format
msgid ""
"Do you really want to pipe the text to the console? This will execute any "
"contained commands with your user rights."
msgstr ""
"آیا واقعاً می‌خواهید متن را به کنسول هدایت کنید؟ این کار هر فرمان موجود در "
"آن را با دسترسی‌های کاربری شما اجرا خواهد کرد."

#: kateconsole.cpp:440
#, kde-format
msgid "Pipe to Terminal?"
msgstr "هدایت به پایانه؟"

#: kateconsole.cpp:441
#, kde-format
msgid "Pipe to Terminal"
msgstr "هدایت به پایانه"

#: kateconsole.cpp:509
#, kde-format
msgid "Not a local file: '%1'"
msgstr "یک پروندهٔ محلی نیست: '%1'"

#: kateconsole.cpp:542
#, kde-format
msgid ""
"Do you really want to Run the document ?\n"
"This will execute the following command,\n"
"with your user rights, in the terminal:\n"
"'%1'"
msgstr ""
"آیا واقعاً می‌خواهید سند را اجرا کنید؟\n"
"این کار فرمان زیر را با دسترسی‌های کاربری شما،\n"
"در پایانه اجرا خواهد کرد:\n"
"'%1'"

#: kateconsole.cpp:549
#, kde-format
msgid "Run in Terminal?"
msgstr "اجرا در پایانه؟"

#: kateconsole.cpp:550
#, kde-format
msgid "Run"
msgstr "اجرا"

#: kateconsole.cpp:582
#, kde-format
msgctxt "@action"
msgid "&Hide Terminal Panel"
msgstr "نهفتن تابلوی پایانه"

#: kateconsole.cpp:590
#, kde-format
msgid "Defocus Terminal Panel"
msgstr "برداشتن تمرکز از تابلوی پایانه"

#: kateconsole.cpp:591 kateconsole.cpp:592
#, kde-format
msgid "Focus Terminal Panel"
msgstr "تمرکز روی تابلوی پایانه"

#: kateconsole.cpp:704
#, kde-format
msgid "Terminal Synchronization Mode"
msgstr "حالت همگام‌سازی پایانه"

#: kateconsole.cpp:707
#, kde-format
msgid "&Don't synchronize terminal tab with current document"
msgstr "عدم همگام‌سازی زبانهٔ پایانه با سند کنونی"

#: kateconsole.cpp:710
#, kde-format
msgid ""
"&Automatically synchronize the current terminal tab with the current "
"document when possible"
msgstr "همگام‌سازی خودکار زبانهٔ کنونی پایانه با سند کنونی در صورت امکان"

#: kateconsole.cpp:713
#, kde-format
msgid ""
"&Automatically create a terminal tab for the directory of the current "
"document and switch to it"
msgstr "ایجاد خودکار زبانهٔ پایانه برای پوشهٔ سند کنونی و رفتن به آن"

#: kateconsole.cpp:720 kateconsole.cpp:741
#, kde-format
msgid "Run in terminal"
msgstr "اجرا در پایانه"

#: kateconsole.cpp:722
#, kde-format
msgid "&Remove extension"
msgstr "حذف پسوند"

#: kateconsole.cpp:727
#, kde-format
msgid "Prefix:"
msgstr "پیشوند:"

#: kateconsole.cpp:735
#, kde-format
msgid "&Show warning next time"
msgstr "نمایش هشدار در دفعهٔ بعد"

#: kateconsole.cpp:737
#, kde-format
msgid ""
"The next time '%1' is executed, make sure a warning window will pop up, "
"displaying the command to be sent to terminal, for review."
msgstr ""
"دفعهٔ بعد که '%1' اجرا شود، مطمئن می‌شود پنجرهٔ هشداری باز شده و دستور "
"ارسالی به پایانه را جهت بازبینی نمایش دهد."

#: kateconsole.cpp:748
#, kde-format
msgid "Set &EDITOR environment variable to 'kate -b'"
msgstr "تنظیم متغیر محیطی EDITOR روی 'kate -b'"

#: kateconsole.cpp:751
#, kde-format
msgid ""
"Important: The document has to be closed to make the console application "
"continue"
msgstr "مهم: برای ادامهٔ کار برنامهٔ کنسول، سند باید بسته شود"

#: kateconsole.cpp:754
#, kde-format
msgid "Hide Konsole on pressing 'Esc'"
msgstr "پنهان کردن کنسول با فشردن 'Esc'"

#: kateconsole.cpp:757
#, kde-format
msgid ""
"This may cause issues with terminal apps that use Esc key, for e.g., vim. "
"Add these apps in the input below (Comma separated list)"
msgstr ""
"این ممکن است باعث ایجاد مشکل در برنامه‌های پایانه‌ای شود که از کلید Esc "
"استفاده می‌کنند (مانند vim). این برنامه‌ها را در ورودی زیر اضافه کنید (فهرست"
" جداشده با کاما)"

#: kateconsole.cpp:801
#, kde-format
msgid "Terminal Settings"
msgstr "تنظیمات پایانه"

#. i18n: ectx: Menu (tools)
#: ui.rc:6
#, kde-format
msgid "&Tools"
msgstr "ابزارها"
