#: attica/atticaprovider.cpp:167
#, kde-format
msgid "All categories are missing"
msgstr "همه دسته‌ها مفقود هستند"

#: attica/atticaprovider.cpp:352
#, kde-format
msgctxt ""
"the price of a download item, parameter 1 is the currency, 2 is the price"
msgid ""
"This item costs %1 %2.\n"
"Do you want to buy it?"
msgstr ""
"قیمت این مورد %2 %1 است.\n"
"آیا می‌خواهید آن را بخرید؟"

#: attica/atticaprovider.cpp:366
#, kde-format
msgid ""
"Your account balance is too low:\n"
"Your balance: %1\n"
"Price: %2"
msgstr ""
"موجودی حساب شما کافی نیست:\n"
"موجودی شما: %1\n"
"قیمت: %2"

#: attica/atticaprovider.cpp:398
#, kde-format
msgctxt "voting for an item (good/bad)"
msgid "Your vote was recorded."
msgstr "رأی شما ثبت شد."

#: attica/atticaprovider.cpp:413
#, kde-format
msgid "You are now a fan."
msgstr "اکنون شما یک طرفدار هستید."

#: attica/atticaprovider.cpp:441 core/enginebase.cpp:269
#: opds/opdsprovider.cpp:291
#, kde-format
msgid ""
"The service is currently undergoing maintenance and is expected to be back "
"in %1."
msgstr ""
"سرویس در حال حاضر تحت تعمیر و نگهداری است و انتظار می‌رود تا %1 دیگر در "
"دسترس قرار گیرد."

#: attica/atticaprovider.cpp:446
#, kde-format
msgid "Network error %1: %2"
msgstr "خطای شبکه %1: %2"

#: attica/atticaprovider.cpp:453
#, kde-format
msgid "Too many requests to server. Please try again in a few minutes."
msgstr ""
"درخواست‌های بسیار زیادی به کارساز ارسال شده است. لطفاً چند دقیقهٔ دیگر "
"دوباره امتحان کنید."

#: attica/atticaprovider.cpp:457
#, kde-format
msgid ""
"The Open Collaboration Services instance %1 does not support the attempted "
"function."
msgstr "نمونهٔ «خدمات همکاری باز» %1 از عملکرد مورد نظر پشتیبانی نمی‌کند."

#: attica/atticaprovider.cpp:461
#, kde-format
msgid "Unknown Open Collaboration Service API error. (%1)"
msgstr "خطای ناشناختهٔ رابط برنامه‌نویسی «خدمات همکاری باز». (%1)"

#: core/commentsmodel.cpp:154
#, kde-format
msgctxt ""
"The value returned for an unknown role when requesting data from the model."
msgid "Unknown CommentsModel role"
msgstr "نقش ناشناخته CommentsModel"

#: core/enginebase.cpp:98
#, kde-format
msgid ""
"An error occurred during the installation process:\n"
"%1"
msgstr ""
"خطایی هنگام فرایند نصب رخ داد:\n"
"%1"

#: core/enginebase.cpp:134
#, kde-format
msgid "Configuration file does not exist: \"%1\""
msgstr "پرونده پیکربندی وجود ندارد: «%1»"

#: core/enginebase.cpp:142
#, kde-format
msgid "Configuration file exists, but cannot be opened: \"%1\""
msgstr "پرونده پیکربندی وجود دارد، اما باز نمی‌شود: «%1»"

#: core/enginebase.cpp:149
#, kde-format
msgid "Configuration file is invalid: \"%1\""
msgstr "پرونده پیکربندی نامعتبر است: «%1»"

#: core/enginebase.cpp:158
#, kde-format
msgid "Use"
msgstr "استفاده"

#: core/enginebase.cpp:187
#, kde-format
msgid ""
"Could not initialise the installation handler for %1:\n"
"%2\n"
"This is a critical error and should be reported to the application author"
msgstr ""
"راه‌اندازی کنترل‌کننده نصب برای %1 ممکن نشد:\n"
"%2\n"
"این یک خطای بحرانی است و باید به توسعه‌دهنده برنامه گزارش شود"

#: core/enginebase.cpp:354
#, kde-format
msgid "Loading of providers from file: %1 failed"
msgstr "بارگیری ارائه‌دهندگان از پرونده %1 ناموفق بود"

#: core/enginebase.cpp:372
#, kde-format
msgid "Could not load get hot new stuff providers from file: %1"
msgstr "بارگیری ارائه‌دهندگان «دریافت چیزهای داغ جدید» از پرونده %1 ممکن نشد"

#: core/enginebase.cpp:403
#, kde-format
msgid "Error initializing provider."
msgstr "خطا در راه‌اندازی ارائه‌دهنده."

#: core/installation.cpp:101
#, kde-format
msgid "Invalid item."
msgstr "مورد نامعتبر."

#: core/installation.cpp:108
#, kde-format
msgid "Download of item failed: no download URL for \"%1\"."
msgstr "بارگیری مورد ناموفق بود: نشانی وب بارگیری برای «%1» وجود ندارد."

#: core/installation.cpp:139
#, kde-format
msgid "Download of \"%1\" failed, error: %2"
msgstr "بارگیری «%1» ناموفق بود، خطا: %2"

#: core/installation.cpp:148
#, kde-format
msgid ""
"Cannot install '%1' because it points to a web page. Click <a "
"href='%2'>here</a> to finish the installation."
msgstr ""
"نمی‌توان «%1» را نصب کرد زیرا به یک صفحه وب اشاره دارد. برای اتمام نصب <a "
"href='%2'>اینجا</a> کلیک کنید."

#: core/installation.cpp:186
#, kde-format
msgid "Could not install \"%1\": file not found."
msgstr "نمی‌توان «%1» را نصب کرد: پرونده پیدا نشد."

#: core/installation.cpp:352 core/installation.cpp:599
#, kde-format
msgid "Installation of %1 failed: %2"
msgstr "نصب %1 ناموفق بود: %2"

#: core/installation.cpp:386
#, kde-format
msgid "Could not determine the type of archive of the downloaded file %1"
msgstr "تشخیص نوع بایگانی پرونده بارگیری‌شده %1 امکان‌پذیر نبود"

#: core/installation.cpp:398
#, kde-format
msgid "Failed to open the archive file %1. The reported error was: %2"
msgstr "باز کردن پرونده بایگانی %1 ناموفق بود. خطای گزارش‌شده: %2"

#: core/installation.cpp:465
#, kde-format
msgid ""
"This file already exists on disk (possibly due to an earlier failed download"
" attempt). Continuing means overwriting it. Do you wish to overwrite the "
"existing file?"
msgstr ""
"این پرونده از قبل روی دیسک وجود دارد (احتمالاً به دلیل تلاش ناموفق قبلی برای"
" بارگیری). ادامه دادن به معنای بازنویسی آن است. آیا مایلید پرونده موجود "
"رونویسی شود؟"

#: core/installation.cpp:468
#, kde-format
msgid "Overwrite File"
msgstr "رونویسی پرونده"

#: core/installation.cpp:487
#, kde-format
msgid "Unable to move the file %1 to the intended destination %2"
msgstr "امکان انتقال پروندهٔ %1 به مقصد موردنظر %2 وجود ندارد"

#: core/installation.cpp:510
#, kde-format
msgid ""
"The installation failed while attempting to run the command:\n"
"%1\n"
"\n"
"The returned output was:\n"
"%2"
msgstr ""
"نصب هنگام تلاش برای اجرای فرمان زیر شکست خورد:\n"
"%1\n"
"\n"
"خروجی بازگردانده‌شده:\n"
"%2"

#: core/installation.cpp:521
#, kde-format
msgid ""
"The installation failed with code %1 while attempting to run the command:\n"
"%2\n"
"\n"
"The returned output was:\n"
"%3"
msgstr ""
"نصب با کد %1 هنگام تلاش برای اجرای فرمان زیر شکست خورد:\n"
"%2\n"
"\n"
"خروجی بازگردانده‌شده:\n"
"%3"

#: core/installation.cpp:563
#, kde-format
msgid ""
"The removal of %1 failed, as the installed file %2 could not be "
"automatically removed. You can attempt to manually delete this file, if you "
"believe this is an error."
msgstr ""
"حذف %1 ناموفق بود، زیرا پروندهٔ نصب‌شدهٔ %2 به‌طور خودکار حذف نشد. اگر فکر "
"می‌کنید این یک خطا است، می‌توانید به‌صورت دستی این پرونده را حذف کنید."

#: core/installation.cpp:632
#, kde-format
msgid ""
"The uninstallation process failed to successfully run the command %1\n"
"The output of was: \n"
"%2\n"
"If you think this is incorrect, you can continue or cancel the uninstallation process"
msgstr ""
"فرایند حذف نصب نتوانست فرمان %1 را با موفقیت اجرا کند\n"
"خروجی عبارت بود از: \n"
"%2\n"
"اگر فکر می‌کنید این نادرست است، می‌توانید فرایند حذف نصب را ادامه داده یا لغو کنید"

#: core/jobs/filecopyworker.cpp:60
#, kde-format
msgid "Could not open %1 for writing"
msgstr "امکان باز کردن %1 برای نوشتن وجود نداشت"

#: core/jobs/filecopyworker.cpp:63
#, kde-format
msgid "Could not open %1 for reading"
msgstr "امکان باز کردن %1 برای خواندن وجود نداشت"

#: core/transaction.cpp:126
#, kde-format
msgid ""
"Could not perform an installation of the entry %1 as it does not have any "
"downloadable items defined. Please contact the author so they can fix this."
msgstr ""
"امکان نصب ورودی %1 وجود نداشت زیرا هیچ مورد قابل بارگیری برای آن تعریف نشده "
"است. لطفاً با پدیدآورنده تماس بگیرید تا این مشکل را برطرف کند."

#: core/transaction.cpp:341
#, kde-format
msgid "Pick Update Item"
msgstr "انتخاب مورد به‌روزرسانی"

#: core/transaction.cpp:343
#, kde-format
msgid ""
"Please pick the item from the list below which should be used to apply this "
"update. We were unable to identify which item to select, based on the "
"original item, which was named %1"
msgstr ""
"لطفاً موردی را که باید برای اعمال این به‌روزرسانی استفاده شود، از فهرست زیر "
"انتخاب کنید. بر اساس مورد اصلی با نام %1، امکان تشخیص این‌که کدام مورد باید "
"انتخاب شود وجود نداشت"

#: core/transaction.cpp:367
#, kde-format
msgid ""
"We failed to identify a good link for updating %1, and are unable to perform"
" the update"
msgstr ""
"پیوند مناسبی برای به‌روزرسانی %1 پیدا نشد و امکان انجام به‌روزرسانی وجود "
"ندارد"

#: core/transaction.cpp:460
#, kde-format
msgid ""
"Failed to adopt '%1'\n"
"%2"
msgstr ""
"پذیرش «%1» ناموفق بود\n"
"%2"

#: qtquick/categoriesmodel.cpp:52
#, kde-format
msgctxt ""
"The first entry in the category selection list (also the default value)"
msgid "All Categories"
msgstr "همهٔ دسته‌ها"

#: qtquick/categoriesmodel.cpp:74
#, kde-format
msgctxt ""
"The string passed back in the case the requested category is not known"
msgid "Unknown Category"
msgstr "دستهٔ ناشناخته"

#. i18nd("knewstuff6", "Download New %1…").
#. \note For the sake of consistency, you should NOT override the text
#. property, just set this one
#: qtquick/qml/Button.qml:46
#, kde-format
msgctxt ""
"Used to construct the button's label (which will become Download New 'this "
"value'…)"
msgid "Stuff"
msgstr "موارد"

#: qtquick/qml/Button.qml:47
#, kde-format
msgid "Download New %1…"
msgstr "بارگیری %1 جدید…"

#: qtquick/qml/Dialog.qml:47
#, kde-format
msgctxt "The dialog title when we know which type of stuff is being requested"
msgid "Download New %1"
msgstr "بارگیری %1 جدید"

#: qtquick/qml/Dialog.qml:48
#, kde-format
msgctxt ""
"A placeholder title used in the dialog when there is no better title "
"available"
msgid "Download New Stuff"
msgstr "بارگیری موارد جدید"

#: qtquick/qml/DownloadItemsSheet.qml:38
#, kde-format
msgid "Pick Your Installation Option"
msgstr "گزینهٔ نصب خود را انتخاب کنید"

#: qtquick/qml/DownloadItemsSheet.qml:50
#, kde-format
msgid ""
"Please select the option you wish to install from the list of downloadable "
"items below. If it is unclear which you should chose out of the available "
"options, please contact the author of this item and ask that they clarify "
"this through the naming of the items."
msgstr ""
"لطفاً گزینهٔ مورد نظر برای نصب را از فهرست موارد قابل بارگیری زیر انتخاب "
"کنید. اگر مشخص نیست از بین گزینه‌های موجود کدام را باید انتخاب کنید، لطفاً "
"با پدیدآورندهٔ این مورد تماس بگیرید و از او بخواهید از طریق نام‌گذاری موارد،"
" این موضوع را شفاف کند."

#: qtquick/qml/DownloadItemsSheet.qml:91
#, kde-format
msgid "Install"
msgstr "نصب"

#: qtquick/qml/EntryDetails.qml:92
#, kde-format
msgctxt ""
"A passive notification shown when installation of an item is initiated"
msgid "Installing %1 from %2"
msgstr "در حال نصب %1 از %2"

#: qtquick/qml/EntryDetails.qml:109
#, kde-format
msgctxt ""
"Combined title for the entry details page made of the name of the entry, and"
" the author's name"
msgid "%1 by %2"
msgstr "%1 اثر %2"

#: qtquick/qml/EntryDetails.qml:114
#: qtquick/qml/private/entrygriddelegates/BigPreviewDelegate.qml:43
#: qtquick/qml/private/entrygriddelegates/TileDelegate.qml:48
#, kde-format
msgctxt ""
"Request installation of this item, available when there is exactly one "
"downloadable item"
msgid "Install"
msgstr "نصب"

#: qtquick/qml/EntryDetails.qml:115
#: qtquick/qml/private/entrygriddelegates/BigPreviewDelegate.qml:44
#: qtquick/qml/private/entrygriddelegates/TileDelegate.qml:49
#, kde-format
msgctxt ""
"Show installation options, where there is more than one downloadable item"
msgid "Install…"
msgstr "نصب…"

#: qtquick/qml/EntryDetails.qml:131
#: qtquick/qml/private/entrygriddelegates/BigPreviewDelegate.qml:59
#: qtquick/qml/private/entrygriddelegates/TileDelegate.qml:64
#, kde-format
msgctxt "Request updating of this item"
msgid "Update"
msgstr "به‌روزرسانی"

#: qtquick/qml/EntryDetails.qml:138 qtquick/qml/Page.qml:121
#, kde-format
msgctxt "Request uninstallation of this item"
msgid "Uninstall"
msgstr "حذف نصب"

#: qtquick/qml/EntryDetails.qml:160
#, kde-format
msgctxt ""
"Status message to be shown when the entry is in the process of being "
"installed OR uninstalled"
msgid "Currently working on the item %1 by %2. Please wait…"
msgstr "در حال پردازش مورد %1 اثر %2. لطفاً صبر کنید…"

#: qtquick/qml/EntryDetails.qml:162
#, kde-format
msgctxt ""
"Status message to be shown when the entry is in the process of being updated"
msgid "Currently updating the item %1 by %2. Please wait…"
msgstr "در حال به‌روزرسانی مورد %1 اثر %2. لطفاً صبر کنید…"

#: qtquick/qml/EntryDetails.qml:164
#, kde-format
msgctxt ""
"Status message which should only be shown when the entry has been given some"
" unknown or invalid status."
msgid ""
"This item is currently in an invalid or unknown state. <a "
"href=\"https://bugs.kde.org/enter_bug.cgi?product=frameworks-"
"knewstuff\">Please report this to the KDE Community in a bug report</a>."
msgstr ""
"این مورد در حال حاضر در وضعیتی نامعتبر یا نامشخص قرار دارد. <a "
"href=\"https://bugs.kde.org/enter_bug.cgi?product=frameworks-"
"knewstuff\">لطفاً این موضوع را در قالب یک گزارش اشکال به جامعهٔ KDE گزارش "
"دهید</a>."

#: qtquick/qml/EntryDetails.qml:218
#, kde-format
msgid "Rating:"
msgstr "امتیاز:"

#: qtquick/qml/EntryDetails.qml:226
#, kde-format
msgctxt "@action:button Opens a new sub-page with comments for this entry"
msgid "See %1 Reviews and Comments"
msgstr "مشاهدهٔ %1 بازخورد و دیدگاه"

#: qtquick/qml/EntryDetails.qml:231
#, kde-format
msgid "Homepage:"
msgstr "صفحهٔ خانگی:"

#: qtquick/qml/EntryDetails.qml:232
#, kde-format
msgctxt ""
"A link which, when clicked, opens the website associated with the entry "
"(this could be either one specific to the project, the author's homepage, or"
" any other website they have chosen for the purpose)"
msgid "Open the homepage for %1"
msgstr "باز کردن صفحهٔ خانگی %1"

#: qtquick/qml/EntryDetails.qml:238
#, kde-format
msgid "How To Donate:"
msgstr "نحوهٔ کمک مالی:"

#: qtquick/qml/EntryDetails.qml:239
#, kde-format
msgctxt ""
"A link which, when clicked, opens a website with information on donation in "
"support of the entry"
msgid "Find out how to donate to this project"
msgstr "آگاهی از نحوهٔ کمک مالی به این پروژه"

#: qtquick/qml/Page.qml:147
#, kde-kuit-format
msgctxt "@info displayed as InlineMessage"
msgid ""
"Use caution when accessing user-created content shown here, as it may "
"contain executable code that hasn't been tested by KDE or %1 for safety, "
"stability, or quality."
msgstr ""
"هنگام دسترسی به محتوای ایجادشده توسط کاربر که در اینجا نشان داده شده است "
"احتیاط کنید، زیرا ممکن است حاوی کدهای اجرایی باشد که از نظر ایمنی، پایداری "
"یا کیفیت توسط KDE یا %1 آزمایش نشده است."

#: qtquick/qml/Page.qml:148
#, kde-format
msgctxt "@info displayed as InlineMessage"
msgid ""
"User-created content shown here hasn't been tested by KDE or %1 for "
"functionality or quality."
msgstr ""
"محتوای ایجادشده توسط کاربر که در اینجا نشان داده شده است، از نظر کارایی یا "
"کیفیت توسط KDE یا %1 آزمایش نشده است."

#: qtquick/qml/Page.qml:179
#, kde-format
msgctxt "@action:button opening menu similar to combobox, filter list"
msgid "All"
msgstr "همه"

#: qtquick/qml/Page.qml:181
#, kde-format
msgctxt "@action:button opening menu similar to combobox, filter list"
msgid "Installed"
msgstr "نصب‌شده"

#: qtquick/qml/Page.qml:183
#, kde-format
msgctxt "@action:button opening menu similar to combobox, filter list"
msgid "Updateable"
