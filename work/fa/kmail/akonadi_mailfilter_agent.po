#: filterlogdialog.cpp:45
#, kde-format
msgctxt "@action:button"
msgid "Share…"
msgstr "هم‌رسانی…"

#: filterlogdialog.cpp:47
#, kde-format
msgctxt "@title:window"
msgid "Filter Log Viewer"
msgstr "نمایشگر گزارش پالایه"

#: filterlogdialog.cpp:69
#, kde-format
msgctxt "@option:check"
msgid "&Log filter activities"
msgstr "ثبت فعالیت‌های پالایه"

#: filterlogdialog.cpp:74
#, kde-format
msgid ""
"You can turn logging of filter activities on and off here. Of course, log "
"data is collected and shown only when logging is turned on. "
msgstr ""
"می‌توانید ثبت فعالیت‌های پالایه را در اینجا روشن و خاموش کنید. البته "
"داده‌های گزارش فقط زمانی جمع‌آوری و نشان داده می‌شوند که گزارش‌گیری روشن "
"باشد."

#: filterlogdialog.cpp:95
#, kde-format
msgid "Logging Details"
msgstr "جزئیات گزارش‌گیری"

#: filterlogdialog.cpp:102
#, kde-format
msgctxt "@option:check"
msgid "Log pattern description"
msgstr "ثبت شرح الگو"

#: filterlogdialog.cpp:107
#, kde-format
msgctxt "@option:check"
msgid "Log filter &rule evaluation"
msgstr "ثبت ارزیابی قاعدهٔ پالایه"

#: filterlogdialog.cpp:112
#, kde-format
msgid ""
"You can control the feedback in the log concerning the evaluation of the "
"filter rules of applied filters: having this option checked will give "
"detailed feedback for each single filter rule; alternatively, only feedback "
"about the result of the evaluation of all rules of a single filter will be "
"given."
msgstr ""
"می‌توانید بازخورد موجود در گزارش دربارهٔ ارزیابی قواعد پالایه برای "
"پالایه‌های اعمال‌شده را کنترل کنید: با علامت زدن این گزینه، بازخورد دقیقی "
"برای تک‌تک قواعد پالایه ارائه خواهد شد؛ در غیر این صورت، تنها بازخوردی "
"دربارهٔ نتیجهٔ ارزیابی همهٔ قواعد یک پالایه ارائه می‌شود."

#: filterlogdialog.cpp:119
#, kde-format
msgctxt "@option:check"
msgid "Log filter pattern evaluation"
msgstr "ثبت ارزیابی الگوی پالایه"

#: filterlogdialog.cpp:124
#, kde-format
msgctxt "@option:check"
msgid "Log filter actions"
msgstr "ثبت کنش‌های پالایه"

#: filterlogdialog.cpp:134
#, kde-format
msgctxt "@label:textbox"
msgid "Log size limit:"
msgstr "محدودیت اندازهٔ گزارش:"

#: filterlogdialog.cpp:142
#, kde-format
msgid " KB"
msgstr " کیلوبایت"

#: filterlogdialog.cpp:143
#, kde-format
msgctxt "@label:spinbox Set the size of the logfile to unlimited."
msgid "unlimited"
msgstr "نامحدود"

#: filterlogdialog.cpp:146
#, kde-format
msgid ""
"Collecting log data uses memory to temporarily store the log data; here you "
"can limit the maximum amount of memory to be used: if the size of the "
"collected log data exceeds this limit then the oldest data will be discarded"
" until the limit is no longer exceeded. "
msgstr ""
"جمع‌آوری داده‌های گزارش از حافظه برای ذخیرهٔ موقت داده‌ها استفاده می‌کند؛ در"
" اینجا می‌توانید حداکثر حافظهٔ مورد استفاده را محدود کنید: اگر اندازهٔ "
"داده‌های جمع‌آوری‌شده از این حد فراتر رود، قدیمی‌ترین داده‌ها حذف می‌شوند تا"
" زمانی که مقدار مجاز رعایت شود."

#: filterlogdialog.cpp:324
#, kde-format
msgid ""
"Could not write the file %1:\n"
"\"%2\" is the detailed error description."
msgstr ""
"نوشتن پروندهٔ %1 امکان‌پذیر نبود:\n"
"«%2» شرح دقیق خطا است."

#: filterlogdialog.cpp:328
#, kde-format
msgctxt "@title:window"
msgid "KMail Error"
msgstr "خطای کی‌میل"

#: filtermanager.cpp:101
#, kde-format
msgid "Filtering message %1 of %2"
msgstr "پالایش پیام %1 از %2"

#: filtermanager.cpp:186
#, kde-format
msgid "Error applying mail filter move"
msgstr "خطا در اعمال انتقال پالایهٔ رایانامه"

#: filtermanager.cpp:194
#, kde-format
msgid "Error applying mail filter delete"
msgstr "خطا در اعمال حذف پالایهٔ رایانامه"

#: filtermanager.cpp:202
#, kde-format
msgid "Error applying mail filter modifications"
msgstr "خطا در اعمال تغییرات پالایهٔ رایانامه"

#: filtermanager.cpp:219
#, kde-format
msgid "<b>Evaluating filter rules:</b> "
msgstr "<b>ارزیابی قواعد فیلتر:</b> "

#: filtermanager.cpp:226
#, kde-format
msgid "<b>Filter rules have matched.</b>"
msgstr "<b>قواعد فیلتر مطابقت داشتند.</b>"

#: filtermanager.cpp:254
#, kde-format
msgid "<b>Begin filtering on message \"%1\" from \"%2\" at \"%3\" :</b>"
msgstr "<b>شروع فیلتر کردن روی پیام «%1» از طرف «%2» در «%3»:</b>"

#: filtermanager.cpp:587 mailfilteragent.cpp:222
#, kde-format
msgid "Filtering messages"
msgstr "فیلتر کردن پیام‌ها"

#: mailfilteragent.cpp:92
#, kde-format
msgid "Starting"
msgstr "در حال شروع"

#: mailfilteragent.cpp:114
#, kde-format
msgctxt "Notification when the filter log was enabled"
msgid "Mail Filter Log Enabled"
msgstr "گزارش فیلتر رایانامه فعال شد"

#: mailfilteragent.cpp:116
#, kde-format
msgid "Show Log"
msgstr "نمایش گزارش"

#: mailfilteragent.cpp:183
#, kde-format
msgid "Ready"
msgstr "آماده"

#: mailfilteragent.cpp:270
#, kde-format
msgid "Filtering in %1"
msgstr "فیلتر کردن در %1"

#: mailfilteragent.cpp:393
#, kde-format
msgid "Finished filtering, %1 message processed"
msgid_plural "Finished filtering, %1 messages processed"
msgstr[0] "فیلتر کردن به پایان رسید، %1 پیام پردازش شد"
msgstr[1] "فیلتر کردن به پایان رسید، %1 پیام پردازش شدند"
