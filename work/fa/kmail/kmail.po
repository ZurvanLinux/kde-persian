#: identity/identitydialog.cpp:372
#, kde-format
msgctxt "@label:textbox"
msgid "&Your name:"
msgstr "نام شما:"

#: identity/identitydialog.cpp:377
#, kde-format
msgid ""
"<qt><h3>Your name</h3><p>This field should contain your name as you would "
"like it to appear in the email header that is sent out;</p><p>if you leave "
"this blank your real name will not appear, only the email address.</p></qt>"
msgstr ""
"<qt><h3>نام شما</h3><p>این فیلد باید شامل نام شما به همان صورتی باشد که "
"می‌خواهید در سرآیند رایانامه‌های ارسالی نمایش داده شود؛</p><p>اگر این فیلد "
"را خالی بگذارید، نام واقعی شما نمایش داده نخواهد شد و فقط نشانی رایانامه "
"ظاهر می‌شود.</p></qt>"

#: identity/identitydialog.cpp:388
#, kde-format
msgctxt "@label:textbox"
msgid "Organi&zation:"
msgstr "سازمان:"

#: identity/identitydialog.cpp:393
#, kde-format
msgid ""
"<qt><h3>Organization</h3><p>This field should have the name of your "
"organization if you would like it to be shown in the email header that is "
"sent out.</p><p>It is safe (and normal) to leave this blank.</p></qt>"
msgstr ""
"<qt><h3>سازمان</h3><p>اگر مایلید نام سازمان شما در سرآیند رایانامه‌های "
"ارسالی نمایش داده شود، باید آن را در این فیلد وارد کنید.</p><p>خالی گذاشتن "
"این فیلد بی‌خطر (و معمول) است.</p></qt>"

#: identity/identitydialog.cpp:405
#, kde-format
msgctxt "@label:textbox"
msgid "&Email address:"
msgstr "نشانی رایانامه:"

#: identity/identitydialog.cpp:410
#, kde-format
msgid ""
"<qt><h3>Email address</h3><p>This field should have your full email "
"address.</p><p>This address is the primary one, used for all outgoing mail. "
"If you have more than one address, either create a new identity, or add "
"additional alias addresses in the field below.</p><p>If you leave this "
"blank, or get it wrong, people will have trouble replying to you.</p></qt>"
msgstr ""
"<qt><h3>نشانی رایانامه</h3><p>این فیلد باید شامل نشانی کامل رایانامه شما "
"باشد.</p><p>این نشانی، نشانی اصلی شماست که برای تمام نامه‌های خروجی استفاده "
"می‌شود. اگر بیش از یک نشانی دارید، یا یک هویت جدید ایجاد کنید، یا نشانی‌های "
"مستعار اضافی را در فیلد زیر بیفزایید.</p><p>اگر این فیلد را خالی بگذارید یا "
"اشتباه وارد کنید، افراد در پاسخ دادن به شما دچار مشکل خواهند شد.</p></qt>"

#: identity/identitydialog.cpp:429
#, kde-format
msgctxt "@label:textbox"
msgid "Email a&liases:"
msgstr "نام‌های مستعار رایانامه:"

#: identity/identitydialog.cpp:434
#, kde-format
msgid ""
"<qt><h3>Email aliases</h3><p>This field contains alias addresses that should"
" also be considered as belonging to this identity (as opposed to "
"representing a different identity).</p><p>Example:</p><table><tr><th>Primary"
" "
"address:</th><td>first.last@example.org</td></tr><tr><th>Aliases:</th><td>first@example.org<br>last@example.org</td></tr></table><p>Type"
" one alias address per line.</p></qt>"
msgstr ""
"<qt><h3>نام‌های مستعار رایانامه</h3><p>این فیلد شامل نشانی‌های مستعاری است "
"که باید متعلق به همین هویت در نظر گرفته شوند (برخلاف نشان دادن یک هویت "
"متفاوت).</p><p>مثال:</p><table><tr><th>نشانی "
"اصلی:</th><td>first.last@example.org</td></tr><tr><th>نام‌های "
"مستعار:</th><td>first@example.org<br>last@example.org</td></tr></table><p>در"
" هر سطر یک نشانی مستعار وارد کنید.</p></qt>"

#: identity/identitydialog.cpp:451
#, kde-format
msgid "Cryptography"
msgstr "رمزنگاری"

#: identity/identitydialog.cpp:457
#, kde-format
msgid ""
"<qt><p>The OpenPGP key you choose here will be used to digitally sign "
"messages. You can also use GnuPG keys.</p><p>You can leave this blank, but "
"KMail will not be able to digitally sign emails using OpenPGP; normal mail "
"functions will not be affected.</p><p>You can find out more about keys at "
"<a>https://www.gnupg.org</a></p></qt>"
msgstr ""
"<qt><p>کلید OpenPGP که اینجا انتخاب می‌کنید برای امضای دیجیتال پیام‌ها "
"استفاده خواهد شد. همچنین می‌توانید از کلیدهای GnuPG استفاده "
"کنید.</p><p>می‌توانید این قسمت را خالی بگذارید، اما کی‌میل (KMail) قادر به "
"امضای دیجیتال رایانامه‌ها با استفاده از OpenPGP نخواهد بود؛ کارکردهای عادی "
"رایانامه تحت تأثیر قرار نخواهند گرفت.</p><p>می‌توانید اطلاعات بیشتری درباره "
"کلیدها در <a>https://www.gnupg.org</a> بیابید.</p></qt>"

#: identity/identitydialog.cpp:463
#, kde-format
msgctxt "@label:textbox"
msgid "OpenPGP signing key:"
msgstr "کلید امضای OpenPGP:"

#: identity/identitydialog.cpp:469
#, kde-format
msgctxt "@option:check"
msgid "Use same key for encryption and signing"
msgstr "استفاده از همان کلید برای رمزگذاری و امضا"

#: identity/identitydialog.cpp:479
#, kde-format
msgid "OpenPGP key:"
msgstr "کلید OpenPGP:"

#: identity/identitydialog.cpp:486
#, kde-format
msgid "OpenPGP signing key:"
msgstr "کلید امضای OpenPGP:"

#: identity/identitydialog.cpp:503
#, kde-format
msgid ""
"<qt><p>The OpenPGP key you choose here will be used to encrypt messages to "
"yourself and for the \"Attach My Public Key\" feature in the composer. You "
"can also use GnuPG keys.</p><p>You can leave this blank, but KMail will not "
"be able to encrypt copies of outgoing messages to you using OpenPGP; normal "
"mail functions will not be affected.</p><p>You can find out more about keys "
"at <a>https://www.gnupg.org</a></p></qt>"
msgstr ""
"<qt><p>کلید OpenPGP که اینجا انتخاب می‌کنید برای رمزگذاری پیام‌ها برای "
"خودتان و برای ویژگی «پیوست کردن کلید عمومی من» در نگارش‌گر استفاده خواهد شد."
" همچنین می‌توانید از کلیدهای GnuPG استفاده کنید.</p><p>می‌توانید این قسمت را"
" خالی بگذارید، اما کی‌میل (KMail) قادر نخواهد بود رونوشت پیام‌های ارسالی به "
"خودتان را با استفاده از OpenPGP رمزگذاری کند؛ کارکردهای عادی رایانامه تحت "
"تأثیر قرار نخواهند گرفت.</p><p>می‌توانید اطلاعات بیشتری درباره کلیدها در "
"<a>https://www.gnupg.org</a> بیابید.</p></qt>"

#: identity/identitydialog.cpp:510
#, kde-format
msgctxt "@label:textbox"
msgid "OpenPGP encryption key:"
msgstr "کلید رمزگذاری OpenPGP:"

#: identity/identitydialog.cpp:520
#, kde-format
msgid ""
"<qt><p>The S/MIME (X.509) certificate you choose here will be used to "
"digitally sign messages.</p><p>You can leave this blank, but KMail will not "
"be able to digitally sign emails using S/MIME; normal mail functions will "
"not be affected.</p></qt>"
msgstr ""
"<qt><p>گواهی S/MIME‏ (X.509) که اینجا انتخاب می‌کنید برای امضای دیجیتال "
"پیام‌ها استفاده خواهد شد.</p><p>می‌توانید این قسمت را خالی بگذارید، اما "
"کی‌میل (KMail) قادر به امضای دیجیتال رایانامه‌ها با استفاده از S/MIME نخواهد"
" بود؛ کارکردهای عادی رایانامه تحت تأثیر قرار نخواهند گرفت.</p></qt>"

#: identity/identitydialog.cpp:525
#, kde-format
msgctxt "@label:textbox"
msgid "S/MIME signing certificate:"
msgstr "گواهی امضای S/MIME:"

#: identity/identitydialog.cpp:539
#, kde-format
msgid ""
"<qt><p>The S/MIME certificate you choose here will be used to encrypt "
"messages to yourself and for the \"Attach My Certificate\" feature in the "
"composer.</p><p>You can leave this blank, but KMail will not be able to "
"encrypt copies of outgoing messages to you using S/MIME; normal mail "
"functions will not be affected.</p></qt>"
msgstr ""
"<qt><p>گواهی S/MIME که اینجا انتخاب می‌کنید برای رمزگذاری پیام‌ها برای "
"خودتان و برای ویژگی «پیوست کردن گواهی من» در نگارش‌گر استفاده خواهد "
"شد.</p><p>می‌توانید این قسمت را خالی بگذارید، اما کی‌میل (KMail) قادر نخواهد"
" بود رونوشت پیام‌های ارسالی به خودتان را با استفاده از S/MIME رمزگذاری کند؛ "
"کارکردهای عادی رایانامه تحت تأثیر قرار نخواهند گرفت.</p></qt>"

