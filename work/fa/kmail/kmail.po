#: identity/identitydialog.cpp:606
#, kde-format
msgctxt "@title:tab Advanced identity settings."
msgid "Advanced"
msgstr "پیشرفته"

#: identity/identitydialog.cpp:614
#, kde-format
msgctxt "@label:textbox"
msgid "&Reply-To address:"
msgstr "نشانی پاسخ به:"

#: identity/identitydialog.cpp:618
#, kde-format
msgid ""
"<qt><h3>Reply-To addresses</h3><p>This sets the <tt>Reply-to:</tt> header to"
" contain a different email address to the normal <tt>From:</tt> "
"address.</p><p>This can be useful when you have a group of people working "
"together in similar roles. For example, you might want any emails sent to "
"have your email in the <tt>From:</tt> field, but any responses to go to a "
"group address.</p><p>If in doubt, leave this field blank.</p></qt>"
msgstr ""
"<qt><h3>نشانی‌های پاسخ به (Reply-To)</h3><p>این گزینه سرآیند <tt>Reply-"
"to:</tt> را طوری تنظیم می‌کند که نشانی رایانامه‌ای متفاوت از نشانی معمول "
"<tt>From:</tt> داشته باشد.</p><p>این ویژگی زمانی مفید است که گروهی از افراد "
"با نقش‌های مشابه با هم کار می‌کنند؛ برای مثال، شاید بخواهید تمام "
"رایانامه‌های ارسالی، نشانی شما را در فیلد <tt>From:</tt> داشته باشند، اما "
"پاسخ‌ها به یک نشانی گروهی فرستاده شوند.</p><p>اگر شک دارید، این فیلد را خالی"
" بگذارید.</p></qt>"

#: identity/identitydialog.cpp:636
#, kde-format
msgctxt "@label:textbox"
msgid "&CC addresses:"
msgstr "نشانی‌های رونوشت (CC):"

#: identity/identitydialog.cpp:642
#, kde-format
msgid ""
"<qt><h3>CC (Carbon Copy) addresses</h3><p>The addresses that you enter here "
"will be added to each outgoing mail that is sent with this "
"identity.</p><p>This is commonly used to send a copy of each sent message to"
" another account of yours.</p><p>To specify more than one address, use "
"commas to separate the list of CC recipients.</p><p>If in doubt, leave this "
"field blank.</p></qt>"
msgstr ""
"<qt><h3>نشانی‌های رونوشت (CC)</h3><p>نشانی‌هایی که اینجا وارد می‌کنید، به هر"
" نامهٔ خروجی که با این هویت ارسال شود افزوده خواهند شد.</p><p>این مورد "
"معمولاً برای ارسال یک نسخه از هر پیام ارسالی به حسابی دیگر از شما استفاده "
"می‌شود.</p><p>برای تعیین بیش از یک نشانی، از کاما برای جدا کردن فهرست "
"گیرندگان رونوشت استفاده کنید.</p><p>اگر شک دارید، این فیلد را خالی "
"بگذارید.</p></qt>"

#: identity/identitydialog.cpp:658
#, kde-format
msgctxt "@label:textbox"
msgid "&BCC addresses:"
msgstr "نشانی‌های رونوشت مخفی (BCC):"

#: identity/identitydialog.cpp:662
#, kde-format
msgid ""
"<qt><h3>BCC (Blind Carbon Copy) addresses</h3><p>The addresses that you "
"enter here will be added to each outgoing mail that is sent with this "
"identity. They will not be visible to other recipients.</p><p>This is "
"commonly used to send a copy of each sent message to another account of "
"yours.</p><p>To specify more than one address, use commas to separate the "
"list of BCC recipients.</p><p>If in doubt, leave this field blank.</p></qt>"
msgstr ""
"<qt><h3>نشانی‌های رونوشت مخفی (BCC)</h3><p>نشانی‌هایی که اینجا وارد می‌کنید،"
" به هر نامهٔ خروجی که با این هویت ارسال شود افزوده خواهند شد. این نشانی‌ها "
"برای سایر گیرندگان قابل مشاهده نخواهند بود.</p><p>این مورد معمولاً برای "
"ارسال یک نسخه از هر پیام ارسالی به حسابی دیگر از شما استفاده "
"می‌شود.</p><p>برای تعیین بیش از یک نشانی، از کاما برای جدا کردن فهرست "
"گیرندگان رونوشت مخفی استفاده کنید.</p><p>اگر شک دارید، این فیلد را خالی "
"بگذارید.</p></qt>"

