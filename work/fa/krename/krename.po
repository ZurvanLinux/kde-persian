#: batchrenamer.cpp:192 batchrenamer.cpp:662
#, kde-format
msgid "Input files will be renamed."
msgstr "نام پرونده‌های ورودی تغییر خواهد کرد."

#: batchrenamer.cpp:195 batchrenamer.cpp:656
#, kde-format
msgid "Files will be copied to: %1"
msgstr "پرونده‌ها در این نشانی رونوشت خواهند شد: %1"

#: batchrenamer.cpp:198 batchrenamer.cpp:658
#, kde-format
msgid "Files will be moved to: %1"
msgstr "پرونده‌ها به این نشانی منتقل خواهند شد: %1"

#: batchrenamer.cpp:201 batchrenamer.cpp:660
#, kde-format
msgid "Symbolic links will be created in: %1"
msgstr "پیوندهای نمادین در این نشانی ایجاد خواهند شد: %1"

#: batchrenamer.cpp:222
#, kde-format
msgid "Cannot rename: source and target filename are equal: %1"
msgstr "امکان تغییر نام وجود ندارد: نام پرونده مبدأ و مقصد یکسان است: %1"

#: batchrenamer.cpp:240
#, kde-format
msgid "Cannot create symlink to non-local URL: %1"
msgstr "امکان ایجاد پیوند نمادین به نشانی اینترنتی غیرمحلی وجود ندارد: %1"

#: batchrenamer.cpp:254 dirsortplugin.cpp:122
#, kde-format
msgid "Error renaming %2 (to %1)"
msgstr "خطا در تغییر نام %2 (به %1)"

#: batchrenamer.cpp:277 batchrenamer.cpp:401 batchrenamer.cpp:735
#, kde-format
msgid "%1 error occurred."
msgid_plural "%1 errors occurred."
msgstr[0] "%1 خطا رخ داد."
msgstr[1] "%1 خطا رخ داد."

#: batchrenamer.cpp:280 batchrenamer.cpp:739
#, kde-format
msgid "KRename finished the renaming process."
msgstr "کی‌رنیم فرایند تغییر نام را به پایان رساند."

#: batchrenamer.cpp:281 batchrenamer.cpp:405 batchrenamer.cpp:740
#, kde-format
msgid "Press close to quit."
msgstr "برای خروج، «بستن» را فشار دهید."

#: batchrenamer.cpp:345
#, kde-format
msgid "Filenames Processed after %1 seconds."
msgstr "نام پرونده‌ها پس از %1 ثانیه پردازش شد."

#: batchrenamer.cpp:360
#, kde-format
msgid "Undoing all renamed files."
msgstr "در حال لغو تغییر نام همهٔ پرونده‌ها."

#: batchrenamer.cpp:392
#, kde-format
msgid "Error during undoing %1"
msgstr "خطا هنگام واگرد %1"

#: batchrenamer.cpp:404
#, kde-format
msgid "KRename finished the undo process."
msgstr "‏KRename فرایند واگرد را به پایان رساند."

#: batchrenamer.cpp:643
#, kde-format
msgid "Cannot create undo script: %1"
msgstr "امکان ایجاد دست‌نوشتهٔ واگرد وجود ندارد: %1"

#: batchrenamer.cpp:717
#, kde-format
msgid "Undo is not possible for remote file: %1"
msgstr "واگرد برای پروندهٔ دوردست امکان‌پذیر نیست: %1"

#: batchrenamer.cpp:731
#, kde-format
msgid "Renamed %1 files successfully."
msgstr "تغییر نام %1 پرونده با موفقیت انجام شد."

#: batchrenamer.cpp:738
#, kde-format
msgid "Elapsed time: %1 seconds"
msgstr "زمان سپری‌شده: %1 ثانیه"

#: batchrenamer.cpp:750
#, kde-format
msgid "Cannot set executable bit on undo script."
msgstr "امکان تنظیم بیت قابل اجرا روی دست‌نوشتهٔ واگرد نیست."

#: batchrenamer.cpp:1170
#, kde-format
msgid "Cannot create directory %1: %2"
msgstr "امکان ایجاد شاخهٔ %1 وجود ندارد: %2"

