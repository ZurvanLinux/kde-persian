msgstr "افزودن کلیدواژه جستجوی وب جدید"

#. i18n: ectx: property (text), widget (QPushButton, pbNew)
#: webshortcuts/ikwsopts_ui.ui:99
#, kde-format
msgid "&New…"
msgstr "جدید…"

#. i18n: ectx: property (toolTip), widget (QPushButton, pbChange)
#: webshortcuts/ikwsopts_ui.ui:109
#, kde-format
msgid "Modify the highlighted Web search keyword"
msgstr "تغییر کلیدواژه برجسته‌شده جستجوی وب"

#. i18n: ectx: property (text), widget (QPushButton, pbChange)
#: webshortcuts/ikwsopts_ui.ui:112
#, kde-format
