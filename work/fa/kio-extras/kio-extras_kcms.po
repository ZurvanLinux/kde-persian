#: webshortcuts/searchproviderdlg_ui.ui:83
#, kde-format
msgid ""
"Select the character set that will be used to encode your search query."
msgstr ""
"مجموعه نویسه‌ای را که برای کدگذاری پرس‌وجوی جست‌وجوی شما استفاده می‌شود "
"انتخاب کنید."

#. i18n: ectx: property (toolTip), widget (QLineEdit, leShortcut)
#. i18n: ectx: property (whatsThis), widget (QLineEdit, leShortcut)
#. i18n: ectx: property (whatsThis), widget (QLabel, lbShortcut)
#: webshortcuts/searchproviderdlg_ui.ui:92
#: webshortcuts/searchproviderdlg_ui.ui:97
#: webshortcuts/searchproviderdlg_ui.ui:116
#, kde-format
msgid ""
"<qt>\n"
"The keywords entered here can be used as a pseudo-URI scheme in KDE. For example, the keyword <b>av</b> can be used as in <b>av</b>:<b>my search</b>\n"
"</qt>"
msgstr ""
"<qt>\n"
"کلیدواژه‌های واردشده در اینجا می‌توانند به‌عنوان یک طرح شبه‌URI در KDE استفاده شوند. برای مثال، کلیدواژهٔ <b>av</b> می‌تواند به‌صورت <b>av</b>:<b>جست‌وجوی من</b> استفاده شود\n"
"</qt>"

