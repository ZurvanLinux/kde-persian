#: thumbnail.cpp:291
#, kde-format
msgid "No MIME Type specified."
msgstr "هیچ نوع MIME مشخص نشده است."

#: thumbnail.cpp:298
#, kde-format
msgid "No or invalid size specified."
msgstr "اندازه مشخص نشده یا نامعتبر است."

#: thumbnail.cpp:323
#, kde-format
msgid "Cannot create thumbnail for directory"
msgstr "ایجاد تصویر بندانگشتی برای پوشه امکان‌پذیر نیست"

#: thumbnail.cpp:332
#, kde-format
msgid "No plugin specified."
msgstr "هیچ افزونه‌ای مشخص نشده است."

#: thumbnail.cpp:337
#, kde-format
msgid "Cannot load ThumbCreator %1"
msgstr "بارگذاری ThumbCreator %1 امکان‌پذیر نیست"

#: thumbnail.cpp:345
#, kde-format
msgid "Cannot create thumbnail for %1"
msgstr "ایجاد تصویر بندانگشتی برای %1 امکان‌پذیر نیست"

#: thumbnail.cpp:355
#, kde-format
msgid "Failed to create a thumbnail."
msgstr "ایجاد تصویر بندانگشتی ناموفق بود."

#: thumbnail.cpp:375
#, kde-format
msgid "Could not write image."
msgstr "نوشتن تصویر امکان‌پذیر نبود."

#: thumbnail.cpp:403
#, kde-format
msgid "Failed to attach to shared memory segment %1"
msgstr "پیوستن به قطعه حافظه اشتراکی %1 ناموفق بود"

#: thumbnail.cpp:407
#, kde-format
msgid "Image is too big for the shared memory segment"
msgstr "تصویر برای قطعه حافظه اشتراکی بیش از حد بزرگ است"
