#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "محمد شفیعی سروستانی"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "muhammad.shafiee@gmail.com"

#: kfmclient.cpp:57
#, kde-format
msgid "kfmclient"
msgstr "kfmclient"

#: kfmclient.cpp:58
#, kde-format
msgid "KDE tool for opening URLs from the command line"
msgstr "ابزار KDE برای باز کردن نشانی‌های وب از خط فرمان"

#: kfmclient.cpp:66
#, kde-format
msgid "Non interactive use: no message boxes"
msgstr "استفادهٔ غیرتعاملی: بدون جعبه‌های پیام"

#: kfmclient.cpp:68
#, kde-format
msgid "Show available commands"
msgstr "نمایش دستورهای موجود"

#: kfmclient.cpp:77
#, kde-format
msgid ""
"The mimetype of the URL. Allows Konqueror to determine in advance which "
"component to use, making it start faster."
msgstr ""
"نوع MIME مربوط به نشانی اینترنتی. به کنکرور اجازه می‌دهد از قبل مؤلفهٔ مورد "
"استفاده را تعیین کرده و سریع‌تر شروع به کار کند."

#: kfmclient.cpp:78
#, kde-format
msgctxt "the name for a the value of an option on the command line help"
msgid "type"
msgstr "نوع"

#: kfmclient.cpp:80
#, kde-format
msgid "Command (see --commands)"
msgstr "دستور (نگاه کنید به ‎--commands)"

#: kfmclient.cpp:82
#, kde-format
msgid "Arguments for command"
msgstr "آرگومان‌های دستور"

#: kfmclient.cpp:84
#, kde-format
msgid "The files/URLs opened by the application will be deleted after use"
msgstr ""
"پرونده‌ها/نشانی‌های وب باز شده توسط برنامه پس از استفاده حذف خواهند شد"

#: kfmclient.cpp:93
#, kde-format
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"نحو:\n"

#: kfmclient.cpp:94
#, kde-format
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, the start page is shown.\n"
"\n"
msgstr ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # پنجره‌ای را باز می‌کند که 'url' را نشان می‌دهد.\n"
"            #  'url' می‌تواند یک مسیر نسبی\n"
"            #   یا نام پرونده باشد، مانند . یا subdir/\n"
"            #   اگر 'url' حذف شود، صفحهٔ شروع نشان داده می‌شود.\n"
"\n"

#: kfmclient.cpp:99
#, kde-format
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it to\n"
"            #   text/html for a web page, to make it appear faster\n"
"            # Note: this way of specifying mimetype is deprecated.\n"
"            #   Please use the --mimetype option\n"
"\n"
msgstr ""
"            # اگر 'mimetype' مشخص شده باشد، برای تعیین مؤلفه‌ای که\n"
"            #   Konqueror باید استفاده کند، به کار می‌رود. برای نمونه، برای یک صفحهٔ وب آن را روی\n"
"            #   text/html تنظیم کنید تا سریع‌تر نشان داده شود\n"
"            # نکته: این روش تعیین mimetype منسوخ شده است.\n"
"            #   لطفاً از گزینهٔ ‎--mimetype استفاده کنید\n"
"\n"

#: kfmclient.cpp:104
#, kde-format
msgid ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Same as above but opens a new tab with 'url' in an existing Konqueror\n"
"            #   window on the current active desktop if possible.\n"
"\n"
msgstr ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # همانند بالا، ولی در صورت امکان، برگهٔ جدیدی با 'url' در یکی از پنجره‌های موجود Konqueror\n"
"            #   در میزکار فعال کنونی باز می‌کند.\n"
"\n"

#: kfmclient.cpp:280
#, kde-format
msgid "Syntax error, not enough arguments\n"
msgstr "خطای نحو، آرگومان‌ها کافی نیستند\n"

#: kfmclient.cpp:284
#, kde-format
msgid "Syntax error, too many arguments\n"
msgstr "خطای نحو، آرگومان‌های بیش از حد\n"

#: kfmclient.cpp:339
#, kde-format
msgid "Syntax error, unknown command '%1'\n"
msgstr "خطای نحو، دستور ناشناختهٔ «%1»\n"
