#. i18n: ectx: property (title), widget (QGroupBox, GroupBox3_2)
#: appearance.cpp:48 css/csscustom.ui:296
#, kde-format
msgid "Images"
msgstr "تصاویر"

#: appearance.cpp:52
#, kde-format
msgid "A&utomatically load images"
msgstr "بارگیری خودکار تصاویر"

#: appearance.cpp:53
#, kde-format
msgid ""
"<html>If this box is checked, Konqueror will automatically load any images "
"that are embedded in a web page. Otherwise, it will display placeholders for"
" the images, and you can then manually load the images by clicking on the "
"image button.<br />Unless you have a very slow network connection, you will "
"probably want to check this box to enhance your browsing experience.</html>"
msgstr ""
"<html>اگر این گزینه علامت زده شود، کنکرور به‌طور خودکار هر تصویری را که درون"
" صفحهٔ وب جاسازی شده بارگیری می‌کند. در غیر این صورت، جای‌نگهدارنده‌هایی "
"برای تصاویر نمایش می‌دهد و سپس می‌توانید با کلیک روی دکمهٔ تصویر، آن‌ها را "
"به‌صورت دستی بارگیری کنید.<br />به احتمال زیاد مایلید این گزینه را برای "
"بهبود تجربهٔ مرور خود فعال کنید، مگر اینکه اتصالی بسیار کند داشته "
"باشید.</html>"

#: appearance.cpp:63
#, kde-format
msgid "Dra&w frame around not completely loaded images"
msgstr "رسم کادر دور تصاویری که کامل بارگیری نشده‌اند"

#: appearance.cpp:64
#, kde-format
msgid ""
"<html>If this box is checked, Konqueror will draw a frame as a placeholder "
"around images embedded in a web page that are not yet fully loaded.<br />You"
" will probably want to check this box to enhance your browsing experience, "
"especially if have a slow network connection.</html>"
msgstr ""
"<html>اگر این گزینه علامت زده شود، کنکرور کادری را به عنوان جای‌نگهدارنده "
"دور تصاویری که در صفحهٔ وب تعبیه شده‌اند و هنوز کامل بارگیری نشده‌اند، رسم "
"می‌کند.<br />به احتمال زیاد مایلید این گزینه را برای بهبود تجربهٔ مرور خود "
"فعال کنید، به‌ویژه اگر اتصالی کند دارید.</html>"

#: appearance.cpp:74
#, kde-format
msgctxt "animations"
msgid "Enabled"
msgstr "فعال"

#: appearance.cpp:75
#, kde-format
msgctxt "animations"
msgid "Disabled"
msgstr "غیرفعال"

#: appearance.cpp:76
#, kde-format
msgid "Show Only Once"
msgstr "نمایش فقط یک‌بار"

#: appearance.cpp:77
#, kde-format
msgid ""
"<html>Controls how Konqueror shows animated images:<br "
"/><ul><li><b>Enabled</b>: Show all animations "
"completely.</li><li><b>Disabled</b>: Never show animations, show the "
"starting image only.</li><li><b>Show only once</b>: Show all animations "
"completely but do not repeat them.</li></ul></html>"
msgstr ""
"<html>چگونگی نمایش تصاویر متحرک توسط کانکرور را کنترل می‌کند:<br "
"/><ul><li><b>فعال</b>: نمایش کامل همهٔ پویانمایی‌ها.</li><li><b>غیرفعال</b>:"
" پویانمایی‌ها هرگز نمایش داده نشوند، فقط تصویر آغازین نمایش داده "
"شود.</li><li><b>نمایش فقط یک‌بار</b>: نمایش کامل همهٔ پویانمایی‌ها، اما "
"تکرار نشوند.</li></ul></html>"

#: appearance.cpp:82
#, kde-format
msgid "A&nimations:"
msgstr "پویانمایی‌ها:"

#: appearance.cpp:85 htmlopts.cpp:108
#, kde-format
msgctxt "@title:group"
msgid "Miscellaneous"
msgstr "متفرقه"

#: appearance.cpp:90
#, kde-format
msgctxt "underline"
msgid "Enabled"
msgstr "فعال"

#: appearance.cpp:91
#, kde-format
msgctxt "underline"
msgid "Disabled"
msgstr "غیرفعال"

#: appearance.cpp:92
#, kde-format
msgid "Only on Hover"
msgstr "فقط هنگام قرارگیری موشی"

#: appearance.cpp:93
#, kde-format
msgid "Und&erline links:"
msgstr "خط کشیدن زیر پیوندها:"

#: appearance.cpp:96
#, kde-format
msgid ""
"<html>Controls how Konqueror handles underlining hyperlinks:<br "
"/><ul><li><b>Enabled</b>: Always underline links</li><li><b>Disabled</b>: "
"Never underline links</li><li><b>Only on Hover</b>: Underline when the mouse"
" is moved over the link</li></ul><br /><i>Note: The site's CSS definitions "
"can override this value.</i></html>"
msgstr ""
"<html>چگونگی مدیریت خط زیر ابرپیوندها توسط کانکرور را کنترل می‌کند:<br "
"/><ul><li><b>فعال</b>: همیشه زیر پیوندها خط کشیده "
"شود</li><li><b>غیرفعال</b>: هرگز زیر پیوندها خط کشیده نشود</li><li><b>فقط "
"هنگام قرارگیری موشی</b>: هنگامی که موشی روی پیوند قرار می‌گیرد زیر آن خط "
"کشیده شود</li></ul><br /><i>نکته: تعاریف CSS وبگاه می‌توانند این مقدار را "
"بازنویسی کنند.</i></html>"

#: appearance.cpp:105
#, kde-format
msgid "When Efficient"
msgstr "هنگام کارایی"

#: appearance.cpp:106
#, kde-format
msgctxt "smooth scrolling"
msgid "Always"
msgstr "همیشه"

#: appearance.cpp:107
#, kde-format
msgctxt "soft scrolling"
msgid "Never"
msgstr "هرگز"

#: appearance.cpp:108
#, kde-format
msgid "S&mooth scrolling:"
msgstr "پیمایش روان:"

#: appearance.cpp:110
#, kde-format
msgid ""
"<html>Determines whether Konqueror should use smooth steps to scroll HTML "
"pages, or whole steps:<br /><ul><li><b>Always</b>: Always use smooth steps "
"when scrolling.</li><li><b>Never</b>: Never use smooth scrolling, scroll "
"with whole steps instead.</li><li><b>When Efficient</b>: Only use smooth "
"scrolling on pages where it can be achieved with moderate usage of system "
"resources.</li></ul></html>"
msgstr ""
"<html>تعیین می‌کند که آیا کانکرور باید برای پیمایش صفحات HTML از گام‌های "
"روان استفاده کند یا گام‌های کامل:<br /><ul><li><b>همیشه</b>: همیشه هنگام "
"پیمایش از گام‌های روان استفاده شود.</li><li><b>هرگز</b>: هرگز از پیمایش روان"
" استفاده نشود، در عوض با گام‌های کامل پیمایش شود.</li><li><b>در صورت کارآمد "
"بودن</b>: فقط در صفحاتی از پیمایش روان استفاده شود که با مصرف متوسط منابع "
"سامانه امکان‌پذیر باشد.</li></ul></html>"

#: appearance.cpp:128
#, kde-format
msgid "Font Si&ze"
msgstr "اندازهٔ قلم"

#: appearance.cpp:131 appearance.cpp:149
#, kde-format
msgid "This is the relative font size Konqueror uses to display web sites."
msgstr ""
"این اندازهٔ نسبی قلمی است که کانکرور برای نمایش وب‌گاه‌ها استفاده می‌کند."

#: appearance.cpp:135
#, kde-format
msgid "M&inimum font size:"
msgstr "حداقل اندازهٔ قلم:"

#: appearance.cpp:139
#, kde-format
msgid ""
"Konqueror will never display text smaller than this size,<br />overriding "
"any other settings."
msgstr ""
"کانکرور هرگز متن را کوچک‌تر از این اندازه نمایش نخواهد داد،<br />و سایر "
"تنظیمات را نادیده می‌گیرد."

#: appearance.cpp:144
#, kde-format
msgid "&Medium font size:"
msgstr "اندازهٔ قلم متوسط:"

#: appearance.cpp:157
#, kde-format
msgid "S&tandard font:"
msgstr "قلم استاندارد:"

#: appearance.cpp:158
#, kde-format
msgid "This is the font used to display normal text in a web page."
msgstr "این قلمی است که برای نمایش متن عادی در یک صفحهٔ وب استفاده می‌شود."

#: appearance.cpp:162
#, kde-format
msgid "&Fixed font:"
msgstr "قلم با عرض ثابت:"

#: appearance.cpp:163
#, kde-format
msgid ""
"This is the font used to display fixed-width (i.e. non-proportional) text."
msgstr ""
"این قلمی است که برای نمایش متن با عرض ثابت (یعنی غیرمتناسب) استفاده می‌شود."

#: appearance.cpp:167
#, kde-format
msgid "S&erif font:"
msgstr "قلم سریف:"

#: appearance.cpp:168
#, kde-format
msgid "This is the font used to display text that is marked up as serif."
msgstr ""
"این قلمی است که برای نمایش متنی که به عنوان سریف نشانه‌گذاری شده استفاده "
"می‌شود."

#: appearance.cpp:172
#, kde-format
msgid "Sa&ns serif font:"
msgstr "قلم بدون سریف:"

#: appearance.cpp:173
#, kde-format
msgid "This is the font used to display text that is marked up as sans-serif."
msgstr ""
"این قلمی است که برای نمایش متنی که به عنوان بدون سریف نشانه‌گذاری شده "
"استفاده می‌شود."

#: appearance.cpp:177
#, kde-format
msgid "C&ursive font:"
msgstr "قلم شکسته (Cursive):"

#: appearance.cpp:178
#, kde-format
msgid "This is the font used to display text that is marked up as italic."
msgstr ""
"این قلمی است که برای نمایش متنی که به عنوان کج (italic) نشانه‌گذاری شده "
"استفاده می‌شود."

#: appearance.cpp:182
#, kde-format
msgid "Fantas&y font:"
msgstr "قلم فانتزی:"

#: appearance.cpp:183
#, kde-format
msgid ""
"This is the font used to display text that is marked up as a fantasy font."
msgstr ""
"این قلم برای نمایش متنی استفاده می‌شود که به عنوان قلم فانتزی علامت‌گذاری "
