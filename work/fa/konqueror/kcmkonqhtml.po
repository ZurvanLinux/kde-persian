#. i18n: ectx: property (whatsThis), widget (QWidget, CSSConfigWidget)
#. i18n: ectx: property (whatsThis), widget (QWidget, CSSCustomDialog)
#: css/cssconfig.ui:14 css/csscustom.ui:13
#, kde-format
msgid ""
"<b>Stylesheets</b><p>See http://www.w3.org/Style/CSS for further information"
" on cascading style sheets.</p>"
msgstr ""
"<b>شیوه‌نامه‌ها</b><p>برای اطلاعات بیشتر دربارهٔ شیوه‌نامه‌های آبشاری، "
"http://www.w3.org/Style/CSS را ببینید.</p>"

#. i18n: ectx: property (whatsThis), widget (QGroupBox, ButtonGroup1)
#: css/cssconfig.ui:26
#, kde-format
msgid ""
"<b>Stylesheets</b><p>Use this groupbox to determine how Konqueror will "
"render style sheets.</p>"
msgstr ""
"<b>شیوه‌نامه‌ها</b><p>از این جعبه‌گروه برای تعیین چگونگی رندر شیوه‌نامه‌ها "
"توسط کانکرر استفاده کنید.</p>"

#. i18n: ectx: property (title), widget (QGroupBox, ButtonGroup1)
#: css/cssconfig.ui:29
#, kde-format
msgid "Stylesheets"
msgstr "شیوه‌نامه‌ها"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, useDefault)
#: css/cssconfig.ui:35
#, kde-format
msgid ""
"<b>Use default stylesheet</b><p>Select this option to use the default "
"stylesheet.</p>"
msgstr ""
"<b>استفاده از شیوه‌نامهٔ پیش‌فرض</b><p>این گزینه را برای استفاده از "
"شیوه‌نامهٔ پیش‌فرض انتخاب کنید.</p>"

#. i18n: ectx: property (text), widget (QRadioButton, useDefault)
#: css/cssconfig.ui:38
#, kde-format
msgid "Us&e default stylesheet"
msgstr "استفاده از شیوه‌نامهٔ پیش‌فرض"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, useUser)
#: css/cssconfig.ui:48
#, kde-format
msgid ""
"<b>Use user-defined stylesheet</b><p>If this box is checked, Konqueror will "
"try to load a user-defined style sheet as specified in the location below. "
"The style sheet allows you to completely override the way web pages are "
"rendered in your browser. The file specified should contain a valid style "
"sheet (see http://www.w3.org/Style/CSS for further information on cascading "
"style sheets).</p>"
msgstr ""
"<b>استفاده از شیوه‌نامهٔ تعریف‌شده توسط کاربر</b><p>اگر این جعبه علامت زده "
"شود، کانکرر تلاش خواهد کرد شیوه‌نامهٔ تعریف‌شده توسط کاربر را همان‌طور که در"
" مکان زیر مشخص شده است بارگذاری کند. این شیوه‌نامه به شما امکان می‌دهد نحوهٔ"
" رندر صفحات وب را در مرورگرتان کاملاً بازتعریف کنید. پروندهٔ مشخص‌شده باید "
"حاوی یک شیوه‌نامهٔ معتبر باشد (برای اطلاعات بیشتر دربارهٔ شیوه‌نامه‌های "
"آبشاری، http://www.w3.org/Style/CSS را ببینید).</p>"

#. i18n: ectx: property (text), widget (QRadioButton, useUser)
#: css/cssconfig.ui:51
#, kde-format
msgid "Use &user-defined stylesheet"
msgstr "استفاده از شیوه‌نامهٔ تعریف‌شده توسط کاربر"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, useAccess)
#: css/cssconfig.ui:103
#, kde-format
msgid ""
"<b>Use accessibility stylesheet</b><p>Selecting this option will allow you "
"to define a default font, font size, and font color with a few simple clicks"
" of the mouse. Simply wander over to the Customize... dialog and pick out "
"your desired options.</p>"
msgstr ""
"<b>استفاده از شیوه‌نامهٔ دسترسی‌پذیری</b><p>انتخاب این گزینه به شما امکان "
"می‌دهد با چند کلیک سادهٔ ماوس، قلم، اندازهٔ قلم و رنگ قلم پیش‌فرض را تعیین "
"کنید. کافی است به گفت‌وگوی سفارشی‌سازی... بروید و گزینه‌های دلخواه خود را "
"انتخاب کنید.</p>"

#. i18n: ectx: property (text), widget (QRadioButton, useAccess)
#: css/cssconfig.ui:106
#, kde-format
msgid "U&se accessibility stylesheet"
msgstr "استفاده از شیوه‌نامهٔ دسترسی‌پذیری"

#. i18n: ectx: property (text), widget (QPushButton, customize)
#: css/cssconfig.ui:146
#, kde-format
msgid "Custom&ize..."
msgstr "سفارشی‌سازی..."

#. i18n: ectx: property (title), widget (QGroupBox, customPageBackgroundBox)
#: css/cssconfig.ui:177
#, kde-format
msgid "Custom Page Background"
msgstr "پس‌زمینهٔ سفارشی صفحه"

#. i18n: ectx: property (toolTip), widget (QCheckBox,
#. useCustomBackgroundColor)
#: css/cssconfig.ui:183
#, kde-format
msgid ""
"<html><head/><body><p align=\"justify\">Use a custom background color for "
"web pages. This color is used:</p><ul style=\"margin-top: 0px; margin-"
"bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\"><li "
"align=\"justify\" style=\" margin-top:0px; margin-bottom:0px; margin-"
"left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">when the "
"background color isn't explicitly set by the page or by a custom "
"stylesheet</li><li align=\"justify\" style=\" margin-top:0px; margin-"
"bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-"
"indent:0px;\">before a web page is loaded</li></ul><p "
"align=\"justify\">Setting a custom background color is mostly useful if you "
"use a custom stylesheet which sets a background color for the page "
"(especially a dark color), to avoid a white flash before the page is "
"loaded</p></body></html>"
msgstr ""
"<html><head/><body><p align=\"justify\">استفاده از رنگ پس‌زمینهٔ سفارشی برای"
" صفحه‌های وب. این رنگ در موارد زیر استفاده می‌شود:</p><ul style=\"margin-"
"top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-"
"indent: 1;\"><li align=\"justify\" style=\" margin-top:0px; margin-"
"bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-"
"indent:0px;\">وقتی رنگ پس‌زمینه صراحتاً توسط صفحه یا شیوه‌نامهٔ سفارشی تنظیم"
" نشده باشد</li><li align=\"justify\" style=\" margin-top:0px; margin-"
"bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-"
"indent:0px;\">پیش از بارگیری کامل صفحهٔ وب</li></ul><p "
"align=\"justify\">تنظیم رنگ پس‌زمینهٔ سفارشی بیشتر زمانی کاربرد دارد که از "
"شیوه‌نامهٔ سفارشی تعیین‌کنندهٔ رنگ پس‌زمینه (به‌ویژه رنگ تیره) استفاده "
"می‌کنید تا از پرش رنگ سفید پیش از بارگیری صفحه جلوگیری شود</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, useCustomBackgroundColor)
#: css/cssconfig.ui:186
#, kde-format
msgid "Use custom &background color"
msgstr "استفاده از رنگ پس‌زمینهٔ سفارشی"

#. i18n: ectx: property (toolTip), widget (KColorButton,
#. customBackgroundColor)
#: css/cssconfig.ui:196
#, kde-format
msgid ""
"<html><head/><body><p>The custom background color to use for web "
"pages</p></body></html>"
msgstr ""
"<html><head/><body><p>رنگ پس‌زمینهٔ سفارشی برای استفاده در صفحه‌های "
"وب</p></body></html>"

#. i18n: ectx: property (toolTip), widget (QCheckBox,
#. addCustomBackgroundToStyleSheet)
#: css/cssconfig.ui:206
#, kde-format
msgid ""
"<html><head/><body><p align=\"justify\">Add to your custom stylesheet "
"(including the accessibility stylesheet) a rule to set all background colors"
" to the custom color you chose above. This avoids the need of setting the "
"background color both in the stylesheet and in the configuration "
"dialog.</p><p align=\"justify\"><span style=\" font-"
"weight:600;\">Notes:</span></p><ul style=\"margin-top: 0px; margin-bottom: "
"0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\"><li "
"align=\"justify\" style=\" margin-top:12px; margin-bottom:0px; margin-"
"left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">the rule "
"will be overridden by other rules for background colors in your custom "
"stylesheet following the usual CSS rules</li><li align=\"justify\" style=\" "
"margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-"
"block-indent:0; text-indent:0px;\">the rule isn't actually added to the file"
" containing your custom stylesheet; it's only inserted in the copy Konqueror"
" keeps in memory. This means that if you use the stylesheet in other "
"browsers, you'll need to manually add the rule to "
"it.</li></ul></body></html>"
msgstr ""
"<html><head/><body><p align=\"justify\">قاعده‌ای به شیوه‌نامهٔ سفارشی خود "
"(از جمله شیوه‌نامهٔ دسترسی‌پذیری) اضافه کنید تا همهٔ رنگ‌های پس‌زمینه را به "
"رنگ سفارشی بالا تغییر دهد. این کار از نیاز به تنظیم رنگ پس‌زمینه در هر دو "
"بخشِ شیوه‌نامه و پنجرهٔ پیکربندی جلوگیری می‌کند.</p><p "
"align=\"justify\"><span style=\" font-weight:600;\">نکات:</span></p><ul "
"style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right:"
" 0px; -qt-list-indent: 1;\"><li align=\"justify\" style=\" margin-top:12px; "
"margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; "
"text-indent:0px;\">این قاعده با پیروی از قواعد معمول CSS، توسط سایر قواعد "
"رنگ پس‌زمینه در شیوه‌نامهٔ سفارشی‌تان لغو خواهد شد</li><li align=\"justify\""
" style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">این قاعده در اصل به "
"پروندهٔ شیوه‌نامه اضافه نمی‌شود؛ بلکه فقط در رونوشتی که کانکرور در حافظه نگه"
" می‌دارد اعمال می‌گردد. یعنی اگر از این شیوه‌نامه در مرورگرهای دیگر استفاده "
"می‌کنید، باید این قاعده را به‌صورت دستی به آن "
"بیفزایید.</li></ul></body></html>"

