#: modellist.cpp:49
#, kde-format
msgctxt "@action"
msgid "&Apply Difference"
msgstr "اِعمال تفاوت"

#: modellist.cpp:53
#, kde-format
msgctxt "@action"
msgid "Un&apply Difference"
msgstr "لغو اِعمال تفاوت"

#: modellist.cpp:57
#, kde-format
msgctxt "@action"
msgid "App&ly All"
msgstr "اِعمال همه"

#: modellist.cpp:61
#, kde-format
msgctxt "@action"
msgid "&Unapply All"
msgstr "لغو اِعمال همه"

#: modellist.cpp:71
#, kde-format
msgctxt "@action"
msgid "P&revious File"
msgstr "پروندهٔ قبلی"

#: modellist.cpp:75
#, kde-format
msgctxt "@action"
msgid "N&ext File"
msgstr "پروندهٔ بعدی"

#: modellist.cpp:79
#, kde-format
msgctxt "@action"
msgid "&Previous Difference"
msgstr "تفاوت قبلی"

#: modellist.cpp:83
#, kde-format
msgctxt "@action"
msgid "&Next Difference"
msgstr "تفاوت بعدی"

#: modellist.cpp:183 modellist.cpp:209
#, kde-format
msgid ""
"<qt>No models or no differences, this file: <b>%1</b>, is not a valid diff "
"file.</qt>"
msgstr ""
"<qt>بدون مدل یا بدون تفاوت؛ این پرونده: <b>%1</b>، یک پروندهٔ diff معتبر "
"نیست.</qt>"

#: modellist.cpp:192
#, kde-format
msgid ""
"<qt>There were problems applying the diff <b>%1</b> to the file "
"<b>%2</b>.</qt>"
msgstr ""
"<qt>هنگام اعمال diff <b>%1</b> روی پروندهٔ <b>%2</b> مشکلاتی وجود داشت.</qt>"

#: modellist.cpp:220
#, kde-format
msgid ""
"<qt>There were problems applying the diff <b>%1</b> to the folder "
"<b>%2</b>.</qt>"
msgstr ""
"<qt>هنگام اعمال تفاضل (diff) <b>%1</b> به پوشهٔ <b>%2</b> مشکلاتی رخ "
"داد.</qt>"

#: modellist.cpp:256 modellist.cpp:520
#, kde-format
msgid "Could not open a temporary file."
msgstr "باز کردن پروندهٔ موقت ممکن نشد."

#: modellist.cpp:289 modellist.cpp:296
#, kde-format
msgid "<qt>Could not write to the temporary file <b>%1</b>, deleting it.</qt>"
msgstr "<qt>نوشتن در پروندهٔ موقت <b>%1</b> ممکن نشد؛ در حال حذف آن.</qt>"

#: modellist.cpp:324
#, kde-format
msgid ""
"<qt>Could not create destination directory <b>%1</b>.\n"
"The file has not been saved.</qt>"
msgstr ""
"<qt>ایجاد شاخهٔ مقصد <b>%1</b> ممکن نشد.\n"
"پرونده ذخیره نشده است.</qt>"

#: modellist.cpp:350
#, kde-format
msgid ""
"<qt>Could not upload the temporary file to the destination location "
"<b>%1</b>. The temporary file is still available under: <b>%2</b>. You can "
"manually copy it to the right place.</qt>"
msgstr ""
"<qt>بارگذاری پروندهٔ موقت در مکان مقصد <b>%1</b> ممکن نشد. پروندهٔ موقت "
"همچنان در این مسیر در دسترس است: <b>%2</b>. می‌توانید آن را به صورت دستی در "
"مکان مناسب رونوشت کنید.</qt>"

#: modellist.cpp:429 modellist.cpp:465 modellist.cpp:486
#, kde-format
msgid "Could not parse diff output."
msgstr "تجزیهٔ خروجی diff ممکن نشد."

#: modellist.cpp:440
#, kde-format
msgid "The files are identical."
msgstr "پرونده‌ها یکسان هستند."

#: modellist.cpp:550
#, kde-format
msgid "Could not write to the temporary file."
msgstr "نوشتن در پروندهٔ موقت ممکن نشد."

#: modellist.cpp:820
#, kde-format
msgid ""
"The diff is malformed. Some lines could not be parsed and will not be "
"displayed in the diff view."
msgstr ""
"ساختار diff نامعتبر است. تجزیهٔ برخی از خطوط ممکن نشد و در نمای تفاضل نمایش "
"داده نخواهند شد."
