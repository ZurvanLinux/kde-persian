msgstr "♥︎ نمایش گزینه‌های حامیان"

msgctxt "donation_dialog_supporter_text"
msgid ""
"Thank you for supporting Krita! Your contribution helps to keep its "
"continued development going."
msgstr ""
"از حمایت شما از کریتا سپاسگزاریم! مشارکت شما به ادامهٔ روند توسعهٔ آن کمک "
"می‌کند."

msgctxt "product_donations_description"
msgid ""
"&lt;h2&gt;Donations&lt;/h2&gt;&lt;p&gt;Help Krita's continued development "
"with a direct donation through PayPal, via credit or debit card and many "
"other payment methods.&lt;/p&gt;"
msgstr ""
"&lt;h2&gt;کمک‌های مالی&lt;/h2&gt;&lt;p&gt;با اهدای مستقیم کمک مالی از طریق "
"پی‌پال، کارت‌های اعتباری یا نقدی و بسیاری از روش‌های پرداخت دیگر، به ادامهٔ "
"توسعهٔ کریتا کمک کنید.&lt;/p&gt;"

msgctxt "product_donations_button"
msgid "Donate"
msgstr "کمک مالی"

msgctxt "product_development_fund_description"
msgid ""
"&lt;h2&gt;Development Fund&lt;/h2&gt;&lt;p&gt;Join Krita's development fund "
"and help its continued development with a monthly contribution. Different "
"tiers with benefits are available.&lt;/p&gt;"
msgstr ""
"&lt;h2&gt;صندوق توسعه&lt;/h2&gt;&lt;p&gt;به صندوق توسعهٔ کریتا بپیوندید و با"
" مشارکت ماهانه به ادامهٔ توسعهٔ آن کمک کنید. سطوح مختلفی با مزایای گوناگون "
"در دسترس است.&lt;/p&gt;"

msgctxt "product_development_fund_button"
msgid "Join the Fund"
msgstr "پیوستن به صندوق"

msgctxt "product_button_subscribe"
msgid "Subscribe"
msgstr "اشتراک"

#, c-format
msgctxt "product_button_subscribe_for_month"
msgid "Subscribe for %s/month"
msgstr "اشتراک به ازای %s/ماه"

msgctxt "product_button_buy"
msgid "Buy"
msgstr "خرید"

#, c-format
msgctxt "product_button_buy_for"
msgid "Buy for %s"
msgstr "خرید به قیمت %s"

msgctxt "product_supporter_badge_title"
msgid "Supporter Badge"
msgstr "نشان حامی"

msgctxt "product_supporter_badge_description"
msgid "&lt;p&gt;A badge for early supporters of Krita on Android.&lt;/p&gt;"
msgstr "&lt;p&gt;نشانی برای حامیان اولیهٔ کریتا در اندروید.&lt;/p&gt;"

msgctxt "product_subscription_title"
msgid "Supporter Subscription"
msgstr "اشتراک حامی"

#, c-format
msgctxt "product_subscription_description"
msgid ""
"&lt;p&gt;Support Krita's development with a monthly contribution. While "
"subscribed, you get access to &lt;strong&gt;all&lt;/strong&gt; supporter "
"benefits as they are released. You currently receive %1$d resource bundles "
"together containing over %2$d brushes, including the paid Digital Atelier "
"bundle, with more planned in the future.&lt;/p&gt;"
msgstr ""
"&lt;p&gt;با مشارکت ماهانه از توسعهٔ کریتا پشتیبانی کنید. تا زمانی که اشتراک "
"دارید، به &lt;strong&gt;تمام&lt;/strong&gt; مزایای حامیان به محض انتشار "
"دسترسی خواهید داشت. هم‌اکنون %1$d بستهٔ منابع را که در مجموع شامل بیش از "
"%2$d قلم‌مو است، از جمله بستهٔ پولی Digital Atelier دریافت می‌کنید؛ بسته‌های"
" بیشتری نیز برای آینده برنامه‌ریزی شده است.&lt;/p&gt;"

msgctxt "product_onetime_title"
msgid "Krita 5.3 Supporter Pack"
msgstr "بستهٔ حامی کریتا ۵٫۳"

#, c-format
msgctxt "product_onetime_description"
msgid ""
"&lt;p&gt;In this pack you will receive %1$d resource bundles together "
"containing over %2$d brushes, including the paid Digital Atelier bundle. "
"This is a &lt;strong&gt;one-time purchase&lt;/strong&gt;, you won't be "
"entered into a subscription.&lt;/p&gt;"
msgstr ""
"&lt;p&gt;در این بسته %1$d بستهٔ منابع را دریافت خواهید کرد که در مجموع شامل "
"بیش از %2$d قلم‌مو است، از جمله بستهٔ پولی Digital Atelier. این یک "
"&lt;strong&gt;خرید یک‌باره&lt;/strong&gt; است و مشمول اشتراک نخواهید "
"شد.&lt;/p&gt;"

msgctxt "show_this_dialog_when_krita_starts"
msgid "Show this dialog when Krita starts"
msgstr "نمایش این کادر محاوره‌ای هنگام شروع کریتا"

