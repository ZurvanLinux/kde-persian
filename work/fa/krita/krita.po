msgstr "بارگذاری فریم‌های کلیدی از %1 امکان‌پذیر نبود."

#: plugins/impex/libkra/kis_kra_load_visitor.cpp:837
#: plugins/impex/libkra/kis_kra_load_visitor.cpp:840
#, kde-format
msgid ""
"parsing error in the keyframe file %1 at line %2, column %3\n"
"Error message: %4"
msgstr ""
"خطای تجزیه در پروندهٔ فریم کلیدی %1 در سطر %2، ستون %3\n"
"پیام خطا: %4"

#: plugins/impex/libkra/kis_kra_load_visitor.cpp:854
#, kde-format
msgid "unknown keyframe channel type: %1 in %2"
msgstr "نوع کانال فریم کلیدی ناشناخته: %1 در %2"

#: plugins/impex/libkra/kis_kra_loader.cpp:211
#, kde-format
msgid "Image does not have a name."
msgstr "تصویر فاقد نام است."

#: plugins/impex/libkra/kis_kra_loader.cpp:216
#, kde-format
msgid "Image does not specify a width."
msgstr "عرض تصویر مشخص نشده است."

#: plugins/impex/libkra/kis_kra_loader.cpp:222
#, kde-format
msgid "Image does not specify a height."
msgstr "ارتفاع تصویر مشخص نشده است."

#: plugins/impex/libkra/kis_kra_loader.cpp:272
#, kde-format
msgid "Image specifies an unsupported color model: %1."
msgstr "تصویر یک مدل رنگی پشتیبانی‌نشده را مشخص می‌کند: %1."

#: plugins/impex/libkra/kis_kra_loader.cpp:593
#, kde-format
msgctxt "Warning message on loading a .kra file"
msgid ""
"Embedded palette is empty and cannot be loaded. The name of the palette: %1"
msgstr "پالت تعبیه‌شده خالی است و بارگیری نمی‌شود. نام پالت: %1"

#: plugins/impex/libkra/kis_kra_loader.cpp:604
#, kde-format
msgctxt "Warning message on loading a .kra file"
msgid "Embedded resource cannot be read. The filename of the resource: %1"
msgstr "منبع تعبیه‌شده قابل خواندن نیست. نام پروندهٔ منبع: %1"

#: plugins/impex/libkra/kis_kra_loader.cpp:613
#, kde-format
msgctxt "Warning message on loading a .kra file"
msgid "Embedded resource cannot be imported. The filename of the resource: %1"
msgstr "منبع تعبیه‌شده قابل وارد کردن نیست. نام پروندهٔ منبع: %1"

#: plugins/impex/libkra/kis_kra_loader.cpp:697
#, kde-format
msgctxt "@info"
msgid ""
"Audio channel file \"%1\" doesn't exist!\n"
"\n"
"Expected path:\n"
"%2\n"
"\n"
"Do you want to locate it manually?"
msgstr ""
"پروندهٔ کانال صوتی «%1» وجود ندارد!\n"
"\n"
"مسیر مورد انتظار:\n"
"%2\n"
"\n"
"آیا می‌خواهید مکان آن را به‌طور دستی مشخص کنید؟"

#: plugins/impex/libkra/kis_kra_loader.cpp:872
#, kde-format
msgid ""
"Two global selection masks in active state found. \"%1\" is kept active, "
"\"%2\" is deactivated"
msgstr ""
"دو ماسک انتخاب سراسری در حالت فعال پیدا شدند. «%1» فعال نگه داشته شد، «%2» "
"غیرفعال شد"

#: plugins/impex/libkra/kis_kra_loader.cpp:932
#, kde-format
msgid "Layer %1 specifies an unsupported color model: %2."
msgstr "لایهٔ %1 یک مدل رنگی پشتیبانی‌نشده را مشخص می‌کند: %2."

