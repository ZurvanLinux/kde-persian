#: libs/ui/forms/wdgperformancesettings.ui:262
#, kde-format
msgid "CPU Limit:"
msgstr "محدودیت پردازنده:"

#. i18n: ectx: property (toolTip), widget (KisSliderSpinBox,
#. sliderThreadsLimit)
#: libs/ui/forms/wdgperformancesettings.ui:275
#, kde-format
msgid ""
"<html><head/><body><p>Krita will not use more CPU cores than selected by "
"this limit</p></body></html>"
msgstr ""
"<html><head/><body><p>کریتا بیش از تعداد هسته‌های پردازنده‌ای که با این "
"محدودیت تعیین شده، استفاده نخواهد کرد</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, label_9)
#: libs/ui/forms/wdgperformancesettings.ui:282
#, kde-format
msgid "Frame Rendering Clones Limit"
msgstr "محدودیت نسخه‌های موازی رندر فریم"

#. i18n: ectx: property (toolTip), widget (KisSliderSpinBox,
#. sliderFrameClonesLimit)
#: libs/ui/forms/wdgperformancesettings.ui:295
#, no-c-format, kde-format
msgid ""
"<html><head/><body><p>When rendering animation frames (into files or during "
"animation cache regeneration), Krita will make the specified number of "
"copies of your image and will work on them in parallel. Each copy will "
"demand more RAM for its storage (about 20% of the size of you image), so "
"raise this limit only if you have enough RAM "
"installed.</p><p><br/></p><p><span style=\" font-weight:600;\">Recommended "
"value:</span> set Clones Limit to the number of <span style=\" text-"
"decoration: underline;\">physical</span> (non-hyperthreaded) cores your CPU "
"has</p></body></html>"
msgstr ""
"<html><head/><body><p>هنگام رندر کردن فریم‌های پویانمایی (به صورت پرونده یا "
"در طول بازتولید حافظهٔ موقت پویانمایی)، کریتا به تعداد مشخص‌شده از تصویر شما"
" نسخه ایجاد کرده و به‌صورت موازی روی آن‌ها کار خواهد کرد. هر نسخه به حافظهٔ "
"RAM بیشتری برای نگهداری نیاز دارد (حدود ۲۰٪ از اندازهٔ تصویر شما)، بنابراین "
"این محدودیت را تنها در صورتی افزایش دهید که RAM کافی نصب شده "
"باشد.</p><p><br/></p><p><span style=\" font-weight:600;\">مقدار "
"توصیه‌شده:</span> محدودیت نسخه‌ها را برابر با تعداد هسته‌های <span style=\" "
"text-decoration: underline;\">فیزیکی</span> (غیر Hyper-Threading) پردازندهٔ "
"خود قرار دهید</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, label_11)
#: libs/ui/forms/wdgperformancesettings.ui:302
#, kde-format
msgid "Frame Rendering Timeout"
msgstr "مهلت زمانی رندر فریم"

#. i18n: ectx: property (toolTip), widget (KisSliderSpinBox,
#. sliderFrameTimeout)
#: libs/ui/forms/wdgperformancesettings.ui:315
#, kde-format
msgid ""
"<html><head/><body><p>The timeout for rendering one frame. If your animation"
" rendering fails regularly with a timeout, try increasing this "
"value</p><p><br/></p><p><span style=\" font-weight:600;\">Recommended "
"value:</span> 30...60 seconds</p></body></html>"
msgstr ""
"<html><head/><body><p>مهلت زمانی برای رندر یک فریم. اگر رندر پویانمایی شما "
"مرتباً به دلیل اتمام مهلت زمانی با شکست مواجه می‌شود، مقدار این گزینه را "
"افزایش دهید</p><p><br/></p><p><span style=\" font-weight:600;\">مقدار "
"توصیه‌شده:</span> ۳۰...۶۰ ثانیه</p></body></html>"

#. i18n: ectx: property (title), widget (QGroupBox, fpsGroup)
#: libs/ui/forms/wdgperformancesettings.ui:325
#, kde-format
msgid "Frame rate"
msgstr "نرخ فریم"

#. i18n: ectx: property (text), widget (QLabel, label_fps)
#: libs/ui/forms/wdgperformancesettings.ui:331
#, kde-format
msgid "Frame rate limit:"
msgstr "محدودیت نرخ فریم:"

#. i18n: ectx: property (toolTip), widget (KisSliderSpinBox, sliderFpsLimit)
#: libs/ui/forms/wdgperformancesettings.ui:344
#, kde-format
msgid ""
"<html><head/><body><p>Krita will try to limit the number of screen updates "
"per second to the given number. A lower number will decrease visual "
"responsiveness but increase stylus precision on some systems like "
"macOS.<p></body></html>"
msgstr ""
"<html><head/><body><p>کریتا تلاش خواهد کرد تعداد به‌روزرسانی‌های صفحه در هر "
"ثانیه را به این مقدار محدود کند. مقدار کمتر، پاسخ‌دهی بصری را کاهش می‌دهد "
"اما در برخی سیستم‌ها مانند macOS دقت قلم نوری را افزایش "
"می‌دهد.<p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, chkDetectFps)
#: libs/ui/forms/wdgperformancesettings.ui:351
#, kde-format
msgid "Detect from screen"
msgstr "تشخیص از صفحه"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_7)
#: libs/ui/forms/wdgperformancesettings.ui:361
#, kde-format
msgid "Debug options"
msgstr "گزینه‌های اشکال‌زدایی"

#. i18n: ectx: property (text), widget (QCheckBox, chkOpenGLFramerateLogging)
#: libs/ui/forms/wdgperformancesettings.ui:367
#, kde-format
msgid "Debug logging of OpenGL framerate"
msgstr "گزارش‌گیری اشکال‌زدایی برای نرخ فریم OpenGL"

#. i18n: ectx: property (text), widget (QCheckBox, chkBrushSpeedLogging)
#: libs/ui/forms/wdgperformancesettings.ui:374
#, kde-format
msgid "Debug logging for brush rendering speed"
msgstr "گزارش‌گیری اشکال‌زدایی برای سرعت رندر قلم‌مو"

#. i18n: ectx: property (text), widget (QCheckBox, chkDisableAVXOptimizations)
#: libs/ui/forms/wdgperformancesettings.ui:381
#, kde-format
msgid "Disable AVX vector optimizations"
msgstr "غیرفعال‌سازی بهینه‌سازی‌های برداری AVX"

#. i18n: ectx: property (text), widget (QCheckBox,
#. chkDisableVectorOptimizations)
#: libs/ui/forms/wdgperformancesettings.ui:388
#, kde-format
msgid "Disable all vector optimizations"
msgstr "غیرفعال‌سازی همهٔ بهینه‌سازی‌های برداری"

#. i18n: ectx: property (text), widget (QCheckBox, chkProgressReporting)
#: libs/ui/forms/wdgperformancesettings.ui:395
#, kde-format
msgid "Progress reporting (might affect performance)"
msgstr "گزارش پیشرفت (ممکن است روی عملکرد اثر بگذارد)"

#. i18n: ectx: property (text), widget (QCheckBox, chkPerformanceLogging)
#: libs/ui/forms/wdgperformancesettings.ui:402
#, kde-format
msgid "Performance logging"
msgstr "ثبت عملکرد"

#. i18n: ectx: property (text), widget (QLabel, label_7)
#: libs/ui/forms/wdgperformancesettings.ui:415
#, kde-format
msgid ""
"<html><head/><body><p>When performance logging is enabled Krita saves timing"
" information into the <tt>&lt;working_dir&gt;/log</tt> folder. If you "
"experience performance problems and want to help us, enable this option and "
"add the contents of the directory to a bug report.</p></body></html>"
msgstr ""
"<html><head/><body><p>هنگامی که ثبت عملکرد فعال باشد، کریتا اطلاعات "
"زمان‌بندی را در پوشهٔ <tt>&lt;working_dir&gt;/log</tt> ذخیره می‌کند. اگر با "
"مشکلات عملکردی مواجه شده‌اید و می‌خواهید به ما کمک کنید، این گزینه را فعال "
"کرده و محتویات این پوشه را به گزارش اشکال ضمیمه کنید.</p></body></html>"

#. i18n: ectx: attribute (title), widget (QWidget, AnimationCache)
#: libs/ui/forms/wdgperformancesettings.ui:442
#, kde-format
msgid "Animation Cache"
msgstr "حافظهٔ نهان پویانمایی"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: libs/ui/forms/wdgperformancesettings.ui:448
#, kde-format
msgid "Cache Storage Backend"
msgstr "بستر ذخیره‌سازی حافظهٔ نهان"

#. i18n: ectx: property (toolTip), widget (QRadioButton, optInMemory)
#: libs/ui/forms/wdgperformancesettings.ui:454
#, kde-format
msgid ""
"<html><head/><body><p>Animation frame cache will be stored in RAM completely"
" without any limitations</p><p><span style=\" font-"
"weight:600;\">WARNING:</span> please make sure your computer has enough RAM "
"<span style=\" text-decoration: underline;\">above</span> the amount you "
"requested in General tab. Otherwise you might face system freezes.</p><p>* "
"for 1 second of FullHD@25fps video you need extra 200 MiB of memory</p><p>* "
"for 1 second of 4K UltraHD@25fps video you need extra 800 MiB of "
"memory</p></body></html>"
msgstr ""
"<html><head/><body><p>حافظهٔ نهان فریم‌های پویانمایی به‌طور کامل و بدون هیچ "
"محدودیتی در RAM ذخیره خواهد شد</p><p><span style=\" font-"
"weight:600;\">هشدار:</span> لطفاً مطمئن شوید رایانهٔ شما حافظهٔ RAM کافی "
"<span style=\" text-decoration: underline;\">فراتر</span> از مقدار درخواستی "
"در زبانهٔ عمومی دارد. در غیر این صورت ممکن است با هنگ کردن سیستم مواجه "
"شوید.</p><p>* برای ۱ ثانیه ویدئوی FullHD@25fps به 200 MiB حافظهٔ اضافی نیاز "
"دارید</p><p>* برای ۱ ثانیه ویدئوی 4K UltraHD@25fps به 800 MiB حافظهٔ اضافی "
"نیاز دارید</p></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, optInMemory)
#: libs/ui/forms/wdgperformancesettings.ui:457
#, kde-format
msgid "In-memory"
msgstr "در حافظه"

#. i18n: ectx: property (toolTip), widget (QRadioButton, optOnDisk)
#: libs/ui/forms/wdgperformancesettings.ui:464
#, kde-format
msgid ""
"<html><head/><body><p>Animation frames are stored on hard disk in the same "
"folder as swap file. The cache is stored in a compressed way. Little amount "
"of extra RAM is needed.</p><p>Since data transfer speed of the hard drive is"
" low, you might want to limit cached frame size to be able to play your "
"video at 25 fps. The limit of 2500 px is usually a good "
"choice.</p></body></html>"
msgstr ""
"<html><head/><body><p>فریم‌های پویانمایی روی دیسک سخت و در همان پوشهٔ "
"پروندهٔ مبادله (swap) ذخیره می‌شوند. حافظهٔ نهان به‌صورت فشرده ذخیره می‌شود."
" به مقدار اندکی RAM اضافی نیاز است.</p><p>از آنجا که سرعت انتقال دادهٔ دیسک "
"سخت پایین است، شاید بخواهید اندازهٔ فریم‌های نهان‌سازی‌شده را محدود کنید تا "
"بتوانید ویدئوی خود را با سرعت ۲۵ فریم‌برثانیه پخش کنید. محدودیت ۲۵۰۰ پیکسل "
"معمولاً انتخاب مناسبی است.</p></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, optOnDisk)
#: libs/ui/forms/wdgperformancesettings.ui:467
#, kde-format
msgid "On-disk"
msgstr "روی دیسک"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_5)
#: libs/ui/forms/wdgperformancesettings.ui:477
#, kde-format
msgid "Cache Generation Options"
msgstr "گزینه‌های تولید حافظهٔ نهان"

#. i18n: ectx: property (toolTip), widget (QCheckBox,
#. chkCachedFramesSizeLimit)
#: libs/ui/forms/wdgperformancesettings.ui:483
#, kde-format
msgid ""
"<html><head/><body><p>Render scaled down version of the frame if the image "
"is bigger than the provided limit. Make sure you enable this option when "
"using on-disk storage backend.</p></body></html>"
msgstr ""
"<html><head/><body><p>اگر تصویر بزرگ‌تر از حد مشخص‌شده باشد، نسخه کوچک‌شده "
"فریم رندر می‌شود. هنگام استفاده از پشتیبان ذخیره‌سازی روی دیسک، حتماً این "
"گزینه را فعال کنید.</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, chkCachedFramesSizeLimit)
#: libs/ui/forms/wdgperformancesettings.ui:486
#, kde-format
msgid "Limit cached frame size:"
msgstr "محدود کردن اندازه فریم‌های ذخیره‌شده در حافظه پنهان:"

#. i18n: ectx: property (toolTip), widget (KisSliderSpinBox,
#. intCachedFramesSizeLimit)
#: libs/ui/forms/wdgperformancesettings.ui:499
#, kde-format
msgid ""
"<html><head/><body><p>Size limit after which the frames will be scaled "
"down</p><p><span style=\" font-weight:600;\">Recommended value:</span> "
"2500&nbsp;px</p></body></html>"
msgstr ""
"<html><head/><body><p>حد اندازه‌ای که پس از آن فریم‌ها کوچک "
"می‌شوند</p><p><span style=\" font-weight:600;\">مقدار توصیه‌شده:</span> "
"۲۵۰۰&nbsp;px</p></body></html>"

#. i18n: ectx: property (toolTip), widget (QCheckBox, chkUseRegionOfInterest)
#: libs/ui/forms/wdgperformancesettings.ui:506
#, kde-format
msgid ""
"<html><head/><body><p>When the image is too big, render only currently "
"visible part of it</p></body></html>"
msgstr ""
"<html><head/><body><p>وقتی تصویر خیلی بزرگ است، فقط بخش قابل مشاهده فعلی آن "
"رندر شود</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, chkUseRegionOfInterest)
#: libs/ui/forms/wdgperformancesettings.ui:509
#, kde-format
msgid "Use region of interest"
msgstr "استفاده از ناحیه مورد نظر (ROI)"

#. i18n: ectx: property (toolTip), widget (KisSliderSpinBox,
#. intRegionOfInterestMargin)
#: libs/ui/forms/wdgperformancesettings.ui:522
#, no-c-format, kde-format
msgid ""
"<html><head/><body><p>Add extra area to the region of interest to each side "
"of the canvas.</p><p><span style=\" font-weight:600;\">Recommended "
"value:</span> 25%. The region of interest will be extended by 25% to each "
"side.</p></body></html>"
msgstr ""
"<html><head/><body><p>افزودن فضای اضافی به ناحیه مورد نظر از هر طرف "
"بوم.</p><p><span style=\" font-weight:600;\">مقدار توصیه‌شده:</span> ۲۵٪. "
"ناحیه مورد نظر از هر طرف ۲۵٪ گسترش خواهد یافت.</p></body></html>"

#. i18n: ectx: property (toolTip), widget (QCheckBox,
#. chkBackgroundCacheGeneration)
#: libs/ui/forms/wdgperformancesettings.ui:529
#, kde-format
msgid ""
"<html><head/><body><p>Automatically prerender animation cache in background "
"when the user is idle</p></body></html>"
msgstr ""
"<html><head/><body><p>پیش‌رندر خودکار حافظه پنهان پویانمایی در پس‌زمینه "
"هنگام بیکار بودن کاربر</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox,
#. chkBackgroundCacheGeneration)
#: libs/ui/forms/wdgperformancesettings.ui:532
#, kde-format
msgid "Enable background cache generation"
msgstr "فعال‌سازی تولید حافظه پنهان در پس‌زمینه"

#. i18n: ectx: attribute (title), widget (QWidget, InstantPreview)
#: libs/ui/forms/wdgperformancesettings.ui:556
#: libs/ui/widgets/kis_lod_availability_widget.cpp:168
#, kde-format
msgid "Instant Preview"
msgstr "پیش‌نمایش فوری"

#. i18n: ectx: property (text), widget (QCheckBox,
#. chkTransformToolUseInStackPreview)
#: libs/ui/forms/wdgperformancesettings.ui:565
#, kde-format
msgid "Use in-stack preview in Transform Tool"
msgstr "استفاده از پیش‌نمایش درون‌پشته‌ای در ابزار تبدیل"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_6)
#: libs/ui/forms/wdgperformancesettings.ui:572
#, kde-format
msgid "Force Instant Preview"
msgstr "اجبار به پیش‌نمایش فوری"

#. i18n: ectx: property (toolTip), widget (QCheckBox, chkFiltersForceLodMode)
#: libs/ui/forms/wdgperformancesettings.ui:578
#, kde-format
msgid ""
"<html><head/><body><p>The filter dialog will always use instant preview, "
"even if instant preview is disabled in the &quot;View&quot; "
"menu</p></body></html>"
msgstr ""
"<html><head/><body><p>کادر محاوره‌ای فیلتر همیشه از پیش‌نمایش فوری استفاده "
"خواهد کرد، حتی اگر پیش‌نمایش فوری در منوی «نما» غیرفعال شده "
"باشد</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, chkFiltersForceLodMode)
#: libs/ui/forms/wdgperformancesettings.ui:581
#, kde-format
msgid "in Filters"
msgstr "در فیلترها"

#. i18n: ectx: property (toolTip), widget (QCheckBox,
#. chkTransformToolForceLodMode)
#: libs/ui/forms/wdgperformancesettings.ui:588
#, kde-format
msgid ""
"<html><head/><body><p>The transform tool preview will always use instant "
"preview, even if instant preview is disabled in the &quot;View&quot; "
"menu</p></body></html>"
msgstr ""
"<html><head/><body><p>پیش‌نمایش ابزار تبدیل شکل همیشه از پیش‌نمایش فوری "
"استفاده خواهد کرد، حتی اگر پیش‌نمایش فوری در منوی «نما» غیرفعال شده "
"باشد</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox,
#. chkTransformToolForceLodMode)
#: libs/ui/forms/wdgperformancesettings.ui:591
#, kde-format
msgid "in Transform Tool"
msgstr "در ابزار تبدیل شکل"

#. i18n: ectx: property (toolTip), widget (QCheckBox, chkMoveToolForceLodMode)
#: libs/ui/forms/wdgperformancesettings.ui:598
#, kde-format
msgid ""
"<html><head/><body><p>The move tool preview will always use instant preview,"
" even if instant preview is disabled in the &quot;View&quot; "
"menu</p></body></html>"
msgstr ""
"<html><head/><body><p>پیش‌نمایش ابزار جابه‌جایی همیشه از پیش‌نمایش فوری "
"استفاده خواهد کرد، حتی اگر پیش‌نمایش فوری در منوی «نما» غیرفعال شده "
"باشد</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, chkMoveToolForceLodMode)
#: libs/ui/forms/wdgperformancesettings.ui:601
#, kde-format
msgid "in Move Tool"
msgstr "در ابزار جابه‌جایی"

