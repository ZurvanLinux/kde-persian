msgctxt "@label"
msgid "Hanging Punctuation"
msgstr "نشانه‌گذاری آویزان"

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:16
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Hanging punctuation allows hanging opening and closing punctuation as well "
"as commas. This implementation only implements East-Asian style hanging "
"punctuation."
msgstr ""
"نشانه‌گذاری آویزان امکان آویزان کردن علائم نگارشی آغازین و پایانی و همچنین "
"ویرگول‌ها را فراهم می‌کند. این پیاده‌سازی فقط نشانه‌گذاری آویزان به سبک شرق "
"آسیا را پیاده‌سازی می‌کند."

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:18
#, kde-format
msgctxt ""
"comma separated search terms for the hanging-punctuation property, matching "
"is case-insensitive"
msgid "hanging-punctuation, burasagari"
msgstr "نشانه‌گذاری آویزان, بوراساگاری, hanging-punctuation, burasagari"

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:115
#, kde-format
msgctxt "@option:check"
msgid "Hang First"
msgstr "آویزان کردن آغازین"

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:124
#, kde-format
