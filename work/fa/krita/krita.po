msgstr "بدون آویختگی"

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:133
#, kde-format
msgctxt "@label:inlistbox"
msgid "Allow hanging commas"
msgstr "مجاز بودن ویرگول‌های آویزان"

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:134
#, kde-format
msgctxt "@label:inlistbox"
