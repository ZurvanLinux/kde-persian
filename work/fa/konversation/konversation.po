#: src/viewer/channeloptionsdialog.cpp:609
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p>The <b>T</b>opic mode means that only the channel "
"operator can change the topic for the channel.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>حالت موضوع (<b>T</b>opic) به "
"این معنی است که فقط گردانندهٔ کانال می‌تواند موضوع کانال را تغییر "
"دهد.</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:611
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p><b>N</b>o messages from outside means users who are not"
" in the channel cannot send messages for everybody in the channel to see.  "
"Almost all channels have this set to prevent nuisance messages.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>حالت <b>N</b>o messages from "
"outside (عدم دریافت پیام از بیرون) به این معنی است که کاربرانی که در کانال "
"نیستند، نمی‌توانند برای دیدن همه پیامی به کانال بفرستند. تقریباً همهٔ "
"کانال‌ها این گزینه را برای جلوگیری از پیام‌های مزاحم فعال دارند.</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:613
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p>A <b>S</b>ecret channel will not show up in the channel"
" list, nor will any user be able to see that you are in the channel with the"
" <em>WHOIS</em> command or anything similar.  Only the people that are in "
"the same channel will know that you are in this channel, if this mode is "
"set.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>یک کانال محرمانه "
"(<b>S</b>ecret) در فهرست کانال‌ها نشان داده نخواهد شد، و هیچ کاربری "
"نمی‌تواند از طریق دستور <em>WHOIS</em> یا موارد مشابه متوجه حضور شما در "
"کانال شود. در صورت تنظیم این حالت، تنها کسانی که در همان کانال هستند متوجه "
"حضور شما خواهند شد.</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:615
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p>An <b>I</b>nvite only channel means that people can "
"only join the channel if they are invited.  To invite someone, a channel "
"operator needs to issue the command <em>/invite nick</em> from within the "
"channel.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>کانال فقط با دعوت "
"(<b>I</b>nvite only) به این معنی است که افراد فقط در صورت دعوت شدن می‌توانند"
" به کانال بپیوندند. برای دعوت دیگران، گردانندهٔ کانال باید دستور "
"<em>‎/invite nick</em> را از داخل کانال صادر کند.</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:617
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p>A <b>P</b>rivate channel is shown in a listing of all "
"channels, but the topic is not shown.  A user's <em>WHOIS</em> may or may "
"not show them as being in a private channel depending on the IRC "
"server.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>یک کانال خصوصی "
"(<b>P</b>rivate) در فهرست تمام کانال‌ها نمایش داده می‌شود، اما موضوع آن "
"پنهان است. بسته به سرور IRC، دستور <em>WHOIS</em> یک کاربر ممکن است حضور او "
"را در یک کانال خصوصی نشان دهد یا ندهد.</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:619
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p>A <b>M</b>oderated channel is one where only operators,"
" half-operators and those with voice can talk.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>کانال مدیریت‌شده "
"(<b>M</b>oderated) کانالی است که در آن فقط گردانندگان، نیمه‌گردانندگان و "
"افرادی با حق صحبت (voice) اجازهٔ گفت‌وگو دارند.</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:621
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p>A protected channel requires users to enter a password "
"in order to join.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>یک کانال محافظت‌شده برای "
"پیوستن، کاربران را ملزم به وارد کردن گذرواژه می‌کند.</p></qt>"

#: src/viewer/channeloptionsdialog.cpp:623
#, kde-format
msgid ""
"<qt><p>These control the <em>mode</em> of the channel.  Only an operator can"
" change these.</p><p>A channel that has a user <b>L</b>imit means that only "
"that many users can be in the channel at any one time.  Some channels have a"
" bot that sits in the channel and changes this automatically depending on "
"how busy the channel is.</p></qt>"
msgstr ""
"<qt><p>این موارد <em>حالت</em> (mode) کانال را کنترل می‌کنند. تنها گرداننده "
"(اپراتور) می‌تواند این‌ها را تغییر دهد.</p><p>کانالی با محدودیت کاربر "
"(<b>L</b>imit) به این معنی است که در هر لحظه فقط تعداد مشخصی کاربر می‌توانند"
" در کانال حضور داشته باشند. برخی کانال‌ها رباتی دارند که در کانال مستقر است "
"و بسته به میزان شلوغی، این مقدار را به‌طور خودکار تغییر می‌دهد.</p></qt>"

