msgstr "باز کردن در مرورگر…"

#: src/qml/pages/PlasmaUpdate.qml:228
#, kde-format
msgctxt "@option:check"
msgid "Load preview automatically"
msgstr "بارگذاری خودکار پیش‌نمایش"

#: src/qml/pages/PlasmaUpdate.qml:236
#, kde-format
msgctxt "@info:tooltip"
