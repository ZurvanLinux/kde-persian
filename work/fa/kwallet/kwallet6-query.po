#: main.cpp:34 main.cpp:35
#, kde-format
msgid "Entry"
msgstr "ورودی"

#: main.cpp:35
#, kde-format
msgid ""
"write secrets to the given <entry>. The values are read from the standard "
"input. IMPORTANT: previous wallet entry value will be overwritten!"
msgstr ""
"نوشتن رمزها در <entry> مشخص‌شده. مقادیر از ورودی استاندارد خوانده می‌شوند. "
"مهم: مقدار ورودی قبلی کیف پول بازنویسی خواهد شد!"

#: main.cpp:36
#, kde-format
msgid "specify the folder in the wallet <folder>"
msgstr "مشخص کردن پوشه در کیف پول <folder>"

#: main.cpp:36
#, kde-format
msgid "Folder"
msgstr "پوشه"

#: main.cpp:40
#, kde-format
msgid "The wallet to query"
msgstr "کیف پول برای پرس‌وجو"

#: main.cpp:50
#, kde-format
msgid "Missing argument"
msgstr "آرگومان مفقود است"

#: main.cpp:54
#, kde-format
msgid "Too many arguments given"
msgstr "تعداد آرگومان‌های ارائه‌شده بیش از حد است"

#: main.cpp:59
#, kde-format
msgid "Only one mode (list, read or write) can be set. Aborting"
msgstr "فقط یک حالت (فهرست، خواندن یا نوشتن) قابل تنظیم است. لغو عملیات"

#: main.cpp:63
#, kde-format
msgid "Please specify the mode (list or read)."
msgstr "لطفاً حالت (فهرست یا خواندن) را مشخص کنید."

#: querydriver.cpp:46
#, kde-format
msgid "Wallet %1 not found"
msgstr "کیف پول %1 یافت نشد"

#: querydriver.cpp:70
#, kde-format
msgid "Failed to open wallet %1. Aborting"
msgstr "باز کردن کیف پول %1 ناموفق بود. لغو عملیات"

#: querydriver.cpp:104 querydriver.cpp:122 querydriver.cpp:180
#, kde-format
msgid "The folder %1 does not exist!"
msgstr "پوشهٔ %1 وجود ندارد!"

#: querydriver.cpp:132
#, kde-format
msgid "Failed to read entry %1 value from the %2 wallet."
msgstr "خواندن مقدار ورودی %1 از کیف پول %2 ناموفق بود."

#: querydriver.cpp:142 querydriver.cpp:159
#, kde-format
msgid "Failed to read entry %1 value from the %2 wallet"
msgstr "خواندن مقدار ورودی %1 از کیف‌پول %2 ناموفق بود"

#: querydriver.cpp:206 querydriver.cpp:227
#, kde-format
msgid "Failed to write entry %1 value to %2 wallet"
msgstr "نوشتن مقدار ورودی %1 در کیف‌پول %2 ناموفق بود"

#: querydriver.cpp:213
#, kde-format
msgid "Invalid argument: the value for entry %1 is not valid JSON"
msgstr "آرگومان نامعتبر: مقدار ورودی %1، یک JSON معتبر نیست"

#: querydriver.cpp:232
#, kde-format
msgid "Unsupported entry type for entry %1"
msgstr "نوع ورودی پشتیبانی‌نشده برای ورودی %1"
