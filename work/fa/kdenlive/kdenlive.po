#: data/effects/avfilter/avfilter_shufflepixels.xml:4
#, kde-format
msgid "Shuffle Pixels"
msgstr "برزدن پیکسل‌ها"

#: data/effects/avfilter/avfilter_shufflepixels.xml:5
#, kde-format
msgid "Reorder pixels in video frames."
msgstr "تغییر ترتیب پیکسل‌ها در فریم‌های ویدیو."

#: data/effects/avfilter/avfilter_shufflepixels.xml:10
#, kde-format
msgid ""
"Set shuffle direction.<br>\n"
"        A forward shuffle can be reversed by using <b>inverse</b>, setting the same parameters, and the exact same seed value."
msgstr ""
"جهت بر زدن را تنظیم کنید.<br>\n"
"        یک بر زدن رو به جلو را می‌توان با استفاده از <b>معکوس</b>، اعمال پارامترهای یکسان و مقدار بذر (seed) دقیقاً مشابه، بازگردانی کرد."

#: data/effects/avfilter/avfilter_shufflepixels.xml:11
#, kde-format
msgid "Forward,Inverse"
msgstr "رو به جلو,معکوس"

#: data/effects/avfilter/avfilter_shufflepixels.xml:15
#, kde-format
msgid "Set shuffle mode"
msgstr "تنظیم حالت بر زدن"

#: data/effects/avfilter/avfilter_shufflepixels.xml:16
#, kde-format
msgid "Horizontal,Vertical,Block"
msgstr "افقی,عمودی,بلوک"

#: data/effects/avfilter/avfilter_shufflepixels.xml:20
#, kde-format
msgid "Set shuffle block width size"
msgstr "تنظیم اندازه عرض بلوک بر زدن"

#: data/effects/avfilter/avfilter_shufflepixels.xml:24
#, kde-format
msgid "Set shuffle block height size"
msgstr "تنظیم اندازه ارتفاع بلوک بر زدن"

#: data/effects/avfilter/avfilter_shufflepixels.xml:27
#: data/effects/ladspa/ladspa_1402.xml:8 data/effects/typewriter.xml:18
#, kde-format
msgid "Random Seed"
msgstr "بذر تصادفی"

#: data/effects/avfilter/avfilter_shufflepixels.xml:29
#, kde-format
msgid ""
"Set random seed used with shuffling pixels.<br>\n"
"        Mainly useful to set to be able to reverse filtering process to get original input. For example, to reverse forward shuffle you need to use the same parameters and exact same seed and to set direction to inverse."
msgstr ""
"تنظیم بذر تصادفی (random seed) مورد استفاده در بر زدن پیکسل‌ها.<br>\n"
"        عمدتاً برای بازگردانی فرایند فیلتر و دستیابی به ورودی اصلی کاربرد دارد. برای مثال، جهت معکوس کردن بر زدن رو به جلو، باید از پارامترهای یکسان، دقیقاً همان بذر، و تنظیم جهت بر روی معکوس استفاده کنید."

#: data/effects/avfilter/avfilter_shuffleplanes.xml:4
