#: data/effects/frei0r/frei0r_levels.xml:87
#: data/effects/frei0r/frei0r_levels.xml:126
#, kde-format
msgid "Input white level"
msgstr "سطح سفید ورودی"

#: data/effects/frei0r/frei0r_levels.xml:22
#: data/effects/frei0r/frei0r_levels.xml:53
#: data/effects/frei0r/frei0r_levels.xml:97
#: data/effects/frei0r/frei0r_levels.xml:136
#, kde-format
msgid "Black output"
msgstr "سیاه خروجی"

#: data/effects/frei0r/frei0r_levels.xml:25
#: data/effects/frei0r/frei0r_levels.xml:56
#: data/effects/frei0r/frei0r_levels.xml:101
#: data/effects/frei0r/frei0r_levels.xml:140
#, kde-format
msgid "White output"
msgstr "سفید خروجی"

#: data/effects/frei0r/frei0r_levels.xml:28
#: data/effects/frei0r/frei0r_levels.xml:59
#: data/effects/frei0r/frei0r_levels.xml:75
#: data/effects/frei0r/frei0r_levels.xml:114
#, kde-format
msgid "Show histogram"
msgstr "نمایش بافت‌نگار"

#: data/effects/frei0r/frei0r_levels.xml:31
#: data/effects/frei0r/frei0r_levels.xml:62
#: data/effects/frei0r/frei0r_levels.xml:78
#: data/effects/frei0r/frei0r_levels.xml:117
#, kde-format
msgid "Histogram position"
msgstr "موقعیت بافت‌نگار"

#: data/effects/frei0r/frei0r_levels.xml:84
#: data/effects/frei0r/frei0r_levels.xml:123
#, kde-format
msgid ""
"Moves the black point to the right: all pixels with that value or less will be black.<br>\n"
"                This makes the dark areas even darker, influences the mid-tones a little and the highlights not at all. Increases contrast."
msgstr ""
"نقطه سیاه را به سمت راست حرکت می‌دهد: همه پیکسل‌های دارای این مقدار یا کمتر، سیاه خواهند شد.<br>\n"
"                این کار نواحی تاریک را حتی تاریک‌تر می‌کند، کمی بر سایه‌روشن‌ها تأثیر می‌گذارد و اصلاً بر روشنایی‌ها تأثیر ندارد. کنتراست را افزایش می‌دهد."

#: data/effects/frei0r/frei0r_levels.xml:89
#: data/effects/frei0r/frei0r_levels.xml:128
#, kde-format
msgid ""
"Moves the white point to the left: all pixels with that value or higher will be white.<br>\n"
"                This makes bright areas even brighter, influences the mid-tones a little and the dark areas not at all. Increases contrast."
msgstr ""
"نقطه سفید را به سمت چپ حرکت می‌دهد: همه پیکسل‌های دارای این مقدار یا بیشتر، سفید خواهند شد.<br>\n"
"                این کار نواحی روشن را حتی روشن‌تر می‌کند، کمی بر سایه‌روشن‌ها تأثیر می‌گذارد و اصلاً بر نواحی تاریک تأثیر ندارد. کنتراست را افزایش می‌دهد."

#: data/effects/frei0r/frei0r_levels.xml:94
#, no-c-format, kde-format
msgid ""
"Changes the overall brightness of the image.<br>\n"
"                Affects only the mid-tones, black and white are not influenced. Default is 25%, equivalent to Gamma 1.0). Lower values (moving the bar to the left) make the image darker, higher values (moving the bar to the right) make it brighter."
msgstr ""
"روشنایی کلی تصویر را تغییر می‌دهد.<br>\n"
"                تنها بر سایه‌روشن‌ها اثر می‌گذارد؛ سیاه و سفید تحت تأثیر قرار نمی‌گیرند. مقدار پیش‌فرض 25% معادل گاما 1.0 است. مقادیر کمتر (حرکت دادن نوار به سمت چپ) تصویر را تاریک‌تر و مقادیر بیشتر (حرکت دادن نوار به سمت راست) آن را روشن‌تر می‌کند."

#: data/effects/frei0r/frei0r_levels.xml:98
#: data/effects/frei0r/frei0r_levels.xml:137
#, kde-format
msgid "Opposite of Input black level"
msgstr "برعکس سطح سیاه ورودی"

#: data/effects/frei0r/frei0r_levels.xml:102
#: data/effects/frei0r/frei0r_levels.xml:141
#, kde-format
msgid "Opposite of Input white level"
msgstr "برعکس سطح سفید ورودی"

#: data/effects/frei0r/frei0r_levels.xml:133
#, kde-format
msgid ""
"Changes the overall brightness of the image.<br>\n"
"                Affects only the mid-tones, black and white are not influenced. Default is 1. Lower values (moving the bar to the left) make the image darker, higher values (moving the bar to the right) make it brighter."
msgstr ""
"روشنایی کلی تصویر را تغییر می‌دهد.<br>\n"
"                تنها بر تن‌های میانه اثر می‌گذارد، سیاه و سفید تحت تاثیر قرار نمی‌گیرند. مقدار پیش‌فرض ۱ است. مقادیر کمتر (حرکت میله به سمت چپ) تصویر را تیره‌تر و مقادیر بیشتر (حرکت میله به سمت راست) آن را روشن‌تر می‌کنند."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:5
#: data/effects/frei0r/frei0r_lightgraffiti.xml:77
#, kde-format
msgid "Light Graffiti"
msgstr "نقاشی با نور"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:8
#, kde-format
msgid ""
"Light Graffiti effect.\n"
"        This effect allows one to do Light Painting (i.e. painting with light sources on a photo by keeping the shutter\n"
"        opened for a while), but for video."
msgstr ""
"جلوه نقاشی با نور (Light Graffiti).\n"
"        این جلوه امکان نقاشی با نور (یعنی نقاشی با منابع نور روی یک عکس از طریق باز نگه داشتن شاتر برای مدتی) را برای ویدیو فراهم می‌کند."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:11
#: data/effects/frei0r/frei0r_lightgraffiti.xml:83
#, kde-format
msgid "Brightness Threshold"
msgstr "آستانه روشنایی"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:13
#: data/effects/frei0r/frei0r_lightgraffiti.xml:85
#, kde-format
msgid ""
"How bright (<code>R+G+B</code>) does a pixel need to be in order to be recognized as a light source?<br/>\n"
"            Increasing this threshold requires brighter light sources (i.e. more white or less color, respectively) but prevents some «false alarms» where semi-bright parts, e.g. hands where colors can change quite a lot compared to the background, are incorrectly recognized as light source."
msgstr ""
"یک پیکسل چقدر باید روشن (<code>R+G+B</code>) باشد تا به‌عنوان یک منبع نور شناخته شود؟<br/>\n"
"            افزایش این آستانه نیازمند منابع نوری روشن‌تر است (یعنی به‌ترتیب سفید بیشتر یا رنگ کمتر)، اما از هشدارهای نادرست در بخش‌های نیمه‌روشن (مانند دست‌ها که رنگ آن‌ها ممکن است در مقایسه با پس‌زمینه بسیار تغییر کند) که به‌اشتباه به‌عنوان منبع نور شناخته می‌شوند، جلوگیری می‌کند."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:16
#: data/effects/frei0r/frei0r_lightgraffiti.xml:88
#, kde-format
msgid "Difference Threshold"
msgstr "آستانه تفاوت"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:18
#: data/effects/frei0r/frei0r_lightgraffiti.xml:90
#, kde-format
msgid ""
"How much does the strongest color channel of a pixel have to change, compared to the background image (<code>max(dR, dG, dB)</code>), in order to be recognized as light source? <br/>\n"
"            Increasing this threshold makes it harder for light sources to be accepted on bright backgrounds, but decreases the danger of noise or generally bright spots counting as light source."
msgstr ""
"قوی‌ترین کانال رنگی یک پیکسل در مقایسه با تصویر پس‌زمینه (<code>max(dR, dG, dB)</code>) چقدر باید تغییر کند تا به‌عنوان منبع نور شناخته شود؟<br/>\n"
"            افزایش این آستانه، پذیرش منابع نوری در پس‌زمینه‌های روشن را دشوارتر می‌کند، اما خطر به حساب آمدن نویز یا نقاط روشن عمومی به‌عنوان منبع نور را کاهش می‌دهد."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:21
#: data/effects/frei0r/frei0r_lightgraffiti.xml:93
#, kde-format
msgid "Difference Sum Threshold"
msgstr "آستانه مجموع تفاوت‌ها"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:23
#: data/effects/frei0r/frei0r_lightgraffiti.xml:95
#, kde-format
msgid ""
"How much does the sum of all color channels <em>relative to the background image</em> (<code>dR + dG + dB</code>) have to change until a pixel is recognized as a light source?<br/>\n"
"            Raising this value might, in some cases, avoid that some light objects lit by the light source are added to the light mask."
msgstr ""
"مجموع تمام کانال‌های رنگی <em>نسبت به تصویر پس‌زمینه</em> (<code>dR + dG + dB</code>) چقدر باید تغییر کند تا یک پیکسل به عنوان منبع نور شناخته شود؟<br/>\n"
"            افزایش این مقدار در برخی موارد ممکن است از اضافه شدن اشیای روشنی که توسط منبع نور روشن شده‌اند به ماسک نور جلوگیری کند."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:26
#: data/effects/frei0r/frei0r_lightgraffiti.xml:98
#, kde-format
msgid "Sensitivity"
msgstr "حساسیت"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:28
#: data/effects/frei0r/frei0r_lightgraffiti.xml:100
#, kde-format
msgid ""
"Light sensitivity.<br/>\n"
"            For slowly moving light source try to use a lower sensitivity to obtain a better exposure."
msgstr ""
"حساسیت نور.<br/>\n"
"            برای منبع نوری با حرکت آهسته، سعی کنید از حساسیت کمتری برای دستیابی به نوردهی بهتر استفاده کنید."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:31
#: data/effects/frei0r/frei0r_lightgraffiti.xml:103
#, kde-format
msgid "Lower Overexposure"
msgstr "کاهش نوردهی بیش از حد"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:33
#: data/effects/frei0r/frei0r_lightgraffiti.xml:105
#, kde-format
msgid ""
"Lowers overexposure.<br/>\n"
"            The light mask does not get white immediately when the light source is moving slowly or staying steady."
msgstr ""
"نوردهی بیش از حد را کاهش می‌دهد.<br/>\n"
"            وقتی منبع نور به آرامی حرکت می‌کند یا ثابت می‌ماند، ماسک نور بلافاصله سفید نمی‌شود."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:36
#: data/effects/frei0r/frei0r_lightgraffiti.xml:108
#, kde-format
msgid "Dimming"
msgstr "کم‌نور کردن"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:37
#: data/effects/frei0r/frei0r_lightgraffiti.xml:109
#, kde-format
msgid ""
"Dims the light mask. Lights will leave a fainting trail if it is set to a "
"value > 0."
msgstr ""
"ماسک نور را کم‌نور می‌کند. اگر روی مقداری بزرگ‌تر از 0 تنظیم شود، نورها یک "
"رد محوشونده به جا می‌گذارند."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:40
#: data/effects/frei0r/frei0r_lightgraffiti.xml:112
#, kde-format
msgid "Background Weight"
msgstr "وزن پس‌زمینه"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:41
#: data/effects/frei0r/frei0r_lightgraffiti.xml:113
#, kde-format
msgid ""
"Strength of the (calculated) background image. Setting it to 100 paints the "
"light mask directly over the background, without the painting person in the "
"image if the video starts with a «clean» background image. (See the α "
"parameter.)"
msgstr ""
"میزان شدت تصویر پس‌زمینه (محاسبه‌شده). تنظیم آن روی ۱۰۰، ماسک نور را "
"مستقیماً روی پس‌زمینه رسم می‌کند؛ در صورتی که ویدیو با یک تصویر پس‌زمینه "
"«تمیز» شروع شود، فردِ در حال نقاشی در تصویر نخواهد بود. (پارامتر α را "
"ببینید.)"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:44
#: data/effects/frei0r/frei0r_lightgraffiti.xml:116
#, kde-format
msgid "α"
msgstr "α"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:46
#: data/effects/frei0r/frei0r_lightgraffiti.xml:118
#, kde-format
msgid ""
"Determines how the effect tries to adapt to background changes. <br/>\n"
"            The Light Graffiti effect remembers the first frame of the clip it is applied to, so the clip should <em>always</em> start with the painter outside of the video. If the background constantly changes, e.g. on a street, try to set α > 0 to calculate an average background image."
msgstr ""
"تعیین می‌کند که جلوه چگونه با تغییرات پس‌زمینه سازگار شود. <br/>\n"
"            جلوهٔ گرافیتی نوری فریم اول کلیپی را که روی آن اعمال شده به خاطر می‌سپارد، بنابراین کلیپ باید <em>همیشه</em> بدون حضور نقاش در کادر ویدیو شروع شود. اگر پس‌زمینه مرتباً تغییر می‌کند، برای مثال در خیابان، مقدار α > 0 را تنظیم کنید تا یک تصویر میانگین از پس‌زمینه محاسبه شود."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:50
#: data/effects/frei0r/frei0r_lightgraffiti.xml:122
#, kde-format
msgid "Increases the saturation of lights."
msgstr "غلظت رنگ (اشباع) نورها را افزایش می‌دهد."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:53
#: data/effects/frei0r/frei0r_lightgraffiti.xml:125
#, kde-format
msgid "Show brightness statistics"
msgstr "نمایش آمار روشنایی"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:55
#: data/effects/frei0r/frei0r_lightgraffiti.xml:127
#, kde-format
msgid ""
"The stats switches allow easy and accurate adjustment of the threshold parameters.<br/>\n"
"            Example: To adjust the brightness threshold, check this box and adjust the threshold until the whole light source is highlighted. Repeat the same with the other parameters. Only parts that are highlighted in <em>all</em> thresholds will count as light source."
msgstr ""
"کلیدهای آمار امکان تنظیم آسان و دقیق پارامترهای آستانه را فراهم می‌کنند.<br/>\n"
"            مثال: برای تنظیم آستانهٔ روشنایی، این کادر را علامت بزنید و آستانه را تا جایی تنظیم کنید که کل منبع نور برجسته شود. همین کار را برای سایر پارامترها تکرار کنید. تنها بخش‌هایی که در <em>همهٔ</em> آستانه‌ها برجسته شده‌اند، به‌عنوان منبع نور محاسبه می‌شوند."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:58
#: data/effects/frei0r/frei0r_lightgraffiti.xml:130
#, kde-format
msgid "Show background difference statistics"
msgstr "نمایش آمار تفاوت پس‌زمینه"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:61
#: data/effects/frei0r/frei0r_lightgraffiti.xml:133
#, kde-format
msgid "Show background difference sum statistics"
msgstr "نمایش آمار مجموع تفاوت پس‌زمینه"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:65
#: data/effects/frei0r/frei0r_lightgraffiti.xml:137
#, kde-format
msgid ""
"Makes the background transparent, allowing to apply a composite effect and "
"paint the light mask over a completely different video."
msgstr ""
"پس‌زمینه را شفاف می‌کند و امکان اعمال یک جلوهٔ ترکیبی و کشیدن ماسک نور روی "
"یک ویدیوی کاملاً متفاوت را فراهم می‌سازد."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:68
#: data/effects/frei0r/frei0r_lightgraffiti.xml:140
#, kde-format
msgid "Nonlinear dimming"
msgstr "کاهش نور غیرخطی"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:69
#: data/effects/frei0r/frei0r_lightgraffiti.xml:141
#, kde-format
msgid "If normal dimming does not look natural enough, try this one."
msgstr ""
"اگر کاهش نور عادی به اندازهٔ کافی طبیعی به نظر نمی‌رسد، این گزینه را امتحان "
"کنید."

#. i18n: ectx: property (text), widget (QPushButton, resetProxyParams)
#. i18n: ectx: property (toolTip), widget (QToolButton, buttonReset)
#: data/effects/frei0r/frei0r_lightgraffiti.xml:72
#: data/effects/frei0r/frei0r_lightgraffiti.xml:144 src/dialogs/Splash.qml:664
#: src/dialogs/Splash.qml:1051 src/layouts/layoutmanagerdialog.cpp:99
#: src/ui/configproxy_ui.ui:205 src/ui/exportguidesdialog_ui.ui:95
#, kde-format
msgid "Reset"
msgstr "بازنشانی"

#: data/effects/frei0r/frei0r_lightgraffiti.xml:73
#: data/effects/frei0r/frei0r_lightgraffiti.xml:145
#, kde-format
msgid ""
"Resets the light mask and the background image. This is necessary e.g. if "
"you apply this effect to a clip in the timeline and then move the timeline "
"cursor from outside of the clip to the middle of it. The effect receives "
"this frame in the middle as first frame and uses it as background image. For"
" proper threshold adjusting move the timeline cursor to the beginning of the"
" clip, check the Reset box and uncheck it again."
msgstr ""
"ماسک نور و تصویر پس‌زمینه را بازنشانی می‌کند. این کار برای مثال در مواردی "
"لازم است که این جلوه را روی کلیپی در خط زمان اعمال می‌کنید و سپس مکان‌نمای "
"خط زمان را از خارج از کلیپ به وسط آن می‌برید. جلوه، این فریمِ میانی را "
"به‌عنوان فریم اول دریافت کرده و از آن به‌عنوان تصویر پس‌زمینه استفاده "
"می‌کند. برای تنظیم صحیح آستانه، مکان‌نمای خط زمان را به ابتدای کلیپ ببرید، "
"گزینهٔ بازنشانی را علامت بزنید و دوباره علامتش را بردارید."

#: data/effects/frei0r/frei0r_lightgraffiti.xml:80
#, kde-format
msgid ""
"Light Graffiti effect.\n"
"        This effect allows to do Light Painting (i.e. painting with light sources on a photo by keeping the shutter\n"
"        opened for a while), but for video."
msgstr ""
"جلوهٔ گرافیتی نوری.\n"
"        این جلوه امکان نقاشی با نور (یعنی نقاشی با منابع نوری روی عکس از طریق باز نگه داشتن شاتر برای مدتی) را برای ویدیو فراهم می‌کند."

#: data/effects/frei0r/frei0r_luminance.xml:4
#, kde-format
msgctxt "Luminance Effect Name"
msgid "Luminance"
msgstr "درخشندگی"

#: data/effects/frei0r/frei0r_luminance.xml:5
#, kde-format
msgid "Creates a luminance map of the image"
msgstr "یک نقشهٔ درخشندگی از تصویر ایجاد می‌کند"

#: data/effects/frei0r/frei0r_mask0mate.xml:4
#, kde-format
msgid "Rectangular Alpha mask"
msgstr "ماسک آلفای مستطیلی"

#: data/effects/frei0r/frei0r_mask0mate.xml:5
#, kde-format
msgid "Creates an square alpha-channel mask"
msgstr "یک ماسک کانال آلفای مربعی ایجاد می‌کند"

#: data/effects/frei0r/frei0r_measure_pr0be.xml:4
#, kde-format
msgid "Video Values"
msgstr "مقادیر ویدیو"

#: data/effects/frei0r/frei0r_measure_pr0be.xml:5
#, kde-format
msgid "Measure video values"
msgstr "اندازه‌گیری مقادیر ویدیو"

#: data/effects/frei0r/frei0r_measure_pr0be.xml:8
#: data/effects/frei0r/frei0r_pr0be.xml:9
#, kde-format
msgid "Measurement"
msgstr "اندازه‌گیری"

#: data/effects/frei0r/frei0r_measure_pr0be.xml:9
#: data/effects/frei0r/frei0r_pr0be.xml:10
#, kde-format
msgid "RGB,Y'PbPr - Rec.601,Y'PbPr - Rec.709,HSV,HSL"
msgstr "RGB,Y'PbPr - Rec.601,Y'PbPr - Rec.709,HSV,HSL"

#: data/effects/frei0r/frei0r_measure_pr0be.xml:12
#: data/effects/frei0r/frei0r_pr0be.xml:13
#, kde-format
msgid "X Position"
