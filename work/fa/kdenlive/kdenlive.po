msgstr "خط تأخیر شانه (درون‌یابی خطی)"

#: data/effects/ladspa/ladspa_1887.xml:6
#, kde-format
msgid ""
"Comb Delay Line (linear interpolation) (LADSPA 1887)<br>\n"
