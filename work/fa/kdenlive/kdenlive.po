#: data/effects/avfilter/avfilter_stereo3D.xml:13
#, kde-format
msgid ""
"side by side parallel,side by side crosseye,above-below left top,above-below"
" right top,interleaved rows (left top),interleaved rows (right top),anaglyph"
" red/blue gray,anaglyph red/green gray,anaglyph red/cyan gray,anaglyph "
"red/cyan half colored,anaglyph red/cyan color,anaglyph red/cyan "
"dubois,anaglyph green/magenta gray,anaglyph green/magenta half "
"colored,anaglyph green/magenta colored,anaglyph green/magenta "
"dubois,anaglyph yellow/blue gray,anaglyph yellow/blue half colored,anaglyph "
"yellow/blue colored,anaglyph yellow/blue dubois,mono output left,mono output"
" right,checkerboard left eye first,checkerboard right eye first,interleaved "
"columns left eye first,interleaved columns right eye first,HDMI frame pack"
msgstr ""
"کنار هم موازی,کنار هم چپ‌بین,بالا-پایین چپ بالا,بالا-پایین راست بالا,سطرهای "
"درهم‌بافته (چپ بالا),سطرهای درهم‌بافته (راست بالا),آناگلیف قرمز/آبی "
"خاکستری,آناگلیف قرمز/سبز خاکستری,آناگلیف قرمز/فیروزه‌ای خاکستری,آناگلیف "
"قرمز/فیروزه‌ای نیمه‌رنگی,آناگلیف قرمز/فیروزه‌ای رنگی,آناگلیف قرمز/فیروزه‌ای "
"دوبوآ,آناگلیف سبز/ارغوانی خاکستری,آناگلیف سبز/ارغوانی نیمه‌رنگی,آناگلیف "
"سبز/ارغوانی رنگی,آناگلیف سبز/ارغوانی دوبوآ,آناگلیف زرد/آبی خاکستری,آناگلیف "
"زرد/آبی نیمه‌رنگی,آناگلیف زرد/آبی رنگی,آناگلیف زرد/آبی دوبوآ,خروجی مونو "
"چپ,خروجی مونو راست,شطرنجی اول چشم چپ,شطرنجی اول چشم راست,ستون‌های درهم‌بافته"
" اول چشم چپ,ستون‌های درهم‌بافته اول چشم راست,بسته‌بندی فریم HDMI"

#: data/effects/avfilter/avfilter_stereotools.xml:4
#, kde-format
msgid "Stereo tools"
msgstr "ابزارهای استریو"

#: data/effects/avfilter/avfilter_stereotools.xml:5
#, kde-format
msgid ""
"This filter has some handy utilities to manage stereo signals, for "
"converting M/S stereo recordings to L/R signal while having control over the"
" parameters or spreading the stereo image of master track. "
msgstr ""
"این فیلتر دارای ابزارهای مفیدی برای مدیریت سیگنال‌های استریو، جهت تبدیل "
"ضبط‌های استریوی M/S به سیگنال L/R با امکان کنترل پارامترها یا گسترش تصویر "
"استریوی ترک مستر است."

#: data/effects/avfilter/avfilter_stereotools.xml:8
#, kde-format
msgid "Level IN"
msgstr "سطح ورودی"

#: data/effects/avfilter/avfilter_stereotools.xml:10
#: data/effects/avfilter/avfilter_stereotools.xml:15
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr ""
"تنظیم سطح ورودی قبل از فیلترسازی برای هر دو کانال.\n"
"محدوده مجاز بین 0.015625 تا 64 است."

#: data/effects/avfilter/avfilter_stereotools.xml:13
#, kde-format
msgid "Level OUT"
msgstr "سطح خروجی"

#: data/effects/avfilter/avfilter_stereotools.xml:18
#: data/effects/avfilter/avfilter_stereotools.xml:79
#, kde-format
msgid "Balance IN"
msgstr "تراز ورودی"

#: data/effects/avfilter/avfilter_stereotools.xml:19
#: data/effects/avfilter/avfilter_stereotools.xml:23
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from"
" -1 to 1."
msgstr ""
"تنظیم تراز (Balance) ورودی بین هر دو کانال. مقدار پیش‌فرض 0 است. محدوده مجاز"
" از -1 تا 1 است."

#: data/effects/avfilter/avfilter_stereotools.xml:22
#: data/effects/avfilter/avfilter_stereotools.xml:89
#, kde-format
msgid "Balance OUT"
msgstr "تراز خروجی"

#: data/effects/avfilter/avfilter_stereotools.xml:26
#, kde-format
msgid "Softclip"
msgstr "برش نرم (Softclip)"

#: data/effects/avfilter/avfilter_stereotools.xml:27
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr ""
"فعال‌سازی برش نرم (Softclipping). به جای برش خشن دیجیتالی در 0dB، به اعوجاج "
"آنالوگ منجر می‌شود."

#: data/effects/avfilter/avfilter_stereotools.xml:30
#, kde-format
msgid "Mute Left"
msgstr "بی‌صدا کردن چپ"

#: data/effects/avfilter/avfilter_stereotools.xml:33
#, kde-format
msgid "Mute Right"
msgstr "بی‌صدا کردن راست"

#: data/effects/avfilter/avfilter_stereotools.xml:36
#, kde-format
msgid "Phase Left"
msgstr "فاز چپ"

#: data/effects/avfilter/avfilter_stereotools.xml:37
#, kde-format
msgid "Change the phase of the left channel."
msgstr "تغییر فاز کانال چپ."

#: data/effects/avfilter/avfilter_stereotools.xml:40
#, kde-format
msgid "Phase Right"
msgstr "فاز راست"

#: data/effects/avfilter/avfilter_stereotools.xml:41
#, kde-format
msgid "Change the phase of the right channel."
msgstr "تغییر فاز کانال راست."

#: data/effects/avfilter/avfilter_stereotools.xml:44
#: data/effects/ladspa/ladspa_2153.xml:21
#, kde-format
msgid "Stereo Mode"
msgstr "حالت استریو"

#: data/effects/avfilter/avfilter_stereotools.xml:45
#, kde-format
msgid ""
"Left/Right to Left/Right,Left/Right to Mid/Side,Mid/Side to "
"Left/Right,Left/Right to Left/Left,Left/Right to Right/Right,Left/Right to "
"Left + Right,Left/Right to Right/Left,Mid/Side to Left/Left,Mid/Side to "
"Right/Right,Mid/Side to Right/Left,Left/Right to Left - Right"
msgstr ""
"چپ/راست به چپ/راست,چپ/راست به میانه/کنار,میانه/کنار به چپ/راست,چپ/راست به "
"چپ/چپ,چپ/راست به راست/راست,چپ/راست به چپ + راست,چپ/راست به "
"راست/چپ,میانه/کنار به چپ/چپ,میانه/کنار به راست/راست,میانه/کنار به "
"راست/چپ,چپ/راست به چپ - راست"

#: data/effects/avfilter/avfilter_stereotools.xml:48
#, kde-format
msgid "Side Level"
msgstr "سطح سیگنال جانبی"

#: data/effects/avfilter/avfilter_stereotools.xml:49
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to "
"64."
msgstr ""
"تنظیم سطح سیگنال جانبی (Side). پیش‌فرض ۱ است. محدوده مجاز از ۰٫۰۱۵۶۲۵ تا ۶۴ "
"است."

#: data/effects/avfilter/avfilter_stereotools.xml:52
#, kde-format
msgid "Side Balance"
msgstr "تراز سیگنال جانبی"

#: data/effects/avfilter/avfilter_stereotools.xml:53
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"تنظیم تراز سیگنال کناری (Side). پیش‌فرض 0 است. محدوده مجاز از -1 تا 1 است."

#: data/effects/avfilter/avfilter_stereotools.xml:56
#, kde-format
msgid "Mid Level"
msgstr "سطح میانی (Mid)"

#: data/effects/avfilter/avfilter_stereotools.xml:57
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625"
" to 64."
msgstr ""
"تنظیم سطح سیگنال میانی. پیش‌فرض 1 است. محدوده مجاز از 0.015625 تا 64 است."

#: data/effects/avfilter/avfilter_stereotools.xml:60
#, kde-format
msgid "Mid Pan"
msgstr "پان میانی (Mid)"

#: data/effects/avfilter/avfilter_stereotools.xml:61
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr "تنظیم پان سیگنال میانی. پیش‌فرض 0 است. محدوده مجاز از -1 تا 1 است."

#: data/effects/avfilter/avfilter_stereotools.xml:64
#, kde-format
msgid "Stereo base"
msgstr "پایه استریو"

#: data/effects/avfilter/avfilter_stereotools.xml:65
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr ""
"تنظیم پایه استریو بین کانال‌های مونو و معکوس. پیش‌فرض 0 است. محدوده مجاز از "
"-1 تا 1 است."

#: data/effects/avfilter/avfilter_stereotools.xml:69
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice"
" versa. Default is 0. Allowed range is from -20 to 20."
msgstr ""
"تنظیم تاخیر به میلی‌ثانیه برای میزان تاخیر کانال چپ نسبت به راست و بالعکس. "
"پیش‌فرض 0 است. محدوده مجاز از -20 تا 20 است."

#: data/effects/avfilter/avfilter_stereotools.xml:72
#, kde-format
msgid "S/C level"
msgstr "سطح S/C"

#: data/effects/avfilter/avfilter_stereotools.xml:75
#, kde-format
msgid "Stereo phase"
msgstr "فاز استریو"

#: data/effects/avfilter/avfilter_stereotools.xml:76
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "تنظیم فاز استریو بر حسب درجه."

#: data/effects/avfilter/avfilter_stereotools.xml:85
#: data/effects/avfilter/avfilter_stereotools.xml:95
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to 1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr ""
"‘balance’\n"
"حالت تعادل کلاسیک. تضعیف یک کانال در هر زمان. بهره تا ۱ افزایش می‌یابد.\n"
"‘amplitude’\n"
"مشابه حالت کلاسیک بالا اما بهره تا ۲ افزایش می‌یابد.\n"
"‘power’\n"
"توزیع توان یکنواخت، در محدودهٔ -6dB تا +6dB."

#: data/effects/avfilter/avfilter_stereotools.xml:86
#: data/effects/avfilter/avfilter_stereotools.xml:96
#, kde-format
msgid "balance,amplitude,power"
msgstr "balance,amplitude,power"

#: data/effects/avfilter/avfilter_stereowiden.xml:4
#, kde-format
msgid "Stereo widener"
msgstr "عریض‌کنندهٔ استریو"

#: data/effects/avfilter/avfilter_stereowiden.xml:5
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr ""
"این فیلتر با تضعیف سیگنال مشترک بین دو کانال و با تأخیر انداختن سیگنال چپ در"
" راست و بالعکس، جلوهٔ استریو را بهبود داده و در نتیجه گسترهٔ استریو را "
"عریض‌تر می‌کند."

#: data/effects/avfilter/avfilter_stereowiden.xml:9
#, kde-format
msgid ""
"Time in milliseconds of the delay of left signal into right and vice versa."
msgstr "مدت‌زمان تأخیر سیگنال چپ در راست و بالعکس بر حسب میلی‌ثانیه."

#: data/effects/avfilter/avfilter_stereowiden.xml:12
#, kde-format
msgid "Feedback Gain"
msgstr "بهرهٔ بازخورد"

#: data/effects/avfilter/avfilter_stereowiden.xml:14
#, kde-format
msgid ""
"Amount of gain in delayed signal into right and vice versa.\n"
"Gives a delay effect of left signal in right output and vice versa which gives widening effect."
msgstr ""
"میزان بهره در سیگنال با‌تأخیر به کانال راست و بالعکس.\n"
"جلوهٔ تأخیری از سیگنال چپ در خروجی راست و بالعکس ایجاد می‌کند که باعث عریض‌تر شدن صدا می‌شود."

#: data/effects/avfilter/avfilter_stereowiden.xml:17
#, kde-format
msgid "Cross feed"
msgstr "تغذیه متقاطع (Cross feed)"

#: data/effects/avfilter/avfilter_stereowiden.xml:19
#, kde-format
msgid ""
"Cross feed of left into right with inverted phase. This helps in suppressing the mono.\n"
"If the value is 1 it will cancel all the signal common to both channels. "
msgstr ""
"تغذیهٔ متقاطع کانال چپ در راست با فاز معکوس. این قابلیت به تضعیف حالت مونو کمک می‌کند.\n"
"اگر مقدار ۱ باشد، تمام سیگنال‌های مشترک بین دو کانال خنثی می‌شوند."

#: data/effects/avfilter/avfilter_stereowiden.xml:22
#, kde-format
msgid "Drymix"
msgstr "میکس خشک (Drymix)"

#: data/effects/avfilter/avfilter_stereowiden.xml:23
#, kde-format
msgid "Set level of input signal of original channel."
msgstr "تنظیم سطح سیگنال ورودی کانال اصلی."

#: data/effects/avfilter/avfilter_swapuv.xml:4
#, kde-format
msgid "Swap UV"
msgstr "جابه‌جایی UV"

#: data/effects/avfilter/avfilter_swapuv.xml:5
#, kde-format
msgid "Swap U and V components"
msgstr "جابه‌جایی مؤلفه‌های U و V"

#: data/effects/avfilter/avfilter_tmix.xml:4
#, kde-format
msgid "Temporal frames Mixer"
msgstr "میکسر فریم‌های زمانی"

#: data/effects/avfilter/avfilter_tmix.xml:5
#, kde-format
msgid "Mix successive video frames"
msgstr "میکس فریم‌های متوالی ویدیو"

#: data/effects/avfilter/avfilter_tmix.xml:8
#, kde-format
msgid "Frames to mix"
msgstr "فریم‌ها برای میکس"

#: data/effects/avfilter/avfilter_transpose.xml:4
#, kde-format
msgid "Transpose"
msgstr "ترانهش (Transpose)"

#: data/effects/avfilter/avfilter_transpose.xml:5
#, kde-format
msgid "Transpose rows with columns in the input video and optionally flip it"
msgstr "جابه‌جایی سطرها با ستون‌ها در ویدیوی ورودی و برگرداندن اختیاری آن"

#: data/effects/avfilter/avfilter_transpose.xml:9
#, kde-format
msgid "Clock,Clock flip,Counter clock,Counter clock flip"
msgstr "ساعت‌گرد,ساعت‌گرد با بازتاب,پادساعت‌گرد,پادساعت‌گرد با بازتاب"

#: data/effects/avfilter/avfilter_transpose.xml:12
#, kde-format
msgid "Override if"
msgstr "جایگزینی در صورت"

#: data/effects/avfilter/avfilter_transpose.xml:13
#, kde-format
msgid "None,Portrait,Landscape"
msgstr "هیچ‌کدام،عمودی،افقی"

#: data/effects/avfilter/avfilter_unsharp.xml:5
#, kde-format
msgid "Sharp/Unsharp"
msgstr "واضح/مات"

#: data/effects/avfilter/avfilter_unsharp.xml:6
#, kde-format
msgid "Sharpen or unsharpen/blur your video"
msgstr "واضح کردن یا مات کردن/تار کردن ویدیو"

#: data/effects/avfilter/avfilter_unsharp.xml:9
#, kde-format
msgid "Luma horizontal matrix"
msgstr "ماتریس افقی روشنایی (Luma)"

#: data/effects/avfilter/avfilter_unsharp.xml:10
#, kde-format
msgid "Set the luma matrix horizontal size"
msgstr "تنظیم اندازهٔ افقی ماتریس روشنایی"

#: data/effects/avfilter/avfilter_unsharp.xml:13
#, kde-format
msgid "Luma vertical matrix"
msgstr "ماتریس عمودی روشنایی (Luma)"

#: data/effects/avfilter/avfilter_unsharp.xml:14
#, kde-format
msgid "Set the luma matrix vertical size"
msgstr "تنظیم اندازهٔ عمودی ماتریس روشنایی"

#: data/effects/avfilter/avfilter_unsharp.xml:19
#, kde-format
msgid ""
"Set the luma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will blur the input video, while positive values will sharpen it, a value of 0 will disable the effect. "
msgstr ""
"تنظیم شدت جلوهٔ روشنایی.<br>\n"
"            مقادیر منطقی بین -1.5 و 1.5 هستند. مقادیر منفی ویدیوی ورودی را مات می‌کنند، در حالی که مقادیر مثبت آن را واضح‌تر می‌کنند، و مقدار 0 این جلوه را غیرفعال می‌کند. "

#: data/effects/avfilter/avfilter_unsharp.xml:22
#, kde-format
msgid "Chroma horizontal matrix"
msgstr "ماتریس افقی رنگ (Chroma)"

#: data/effects/avfilter/avfilter_unsharp.xml:23
#, kde-format
msgid "Set the chroma matrix horizontal size"
msgstr "تنظیم اندازهٔ افقی ماتریس کروما"

#: data/effects/avfilter/avfilter_unsharp.xml:26
#, kde-format
msgid "Chroma vertical matrix"
msgstr "ماتریس عمودی کروما"

#: data/effects/avfilter/avfilter_unsharp.xml:27
#, kde-format
msgid "Set the chroma matrix vertical size"
msgstr "تنظیم اندازهٔ عمودی ماتریس کروما"

#: data/effects/avfilter/avfilter_unsharp.xml:32
#, kde-format
msgid ""
"Set the chroma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will blur the input video, while positive values will sharpen it, a value of zero will disable the effect. "
msgstr ""
"تنظیم شدت جلوهٔ کروما.<br>\n"
"            مقادیر معقول بین ۱٫۵- تا ۱٫۵ هستند. مقادیر منفی ویدئوی ورودی را تار و مقادیر مثبت آن را واضح‌تر می‌کنند؛ مقدار صفر جلوه را غیرفعال می‌کند."

#: data/effects/avfilter/avfilter_unsharp.xml:35
#, kde-format
msgid "Alpha horizontal matrix"
msgstr "ماتریس افقی آلفا"

#: data/effects/avfilter/avfilter_unsharp.xml:36
#, kde-format
msgid "Set the alpha matrix horizontal size"
msgstr "تنظیم اندازهٔ افقی ماتریس آلفا"

#: data/effects/avfilter/avfilter_unsharp.xml:39
#, kde-format
msgid "Alpha vertical matrix"
msgstr "ماتریس عمودی آلفا"

#: data/effects/avfilter/avfilter_unsharp.xml:40
#, kde-format
msgid "Set the alpha matrix vertical size"
msgstr "تنظیم اندازهٔ عمودی ماتریس آلفا"

#: data/effects/avfilter/avfilter_unsharp.xml:45
#, kde-format
msgid ""
"Set the alpha effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will blur the input video, while positive values will sharpen it, a value of zero will disable the effect. "
msgstr ""
"تنظیم شدت جلوهٔ آلفا.<br>\n"
"            مقادیر معقول بین ۱٫۵- تا ۱٫۵ هستند. مقادیر منفی ویدئوی ورودی را تار و مقادیر مثبت آن را واضح‌تر می‌کنند؛ مقدار صفر جلوه را غیرفعال می‌کند."

#: data/effects/avfilter/avfilter_vaguedenoiser.xml:4
#, kde-format
msgid "Wavelet Denoiser"
msgstr "نویزگیر موجک"

#: data/effects/avfilter/avfilter_vaguedenoiser.xml:6
#, kde-format
msgid ""
"Wavelet based denoiser.<br>\n"
"    It transforms each frame from the video input into the wavelet domain, using Cohen-Daubechies-Feauveau 9/7."
msgstr ""
"نویزگیر مبتنی بر موجک.<br>\n"
"    این فیلتر هر فریم از ورودی ویدیو را با استفاده از Cohen-Daubechies-Feauveau 9/7 به حوزهٔ موجک تبدیل می‌کند."

#: data/effects/avfilter/avfilter_vaguedenoiser.xml:10
#, kde-format
msgid "Hard,Soft,Garrote"
msgstr "سخت,نرم,گاروت"

#: data/effects/avfilter/avfilter_vaguedenoiser.xml:13
#, kde-format
msgid "Threshold Type"
msgstr "نوع آستانه"

#: data/effects/avfilter/avfilter_vaguedenoiser.xml:14
#, kde-format
msgid "Universal,Bayes"
msgstr "جهانی,بیزین"

#: data/effects/avfilter/avfilter_vaguedenoiser.xml:23
#: src/jobs/speedtask.cpp:69
#, kde-format
msgid "Percentage"
msgstr "درصد"

