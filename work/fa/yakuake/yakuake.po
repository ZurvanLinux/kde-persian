#. i18n: ectx: whatsthis, entry (KeepAbove), group (Window)
#: app/config/yakuake.kcfg:56
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Whether to keep the application window above other windows on the screen."
msgstr ""
"اینکه آیا پنجره برنامه بالاتر از سایر پنجره‌ها در صفحه نگه داشته شود یا خیر."

#. i18n: ectx: label, entry (ShowTitleBar), group (Window)
#: app/config/yakuake.kcfg:60
#, kde-format
msgctxt "@label"
msgid "Show title bar"
msgstr "نمایش نوار عنوان"

#. i18n: ectx: whatsthis, entry (ShowTitleBar), group (Window)
#: app/config/yakuake.kcfg:61
#, kde-format
msgctxt "@info:whatsthis"
msgid "Whether to show the title bar in the application window."
msgstr "اینکه آیا نوار عنوان در پنجره برنامه نمایش داده شود یا خیر."

#. i18n: ectx: label, entry (ShowTabBar), group (Window)
#: app/config/yakuake.kcfg:65
#, kde-format
msgctxt "@label"
msgid "Show tab bar"
msgstr "نمایش نوار برگه"

#. i18n: ectx: whatsthis, entry (ShowTabBar), group (Window)
#: app/config/yakuake.kcfg:66
#, kde-format
msgctxt "@info:whatsthis"
msgid "Whether to show the tab bar in the application window."
msgstr "اینکه آیا نوار برگه در پنجره برنامه نمایش داده شود یا خیر."

#. i18n: ectx: label, entry (DynamicTabTitles), group (Window)
#: app/config/yakuake.kcfg:70
#, kde-format
msgctxt "@label"
msgid "Dynamic tab titles"
msgstr "عناوین پویای برگه‌ها"

#. i18n: ectx: whatsthis, entry (DynamicTabTitles), group (Window)
#: app/config/yakuake.kcfg:71
#, kde-format
msgctxt "@info:whatsthis"
msgid "Whether to update tab titles along with the title bar."
msgstr ""
"اینکه آیا عناوین برگه‌ها هم‌گام با نوار عنوان به‌روزرسانی شوند یا خیر."

#. i18n: ectx: label, entry (ShowSystrayIcon), group (Window)
#: app/config/yakuake.kcfg:75
#, kde-format
msgctxt "@label"
msgid "Show a system tray icon"
msgstr "نمایش نشانک در سینی سیستم"

#. i18n: ectx: whatsthis, entry (ShowSystrayIcon), group (Window)
#: app/config/yakuake.kcfg:76
#, kde-format
msgctxt "@info:whatsthis"
msgid "Whether to show a system tray icon."
msgstr "این که آیا نشانکی در سینی سیستم نمایش داده شود یا خیر."

#. i18n: ectx: label, entry (FocusFollowsMouse), group (Behavior)
#: app/config/yakuake.kcfg:82
#, kde-format
msgctxt "@label"
msgid "Focus follows mouse"
msgstr "تمرکز با حرکت موشی"

#. i18n: ectx: whatsthis, entry (FocusFollowsMouse), group (Behavior)
#: app/config/yakuake.kcfg:83
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Whether an individual terminal in a session will be given focus when the "
"mouse pointer is moved above it."
msgstr ""
"این که آیا هنگام بردن نشانگر موشی روی یک پایانهٔ مشخص در یک نشست، به آن "
"تمرکز داده شود یا خیر."

#. i18n: ectx: label, entry (OpenAfterStart), group (Behavior)
#: app/config/yakuake.kcfg:87
#, kde-format
msgctxt "@label"
msgid "Open after start"
msgstr "باز کردن پس از آغاز"

#. i18n: ectx: whatsthis, entry (OpenAfterStart), group (Behavior)
#: app/config/yakuake.kcfg:88
#, kde-format
msgctxt "@info:whatsthis"
msgid "Whether the application window should be opened after program start."
msgstr "این که آیا پنجرهٔ برنامه پس از آغاز برنامه باز شود یا خیر."

#. i18n: ectx: label, entry (RememberFullscreen), group (Behavior)
#: app/config/yakuake.kcfg:92
#, kde-format
msgctxt "@label"
msgid "Remember window fullscreen state"
msgstr "به‌خاطرسپاری وضعیت تمام‌صفحهٔ پنجره"

#. i18n: ectx: whatsthis, entry (RememberFullscreen), group (Behavior)
#: app/config/yakuake.kcfg:93
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Whether the window will be shown fullscreen again when it has been "
"previously."
msgstr ""
"این که آیا پنجره در صورتی که پیش‌تر تمام‌صفحه بوده، دوباره تمام‌صفحه نشان "
"داده شود یا خیر."

#. i18n: ectx: label, entry (Skin), group (Appearance)
#: app/config/yakuake.kcfg:99
#, kde-format
msgctxt "@label"
