#: data/org.kde.yakuake.desktop:2
msgctxt "Name"
msgid "Yakuake"
msgstr "یاکوآکه"

#: data/org.kde.yakuake.desktop:66
msgctxt "GenericName"
msgid "Drop-down Terminal"
msgstr "پایانهٔ کشویی"

#: data/org.kde.yakuake.desktop:130
msgctxt "Comment"
msgid "A drop-down terminal emulator based on KDE Konsole technology."
msgstr "یک شبیه‌ساز پایانهٔ کشویی مبتنی بر فناوری Konsole کی‌دی‌ای."

#: data/yakuake.notifyrc:4
msgctxt "Comment"
msgid "Yakuake"
msgstr "یاکوآکه"

#: data/yakuake.notifyrc:63
msgctxt "Name"
msgid "Silence detected"
msgstr "سکوت شناسایی شد"

#: data/yakuake.notifyrc:119
msgctxt "Comment"
msgid "Silence detected in a monitored terminal or session"
msgstr "سکوت در یک پایانه یا نشستِ تحت نظارت شناسایی شد"

#: data/yakuake.notifyrc:177
msgctxt "Name"
msgid "Activity detected"
msgstr "فعالیت شناسایی شد"

#: data/yakuake.notifyrc:233
msgctxt "Comment"
msgid "Activity detected in a monitored terminal or session"
msgstr "فعالیت در یک پایانه یا نشستِ تحت نظارت شناسایی شد"

#: data/yakuake.notifyrc:291
msgctxt "Name"
msgid "Bell in Visible Session"
msgstr "زنگ در نشست نمایان"

#: data/yakuake.notifyrc:348
msgctxt "Comment"
msgid "Bell emitted within a visible session"
msgstr "صدای زنگ در یک نشست نمایان منتشر شد"

#: data/yakuake.notifyrc:408
msgctxt "Name"
msgid "Bell in Non-Visible Session"
msgstr "زنگ در نشست غیرقابل‌مشاهده"

#: data/yakuake.notifyrc:465
msgctxt "Comment"
msgid "Bell emitted within a non-visible session"
msgstr "پخش زنگ در یک نشست غیرقابل‌مشاهده"
