#: qml/ConfigurationDialog.qml:95
msgid "Hotspot name must not be empty"
msgstr "نام نقطهٔ اتصال نباید خالی باشد"

#: qml/ConfigurationDialog.qml:105
msgid ""
"Hotspot password must either be empty or consist of anywhere from 8 up to 64"
" characters"
msgstr "گذرواژهٔ نقطهٔ اتصال باید یا خالی باشد یا شامل ۸ تا ۶۴ نویسه باشد"

#: qml/ConfigurationDialog.qml:106
msgid ""
"Hotspot password must either be empty or consist of one of the "
"following:<ul><li>Exactly 5 or 13 any characters</li><li>Exactly 10 or 26 "
"hexadecimal characters:<br/>abcdef, ABCDEF or 0-9</li></ul>"
msgstr ""
"گذرواژهٔ نقطهٔ اتصال باید خالی باشد یا شامل یکی از موارد زیر "
"باشد:<ul><li>دقیقاً ۵ یا ۱۳ نویسه از هر نوع</li><li>دقیقاً ۱۰ یا ۲۶ نویسهٔ "
"هگزادسیمال:<br/>abcdef، ABCDEF یا 0-9</li></ul>"

