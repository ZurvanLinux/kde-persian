#. i18n: ectx: property (title), widget (QGroupBox, grp_authenfication)
#: pptpadvanced.ui:17
#, kde-format
msgid "Authentication"
msgstr "احراز هویت"

#. i18n: ectx: property (text), widget (QLabel, lbl_auth)
#: pptpadvanced.ui:26
#, kde-format
msgid "Allow following authentication methods:"
msgstr "اجازه به روش‌های احراز هویت زیر:"

#. i18n: ectx: property (toolTip), widget (QListWidget, listWidget)
#: pptpadvanced.ui:36
#, kde-format
msgid "Allow/disable authentication methods."
msgstr "مجاز/غیرفعال کردن روش‌های احراز هویت."

#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#: pptpadvanced.ui:40
#, kde-format
msgid "PAP"
msgstr "PAP"

#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#: pptpadvanced.ui:48
#, kde-format
msgid "CHAP"
msgstr "CHAP"

#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#: pptpadvanced.ui:56
#, kde-format
msgid "MSCHAP"
msgstr "MSCHAP"

#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#: pptpadvanced.ui:64
#, kde-format
msgid "MSCHAPv2"
msgstr "MSCHAPv2"

#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#: pptpadvanced.ui:72
#, kde-format
msgid "EAP"
msgstr "EAP"

#. i18n: ectx: property (toolTip), widget (QGroupBox, gb_MPPE)
#: pptpadvanced.ui:88
#, kde-format
msgid ""
"Note: MPPE encryption is only available with MSCHAP authentication methods. To\n"
"enable this checkbox, select one or more of the MSCHAP authentication\n"
"methods: MSCHAP or MSCHAPv2."
msgstr ""
"نکته: رمزنگاری MPPE فقط با روش‌های احراز هویت MSCHAP در دسترس است. برای\n"
"فعال کردن این جعبهٔ انتخاب، یک یا چند مورد از روش‌های احراز هویت MSCHAP را\n"
"انتخاب کنید: MSCHAP یا MSCHAPv2."

#. i18n: ectx: property (title), widget (QGroupBox, gb_MPPE)
#: pptpadvanced.ui:91
#, kde-format
msgid "Use MPPE Encryption"
msgstr "استفاده از رمزنگاری MPPE"

#. i18n: ectx: property (text), widget (QLabel, lbl_MMPEcrypto)
#: pptpadvanced.ui:112
#, kde-format
msgid "Crypto:"
msgstr "رمزنگاری:"

#. i18n: ectx: property (toolTip), widget (QComboBox, cb_MPPECrypto)
#: pptpadvanced.ui:128
#, kde-format
msgid "Require the use of MPPE, with 40/128-bit encryption or all."
msgstr "الزام به استفاده از MPPE، با رمزنگاری ۴۰/۱۲۸ بیتی یا همه."

#. i18n: ectx: property (text), item, widget (QComboBox, cb_MPPECrypto)
#: pptpadvanced.ui:132
#, kde-format
msgctxt "like in use Any configuration"
msgid "Any"
msgstr "هرکدام"

#. i18n: ectx: property (text), item, widget (QComboBox, cb_MPPECrypto)
#: pptpadvanced.ui:137
#, kde-format
msgid "128 bit"
msgstr "۱۲۸ بیت"

#. i18n: ectx: property (text), item, widget (QComboBox, cb_MPPECrypto)
#: pptpadvanced.ui:142
#, kde-format
msgid "40 bit"
msgstr "۴۰ بیت"

#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_statefulEncryption)
#: pptpadvanced.ui:150
#, kde-format
msgid ""
"Allow MPPE to use stateful mode. Stateless mode is still attempted first."
msgstr ""
"اجازه به MPPE برای استفاده از حالت باوضعیت. ابتدا همچنان برای حالت "
"بدون‌وضعیت تلاش می‌شود."

#. i18n: ectx: property (text), widget (QCheckBox, cb_statefulEncryption)
#: pptpadvanced.ui:153
#, kde-format
msgid "Use stateful encryption"
msgstr "استفاده از رمزنگاری باوضعیت"

#. i18n: ectx: property (title), widget (QGroupBox, grp_cryptoAndCompression)
#: pptpadvanced.ui:163
#, kde-format
msgid "Compression"
msgstr "فشرده‌سازی"

#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_BSD)
#: pptpadvanced.ui:175
#, kde-format
msgid "Allow/disable BSD-Compress compression."
msgstr "مجاز/غیرفعال کردن فشرده‌سازی BSD-Compress."

#. i18n: ectx: property (text), widget (QCheckBox, cb_BSD)
#: pptpadvanced.ui:178
#, kde-format
msgid "Allow BSD compression"
msgstr "اجازه به فشرده‌سازی BSD"

#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_deflate)
#: pptpadvanced.ui:188
#, kde-format
msgid "Allow/disable Deflate compression."
msgstr "مجاز/غیرفعال کردن فشرده‌سازی Deflate."

#. i18n: ectx: property (text), widget (QCheckBox, cb_deflate)
#: pptpadvanced.ui:191
#, kde-format
msgid "Allow Deflate compression"
msgstr "اجازه به فشرده‌سازی Deflate"

#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_TCPheaders)
#: pptpadvanced.ui:202
#, kde-format
msgid ""
"Allow/disable Van Jacobson style TCP/IP header compression in both the transmit\n"
" and the receive directions."
msgstr ""
"مجاز/غیرفعال کردن فشرده‌سازی سرآیند TCP/IP به سبک ون جاکوبسون در هر دو جهت\n"
" ارسال و دریافت."

#. i18n: ectx: property (text), widget (QCheckBox, cb_TCPheaders)
#: pptpadvanced.ui:205
#, kde-format
msgid "Allow TCP header compression"
msgstr "اجازه به فشرده‌سازی سرآیند TCP"

#. i18n: ectx: property (title), widget (QGroupBox, grp_echo)
#: pptpadvanced.ui:218
#, kde-format
msgid "Echo"
msgstr "پژواک"

#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_sendEcho)
#: pptpadvanced.ui:227
#, kde-format
msgid "Send LCP echo-requests to find out whether peer is alive."
msgstr "ارسال درخواست‌های پژواک LCP برای بررسی فعال بودن همتا."

#. i18n: ectx: property (text), widget (QCheckBox, cb_sendEcho)
#: pptpadvanced.ui:230
#, kde-format
msgid "Send PPP echo packets "
msgstr "ارسال بسته‌های پژواک PPP "

#. i18n: ectx: property (windowTitle), widget (QWidget,
#. PptpAuthenticationWidget)
#: pptpauth.ui:14
#, kde-format
msgid "PPTPAuthentication"
msgstr "احراز هویت PPTP"

#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#. i18n: ectx: property (text), widget (QLabel, lbl_password)
#: pptpauth.ui:38 pptpprop.ui:115
#, kde-format
msgid "Password:"
msgstr "گذرواژه:"

#. i18n: ectx: property (toolTip), widget (PasswordField, lePassword)
#. i18n: ectx: property (toolTip), widget (PasswordField, edt_password)
#: pptpauth.ui:51 pptpprop.ui:131
#, kde-format
msgid "Password passed to PPTP when prompted for it."
msgstr "گذرواژه‌ای که هنگام درخواست به PPTP فرستاده می‌شود."

#. i18n: ectx: property (windowTitle), widget (QWidget, PptpProp)
#: pptpprop.ui:14
#, kde-format
msgid "PPTP Settings"
msgstr "تنظیمات PPTP"

#. i18n: ectx: property (title), widget (QGroupBox, grp_general)
#: pptpprop.ui:26
#, kde-format
msgctxt "like in General settings"
msgid "General"
msgstr "عمومی"

#. i18n: ectx: property (text), widget (QLabel, lbl_gateway)
#: pptpprop.ui:34
#, kde-format
msgid "Gateway:"
msgstr "درگاه:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, edt_gateway)
#: pptpprop.ui:47
#, kde-format
msgid "PPTP server IP or name."
msgstr "نشانی IP یا نام کارساز PPTP."

#. i18n: ectx: property (title), widget (QGroupBox, grp_additional)
#: pptpprop.ui:62
#, kde-format
msgctxt "like in Additional settings"
msgid "Additional"
msgstr "تکمیلی"

#. i18n: ectx: property (text), widget (QLabel, lbl_login)
#: pptpprop.ui:80
#, kde-format
msgid "Login:"
msgstr "ورود:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, edt_login)
#: pptpprop.ui:93
#, kde-format
msgid ""
"Set the name used for authenticating the local system to the peer to <name>."
msgstr ""
"تنظیم نام مورد استفاده برای احراز هویت سامانهٔ محلی نزد همتا به <name>."

#. i18n: ectx: property (text), widget (QLabel, lbl_ntdomain)
#: pptpprop.ui:153
#, kde-format
msgid "NT Domain:"
msgstr "دامنهٔ NT:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, edt_ntDomain)
#: pptpprop.ui:167
#, kde-format
msgid ""
"Append the domain name <domain> to the local host name for\n"
"authenticating purposes."
msgstr ""
"افزودن نام دامنهٔ <domain> به نام میزبان محلی به منظور\n"
"احراز هویت."

#. i18n: ectx: property (text), widget (QPushButton, btnAdvanced)
#: pptpprop.ui:192
#, kde-format
msgctxt "like in Advanced settings"
msgid "Advanced…"
msgstr "پیشرفته…"
