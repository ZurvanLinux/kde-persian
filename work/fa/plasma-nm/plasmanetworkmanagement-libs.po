#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: editor/settings/ui/wireguardinterfacewidget.ui:20
#: editorqml/qml/vpn/wireguard/Wireguard.qml:31
#, kde-format
msgid "Interface"
msgstr "رابط"

#. i18n: ectx: property (toolTip), widget (QLineEdit, interfaceNameLineEdit)
#: editor/settings/ui/wireguardinterfacewidget.ui:34
#, kde-format
msgid ""
"Required.\n"
"Network interface name."
msgstr ""
"الزامی.\n"
"نام رابط شبکه."

#. i18n: ectx: property (toolTip), widget (PasswordField, privateKeyLineEdit)
#: editor/settings/ui/wireguardinterfacewidget.ui:49
#, kde-format
msgid ""
"Required.\n"
"A base64 private key generated by wg genkey."
msgstr ""
"الزامی.\n"
"یک کلید خصوصی base64 تولیدشده توسط wg genkey."

#. i18n: ectx: property (text), widget (QLabel, listenPortLabel)
#: editor/settings/ui/wireguardinterfacewidget.ui:56
#, kde-format
msgid "Listen port:"
msgstr "درگاه شنود:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, listenPortLineEdit)
#: editor/settings/ui/wireguardinterfacewidget.ui:64
#, kde-format
msgid ""
"Optional.\n"
"Listen port number. Chosen randomly if left as 'Automatic'."
msgstr ""
"اختیاری.\n"
"شمارهٔ درگاه شنود. در صورت باقی ماندن روی «خودکار»، به‌طور تصادفی انتخاب می‌شود."

#. i18n: ectx: property (text), widget (QLabel, fwmarkLabel)
#: editor/settings/ui/wireguardinterfacewidget.ui:72
#: editorqml/qml/vpn/wireguard/Wireguard.qml:88
#, kde-format
msgid "fwmark:"
msgstr "fwmark:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, fwmarkLineEdit)
#: editor/settings/ui/wireguardinterfacewidget.ui:82
#, kde-format
msgid ""
"Optional.\n"
"An fwmark for outgoing packets. If set to 0 or 'off', this\n"
"option is disabled. May be specified in hexadecimal by\n"
"prepending '0x'."
msgstr ""
"اختیاری.\n"
"یک fwmark برای بسته‌های خروجی. در صورت تنظیم روی 0 یا «off»، این\n"
"گزینه غیرفعال می‌شود. می‌تواند با افزودن پیشوند «0x» به‌صورت\n"
"هگزادسیمال مشخص شود."

#. i18n: ectx: property (toolTip), widget (QLineEdit, mtuLineEdit)
#: editor/settings/ui/wireguardinterfacewidget.ui:101
#, kde-format
msgid ""
"Optional.\n"
"If not specified, the MTU is automatically determined\n"
"from the endpoint addresses or the system default route,\n"
"which is usually a sane choice. However, to manually\n"
"specify an MTU and to override this automatic discovery,\n"
"this value may be specified explicitly."
msgstr ""
"اختیاری.\n"
"در صورت تعیین نشدن، MTU به‌طور خودکار از نشانی‌های نقطهٔ پایانی\n"
"یا مسیر پیش‌فرض سامانه تعیین می‌شود که معمولاً انتخابی معقول است.\n"
"با این حال، برای تعیین دستی MTU و نادیده‌گرفتن این شناسایی خودکار،\n"
"این مقدار می‌تواند به‌صراحت مشخص شود."

#. i18n: ectx: property (text), widget (QLabel, peerRouteLabel)
#: editor/settings/ui/wireguardinterfacewidget.ui:108
#, kde-format
msgid "Autoroute peers:"
msgstr "مسیریابی خودکار همتایان:"

#. i18n: ectx: property (toolTip), widget (QCheckBox, peerRouteCheckBox)
#: editor/settings/ui/wireguardinterfacewidget.ui:116
#, kde-format
msgid ""
"Whether to automatically add routes for the AllowedIPs ranges\n"
"of the peers."
msgstr ""
"این‌که آیا مسیرها برای محدوده‌های AllowedIPs همتایان به‌طور خودکار اضافه "
"شوند یا خیر."

#. i18n: ectx: property (text), widget (QPushButton, btnPeers)
#: editor/settings/ui/wireguardinterfacewidget.ui:141
#, kde-format
msgid "Peers…"
msgstr "همتایان…"

#. i18n: ectx: property (text), widget (QLabel, publicKeyLabel)
#: editor/settings/ui/wireguardpeerwidget.ui:17
#: editorqml/qml/vpn/wireguard/WireguardPeers.qml:19
#, kde-format
msgid "Public key:"
msgstr "کلید عمومی:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, publicKeyLineEdit)
#: editor/settings/ui/wireguardpeerwidget.ui:27
#, kde-format
msgid ""
"Required.\n"
"            A base64 public key calculated by wg pubkey \n"
"            from a private key, and usually transmitted \n"
"            out of band to the author of the configuration file."
msgstr ""
"الزامی.\n"
"یک کلید عمومی base64 محاسبه‌شده توسط wg pubkey از\n"
"یک کلید خصوصی، که معمولاً به‌صورت خارج از باند برای\n"
"پدیدآورندهٔ پروندهٔ پیکربندی ارسال می‌شود."

#. i18n: ectx: property (text), widget (QLabel, allowedIPsLabel)
#: editor/settings/ui/wireguardpeerwidget.ui:34
#: editorqml/qml/vpn/wireguard/WireguardPeers.qml:20
#, kde-format
msgid "Allowed IPs:"
msgstr "IPهای مجاز:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, allowedIPsLineEdit)
#: editor/settings/ui/wireguardpeerwidget.ui:47
#, kde-format
msgid ""
"Required.\n"
"            A comma-separated list of IP (v4 or v6) addresses \n"
"            with CIDR masks from which incoming traffic for \n"
"            this peer is allowed and to which outgoing traffic \n"
"            for this peer is directed. The catch-all 0.0.0.0/0 \n"
"            may be specified for matching all IPv4 addresses, \n"
"            and ::/0 may be specified for matching all IPv6 addresses."
msgstr ""
"الزامی.\n"
"فهرستی از نشانی‌های IP (نسخهٔ ۴ یا ۶) جداشده با کاما با\n"
"ماسک‌های CIDR که ترافیک ورودی از آن‌ها برای این همتا\n"
"مجاز بوده و ترافیک خروجی برای این همتا به آن‌ها هدایت\n"
"می‌شود. مقدار فراگیر 0.0.0.0/0 می‌تواند برای تطبیق با همهٔ\n"
"نشانی‌های IPv4، و ::/0 برای تطبیق با همهٔ نشانی‌های IPv6 مشخص شود."

#. i18n: ectx: property (text), widget (QLabel, endpointAddressLabel)
#: editor/settings/ui/wireguardpeerwidget.ui:55
#: editorqml/qml/vpn/wireguard/WireguardPeers.qml:21
#, kde-format
msgid "Endpoint address:"
msgstr "نشانی نقطهٔ پایانی:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, endpointAddressLineEdit)
#: editor/settings/ui/wireguardpeerwidget.ui:66
#, kde-format
msgid ""
"Optional.\n"
"            An endpoint for the connection. Can be an\n"
"            IPv4 address, IPv6 address, or FQDN (fully\n"
"            qualified domain name such as abc.com). If\n"
"            present, Endpoint port must also be set."
msgstr ""
"اختیاری.\n"
"یک نقطهٔ پایانی برای اتصال. می‌تواند یک نشانی IPv4،\n"
"نشانی IPv6 یا FQDN (نام دامنهٔ کاملاً مشخص مانند abc.com)\n"
"باشد. در صورت وجود، درگاه نقطهٔ پایانی نیز باید تنظیم شود."

#. i18n: ectx: property (text), widget (QLabel, endpointPortLabel)
#: editor/settings/ui/wireguardpeerwidget.ui:74
#: editorqml/qml/vpn/wireguard/WireguardPeers.qml:22
#, kde-format
msgid "Endpoint port:"
msgstr "درگاه نقطهٔ پایانی:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, endpointPortLineEdit)
#: editor/settings/ui/wireguardpeerwidget.ui:83
#, kde-format
msgid ""
"Optional.\n"
"            The port number of an endpoint. If present Endpoint\n"
"            Address must also be set."
msgstr ""
"اختیاری.\n"
"شمارهٔ درگاه یک نقطهٔ پایانی. در صورت وجود، نشانی\n"
"نقطهٔ پایانی نیز باید تنظیم شود."

#. i18n: ectx: property (text), widget (QLabel, presharedKeyLabel)
#: editor/settings/ui/wireguardpeerwidget.ui:91
#: editorqml/qml/vpn/wireguard/WireguardPeers.qml:23
#, kde-format
msgid "Preshared key:"
msgstr "کلید پیش‌اشتراکی:"

#. i18n: ectx: property (toolTip), widget (PasswordField,
#. presharedKeyLineEdit)
#: editor/settings/ui/wireguardpeerwidget.ui:102
#, kde-format
msgid ""
"Optional.\n"
"            A base64 preshared key generated by wg genpsk.\n"
"            This option adds an additional layer of symmetric-key\n"
"            cryptography to be mixed into the already existing\n"
"            public-key cryptography, for post-quantum resistance."
msgstr ""
"اختیاری.\n"
"یک کلید پیش‌اشتراکی base64 تولیدشده توسط wg genpsk.\n"
"این گزینه لایه‌ای اضافی از رمزنگاری کلید متقارن را برای\n"
"ترکیب با رمزنگاری کلید عمومی موجود اضافه می‌کند تا در\n"
"برابر تهدیدات پساکوانتومی مقاومت ایجاد کند."

#. i18n: ectx: property (text), widget (QLabel, keepaliveLabel)
#: editor/settings/ui/wireguardpeerwidget.ui:109
#: editorqml/qml/vpn/wireguard/WireguardPeers.qml:24
#, kde-format
msgid "Persistent keepalive:"
msgstr "زنده‌داری مداوم:"

#. i18n: ectx: property (toolTip), widget (QLineEdit, keepaliveLineEdit)
#: editor/settings/ui/wireguardpeerwidget.ui:127
#, kde-format
msgid ""
"Optional.\n"
"            A seconds interval, between 1 and 65535 inclusive, of\n"
"            how often to send an authenticated empty packet to\n"
"            the peer for the purpose of keeping a stateful firewall\n"
"            or NAT mapping valid persistently. For example, if the\n"
"            interface very rarely sends traffic, but it might at\n"
"            anytime receive traffic from a peer, and it is behind\n"
"            NAT, the interface might benefit from having a\n"
"            persistent keepalive interval of 25 seconds. If set to\n"
"            0 or \"off\", this option is disabled. By default or\n"
"            when unspecified, this option is off. Most users will not\n"
"            need this."
msgstr ""
"اختیاری.\n"
"بازهٔ زمانی برحسب ثانیه، بین ۱ تا ۶۵۵۳۵ (شامل هر دو)، برای\n"
"تعیین این‌که هر چند وقت یک‌بار یک بستهٔ خالی احراز هویت‌شده\n"
"به همتا ارسال شود تا نگاشت دیوارهٔ آتش وضعیت‌مند یا NAT\n"
"به‌طور مداوم معتبر بماند. برای نمونه، اگر رابط به‌ندرت ترافیک\n"
"ارسال می‌کند، اما ممکن است در هر لحظه ترافیکی از یک همتا\n"
"دریافت کند و پشت NAT قرار دارد، می‌تواند از بازهٔ زنده‌داری\n"
"مداوم ۲۵ ثانیه‌ای بهره‌مند شود. در صورت تنظیم روی 0 یا «off»، این\n"
"گزینه غیرفعال می‌شود. به‌طور پیش‌فرض یا هنگامی که تعیین\n"
"نشده باشد، این گزینه خاموش است. بیشتر کاربران به این\n"
"گزینه نیازی نخواهند داشت."

