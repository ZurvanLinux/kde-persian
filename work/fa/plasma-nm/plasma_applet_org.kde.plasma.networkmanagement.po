#: ConnectionItem.qml:62
#, kde-format
msgid "Connect"
msgstr "اتصال"

#: ConnectionItem.qml:62
#, kde-format
msgid "Disconnect"
msgstr "قطع اتصال"

#: ConnectionItem.qml:90
#, kde-format
msgctxt "Share Wi-Fi network's password or QR code"
msgid "Share"
msgstr "اشتراک‌گذاری"

#: ConnectionItem.qml:96
#, kde-format
msgid "Configure…"
msgstr "پیکربندی…"

#: ConnectionItem.qml:136
#, kde-format
msgid "Speed"
msgstr "سرعت"

#: ConnectionItem.qml:141
#, kde-format
msgid "Details"
msgstr "جزئیات"

#: ConnectionItem.qml:188
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Current download speed is %1 kibibytes per second; current upload speed is "
"%2 kibibytes per second"
msgstr "سرعت دریافت کنونی %1 KiB/s است؛ سرعت ارسال کنونی %2 KiB/s است"

#: ConnectionItem.qml:309
#, kde-format
msgctxt "Download and upload rates in some unit per second"
msgid "↓ %1/s, ↑ %2/s"
msgstr "↓ %1/s، ↑ %2/s"

#: ConnectionListPage.qml:33
#, kde-format
msgid "You need to log in to this network"
msgstr "باید به این شبکه وارد شوید"

#: ConnectionListPage.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Log in"
msgstr "ورود"

#: ConnectionListPage.qml:118
#, kde-format
msgid "Airplane mode is enabled"
msgstr "حالت هواپیما فعال است"

#: ConnectionListPage.qml:122
#, kde-format
msgid "Wi-Fi and mobile data are deactivated"
msgstr "وای‌فای و داده‌های تلفن همراه غیرفعال هستند"

#: ConnectionListPage.qml:124
#, kde-format
msgid "Wi-Fi is deactivated"
msgstr "وای‌فای غیرفعال است"

#: ConnectionListPage.qml:127
#, kde-format
msgid "Looking for Wi-Fi networks"
msgstr "در حال جست‌وجوی شبکه‌های وای‌فای"

#: ConnectionListPage.qml:130
#, kde-format
msgid "Mobile data is deactivated"
msgstr "داده‌های تلفن همراه غیرفعال است"

#: ConnectionListPage.qml:133
#, kde-format
msgid "No matches"
msgstr "موردی یافت نشد"

#: ConnectionListPage.qml:136
#, kde-format
msgid "No available connections"
msgstr "هیچ اتصالی در دسترس نیست"

#: ConnectionListPage.qml:145
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn off airplane mode to search for networks"
msgstr "برای جست‌وجوی شبکه‌ها، حالت هواپیما را خاموش کنید"

#: ConnectionListPage.qml:149
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn on Wi-Fi or mobile data to search for networks"
msgstr "برای جست‌وجوی شبکه‌ها، وای‌فای یا داده‌های تلفن همراه را روشن کنید"

#: ConnectionListPage.qml:151
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn on Wi-Fi to search for networks"
msgstr "برای جست‌وجوی شبکه‌ها، وای‌فای را روشن کنید"

#: ConnectionListPage.qml:154
#, kde-format
msgctxt "@info:placeholder"
msgid "Turn on mobile data to search for networks"
msgstr "برای جست‌وجوی شبکه‌ها، داده‌های تلفن همراه را روشن کنید"

#: DetailsText.qml:40
#, kde-format
msgid "Copy"
msgstr "رونوشت"

#: main.qml:39
#, kde-format
msgid "Networks"
msgstr "شبکه‌ها"

#: main.qml:48
#, kde-format
msgctxt "@info:tooltip"
msgid "Middle-click to turn off Airplane Mode"
msgstr "برای خاموش کردن حالت هواپیما، کلیک میانی کنید"

#: main.qml:50
#, kde-format
msgctxt "@info:tooltip"
msgid "Middle-click to turn on Airplane Mode"
msgstr "برای روشن کردن حالت هواپیما، کلیک میانی کنید"

#: main.qml:78 Toolbar.qml:74
#, kde-format
msgid "Enable Wi-Fi"
msgstr "فعال کردن وای‌فای"

#: main.qml:89
#, kde-format
msgid "Enable Mobile Data"
msgstr "فعال کردن دادهٔ تلفن همراه"

#: main.qml:101
#, kde-format
msgid "Enable Airplane Mode"
msgstr "فعال کردن حالت هواپیما"

#: main.qml:113
#, kde-format
msgid "Open Network Login Page…"
msgstr "باز کردن صفحهٔ ورود به شبکه…"

#: main.qml:123
#, kde-format
msgid "&Configure Network Connections…"
msgstr "پیکربندی اتصالات شبکه…"

#: PopupDialog.qml:58
#, kde-format
msgctxt "@action:button"
msgid "Return to Network Connections"
msgstr "بازگشت به اتصالات شبکه"

#: ShareNetworkQrCodePage.qml:33
#, kde-format
msgid "Scan this QR code with another device to connect to the \"%1\" network."
msgstr "این کد QR را با دستگاه دیگری اسکن کنید تا به شبکهٔ «%1» متصل شوید."

#: ShareNetworkQrCodePage.qml:108
#, kde-format
msgid "Wi-Fi password:"
msgstr "گذرواژهٔ وای‌فای:"

#: Toolbar.qml:124
#, kde-format
msgid "Enable mobile data"
msgstr "فعال کردن دادهٔ همراه"

#: Toolbar.qml:147
#, kde-kuit-format
msgctxt "@info"
msgid "Disable airplane mode<nl/><nl/>This will enable Wi-Fi and Bluetooth"
msgstr ""
"غیرفعال کردن حالت هواپیما<nl/><nl/>این کار وای‌فای و بلوتوث را فعال می‌کند"

#: Toolbar.qml:148
#, kde-kuit-format
msgctxt "@info"
msgid "Enable airplane mode<nl/><nl/>This will disable Wi-Fi and Bluetooth"
msgstr ""
"فعال کردن حالت هواپیما<nl/><nl/>این کار وای‌فای و بلوتوث را غیرفعال می‌کند"

#: Toolbar.qml:176
#, kde-format
msgid "Hotspot"
msgstr "نقطهٔ اتصال"

#: Toolbar.qml:193
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot create a hotspot because Wi-Fi is disabled."
msgstr "نمی‌توان نقطهٔ اتصال ایجاد کرد زیرا وای‌فای غیرفعال است."

#: Toolbar.qml:195
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Cannot create a hotspot because all wireless radios are in use. Disconnect "
"from the current Wi-Fi network or connect another wireless radio."
msgstr ""
"نمی‌توان نقطهٔ اتصال ایجاد کرد زیرا همهٔ رادیوهای بی‌سیم در حال استفاده "
"هستند. از شبکهٔ وای‌فای کنونی قطع شوید یا یک رادیوی بی‌سیم دیگر متصل کنید."

#: Toolbar.qml:197
#, kde-format
msgctxt "@info:tooltip"
msgid "Disable Hotspot"
msgstr "غیرفعال کردن نقطهٔ اتصال"

#: Toolbar.qml:199
#, kde-format
msgctxt "@info:tooltip"
msgid "Create Hotspot"
msgstr "ایجاد نقطهٔ اتصال"

#: Toolbar.qml:227
#, kde-format
msgctxt "@action:button"
msgid "Scan Wi-Fi QR Code"
msgstr "اسکن کد QR وای‌فای"

#: Toolbar.qml:232
#, kde-format
msgctxt "@info:tooltip"
msgid "Scan QR Code to connect to a Wi-Fi network"
msgstr "اسکن کد QR برای اتصال به شبکهٔ وای‌فای"

#: Toolbar.qml:234
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Install QRCA Barcode Scanner to scan for a QR Code that connects to a Wi-Fi "
"network"
msgstr "بارکدخوان QRCA را برای اسکن کد QR جهت اتصال به شبکهٔ وای‌فای نصب کنید"

#: Toolbar.qml:253
#, kde-format
msgid "Configure network connections…"
msgstr "پیکربندی اتصالات شبکه…"
