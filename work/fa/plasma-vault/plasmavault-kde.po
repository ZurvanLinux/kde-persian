#: kded/engine/backends/cryfs/cryfsbackend.cpp:92
#: kded/engine/backends/encfs/encfsbackend.cpp:51
#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:77
#, kde-format
msgid "Failed to create directories, check your permissions"
msgstr "ایجاد شاخه‌ها ناموفق بود، دسترسی‌های خود را بررسی کنید"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:131
#, kde-format
msgid "Upgrade the vault?"
msgstr "گاوصندوق ارتقا یابد؟"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:132
#, kde-format
msgid ""
"This vault was created with an older version of cryfs and needs to be upgraded.\n"
"\n"
"Mind that this process is irreversible and the vault will no longer work with older versions of cryfs.\n"
"\n"
"Do you want to perform the upgrade now?"
msgstr ""
"این گاوصندوق با نگارش قدیمی‌تری از cryfs ایجاد شده است و باید ارتقا یابد.\n"
"\n"
"توجه داشته باشید که این فرایند غیرقابل‌بازگشت است و گاوصندوق دیگر با نگارش‌های قدیمی‌تر cryfs کار نخواهد کرد.\n"
"\n"
"آیا می‌خواهید ارتقا را اکنون انجام دهید؟"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:136
#, kde-format
msgid ""
"The vault needs to be upgraded before it can be unlocked with this version "
"of cryfs"
msgstr ""
"پیش از آنکه بتوان قفل گاوصندوق را با این نگارش از cryfs باز کرد، باید ارتقا "
"داده شود"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:150
#: kded/engine/fusebackend_p.cpp:45
#, kde-format
msgid "The mount point directory is not empty; refusing to unlock the vault"
msgstr "شاخهٔ نقطهٔ سوار کردن خالی نیست؛ از باز کردن قفل گاوصندوق صرف‌نظر شد"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:158
#, kde-format
msgid "You entered the wrong password"
msgstr "گذرواژه را اشتباه وارد کردید"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:162
#, kde-format
msgid "The installed version of cryfs is too old to unlock this vault."
msgstr ""
"نگارش نصب‌شدهٔ cryfs برای باز کردن قفل این گاوصندوق بیش از حد قدیمی است."

#: kded/engine/backends/cryfs/cryfsbackend.cpp:169
#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:120
#, kde-format
msgid "Unable to perform the operation (error code %1)."
msgstr "امکان انجام عملیات وجود ندارد (کد خطا %1)."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:110
#, kde-format
msgid "The cipher directory is not empty, cannot initialise the vault."
msgstr ""
"پوشهٔ رمزگذاری‌شده خالی نیست، نمی‌توان گاوصندوق را مقداردهی اولیه کرد."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:113
#, kde-format
msgid "The password is empty, cannot initialise the vault."
msgstr "گذرواژه خالی است، نمی‌توان گاوصندوق را مقداردهی اولیه کرد."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:116
#, kde-format
msgid ""
"Cannot write gocryptfs.conf inside cipher directory, check your permissions."
msgstr ""
"امکان نوشتن gocryptfs.conf درون پوشهٔ رمزگذاری‌شده وجود ندارد، مجوزهای خود "
"را بررسی کنید."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:144
#: kded/engine/fusebackend_p.cpp:192
#, kde-format
msgid "Failed to execute"
msgstr "اجرا نشد"

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:154
#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:169
#: kded/engine/fusebackend_p.cpp:204
#, kde-format
msgid "Unable to detect the version"
msgstr "امکان تشخیص نسخه وجود ندارد"

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:163
#, kde-format
msgid "Unable to detect the version, the version string is invalid"
msgstr "امکان تشخیص نسخه وجود ندارد، رشتهٔ نسخه نامعتبر است"

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:177
#, kde-format
msgid "Wrong version installed. The required version is %1.%2"
msgstr "نسخهٔ اشتباهی نصب شده است. نسخهٔ لازم %1.%2 است"

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:180
#: kded/engine/fusebackend_p.cpp:218
#, kde-format
msgid "Correct version found"
msgstr "نسخهٔ درست پیدا شد"

#: kded/engine/fusebackend_p.cpp:54
#, kde-format
msgid "Unable to perform the operation"
msgstr "امکان انجام عملیات وجود ندارد"

#: kded/engine/fusebackend_p.cpp:117
#, kde-format
msgid "This directory already contains encrypted data"
msgstr "این شاخه از قبل حاوی داده‌های رمزگذاری‌شده است"

#: kded/engine/fusebackend_p.cpp:120
#, kde-format
msgid ""
"You need to select empty directories for the encrypted storage and for the "
"mount point"
msgstr ""
"باید شاخه‌های خالی را برای فضای ذخیره‌سازی رمزگذاری‌شده و نقطهٔ اتصال انتخاب"
" کنید"

#: kded/engine/fusebackend_p.cpp:137
#, kde-format
msgid "This directory doesn't contain encrypted data"
msgstr "این شاخه حاوی داده‌های رمزگذاری‌شده نیست"

#: kded/engine/fusebackend_p.cpp:141
#, kde-format
msgid "You need to select an empty directory for the mount point"
msgstr "باید یک شاخهٔ خالی برای نقطهٔ اتصال انتخاب کنید"

#: kded/engine/fusebackend_p.cpp:153
#, kde-format
