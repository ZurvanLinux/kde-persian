#, kde-format
msgid "Mount point is not specified"
msgstr "نقطهٔ اتصال مشخص نشده است"

#: kded/engine/vault.cpp:283
#, kde-format
msgid "Cannot create the mount point"
msgstr "امکان ایجاد نقطهٔ اتصال وجود ندارد"

#: kded/engine/vault.cpp:288
#, kde-format
