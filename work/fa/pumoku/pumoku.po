#: contents/ui/Import.qml:13
#, kde-format
msgctxt "@title:window"
msgid "Import Sudoku"
msgstr "درون‌ریزی سودوکو"

#: contents/ui/Import.qml:35
#, kde-format
msgctxt "Use en dash for number range"
msgid ""
"Enter or paste a string of 81 characters. 1–9 for given cells, 0 or any single non-numeric character except space will do for blanks cells. PuMoKu will check that the Sudoku is solvable and calculate the level.\n"
"\n"
"Line breaks and spaces are silently removed, so that you can enter one row per-line with some optional whitespace."
msgstr ""
"یک رشته از ۸۱ نویسه را وارد کرده یا جای‌گذاری کنید. ۱–۹ برای خانه‌های پرشده، ۰ یا هر نویسه غیرعددی منفرد به‌جز فاصله برای خانه‌های خالی به کار می‌رود. PuMoKu قابل‌حل بودن سودوکو را بررسی کرده و سطح دشواری را محاسبه می‌کند.\n"
"\n"
"شکست‌های خط و فاصله‌ها به صورت خودکار حذف می‌شوند، بنابراین می‌توانید در هر خط یک سطر را با فاصله‌های دلخواه وارد کنید."

#: contents/ui/Import.qml:45
#, kde-format
msgctxt "@button:title"
msgid "Save current game"
msgstr "ذخیره بازی فعلی"

#: contents/ui/Import.qml:53
#, kde-format
msgctxt "@action:button"
