msgstr "لغو"

#: contents/ui/Import.qml:57
#, kde-format
msgctxt "@action:button"
msgid "Import"
msgstr "درون‌ریزی"

#: contents/ui/Import.qml:66
#, kde-format
msgid ""
"The provided string is not exactly 81 characters after cleanup. Please "
"amend."
msgstr "رشته ارائه شده پس از پاک‌سازی دقیقاً ۸۱ نویسه نیست. لطفاً اصلاح کنید."

