msgstr "هر زمانی"

#: alarmtimewidget.cpp:132
#, kde-format
msgctxt "@info:tooltip"
msgid "Set only a date (without a time) for the alarm"
msgstr "تنظیم فقط تاریخ (بدون ساعت) برای هشدار"

#: alarmtimewidget.cpp:134
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Check to specify only a date (without a time) for the alarm. The alarm will "
"trigger at the first opportunity on the selected date."
msgstr ""
"برای مشخص کردن فقط تاریخ (بدون ساعت) برای هشدار، علامت بزنید. هشدار در اولین"
" فرصت در تاریخ انتخاب‌شده به صدا درخواهد آمد."

#: alarmtimewidget.cpp:138
#, kde-format
msgctxt "@option:radio Defer for time interval"
msgid "Defer for:"
msgstr "به تعویق انداختن به مدت:"

#: alarmtimewidget.cpp:138 editdlg.cpp:342
#, kde-format
msgctxt "@option:radio"
msgid "Time from now:"
msgstr "زمان از اکنون:"

#: alarmtimewidget.cpp:139
#, kde-format
msgctxt "@info:whatsthis"
msgid "Reschedule the alarm for the specified time interval after now."
msgstr "زمان‌بندی مجدد هشدار برای بازهٔ زمانی مشخص‌شده پس از اکنون."

#: alarmtimewidget.cpp:140
#, kde-format
msgctxt "@info:whatsthis"
msgid "Schedule the alarm after the specified time interval from now."
msgstr "زمان‌بندی هشدار پس از بازهٔ زمانی مشخص‌شده از اکنون."

