#: ./messagepartthemes/default/templates/htmlmessagepart.html:6
msgid ""
"<b>Note:</b> This is an HTML message. For security reasons, only the raw "
"HTML code is shown. If you trust the sender of this message then you can "
"activate formatted HTML display for this message <a href='kmail:showHTML'>by"
" clicking here</a>."
msgstr ""
"<b>نکته:</b> این یک پیام HTML است. به دلایل امنیتی، فقط کد خام HTML نمایش "
"داده می‌شود. اگر به فرستندهٔ این پیام اعتماد دارید، می‌توانید نمایش "
"قالب‌بندی‌شدهٔ HTML را برای این پیام <a href='kmail:showHTML'>با کلیک در "
"اینجا</a> فعال کنید."

#: ./messagepartthemes/default/templates/htmlmessagepart.html:12
msgid ""
"<b>Note:</b> This HTML message may contain external references to images "
"etc. For security/privacy reasons external references are not loaded. If you"
" trust the sender of this message then you can load the external references "
"for this message <a href='kmail:loadExternal'>by clicking here</a>."
msgstr ""
"<b>نکته:</b> این پیام HTML ممکن است حاوی ارجاعات خارجی به تصاویر و غیره "
"باشد. به دلایل امنیتی/حریم خصوصی، ارجاعات خارجی بارگیری نمی‌شوند. اگر به "
"فرستندهٔ این پیام اعتماد دارید، می‌توانید ارجاعات خارجی را برای این پیام <a "
"href='kmail:loadExternal'>با کلیک در اینجا</a> بارگیری کنید."

#: ./messagepartthemes/default/templates/signedmessagepart.html:5
msgid "Please wait while the signature is being verified..."
msgstr "لطفاً تا اعتبارسنجی امضا صبر کنید..."

#: ./messagepartthemes/default/templates/signedmessagepart.html:17
msgid "End of signed message"
msgstr "پایان پیام امضاشده"

