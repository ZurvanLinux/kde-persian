#: mdn/mdnadvicehelper.cpp:27
msgid ""
"This message contains a request to return a notification about your reception of the message.\n"
"You can either ignore the request or let the mail program send a \"denied\" or normal response."
msgstr ""
"این پیام حاوی درخواستی برای ارسال اعلان دریافت پیام توسط شما است.\n"
"می‌توانید این درخواست را نادیده بگیرید یا به برنامهٔ رایانامه اجازه دهید یک پاسخ عادی یا «رد شد» ارسال کند."

#: mdn/mdnadvicehelper.cpp:33
msgid ""
"This message contains a request to send a notification about your reception of the message.\n"
"It contains a processing instruction that is marked as \"required\", but which is unknown to the mail program.\n"
"You can either ignore the request or let the mail program send a \"failed\" response."
msgstr ""
"این پیام حاوی درخواستی برای ارسال اعلان دریافت پیام توسط شما است.\n"
"پیام شامل یک دستورالعمل پردازشی است که به‌عنوان «لازم» علامت‌گذاری شده، اما برای برنامهٔ رایانامه ناشناخته است.\n"
"می‌توانید این درخواست را نادیده بگیرید یا به برنامهٔ رایانامه اجازه دهید پاسخ «ناموفق» ارسال کند."

#: mdn/mdnadvicehelper.cpp:41
msgid ""
"This message contains a request to send a notification about your reception of the message,\n"
"but it is requested to send the notification to more than one address.\n"
"You can either ignore the request or let the mail program send a \"denied\" or normal response."
msgstr ""
"این پیام حاوی درخواستی برای ارسال اعلان دریافت پیام توسط شما است،\n"
"اما درخواست شده که اعلان به بیش از یک نشانی ارسال شود.\n"
"می‌توانید این درخواست را نادیده بگیرید یا به برنامهٔ رایانامه اجازه دهید یک پاسخ عادی یا «رد شد» ارسال کند."

#: mdn/mdnadvicehelper.cpp:49
msgid ""
"This message contains a request to send a notification about your reception of the message,\n"
"but there is no return-path set.\n"
"You can either ignore the request or let the mail program send a \"denied\" or normal response."
msgstr ""
"این پیام حاوی درخواستی برای ارسال اعلان دریافت پیام توسط شما است،\n"
"اما هیچ مسیر بازگشتی (return-path) تنظیم نشده است.\n"
"می‌توانید این درخواست را نادیده بگیرید یا به برنامهٔ رایانامه اجازه دهید یک پاسخ عادی یا «رد شد» ارسال کند."

#: mdn/mdnadvicehelper.cpp:56
msgid ""
"This message contains a request to send a notification about your reception of the message,\n"
"but the return-path address differs from the address the notification was requested to be sent to.\n"
"You can either ignore the request or let the mail program send a \"denied\" or normal response."
msgstr ""
"این پیام حاوی درخواستی برای ارسال اعلان دریافت پیام توسط شما است،\n"
"اما نشانی مسیر بازگشت (return-path) با نشانی درخواستی برای ارسال اعلان متفاوت است.\n"
"می‌توانید این درخواست را نادیده بگیرید یا به برنامهٔ رایانامه اجازه دهید یک پاسخ عادی یا «رد شد» ارسال کند."

