msgstr "تنظیم پیشوند برای خطوط پیام نقل‌قول‌شده"

#. i18n: ectx: property (whatsThis), widget (QLineEdit, lineEdit_quote)
#: ui/templatesconfiguration_base.ui:326
#, no-c-format, kde-format
msgctxt "@info:whatsthis"
msgid ""
"\n"
"             <qt>The following placeholders are supported in the quote indicator:\n"
"             <ul>\n"
"             <li>%f: sender's initials</li>\n"
"             <li>%%: percent sign</li>\n"
"             <li>%_: space</li>\n"
"             </ul></qt>\n"
"           "
msgstr ""
"\n"
"             <qt>جانگهدار‌های زیر در نشان‌گر نقل‌قول پشتیبانی می‌شوند:\n"
"             <ul>\n"
"             <li>%f: حروف اول نام فرستنده</li>\n"
"             <li>%%: علامت درصد</li>\n"
"             <li>%_: فاصله</li>\n"
"             </ul></qt>\n"
"           "
