#, kde-format
msgctxt "@action:inmenu widget context menu"
msgid "&Configure Activities…"
msgstr "پیکربندی فعالیت‌ها…"

#: qml/main.qml:617
#, kde-format
msgctxt "@action:inmenu widget context menu"
msgid "Configure Virtual Desktops…"
