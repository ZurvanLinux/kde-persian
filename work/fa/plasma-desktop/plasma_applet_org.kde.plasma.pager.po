msgstr "نمایش مدیر فعالیت‌ها"

#: qml/main.qml:599
#, kde-format
msgctxt "@action:inmenu widget context menu"
msgid "Add Virtual Desktop"
msgstr "افزودن میزکار مجازی"

#: qml/main.qml:605
#, kde-format
