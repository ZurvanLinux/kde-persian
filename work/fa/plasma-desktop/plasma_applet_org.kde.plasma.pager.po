#: qml/config.qml:13
#, kde-format
msgctxt "@title:group for configuration dialog page"
msgid "General"
msgstr "عمومی"

#: qml/configGeneral.qml:39
#, kde-format
msgctxt "@title:group prefix for checkbox group"
msgid "General:"
msgstr "عمومی:"

#: qml/configGeneral.qml:41
#, kde-format
msgctxt "@option:check"
msgid "Show window outlines"
msgstr "نمایش طرح کلی پنجره‌ها"

#: qml/configGeneral.qml:46
#, kde-format
msgctxt "@option:check"
msgid "Show application icons on window outlines"
msgstr "نمایش شمایل‌های برنامه روی طرح کلی پنجره‌ها"

#: qml/configGeneral.qml:52
#, kde-format
msgctxt "@option:check"
msgid "Show only current screen"
msgstr "نمایش فقط صفحهٔ کنونی"

#: qml/configGeneral.qml:57
#, kde-format
msgctxt "@option:check"
msgid "Navigation wraps around"
msgstr "پیمایش دور می‌زند"

#: qml/configGeneral.qml:69
#, kde-format
msgctxt "@title:listbox"
msgid "Layout:"
msgstr "چیدمان:"

#: qml/configGeneral.qml:71
#, kde-format
msgctxt "@item:inlistbox The pager layout"
msgid "Default"
msgstr "پیش‌فرض"

#: qml/configGeneral.qml:71
#, kde-format
msgctxt "@item:inlistbox The pager layout"
msgid "Horizontal"
msgstr "افقی"

#: qml/configGeneral.qml:71
#, kde-format
msgctxt "@item:inlistbox The pager layout"
msgid "Vertical"
msgstr "عمودی"

#: qml/configGeneral.qml:85
#, kde-format
msgctxt "@title:group prefix for radiobutton group"
msgid "Text display:"
msgstr "نمایش متن:"

#: qml/configGeneral.qml:88
#, kde-format
msgctxt "@option:radio text display"
msgid "No text"
msgstr "بدون متن"

#: qml/configGeneral.qml:96
#, kde-format
msgctxt "@option:radio text display"
msgid "Activity number"
msgstr "شمارهٔ فعالیت"

#: qml/configGeneral.qml:96
#, kde-format
msgctxt "@option:radio text display"
msgid "Desktop number"
msgstr "شمارهٔ میزکار"

#: qml/configGeneral.qml:104
#, kde-format
msgctxt "@option:radio text display"
msgid "Activity name"
msgstr "نام فعالیت"

#: qml/configGeneral.qml:104
#, kde-format
msgctxt "@option:radio text display"
msgid "Desktop name"
msgstr "نام میزکار"

#: qml/configGeneral.qml:119
#, kde-format
msgctxt ""
"@label Start of the sentence 'Selecting current activity does nothing/shows "
"the desktop'"
msgid "Selecting current Activity:"
msgstr "انتخاب فعالیت کنونی:"

#: qml/configGeneral.qml:120
#, kde-format
msgctxt ""
"@label Start of the sentence 'Selecting current virtual desktop does "
"nothing/shows the desktop'"
msgid "Selecting current virtual desktop:"
msgstr "انتخاب میزکار مجازی کنونی:"

#: qml/configGeneral.qml:123
#, kde-format
msgctxt ""
"option:check completes the sentence 'Selecting current activity/virtual "
"desktop does nothing'"
msgid "Does nothing"
msgstr "کاری انجام نمی‌دهد"

#: qml/configGeneral.qml:131
#, kde-format
msgctxt ""
"option:check completes the sentence 'Selecting current activity/virtual "
"desktop shows the desktop'"
msgid "Shows the desktop"
msgstr "میزکار را نشان می‌دهد"

#: qml/main.qml:87
#, kde-format
msgctxt "@info:tooltip overflow label"
msgid "…and %1 other window"
msgid_plural "…and %1 other windows"
msgstr[0] "… و %1 پنجرهٔ دیگر"
msgstr[1] "… و %1 پنجرهٔ دیگر"

#: qml/main.qml:352
#, kde-format
msgctxt "@info:tooltip start of list"
msgid "%1 Window:"
msgid_plural "%1 Windows:"
msgstr[0] "%1 پنجره:"
msgstr[1] "%1 پنجره:"

#: qml/main.qml:364
#, kde-format
msgctxt "@info:tooltip"
msgid "%1 Minimized Window:"
msgid_plural "%1 Minimized Windows:"
msgstr[0] "%1 پنجرهٔ کمینه‌شده:"
msgstr[1] "%1 پنجرهٔ کمینه‌شده:"

#: qml/main.qml:440
#, kde-format
msgctxt "@info:whatsthis Accessible name for pager section"
msgid "Desktop %1"
msgstr "میزکار %1"

#: qml/main.qml:441
#, kde-format
msgctxt "@info:tooltip %1 is the name of a virtual desktop or an activity"
msgid "Switch to %1"
msgstr "تغییر به %1"

#: qml/main.qml:593
#, kde-format
msgctxt "@action:inmenu widget context menu"
