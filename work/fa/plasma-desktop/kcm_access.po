#, kde-format
msgctxt "@option:check Enable mouse navigation"
msgid "Enable"
msgstr "فعال‌سازی"

#: ui/MouseNavigation.qml:31
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid ""
"The numpad key <shortcut>5</shortcut> functions as a mouse click, toggled by"
" <shortcut>/</shortcut> for middle click, <shortcut>*</shortcut> for right "
"click and <shortcut>NumLock</shortcut> for left click. The keys "
"<shortcut>2</shortcut>, <shortcut>4</shortcut>, <shortcut>6</shortcut>, and "
"<shortcut>8</shortcut> allow for cardinal movement (down, left, right, and "
"up). The keys <shortcut>1</shortcut>, <shortcut>3</shortcut>, "
"<shortcut>7</shortcut>, and <shortcut>9</shortcut> allow for diagonal "
"movement."
msgstr ""
"کلید <shortcut>5</shortcut> صفحه‌کلید عددی به عنوان کلیک موشواره عمل می‌کند،"
" که با <shortcut>/</shortcut> برای کلیک وسط، <shortcut>*</shortcut> برای "
"کلیک راست و <shortcut>NumLock</shortcut> برای کلیک چپ تغییر وضعیت می‌دهد. "
"کلیدهای <shortcut>2</shortcut>، <shortcut>4</shortcut>، "
"<shortcut>6</shortcut> و <shortcut>8</shortcut> امکان حرکت در جهت‌های اصلی "
"(پایین، چپ، راست و بالا) را می‌دهند. کلیدهای <shortcut>1</shortcut>، "
"<shortcut>3</shortcut>، <shortcut>7</shortcut> و <shortcut>9</shortcut> "
"امکان حرکت مورب را می‌دهند."

