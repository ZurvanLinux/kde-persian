#: kcm.cpp:57
#, kde-format
msgid "Not able to select appropriate backend"
msgstr "امکان انتخاب پسانهٔ مناسب وجود ندارد"

#: kcm.cpp:103
#, kde-format
msgid ""
"Error while loading values. See logs for more information. Please restart "
"this configuration module."
msgstr ""
"خطا هنگام بارگذاری مقادیر. برای اطلاعات بیشتر گزارش‌ها را ببینید. لطفاً این "
"پیمانهٔ پیکربندی را دوباره راه‌اندازی کنید."

#: kcm.cpp:106
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "هیچ دستگاه اشاره‌گری یافت نشد. اکنون متصل کنید."

#: kcm.cpp:115
#, kde-format
msgid ""
"Not able to save all changes. See logs for more information. Please restart "
"this configuration module and try again."
msgstr ""
"امکان ذخیرهٔ همهٔ تغییرات وجود ندارد. برای اطلاعات بیشتر گزارش‌ها را ببینید."
" لطفاً این پیمانهٔ پیکربندی را دوباره راه‌اندازی کرده و دوباره تلاش کنید."

#: kcm.cpp:134
#, kde-format
msgid ""
"Error while loading default values. Failed to set some options to their "
"default values."
msgstr ""
"خطا هنگام بارگذاری مقادیر پیش‌فرض. تنظیم برخی گزینه‌ها به مقادیر پیش‌فرضشان "
"ناموفق بود."

#: kcm.cpp:149
#, kde-format
msgid ""
"Error while adding newly connected device. Please reconnect it and restart "
"this configuration module."
msgstr ""
"خطا هنگام افزودن دستگاه تازه‌متصل‌شده. لطفاً آن را دوباره متصل کرده و این "
"پیمانهٔ پیکربندی را دوباره راه‌اندازی کنید."

#: kcm.cpp:162
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "دستگاه اشاره‌گر قطع شد. کادر محاورهٔ تنظیمات آن بسته شد."

#: kcm.cpp:164
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "دستگاه اشاره‌گر قطع شد. دستگاه دیگری یافت نشد."

#: kwinwaylandbackend.cpp:45
#, kde-format
msgid "Critical error on reading fundamental device infos for touchpad %1."
msgstr "خطای بحرانی هنگام خواندن اطلاعات پایهٔ دستگاه برای تاچ‌پد %1."

#: ui/main.qml:69
#, kde-format
msgctxt "@info:status placeholdermessage text"
msgid "No touchpad found"
msgstr "هیچ تاچ‌پدی یافت نشد"

#: ui/main.qml:70
#, kde-format
msgctxt "@info:usagetip placeholdermessage explanation"
msgid "Connect an external touchpad"
msgstr "یک تاچ‌پد خارجی متصل کنید"

#: ui/main.qml:87
#, kde-format
msgctxt "@label:listbox device selection"
msgid "Device:"
msgstr "دستگاه:"

#: ui/main.qml:110
#, kde-format
msgctxt "@title:group prefix for checkbox group"
msgid "General:"
msgstr "عمومی:"

#: ui/main.qml:111
#, kde-format
msgctxt "@option:check"
msgid "Enable device"
msgstr "فعال‌سازی دستگاه"

#: ui/main.qml:126
#, kde-format
msgctxt "@option:check"
msgid "Disable while mouse is connected"
msgstr "غیرفعال‌سازی هنگام اتصال موشی"

#: ui/main.qml:146
#, kde-format
msgctxt "option:check"
msgid "Disable while typing"
msgstr "غیرفعال‌سازی هنگام تایپ"

#: ui/main.qml:147
#, kde-format
msgctxt "@label 'this' refers to the 'disable touchpad while typing' feature"
msgid "This can interfere with video games."
msgstr "این گزینه می‌تواند در بازی‌های ویدئویی تداخل ایجاد کند."

#: ui/main.qml:169
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "دکمه‌های چپ و راست:"

#: ui/main.qml:170
#, kde-format
msgctxt "@option:check"
msgid "Swap (left-handed mode)"
msgstr "جابه‌جایی (حالت چپ‌دست)"

#: ui/main.qml:188
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "فشردن هم‌زمان هر دو برای کلیک وسط"

#: ui/main.qml:201
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Activating this setting increases click latency by 50ms. The extra delay is "
"needed to correctly detect simultaneous left and right button presses."
msgstr ""
"فعال‌سازی این تنظیم تأخیر کلیک را ۵۰ میلی‌ثانیه افزایش می‌دهد. این تأخیر "
"اضافی برای تشخیص درست فشردن هم‌زمان دکمه‌های چپ و راست لازم است."

#: ui/main.qml:202
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"This setting is not available while “Right-click by pressing anywhere with "
"two fingers” is selected."
msgstr ""
"این تنظیم هنگام انتخاب «راست‌کلیک با فشردن هر نقطه با دو انگشت» در دسترس "
"نیست."

#: ui/main.qml:212
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "سرعت اشاره‌گر:"

#: ui/main.qml:292
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "فعال‌سازی شتاب اشاره‌گر"

#: ui/main.qml:304
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"When enabled, pointer travel distance increases with faster movement speed."
msgstr ""
"در صورت فعال بودن، با افزایش سرعت حرکت، مسافت پیمایش اشاره‌گر بیشتر می‌شود."

#: ui/main.qml:315
#, kde-format
msgctxt "@label:slider"
msgid "Scrolling speed:"
msgstr "سرعت پیمایش:"

#: ui/main.qml:397
#, kde-format
msgctxt "@item:inrange Slower Scroll"
msgid "Slower"
msgstr "کندتر"

#: ui/main.qml:404
#, kde-format
msgctxt "@item:inrange Faster Scroll Speed"
msgid "Faster"
msgstr "سریع‌تر"

#: ui/main.qml:411
#, kde-format
msgctxt ""
"@title group begins the sentence 'Scroll by moving two fingers "
"anywhere/moving one finger on edge'"
msgid "Scroll by:"
msgstr "پیمایش با:"

#: ui/main.qml:414
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving two fingers anywhere'"
msgid "Moving two fingers anywhere"
msgstr "حرکت دادن دو انگشت در هر نقطه"

#: ui/main.qml:432
#, kde-format
msgctxt ""
"@option:radio completes the sentence 'Scroll by moving one finger on edge'"
msgid "Moving one finger on edge"
msgstr "حرکت دادن یک انگشت روی لبه"

#: ui/main.qml:441
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction (Natural scrolling)"
msgstr "معکوس کردن جهت پیمایش (پیمایش طبیعی)"

#: ui/main.qml:458
#, kde-format
msgctxt "@option:check"
msgid "Disable horizontal scrolling"
msgstr "غیرفعال کردن پیمایش افقی"

#: ui/main.qml:476
#, kde-format
msgctxt ""
"@title:group for radiobutton group, begins the sentence 'right-click by "
"pressing bottom-right corner/pressing with two fingers'"
msgid "Right-click by:"
msgstr "کلیک راست با:"

#: ui/main.qml:482
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-left "
"corner'"
msgid "Pressing bottom-left corner"
msgstr "فشردن گوشهٔ پایین سمت چپ"

#: ui/main.qml:483
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing bottom-right "
"corner'"
msgid "Pressing bottom-right corner"
msgstr "فشردن گوشهٔ پایین سمت راست"

#: ui/main.qml:489
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing both bottom corners."
msgstr "کلیک وسط با فشردن هر دو گوشهٔ پایین."

#: ui/main.qml:490
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing bottom center."
msgstr "کلیک وسط با فشردن مرکز پایین."

#: ui/main.qml:512
#, kde-format
msgctxt ""
"@option:radio Completes the sentence 'right-click by pressing with two "
"fingers'"
msgid "Pressing anywhere with two fingers"
msgstr "فشردن هر نقطه با دو انگشت"

#: ui/main.qml:513
#, kde-format
msgctxt "@info shown below radio button"
msgid "Middle-click by pressing anywhere with three fingers."
msgstr "کلیک وسط با فشردن هر نقطه با سه انگشت."

#: ui/main.qml:530
#, kde-format
msgctxt "@label for checkbox, tap-to-click"
msgid "Tapping:"
msgstr "ضربه زدن:"

#: ui/main.qml:531
#, kde-format
msgctxt "@option:check"
msgid "Tap to click"
msgstr "ضربه برای کلیک"

#: ui/main.qml:546
#, kde-format
msgctxt "@option:check"
msgid "Allow dragging after tapping"
msgstr "اجازه به کشیدن پس از ضربه زدن"

#: ui/main.qml:558
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Tap, then tap and immediately slide finger over the touchpad to drag. Lift "
"finger to drop."
msgstr ""
"ضربه بزنید، سپس ضربه بزنید و بلافاصله انگشت را روی صفحهٔ لمسی بکشید تا کشیده"
" شود. برای رها کردن، انگشت را بردارید."

#: ui/main.qml:565
#, kde-format
msgctxt "@option:check"
msgid "Allow briefly lifting finger during tap-and-drag"
msgstr "اجازه به برداشتن کوتاه انگشت هنگام ضربه و کشیدن"

#: ui/main.qml:578
#, kde-format
msgctxt "@title:group"
msgid "Two-finger tap:"
msgstr "ضربه با دو انگشت:"

#: ui/main.qml:583
#, kde-format
msgctxt "@option:radio"
msgid "Right-click"
msgstr "کلیک راست"

#: ui/main.qml:586
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by tapping anywhere with three fingers."
msgstr "کلیک وسط با ضربه زدن در هر نقطه با سه انگشت."

#: ui/main.qml:608
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click"
msgstr "کلیک وسط"

#: ui/main.qml:611
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Right-click by tapping anywhere with three fingers."
msgstr "کلیک راست با ضربه زدن در هر نقطه با سه انگشت."
