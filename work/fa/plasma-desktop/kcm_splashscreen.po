#: kcm.cpp:164
#, kde-format
msgid "None"
msgstr "هیچ‌کدام"

#: kcm.cpp:167
#, kde-format
msgid "No splash screen will be shown"
msgstr "هیچ صفحهٔ آغازی نمایش داده نخواهد شد"

#: kcm.cpp:185
#, kde-format
msgid "You cannot delete the currently selected splash screen"
