msgid "Remove splash screen"
msgstr "حذف صفحهٔ آغاز"

#: ui/main.qml:90
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete the active splash screen"
msgstr "نمی‌توان صفحهٔ آغاز فعال را حذف کرد"

#: ui/main.qml:92
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete system-installed splash screens"
