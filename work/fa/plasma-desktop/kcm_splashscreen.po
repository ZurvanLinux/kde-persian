#: ui/main.qml:30
#, kde-format
msgctxt "@action:button"
msgid "&Get New…"
msgstr "دریافت جدید…"

#: ui/main.qml:50
#, kde-format
msgctxt "@info:status"
msgid "Failed to show the splash screen preview."
