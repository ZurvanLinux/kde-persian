#: inputbackend.cpp:49
#, kde-format
msgid "Critical error on reading fundamental device infos of %1."
msgstr "خطای بحرانی در خواندن اطلاعات اساسی دستگاه %1."

#: kcm.cpp:112
#, kde-format
msgid ""
"Error while loading values. See logs for more information. Please restart "
"this configuration module."
msgstr ""
"خطا هنگام بارگیری مقادیر. برای اطلاعات بیشتر گزارش‌ها را بررسی کنید. لطفاً "
"این پیمانهٔ پیکربندی را دوباره راه‌اندازی کنید."

#: kcm.cpp:115
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "هیچ دستگاه اشاره‌گری یافت نشد. اکنون وصل کنید."

#: kcm.cpp:124
#, kde-format
msgid ""
"Not able to save all changes. See logs for more information. Please restart "
"this configuration module and try again."
msgstr ""
"امکان ذخیرهٔ همهٔ تغییرات وجود ندارد. برای اطلاعات بیشتر گزارش‌ها را بررسی "
"کنید. لطفاً این پیمانهٔ پیکربندی را دوباره راه‌اندازی کرده و دوباره تلاش "
"کنید."

#: kcm.cpp:142
#, kde-format
msgid ""
"Error while loading default values. Failed to set some options to their "
"default values."
msgstr ""
"خطا هنگام بارگیری مقادیر پیش‌فرض. تنظیم برخی گزینه‌ها روی مقادیر پیش‌فرضشان "
"ناموفق بود."

#: kcm.cpp:157
#, kde-format
msgid ""
"Error while adding newly connected device. Please reconnect it and restart "
"this configuration module."
msgstr ""
"خطا هنگام افزودن دستگاه تازه‌متصل‌شده. لطفاً آن را دوباره وصل کرده و این "
"پیمانهٔ پیکربندی را دوباره راه‌اندازی کنید."

#: kcm.cpp:170
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "دستگاه اشاره‌گر قطع شد. کادر محاورهٔ تنظیمات آن بسته شد."

#: kcm.cpp:172
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "دستگاه اشاره‌گر قطع شد. هیچ دستگاه دیگری یافت نشد."

#: ui/bindings.qml:27
#, kde-format
msgctxt "@title"
msgid "Extra Mouse Buttons"
msgstr "دکمه‌های اضافی ماوس"

#: ui/bindings.qml:77
#, kde-format
msgctxt "@label for assigning an action to a numbered button"
msgid "Extra Button %1:"
msgstr "دکمهٔ اضافی %1:"

#: ui/bindings.qml:106
#, kde-format
msgctxt "@action:button"
msgid "Press the mouse button for which you want to add a key binding"
msgstr "دکمهٔ ماوسی را که می‌خواهید برای آن پیوند کلید اضافه کنید فشار دهید"

#: ui/bindings.qml:108
#, kde-format
msgctxt ""
"@action:button, %1 is the translation of 'Extra Button %1' from above"
msgid "Enter the new key combination for %1"
msgstr "ترکیب کلید جدید را برای %1 وارد کنید"

#: ui/bindings.qml:112
#, kde-format
msgctxt "@action:button"
msgid "Cancel"
msgstr "لغو"

#: ui/bindings.qml:130
#, kde-format
msgctxt "@action:button"
msgid "Press a mouse button"
msgstr "یک دکمهٔ ماوس را فشار دهید"

#: ui/bindings.qml:131
#, kde-format
msgctxt "@action:button, Bind a mousebutton to keyboard key(s)"
msgid "Add Binding…"
msgstr "افزودن پیوند…"

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Configure Extra Buttons…"
msgstr "پیکربندی دکمه‌های اضافی…"

#: ui/main.qml:64
#, kde-format
msgctxt "@title:listbox select device"
msgid "Device:"
msgstr "دستگاه:"

#: ui/main.qml:86
#, kde-format
msgctxt "@title:group"
msgid "General:"
msgstr "عمومی:"

#: ui/main.qml:87
#, kde-format
msgctxt "@option:check enable this mouse device"
msgid "Enable device"
msgstr "فعال‌سازی دستگاه"

#: ui/main.qml:102
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "دکمه‌های چپ و راست:"

#: ui/main.qml:103
#, kde-format
msgctxt "@option:check Left and right buttons"
msgid "Swap (left-handed mode)"
msgstr "جابه‌جایی (حالت چپ‌دست)"

#: ui/main.qml:118
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "فشردن هم‌زمان هر دو برای کلیک وسط"

#: ui/main.qml:130
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid ""
"Activating this setting increases click latency by 50ms. The extra delay is "
"needed to correctly detect simultaneous left and right button presses."
msgstr ""
"فعال‌سازی این تنظیم تأخیر کلیک را ۵۰ میلی‌ثانیه افزایش می‌دهد. این تأخیر "
"اضافی برای تشخیص درست فشردن هم‌زمان دکمه‌های چپ و راست لازم است."

#: ui/main.qml:142
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "سرعت اشاره‌گر:"

#: ui/main.qml:223
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "فعال‌سازی شتاب اشاره‌گر"

#: ui/main.qml:235
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid ""
"When enabled, pointer travel distance increases with faster movement speed."
msgstr ""
"در صورت فعال بودن، با افزایش سرعت حرکت، مسافت طی‌شده توسط نشانگر افزایش "
"می‌یابد."

#: ui/main.qml:264
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Scrolling speed:"
msgstr "سرعت پیمایش:"

#: ui/main.qml:328
#, kde-format
msgctxt "Slower Scroll"
msgid "Slower"
msgstr "کندتر"

#: ui/main.qml:337
#, kde-format
msgctxt "Faster Scroll Speed"
msgid "Faster"
msgstr "سریع‌تر"

#: ui/main.qml:347
#, kde-format
msgctxt "@title:group"
msgid "Scrolling:"
msgstr "پیمایش:"

#: ui/main.qml:348
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction"
msgstr "معکوس کردن جهت پیمایش"

#: ui/main.qml:363
#, kde-format
msgctxt "@option:check"
msgid "Scroll when moving the pointer"
msgstr "پیمایش هنگام حرکت دادن نشانگر"

#: ui/main.qml:383
#, kde-format
msgctxt "@option:radio"
msgid "while pressing the middle button"
msgstr "هنگام فشردن دکمهٔ میانی"

#: ui/main.qml:396
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid ""
"This will interfere with applications that use middle-button drag, such as "
"some image editors, document viewers, or video games. It may be used on any "
"device, but is intended primarily as a substitute for scroll wheels on "
"devices that do not have any."
msgstr ""
"این کار با برنامه‌هایی که از کشیدن با دکمهٔ میانی استفاده می‌کنند، مانند "
"برخی ویرایشگرهای تصویر، نمایشگرهای سند یا بازی‌های ویدئویی، تداخل ایجاد "
"می‌کند. این قابلیت در هر دستگاهی قابل استفاده است، اما هدف اصلی آن جایگزینی "
"چرخ پیمایش در دستگاه‌های فاقد آن است."

#: ui/main.qml:406
#, kde-format
msgctxt "@option:radio"
msgid "after clicking the middle button"
msgstr "پس از کلیک روی دکمهٔ میانی"

#: ui/main.qml:419
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid ""
"This will interfere with middle-clicks in general; middle-click twice when "
"you want the application to receive a single middle-click. This includes "
"middle-click dragging."
msgstr ""
"این کار به‌طور کلی با کلیک‌های میانی تداخل ایجاد می‌کند؛ هر زمان که "
"می‌خواهید برنامه یک کلیک میانی دریافت کند، دوبار کلیک میانی کنید. این شامل "
"کشیدن با کلیک میانی نیز می‌شود."
