#: interface.cpp:314
#, kde-format
msgid "Scanning stopped by user."
msgstr "پویش توسط کاربر متوقف شد."

#: options/batchdelayoption.cpp:31
#, kde-format
msgid "Batch mode time delay"
msgstr "تأخیر زمانی حالت دسته‌ای"

#: options/batchdelayoption.cpp:36
#, kde-format
msgid "Specify the time delay between each scan when batch mode is enabled."
msgstr "تأخیر زمانی میان هر پویش را هنگام فعال بودن حالت دسته‌ای مشخص کنید."

#: options/batchmodeoption.cpp:31
#, kde-format
msgid "Batch mode with time delay"
msgstr "حالت دسته‌ای با تأخیر زمانی"

#: options/batchmodeoption.cpp:36
#, kde-format
msgid ""
"Enables batch mode scanning. Continues scanning after a delay until "
"canceled."
msgstr ""
"پویش در حالت دسته‌ای را فعال می‌کند. پویش پس از یک تأخیر تا زمان لغو شدن "
"ادامه می‌یابد."

#: options/invertoption.cpp:58
#, kde-format
msgid "Invert colors"
msgstr "معکوس کردن رنگ‌ها"

#: options/invertoption.cpp:63
#, kde-format
msgid "Invert the colors of the scanned image."
msgstr "معکوس کردن رنگ‌های تصویر پویش‌شده."

#: options/pagesizeoption.cpp:184
#, kde-format
msgid "Scan area size"
msgstr "اندازهٔ ناحیهٔ پویش"

#: options/pagesizeoption.cpp:189
#, kde-format
msgid "Select a predefined page size for the scanning area."
msgstr "یک اندازهٔ صفحهٔ از پیش تعریف‌شده برای ناحیهٔ پویش انتخاب کنید."

#: options/pagesizeoption.cpp:329
#, kde-format
msgctxt "Page size landscape"
msgid "Landscape %1"
msgstr "افقی %1"
