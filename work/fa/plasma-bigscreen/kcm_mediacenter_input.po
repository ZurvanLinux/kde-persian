#: ui/GameControllerSidebar.qml:36
#, kde-format
msgid "System navigation"
msgstr "ناوبری سیستم"

#: ui/GameControllerSidebar.qml:51
#, kde-format
msgid "START button when suppressed"
msgstr "دکمه START هنگام مهار ورودی"

#: ui/GameControllerSidebar.qml:52
#, kde-format
msgid ""
"Handle the START button even when input is suppressed (may conflict with "
"some apps)"
msgstr ""
"مدیریت دکمه START حتی در صورت مهار ورودی (ممکن است با برخی از برنامه‌ها "
"تداخل داشته باشد)"

#: ui/main.qml:17
#, kde-format
msgid "Input"
msgstr "ورودی"

#: ui/main.qml:105
#, kde-format
msgid "Input daemon is not running"
msgstr "دیمن ورودی در حال اجرا نیست"

#: ui/main.qml:106
#, kde-format
msgid ""
"Controller and remote settings are only available when plasma-bigscreen-"
"inputhandler is running"
msgstr ""
"تنظیمات کنترلر و ریموت فقط زمانی در دسترس هستند که plasma-bigscreen-"
"inputhandler در حال اجرا باشد"

#: ui/main.qml:112
#, kde-format
msgid "System Navigation"
msgstr "ناوبری سیستم"

#: ui/main.qml:113
#, kde-format
msgid ""
"Navigate the system interface with connected controllers/remotes (apps can "
"always still use them directly)"
msgstr ""
"پیمایش در رابط کاربری سیستم با کنترلرها/ریموت‌های متصل (برنامه‌ها همچنان "
"می‌توانند مستقیماً از آن‌ها استفاده کنند)"

#: ui/main.qml:130
#, kde-format
msgid "TV remote"
msgstr "ریموت تلویزیون"

#: ui/main.qml:131
#, kde-format
msgid "Navigate the system interface with the connected TV remote (CEC)"
msgstr "پیمایش در رابط کاربری سیستم با ریموت تلویزیون متصل (CEC)"

#: ui/main.qml:151
#, kde-format
msgid "TV HDMI port (CEC)"
msgstr "درگاه HDMI تلویزیون (CEC)"

#: ui/main.qml:156
#, kde-format
msgid "Automatic"
msgstr "خودکار"

#: ui/main.qml:158
#, kde-format
msgid "HDMI %1"
msgstr "HDMI %1"

#: ui/main.qml:176
#, kde-format
msgid "Game Controllers"
msgstr "دسته‌های بازی"

#: ui/main.qml:186
#, kde-format
msgid "Game controllers"
msgstr "دسته‌های بازی"

#: ui/main.qml:187
#, kde-format
msgid "Use connected game controllers for system navigation"
msgstr "استفاده از دسته‌های بازی متصل برای ناوبری در سیستم"

#: ui/main.qml:206
#, kde-format
msgid "Automatic input suppression"
msgstr "مهار خودکار ورودی"

#: ui/main.qml:207
#, kde-format
msgid "Stop controller navigation while another app is using a controller"
msgstr ""
"متوقف کردن ناوبری با دسته هنگامی که برنامه دیگری از دسته استفاده می‌کند"

#: ui/main.qml:227
#, kde-format
msgid "No controllers connected"
msgstr "هیچ دسته‌ای متصل نیست"

#: ui/main.qml:228
#, kde-format
msgid "Connect a game controller"
msgstr "اتصال یک دسته بازی"
