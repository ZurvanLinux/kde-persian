#: src/data/org.kde.akonadiimportwizard.desktop:2
msgctxt "Name"
msgid "KMail Import Wizard"
msgstr "جادوگر درون‌ریزی KMail"

#: src/data/org.kde.akonadiimportwizard.desktop:61
msgctxt "Comment"
msgid ""
"Launch the import wizard to migrate data from mailer as "
"thunderbird/evolution etc."
msgstr ""
"راه‌اندازی جادوگر درون‌ریزی برای مهاجرت داده‌ها از برنامه‌های رایانامه‌ای "
"مانند تاندربرد/اوولوشن و غیره."
