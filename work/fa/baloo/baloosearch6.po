#: main.cpp:128
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR filename:jpg)'"
msgstr ""
"فهرستی از واژه‌ها برای پرس‌وجو.\n"
"هر پرس‌وجو می‌تواند یک مقدار تک، یا مقداری با پیشوند نام یک ویژگی باشد.\n"
"پرس‌وجوها می‌توانند تودرتو باشند و با پرانتز گروه‌بندی شوند.\n"
"\n"
"\n"
"مثال:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR filename:jpg)'"

