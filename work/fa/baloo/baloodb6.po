#: main.cpp:33
#, kde-format
msgid ""
"Filter by device id.\n"
"0 (default) does not filter and everything is printed.\n"
"Positive numbers are including filters printing only the mentioned device id.\n"
"Negative numbers are excluding filters printing everything but the mentioned device id.\n"
"May be given multiple times."
msgstr ""
"فیلتر بر اساس شناسهٔ دستگاه.\n"
"۰ (پیش‌فرض) فیلتر نمی‌کند و همه چیز چاپ می‌شود.\n"
"اعداد مثبت فیلترهای شمول هستند و فقط شناسهٔ دستگاه ذکرشده را چاپ می‌کنند.\n"
"اعداد منفی فیلترهای عدم شمول هستند و همه چیز به جز شناسهٔ دستگاه ذکرشده را چاپ می‌کنند.\n"
"می‌تواند چندین بار مشخص شود."

#: main.cpp:38
#, kde-format
msgid "integer"
msgstr "عدد صحیح"

#: main.cpp:43
#, kde-format
msgid ""
"List only inaccessible entries.\n"
"Only applies to \"%1\""
msgstr ""
"فقط ورودی‌های غیرقابل دسترس فهرست شوند.\n"
"فقط برای «%1» اعمال می‌شود"

#: main.cpp:47
#, kde-format
msgid "Act only on item on mounted devices"
msgstr "فقط روی موارد موجود در دستگاه‌های سوارشده اعمال شود"

#: main.cpp:51
#, kde-format
msgid ""
"Print results of a cleaning operation, but do not change anything.\n"
"Only applies to \"%1\" command"
msgstr ""
"نتایج عملیات پاک‌سازی را چاپ کند، اما چیزی را تغییر ندهد.\n"
"فقط برای دستور «%1» اعمال می‌شود"

#: main.cpp:59
#, kde-format
msgid ""
"List database contents. Use a regular expression as argument to filter "
"output"
msgstr ""
"فهرست کردن محتویات پایگاه‌داده. از یک عبارت باقاعده به‌عنوان آرگومان برای "
"پالایش خروجی استفاده کنید"

#: main.cpp:70
#, kde-format
msgid "List devices"
msgstr "فهرست کردن دستگاه‌ها"

#: main.cpp:85
#, kde-format
msgid "Remove stale database entries"
msgstr "حذف ورودی‌های کهنهٔ پایگاه‌داده"

