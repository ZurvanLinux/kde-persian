#: main.cpp:63
#, kde-format
msgid "Enable the file indexer"
msgstr "فعال‌سازی نمایه‌ساز پرونده"

#: main.cpp:64
#, kde-format
msgid "Disable the file indexer"
msgstr "غیرفعال‌سازی نمایه‌ساز پرونده"

