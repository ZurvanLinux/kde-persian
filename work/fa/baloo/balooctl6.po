#: clearcommand.cpp:30
#, kde-format
msgid "Immediately clear entries from the index"
msgstr "پاک‌سازی فوری مدخل‌ها از نمایه"

#: configcommand.cpp:45
#, kde-format
msgid "Manipulate the Baloo configuration"
msgstr "دست‌کاری پیکربندی بالو"

#: configcommand.cpp:68
#, kde-format
msgid "The config command can be used to manipulate the Baloo Configuration\n"
msgstr "از دستور config می‌توان برای تغییر پیکربندی بالو استفاده کرد\n"

#: configcommand.cpp:69
#, kde-format
msgid ""
"Usage: balooctl config <command>\n"
"\n"
msgstr ""
"کاربرد: balooctl config <command>\n"
"\n"

#: configcommand.cpp:70
#, kde-format
msgid "Possible Commands:\n"
msgstr "دستورهای ممکن:\n"

#: configcommand.cpp:72
#, kde-format
msgid "Add a value to config parameter"
msgstr "افزودن مقدار به پارامتر پیکربندی"

#: configcommand.cpp:73
#, kde-format
msgid "Remove a value from a config parameter"
msgstr "حذف مقدار از پارامتر پیکربندی"

#: configcommand.cpp:74
#, kde-format
msgid "Show the value of a config parameter"
msgstr "نمایش مقدار یک پارامتر پیکربندی"

#: configcommand.cpp:75
#, kde-format
msgid "Set the value of a config parameter"
msgstr "تنظیم مقدار یک پارامتر پیکربندی"

#: configcommand.cpp:76
#, kde-format
msgid "Display this help menu"
msgstr "نمایش این منوی راهنما"

#: configcommand.cpp:82
#, kde-format
msgid ""
"The following configuration options may be listed:\n"
"\n"
msgstr ""
"گزینه‌های پیکربندی زیر را می‌توان فهرست کرد:\n"
"\n"

#: configcommand.cpp:84 configcommand.cpp:367
#, kde-format
msgid "Controls if Baloo indexes hidden files and folders"
msgstr ""
"کنترل این که آیا بالو پرونده‌ها و پوشه‌های پنهان را نمایه‌سازی کند یا خیر"

#: configcommand.cpp:85 configcommand.cpp:368
#, kde-format
msgid "Controls if Baloo indexes file content"
msgstr "کنترل این که آیا بالو محتوای پرونده را نمایه‌سازی کند یا خیر"

#: configcommand.cpp:86 configcommand.cpp:153 configcommand.cpp:244
#, kde-format
msgid "The list of folders which Baloo indexes"
msgstr "فهرست پوشه‌هایی که بالو نمایه‌سازی می‌کند"

#: configcommand.cpp:87 configcommand.cpp:154 configcommand.cpp:245
#, kde-format
msgid "The list of folders which Baloo will never index"
msgstr "فهرست پوشه‌هایی که بالو هرگز نمایه‌سازی نخواهد کرد"

#: configcommand.cpp:88 configcommand.cpp:155 configcommand.cpp:246
#, kde-format
msgid "The list of filters which are used to exclude files"
msgstr "فهرست پالایه‌هایی که برای مستثنی کردن پرونده‌ها استفاده می‌شوند"

#: configcommand.cpp:89 configcommand.cpp:156 configcommand.cpp:247
#, kde-format
msgid "The list of mimetypes which are used to exclude files"
msgstr ""
"فهرست نوع‌های چندرسانه‌ای (MIME) که برای مستثنی کردن پرونده‌ها استفاده "
"می‌شوند"

#: configcommand.cpp:145 configcommand.cpp:236 configcommand.cpp:359
#: configcommand.cpp:429
#, kde-format
msgid "Config parameter could not be found\n"
msgstr "پارامتر پیکربندی یافت نشد\n"

#: configcommand.cpp:151 configcommand.cpp:242 configcommand.cpp:365
#, kde-format
msgid ""
"The following configuration options may be modified:\n"
"\n"
msgstr ""
"گزینه‌های پیکربندی زیر را می‌توان تغییر داد:\n"
"\n"

#: configcommand.cpp:164 configcommand.cpp:184 configcommand.cpp:255
#: configcommand.cpp:290
#, kde-format
msgid "A folder must be provided\n"
msgstr "یک پوشه باید مشخص شود\n"

#: configcommand.cpp:172
#, kde-format
msgid "%1 is not in the list of include folders"
msgstr "%1 در فهرست پوشه‌های شامل‌شده نیست"

#: configcommand.cpp:192
#, kde-format
msgid "%1 is not in the list of exclude folders"
msgstr "%1 در فهرست پوشه‌های استثناشده نیست"

#: configcommand.cpp:204 configcommand.cpp:325
#, kde-format
msgid "A filter must be provided\n"
msgstr "یک فیلتر باید مشخص شود\n"

#: configcommand.cpp:210
#, kde-format
msgid "%1 is not in list of exclude filters"
msgstr "%1 در فهرست فیلترهای استثناشده نیست"

#: configcommand.cpp:221 configcommand.cpp:343
#, kde-format
msgid "A mimetype must be provided\n"
msgstr "یک نوع MIME باید مشخص شود\n"

#: configcommand.cpp:227
#, kde-format
msgid "%1 is not in list of exclude mimetypes"
msgstr "%1 در فهرست نوع‌های MIME استثناشده نیست"

#: configcommand.cpp:261 configcommand.cpp:296
#, kde-format
msgid "Path does not exist\n"
msgstr "مسیر وجود ندارد\n"

#: configcommand.cpp:266 configcommand.cpp:301
#, kde-format
msgid "Path is not a directory\n"
msgstr "مسیر یک پوشه نیست\n"

#: configcommand.cpp:273
#, kde-format
msgid "%1 is already in the list of include folders"
msgstr "‏%1 از قبل در فهرست پوشه‌های مشمول وجود دارد"

#: configcommand.cpp:278
#, kde-format
msgid "%1 is in the list of exclude folders"
msgstr "‏%1 در فهرست پوشه‌های مستثنی قرار دارد"

#: configcommand.cpp:308
#, kde-format
msgid "%1 is already in the list of exclude folders"
msgstr "‏%1 از قبل در فهرست پوشه‌های مستثنی وجود دارد"

#: configcommand.cpp:313
#, kde-format
msgid "%1 is in the list of include folders"
msgstr "‏%1 در فهرست پوشه‌های مشمول قرار دارد"

#: configcommand.cpp:331
#, kde-format
msgid "Exclude filter is already in the list\n"
msgstr "فیلتر استثنا از قبل در فهرست وجود دارد\n"

#: configcommand.cpp:349
#, kde-format
msgid "Exclude mimetype is already in the list\n"
msgstr "نوع MIME استثنا از قبل در فهرست وجود دارد\n"

#: configcommand.cpp:377 configcommand.cpp:404
#, kde-format
msgid "A value must be provided\n"
msgstr "باید یک مقدار وارد شود\n"

#: configcommand.cpp:398 configcommand.cpp:425
#, kde-format
msgid "Invalid value\n"
msgstr "مقدار نامعتبر است\n"

#: indexcommand.cpp:29
#, kde-format
msgid "Immediately index files"
msgstr "نمایه‌سازی فوری پرونده‌ها"

#: main.cpp:54
#, kde-format
