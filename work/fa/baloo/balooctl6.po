#: main.cpp:68
#, kde-format
msgid "Check for any unindexed files and index them"
msgstr "بررسی پرونده‌های نمایه‌نشده و نمایه‌سازی آن‌ها"

#: main.cpp:69
#, kde-format
msgid "Index the specified files"
msgstr "نمایه‌سازی پرونده‌های مشخص‌شده"

#: main.cpp:70
#, kde-format
msgid "Forget the specified files"
msgstr "فراموش کردن پرونده‌های مشخص‌شده"

