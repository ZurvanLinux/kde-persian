#: selftest.cpp:34
#, kde-format
msgid "The operation timed out."
msgstr "مهلت زمان عملیات به پایان رسید."

#: selftest.cpp:59
#, kde-format
msgid "Push notification self-test."
msgstr "خودآزمایی اعلان پیش‌رونده (Push)."

#: selftest.cpp:73
#, kde-format
msgid "Could not obtain push notification endpoint."
msgstr "نقطه پایانی (endpoint) اعلان پیش‌رونده دریافت نشد."

#: selftest.cpp:126
#, kde-format
msgid "Received notification does not have the expected content."
msgstr "اعلان دریافت‌شده محتوای مورد انتظار را ندارد."

#: ui/main.qml:28
#, kde-format
msgid "There is no push notification service running!"
msgstr "هیچ سرویس اعلان پیش‌رونده‌ای در حال اجرا نیست!"

#: ui/main.qml:37
#, kde-format
msgid ""
"There is a 3rd party push notification service running. Push notifications "
"are available, but cannot be configured here."
msgstr ""
"یک سرویس اعلان پیش‌رونده متفرقه (شخص ثالث) در حال اجرا است. اعلان‌های "
"پیش‌رونده در دسترس هستند، اما از اینجا قابل پیکربندی نیستند."

#: ui/main.qml:46
#, kde-format
msgid ""
"<b>Online</b><br>Connected to the push notification server and operational."
msgstr "<b>آنلاین</b><br>به سرور اعلان پیش‌رونده متصل و فعال است."

#: ui/main.qml:55
#, kde-format
msgid "<b>Idle</b><br>There are no applications using push notifications."
msgstr "<b>بیکار</b><br>هیچ برنامه‌ای از اعلان‌های پیش‌رونده استفاده نمی‌کند."

#: ui/main.qml:65
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established "
"(%1)."
msgstr "<b>آفلاین</b><br>برقراری اتصال شبکه با سرور امکان‌پذیر نبود (%1)."

#: ui/main.qml:66
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established."
msgstr "<b>آفلاین</b><br>برقراری اتصال شبکه با سرور امکان‌پذیر نبود."

#: ui/main.qml:76
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server (%1)."
msgstr "<b>آفلاین</b><br>احراز هویت در سرور ناموفق بود (%1)."

#: ui/main.qml:77
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server."
msgstr "<b>آفلاین</b><br>احراز هویت در سرور ناموفق بود."

#: ui/main.qml:86
#, kde-format
msgid "<b>Offline</b><br>Push notifications are not set up yet."
msgstr "<b>آفلاین</b><br>اعلان‌های فشاری (Push) هنوز راه‌اندازی نشده‌اند."

#: ui/main.qml:114
#, kde-format
msgid "Push provider:"
msgstr "ارائه‌دهنده پوش:"

#: ui/main.qml:154 ui/main.qml:181 ui/main.qml:233 ui/main.qml:285
#, kde-format
msgid "URL:"
msgstr "نشانی وب (URL):"

#: ui/main.qml:159
#, kde-format
msgid "Client token:"
msgstr "توکن کلاینت:"

#: ui/main.qml:186
#, kde-format
msgid "User name:"
msgstr "نام کاربری:"

#: ui/main.qml:192
#, kde-format
msgid "Authenticate"
msgstr "احراز هویت"

#: ui/main.qml:240
#, kde-format
msgid ""
"Note that ntfy.sh is rate-limiting applications. It will therefore not work "
"with applications with a larger amount of users, such as public Matrix or "
"Mastodon instances."
msgstr ""
"توجه داشته باشید که ntfy.sh درخواست‌های برنامه‌ها را محدود (rate-limit) "
"می‌کند. بنابراین با برنامه‌هایی که تعداد کاربران بیشتری دارند، مانند سرورهای"
" عمومی ماتریکس یا ماستودون، کار نخواهد کرد."

