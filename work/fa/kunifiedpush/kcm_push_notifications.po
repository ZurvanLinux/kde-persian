#: ui/main.qml:331
#, kde-format
msgid "Push notifications are working correctly."
msgstr "اعلان‌های فشاری به‌درستی کار می‌کنند."

#: ui/main.qml:333
#, kde-format
msgid "Push notification test failed."
msgstr "آزمایش اعلان فشاری ناموفق بود."

#: ui/main.qml:335
#, kde-format
msgid "Registering with push server…"
msgstr "در حال ثبت در سرور اعلان فشاری…"

#: ui/main.qml:337
#, kde-format
msgid "Sending push notification…"
msgstr "در حال ارسال اعلان فشاری…"

#: ui/main.qml:339
#, kde-format
msgid "Waiting to receive push notification…"
msgstr "در انتظار دریافت اعلان فشاری…"

