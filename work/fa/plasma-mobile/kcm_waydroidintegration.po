msgstr "نشانی IP"

#: ui/WaydroidConfigurationForm.qml:28
#, kde-format
msgid "Copy"
msgstr "رونوشت"

#: ui/WaydroidConfigurationForm.qml:37
#, kde-format
msgid "Waydroid status"
msgstr "وضعیت Waydroid"

#: ui/WaydroidConfigurationForm.qml:39
#, kde-format
msgid "Stopping..."
msgstr "در حال متوقف‌سازی..."

#: ui/WaydroidConfigurationForm.qml:40
#, kde-format
