msgctxt "@action:button"
msgid "Install APK"
msgstr "نصب APK"

#: ui/WaydroidApplicationsPage.qml:66
#, kde-format
msgid "You must select a local file"
msgstr "باید یک پروندهٔ محلی را انتخاب کنید"

#: ui/WaydroidApplicationsPage.qml:106
#, kde-format
msgctxt "@action:button"
msgid "Delete the application"
msgstr "حذف برنامه"

#: ui/WaydroidConfigurationForm.qml:19
#, kde-format
msgid "General information"
msgstr "اطلاعات عمومی"

#: ui/WaydroidConfigurationForm.qml:24
#, kde-format
