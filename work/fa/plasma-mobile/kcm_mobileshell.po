#: ui/main.qml:18
#, kde-format
msgid "Shell"
msgstr "پوسته"

#: ui/main.qml:27
#, kde-format
msgid "General"
msgstr "عمومی"

#: ui/main.qml:33 ui/VibrationForm.qml:18 ui/VibrationForm.qml:25
#, kde-format
msgid "Shell Vibrations"
msgstr "لرزش‌های پوسته"

#: ui/main.qml:41
#, kde-format
msgid "Animations"
msgstr "پویانمایی‌ها"

#: ui/main.qml:42
#, kde-format
msgid "If this is off, animations will be reduced as much as possible."
msgstr "اگر این گزینه خاموش باشد، پویانمایی‌ها تا حد امکان کاهش می‌یابند."

#: ui/main.qml:55
#, kde-format
msgid "Auto Hide Panels"
msgstr "پنهان‌سازی خودکار پنل‌ها"

#: ui/main.qml:56
#, kde-format
msgid ""
"Auto-hide the status and navigation panels to allow applications to always "
"be in fullscreen."
msgstr ""
"پنهان‌سازی خودکار پنل‌های وضعیت و ناوبری تا برنامه‌ها همیشه به‌صورت "
"تمام‌صفحه نمایش داده شوند."

#: ui/main.qml:69
#, kde-format
msgid "Double Tap to Wakeup"
msgstr "دو بار ضربه برای بیدارباش"

#: ui/main.qml:70
#, kde-format
msgid "When the screen is off, double tap to wakeup the device."
msgstr "هنگامی که صفحه خاموش است، برای بیدار کردن دستگاه دو بار ضربه بزنید."

#: ui/main.qml:83
#, kde-format
msgid "Confirm Close All"
msgstr "تأیید بستن همه"

#: ui/main.qml:84
#, kde-format
msgid "Require confirmation before closing all apps in the task switcher."
msgstr "نیاز به تأیید قبل از بستن همهٔ برنامه‌ها در جابه‌جاگر برنامه‌ها."

#: ui/main.qml:95
#, kde-format
msgid "Status Bar"
msgstr "نوار وضعیت"

#: ui/main.qml:101
#, kde-format
msgid "Date in status bar"
msgstr "تاریخ در نوار وضعیت"

#: ui/main.qml:102
#, kde-format
msgid "If on, date will be shown next to the clock in the status bar."
msgstr "در صورت فعال بودن، تاریخ کنار ساعت در نوار وضعیت نمایش داده خواهد شد."

#: ui/main.qml:115
#, kde-format
msgid "Battery Percentage"
msgstr "درصد باتری"

#: ui/main.qml:116
#, kde-format
msgid "Show battery percentage in the status bar."
msgstr "نمایش درصد باتری در نوار وضعیت."

#: ui/main.qml:130
#, kde-format
msgid "Status Bar Size"
msgstr "اندازهٔ نوار وضعیت"

#: ui/main.qml:131
#, kde-format
msgid "Size of the top panel (needs restart)."
msgstr "اندازهٔ پانل بالایی (نیازمند راه‌اندازی مجدد)."

#: ui/main.qml:134
#, kde-format
msgctxt "Status bar height"
msgid "Tiny"
msgstr "خیلی کوچک"

#: ui/main.qml:135
#, kde-format
msgctxt "Status bar height"
msgid "Small"
msgstr "کوچک"

#: ui/main.qml:136
#, kde-format
msgctxt "Status bar height"
msgid "Normal"
msgstr "عادی"

#: ui/main.qml:137
#, kde-format
msgctxt "Status bar height"
msgid "Large"
msgstr "بزرگ"

#: ui/main.qml:138
#, kde-format
msgctxt "Status bar height"
msgid "Very Large"
msgstr "خیلی بزرگ"

#: ui/main.qml:154
#, kde-format
msgid "Action Drawer"
msgstr "کِشوی کنش"

#: ui/main.qml:160
#, kde-format
msgctxt "Pinned action drawer mode"
msgid "Pinned Mode"
msgstr "حالت پین‌شده"

#: ui/main.qml:161
#, kde-format
msgctxt "Expanded action drawer mode"
msgid "Expanded Mode"
msgstr "حالت گسترش‌یافته"

#: ui/main.qml:165 ui/QuickSettingsForm.qml:20 ui/QuickSettingsForm.qml:106
#, kde-format
msgid "Quick Settings"
msgstr "تنظیمات سریع"

#: ui/main.qml:173
#, kde-format
msgid "Top Left Drawer Mode"
msgstr "حالت کشوی بالا سمت چپ"

#: ui/main.qml:174
#, kde-format
msgid "Mode when opening from the top left."
msgstr "حالت هنگام باز شدن از بالا سمت چپ."

#: ui/main.qml:195
#, kde-format
msgid "Top Right Drawer Mode"
msgstr "حالت کشوی بالا سمت راست"

#: ui/main.qml:196
#, kde-format
msgid "Mode when opening from the top right."
msgstr "حالت هنگام باز شدن از بالا سمت راست."

#: ui/main.qml:215
#, kde-format
msgctxt "@title:group, shortcuts available from lock screen"
msgid "Lock Screen Shortcuts"
msgstr "میان‌برهای صفحهٔ قفل"

#: ui/main.qml:220
#, kde-format
msgctxt "@item:inlistbox"
msgid "None"
msgstr "هیچ‌کدام"

#: ui/main.qml:221
#, kde-format
msgctxt "@item:inlistbox"
msgid "Flashlight"
msgstr "چراغ‌قوه"

#: ui/main.qml:222
#, kde-format
msgctxt "@item:inlistbox"
msgid "Camera"
msgstr "دوربین"

#: ui/main.qml:226
#, kde-format
msgctxt "@label:listbox"
msgid "Left button"
msgstr "دکمهٔ چپ"

#: ui/main.qml:248
#, kde-format
msgctxt "@label:listbox"
msgid "Right button"
msgstr "دکمهٔ راست"

#: ui/QuickSettingsForm.qml:89
#, kde-format
msgctxt "@action:button"
msgid "Hide"
msgstr "پنهان‌کردن"

#: ui/QuickSettingsForm.qml:89
#, kde-format
msgctxt "@action:button"
msgid "Show"
msgstr "نمایش"

#: ui/QuickSettingsForm.qml:114
#, kde-format
msgid "Quick Settings Columns"
msgstr "ستون‌های تنظیمات سریع"

#: ui/QuickSettingsForm.qml:115
#, kde-format
msgid "Maximum number of columns in landscape orientation."
msgstr "حداکثر تعداد ستون‌ها در حالت افقی."

#: ui/QuickSettingsForm.qml:128
#, kde-format
msgid ""
"Customize the order of quick settings in the pull-down panel and hide them."
msgstr "سفارشی‌سازی ترتیب تنظیمات سریع در پنل کشویی و پنهان کردن آن‌ها."

#: ui/QuickSettingsForm.qml:166
#, kde-format
msgid "Disabled Quick Settings"
msgstr "تنظیمات سریع غیرفعال‌شده"

#: ui/QuickSettingsForm.qml:171
#, kde-format
msgid "Re-enable previously disabled quick settings."
msgstr "فعال‌سازی مجدد تنظیمات سریعی که قبلاً غیرفعال شده‌اند."

#: ui/VibrationForm.qml:26
#, kde-format
msgid "Whether to have vibrations enabled in the shell."
msgstr "آیا لرزش‌ها در پوسته فعال باشند یا خیر."

#: ui/VibrationForm.qml:39
#, kde-format
msgid "Vibration Duration"
msgstr "مدت‌زمان لرزش"

#: ui/VibrationForm.qml:40
#, kde-format
msgid "How long shell vibrations should be."
msgstr "مدت‌زمان لرزش‌های پوسته چقدر باشد."

#: ui/VibrationForm.qml:43
#, kde-format
msgctxt "Long duration"
msgid "Long"
msgstr "طولانی"

#: ui/VibrationForm.qml:44
#, kde-format
msgctxt "Medium duration"
msgid "Medium"
msgstr "متوسط"

#: ui/VibrationForm.qml:45
#, kde-format
msgctxt "Short duration"
msgid "Short"
msgstr "کوتاه"

#: ui/VibrationForm.qml:60
#, kde-format
msgid ""
"Keyboard vibrations are controlled separately in the keyboard settings "
"module."
msgstr ""
"لرزش‌های صفحه‌کلید به‌طور جداگانه در بخش تنظیمات صفحه‌کلید کنترل می‌شوند."
