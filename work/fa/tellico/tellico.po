msgid "&Reopen file at startup"
msgstr "باز کردن مجدد پرونده هنگام راه‌اندازی"

#: src/configdialog.cpp:211
#, kde-format
msgid ""
"If checked, the file that was last open will be re-opened at program start-"
"up."
