#: data/org.kde.CrowTranslate.desktop.in:3
msgctxt "Name"
msgid "Crow Translate"
msgstr "مترجم Crow"

#: data/org.kde.CrowTranslate.desktop.in:34
msgctxt "GenericName"
msgid "Translator"
msgstr "مترجم"

#: data/org.kde.CrowTranslate.desktop.in:68
msgctxt "Comment"
msgid ""
"A simple and lightweight translator that allows to translate and speak the "
"selected text using Mozhi"
msgstr ""
"مترجمی ساده و سبک که امکان ترجمه و خواندن متن انتخاب‌شده را با استفاده از "
"Mozhi فراهم می‌کند"

#: data/org.kde.CrowTranslate.desktop.in:99
msgctxt "Keywords"
msgid "google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-speech;"
msgstr ""
"google;yandex;deepl;duckduckgo;libre';mymemory;reverso;text-to-"
"speech;گوگل;یاندکس;دیپ‌ال;متن به گفتار;ترجمه;"

#: data/org.kde.CrowTranslate.desktop.in:143
msgctxt "Name"
msgid "Translate selected text"
msgstr "ترجمهٔ متن انتخاب‌شده"

#: data/org.kde.CrowTranslate.desktop.in:180
msgctxt "Name"
msgid "Speak selected text"
msgstr "خواندن متن انتخاب‌شده"

#: data/org.kde.CrowTranslate.desktop.in:216
msgctxt "Name"
msgid "Speak translation of selected text"
msgstr "خواندن ترجمهٔ متن انتخاب‌شده"

#: data/org.kde.CrowTranslate.desktop.in:252
msgctxt "Name"
msgid "Stop text speaking"
msgstr "توقف خواندن متن"

#: data/org.kde.CrowTranslate.desktop.in:288
msgctxt "Name"
msgid "Show main window"
msgstr "نمایش پنجرهٔ اصلی"

#: data/org.kde.CrowTranslate.desktop.in:325
msgctxt "Name"
msgid "Translate selected text and copy to clipboard"
msgstr "ترجمهٔ متن انتخاب‌شده و رونوشت در تخته‌گیره"

#: data/org.kde.CrowTranslate.desktop.in:360
msgctxt "Name"
msgid "Recognize text in screen area"
msgstr "تشخیص متن در ناحیهٔ صفحه"

#: data/org.kde.CrowTranslate.desktop.in:396
msgctxt "Name"
msgid "Translate text in screen area"
msgstr "ترجمهٔ متن در ناحیهٔ صفحه"

#: data/org.kde.CrowTranslate.desktop.in:432
msgctxt "Name"
msgid "Toggle the option to negate (invert) the captured image before OCR"
msgstr "تغییر وضعیت گزینهٔ نگاتیو (معکوس) کردن تصویر گرفته‌شده پیش از OCR"
