#: src/cli.cpp:78
msgctxt "Cli|"
msgid "translation options:"
msgstr "گزینه‌های ترجمه:"

#: src/cli.cpp:87
msgctxt "Cli|"
msgid "examples:"
msgstr "مثال‌ها:"

#: src/cli.cpp:118
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "نمایش همه کدهای زبان."

#: src/cli.cpp:120
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr ""
"مشخص کردن زبان مبدأ (به‌طور پیش‌فرض، موتور تلاش می‌کند زبان را خودکار تشخیص "
"دهد)."

#: src/cli.cpp:124
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr ""
"مشخص کردن زبان(های) ترجمه، جدا شده با «+» (به‌طور پیش‌فرض از زبان سیستم "
"استفاده می‌شود)."

#: src/cli.cpp:129
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'deepl', "
"'libretranslate', 'mymemory' or 'reverso'), Google is used by default."
msgstr ""
"مشخص کردن موتور مترجم ('google'،‏ 'yandex'،‏ 'bing'،‏ 'deepl'،‏ "
"'libretranslate'،‏ 'mymemory' یا 'reverso')؛ به‌طور پیش‌فرض از Google "
"استفاده می‌شود."

#: src/cli.cpp:133
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr ""
"مشخص کردن نشانی اینترنتی (URL) نمونه Mozhi. به‌طور پیش‌فرض از نشانی تنظیمات "
"برنامه استفاده می‌شود."

#: src/cli.cpp:137
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy', 'mozhi' or 'localai'). Provider from "
"app settings will be used by default."
msgstr ""
"مشخص کردن ارائه‌دهنده ترجمه ('copy'،‏ 'mozhi' یا 'localai'). به‌طور پیش‌فرض "
"از ارائه‌دهنده موجود در تنظیمات برنامه استفاده می‌شود."

#: src/cli.cpp:145
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt' or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"مشخص کردن ارائه‌دهنده متن به گفتار ('none'،‏ 'mozhi'،‏ 'qt' یا 'piper'). "
"به‌طور پیش‌فرض از ارائه‌دهنده موجود در تنظیمات برنامه استفاده می‌شود."

#: src/cli.cpp:147
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi' or 'qt'). Provider from app settings "
"will be used by default."
msgstr ""
"مشخص کردن ارائه‌دهنده متن به گفتار ('none'،‏ 'mozhi' یا 'qt'). به‌طور "
"پیش‌فرض از ارائه‌دهنده موجود در تنظیمات برنامه استفاده می‌شود."

#: src/cli.cpp:149
msgctxt "Cli|"
msgid "Specify TTS provider ('none'). This build has text-to-speech disabled."
msgstr ""
"ارائه‌دهندهٔ تبدیل متن به گفتار (TTS) را مشخص کنید ('none'). تبدیل متن به "
"گفتار در این نسخه غیرفعال است."

#: src/cli.cpp:152
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "خواندن ترجمه."

#: src/cli.cpp:153
msgctxt "Cli|"
msgid "Speak the source."
msgstr "خواندن متن مبدأ."

#: src/cli.cpp:154
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr ""
"خواندن متن مبدأ از پرونده‌ها. آرگومان‌ها به عنوان مسیر پرونده در نظر گرفته "
"می‌شوند."

#: src/cli.cpp:155
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "افزودن داده‌های stdin به متن مبدأ."

#: src/cli.cpp:157
msgctxt "Cli|"
msgid "Read source text from an image using the configured OCR engine."
msgstr "خواندن متن مبدأ از یک تصویر با استفاده از موتور OCR پیکربندی‌شده."

#: src/cli.cpp:158
msgctxt "Cli|"
msgid "path"
msgstr "مسیر"

#: src/cli.cpp:160
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "هنگام استفاده از ‎--%1‎ یا ‎--%2‎ هیچ متنی چاپ نشود."

#: src/cli.cpp:161
msgctxt "Cli|"
msgid "Print only translations."
msgstr "فقط ترجمه‌ها چاپ شوند."

#: src/cli.cpp:162
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "چاپ خروجی با قالب‌بندی JSON."

#: src/cli.cpp:168
msgctxt "Cli|"
msgid ""
"Which frontend to run ('gui' or 'cli'). Defaults to 'cli' whenever any "
"argument is given."
msgstr ""
"اجرای کدام رابط کاربری («gui» یا «cli»). در صورت ارائه هرگونه آرگومان، "
"پیش‌فرض روی «cli» است."

#: src/cli.cpp:169
msgctxt "Cli|"
msgid "frontend"
msgstr "رابط کاربری"

#: src/cli.cpp:173
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr "برنامه‌ای برای ترجمه و تلفظ متن با استفاده از ارائه‌دهندگان گوناگون"

#: src/cli.cpp:174
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
"language."
msgstr "متن جهت ترجمه. به‌طور پیش‌فرض، ترجمه به زبان سیستم انجام خواهد شد."

