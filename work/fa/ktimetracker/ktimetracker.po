#: base/timetrackerwidget.cpp:492
#, kde-format
msgctxt "@title:window"
msgid "New Task"
msgstr "تکلیف جدید"

#: base/timetrackerwidget.cpp:569
#, kde-format
msgctxt "@info in message box"
msgid ""
"There is no history yet. Start and stop a task and you will have an entry in"
" your history."
msgstr ""
"هنوز هیچ تاریخچه‌ای وجود ندارد. یک تکلیف را شروع و متوقف کنید تا مدخلی در "
"تاریخچه داشته باشید."

#: base/timetrackerwidget.cpp:579
#, kde-format
msgid ""
"Do you really want to reset the time to zero for all tasks? This will delete"
" the entire history."
msgstr ""
"آیا واقعاً می‌خواهید زمان را برای همهٔ تکلیف‌ها به صفر بازنشانی کنید؟ این "
"کار تمام تاریخچه را حذف خواهد کرد."

#: base/timetrackerwidget.cpp:581
#, kde-format
msgctxt "@title:window"
msgid "Confirmation Required"
msgstr "تأیید لازم است"

#: base/timetrackerwidget.cpp:582
#, kde-format
msgctxt "@action:button"
msgid "Reset All Times"
msgstr "بازنشانی همهٔ زمان‌ها"

#: base/timetrackerwidget.cpp:770
#, kde-format
msgid "Save failed, most likely because the file could not be locked."
msgstr ""
"ذخیره‌سازی ناموفق بود، احتمالاً به این دلیل که قفل کردن پرونده امکان‌پذیر "
"نبود."

#: base/timetrackerwidget.cpp:772
#, kde-format
msgid "Could not modify calendar resource."
msgstr "تغییر منبع تقویم امکان‌پذیر نبود."

#: base/timetrackerwidget.cpp:774
#, kde-format
msgid "Out of memory--could not create object."
msgstr "کمبود حافظه--ایجاد شیء امکان‌پذیر نبود."

#: base/timetrackerwidget.cpp:776
#, kde-format
msgid "UID not found."
msgstr "شناسهٔ کاربر (UID) پیدا نشد."

#: base/timetrackerwidget.cpp:778
#, kde-format
msgid "Invalidate date--format is YYYY-MM-DD."
msgstr "تاریخ نامعتبر است--قالب YYYY-MM-DD است."

#: base/timetrackerwidget.cpp:780
#, kde-format
msgid "Invalid time--format is YYYY-MM-DDTHH:MM:SS."
msgstr "زمان نامعتبر است--قالب YYYY-MM-DDTHH:MM:SS است."

#: base/timetrackerwidget.cpp:782
#, kde-format
msgid "Invalid task duration--must be greater than zero."
msgstr "مدت‌زمان کار نامعتبر است--باید بیشتر از صفر باشد."

#: base/timetrackerwidget.cpp:784
#, kde-format
msgid "Invalid error number: %1"
msgstr "شماره خطای نامعتبر: %1"

#: base/timetrackerwidget.cpp:1008
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This is ktimetracker, KDE's program to help you track your time. Best, start"
" with creating your first task - enter it into the field where you see "
"\"Search or add task\"."
msgstr ""
"این ktimetracker است، برنامه‌ای از KDE برای کمک به پیگیری زمان شما. بهتر است"
" با ایجاد اولین کار خود شروع کنید - آن را در فیلدی که «جستجو یا افزودن کار» "
"را می‌بینید وارد کنید."

#: base/timetrackerwidget.cpp:1015
#, kde-format
msgctxt "@info:whatsthis"
msgid "You have already created a task. You can now start and stop timing."
msgstr ""
"شما قبلاً یک کار ایجاد کرده‌اید. اکنون می‌توانید زمان‌سنجی را شروع و متوقف "
"کنید."

#: base/tray.cpp:79
