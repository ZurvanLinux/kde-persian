#: ui/sonnetui.ui:206
msgctxt "SonnetUi|"
msgid "S&uggest"
msgstr "پیشنهاد"

#: ui/sonnetui.ui:213
msgctxt "SonnetUi|"
msgid ""
"<qt>\n"
"<p>Click here to replace this occurrence of the unknown text with the text in the edit box above (to the left).</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>برای جایگزین کردن این مورد از متن ناشناخته با متن موجود در کادر ویرایش بالا (سمت چپ)، اینجا کلیک کنید.</p>\n"
"</qt>"

#: ui/sonnetui.ui:218
msgctxt "SonnetUi|"
msgid "&Replace"
msgstr "جایگزینی"

#: ui/sonnetui.ui:225
msgctxt "SonnetUi|"
msgid ""
"<qt>\n"
"<p>Click here to replace all occurrences of the unknown text with the text in the edit box above (to the left).</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>برای جایگزین کردن همهٔ موارد متن ناشناخته با متن موجود در کادر ویرایش بالا (سمت چپ)، اینجا کلیک کنید.</p>\n"
"</qt>"

#: ui/sonnetui.ui:230
msgctxt "SonnetUi|"
msgid "R&eplace All"
msgstr "جایگزینی همه"

#: ui/sonnetui.ui:237
msgctxt "SonnetUi|"
msgid ""
"<qt>\n"
"<p>Click here to let this occurrence of the unknown word remain as is.</p>\n"
"<p>This action is useful when the word is a name, an acronym, a foreign word or any other unknown word that you want to use but not add to the dictionary.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>برای بدون تغییر باقی ماندن این مورد از واژهٔ ناشناخته، اینجا کلیک کنید.</p>\n"
"<p>این عمل زمانی مفید است که واژه یک نام، کوته‌نوشت، واژه‌ای بیگانه یا هر واژهٔ ناشناختهٔ دیگری باشد که می‌خواهید از آن استفاده کنید ولی به فرهنگ لغت اضافه نشود.</p>\n"
"</qt>"

#: ui/sonnetui.ui:243
msgctxt "SonnetUi|"
msgid "&Ignore"
msgstr "نادیده گرفتن"

#: ui/sonnetui.ui:250 ui/sonnetui.ui:263
msgctxt "SonnetUi|"
msgid ""
"<qt>\n"
"<p>Click here to let all occurrences of the unknown word remain as they are.</p>\n"
"<p>This action is useful when the word is a name, an acronym, a foreign word or any other unknown word that you want to use but not add to the dictionary.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>برای باقی ماندن تمام موارد واژهٔ ناشناخته به همان صورت قبلی، اینجا را کلیک کنید.</p>\n"
"<p>این عمل هنگامی مفید است که واژه یک نام، کوته‌نوشت، واژه‌ای بیگانه یا هر واژهٔ ناشناختهٔ دیگری باشد که می‌خواهید از آن استفاده کنید ولی به لغت‌نامه اضافه نشود.</p>\n"
"</qt>"

#: ui/sonnetui.ui:256
msgctxt "SonnetUi|"
msgid "I&gnore All"
msgstr "نادیده گرفتن همه"

#: ui/sonnetui.ui:269
