#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "محمد شفیعی سروستانی"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "muhammad.shafiee@gmail.com"

#: downloadjob.cpp:147
#, kde-format
msgid ""
"This type of file can harm your computer. If you want to keep it, accept "
"this download from the browser window."
msgstr ""
"این نوع پرونده می‌تواند به رایانهٔ شما آسیب برساند. اگر می‌خواهید آن را نگه "
"دارید، این بارگیری را از پنجرهٔ مرورگر بپذیرید."

#: downloadjob.cpp:244
#, kde-format
msgid "Access denied."
msgstr "دسترسی رد شد."

#: downloadjob.cpp:245
#, kde-format
msgid "Insufficient free space."
msgstr "فضای خالی کافی نیست."

#: downloadjob.cpp:246
#, kde-format
msgid "The file name you have chosen is too long."
msgstr "نام پرونده‌ای که انتخاب کرده‌اید بیش از حد طولانی است."

#: downloadjob.cpp:247
#, kde-format
msgid "The file is too large to be downloaded."
msgstr "پرونده برای بارگیری بیش از حد بزرگ است."

#: downloadjob.cpp:249
#, kde-format
msgid "The file possibly contains malicious contents."
msgstr "پرونده احتمالاً حاوی محتوای مخرب است."

#: downloadjob.cpp:250
#, kde-format
msgid "A temporary error has occurred. Please try again later."
msgstr "خطایی موقت رخ داد. لطفاً بعداً دوباره امتحان کنید."

#: downloadjob.cpp:252
#, kde-format
msgid "A network error has occurred."
msgstr "خطای شبکه رخ داد."

#: downloadjob.cpp:253
#, kde-format
msgid "The network operation timed out."
msgstr "مهلت عملیات شبکه به پایان رسید."

#: downloadjob.cpp:254
#, kde-format
msgid "The network connection has been lost."
msgstr "اتصال شبکه قطع شده است."

#: downloadjob.cpp:255
#, kde-format
msgid "The server is no longer reachable."
msgstr "سرور دیگر در دسترس نیست."

#: downloadjob.cpp:257
#, kde-format
msgid "A server error has occurred."
msgstr "خطایی در سرور رخ داده است."

#: downloadjob.cpp:261
#, kde-format
msgid "The server does not have the requested data."
msgstr "سرور داده‌های درخواستی را ندارد."

#: downloadjob.cpp:263
#, kde-format
msgid "The browser application closed unexpectedly."
msgstr "برنامه مرورگر به طور غیرمنتظره‌ای بسته شد."

#: downloadjob.cpp:269
#, kde-format
msgid "An unknown error occurred while downloading."
msgstr "هنگام بارگیری خطای ناشناخته‌ای روی داد."

#: downloadjob.cpp:307
#, kde-format
msgctxt "Job heading, like 'Copying'"
msgid "Downloading"
msgstr "در حال بارگیری"

#: downloadjob.cpp:308
#, kde-format
msgctxt "The URL being downloaded"
msgid "Source"
msgstr "مبدأ"

#: downloadjob.cpp:309
#, kde-format
msgctxt "The location being downloaded to"
msgid "Destination"
msgstr "مقصد"

#: historyrunnerplugin.cpp:108
#, kde-format
msgctxt "Dummy search result"
msgid "Additional permissions are required"
msgstr "مجوزهای بیشتری لازم است"

#: tabsrunnerplugin.cpp:38
#, kde-format
msgid "Mute Tab"
msgstr "بی‌صدا کردن برگه"

#: tabsrunnerplugin.cpp:43
#, kde-format
msgid "Unmute Tab"
msgstr "صدا دار کردن برگه"
