msgstr "کنترل‌های رسانه پیشرفته"

#: options_plugin_mpris_title:0
msgctxt "Title for Media Controls plugin"
msgid "Media Controls"
msgstr "کنترل‌های رسانه"

#: options_plugin_purpose_description:0
