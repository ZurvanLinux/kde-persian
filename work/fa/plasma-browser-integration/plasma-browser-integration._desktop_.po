#: host/org.kde.plasma.browser_integration.host.desktop.in:3
msgctxt "Name"
msgid "Plasma Browser Integration Host"
msgstr "میزبان یکپارچه‌سازی مرورگر پلاسما"

#: host/plasma-runner-browserhistory.desktop:3
msgctxt "Name|plasma runner"
msgid "Browser History"
msgstr "تاریخچهٔ مرورگر"

#: host/plasma-runner-browserhistory.desktop:55
msgctxt "Comment"
msgid "Search the browser history for visited websites"
msgstr "جست‌وجوی وبگاه‌های بازدیدشده در تاریخچهٔ مرورگر"

#: host/plasma-runner-browserhistory.desktop:122
msgctxt "X-Plasma-Runner-Syntax-Descriptions"
msgid "Finds websites in the browser history whose title or URL match :q:"
msgstr ""
"وبگاه‌هایی را در تاریخچهٔ مرورگر می‌یابد که عنوان یا نشانی اینترنتی آن‌ها با"
" :q: همخوانی دارد"

#: host/plasma-runner-browsertabs.desktop:3
msgctxt "Name|plasma runner"
msgid "Browser Tabs"
msgstr "تب‌های مرورگر"

#: host/plasma-runner-browsertabs.desktop:55
msgctxt "Comment"
msgid "Find and activate browser tabs"
msgstr "یافتن و فعال‌سازی تب‌های مرورگر"

#: host/plasma-runner-browsertabs.desktop:123
msgctxt "X-Plasma-Runner-Syntax-Descriptions"
msgid "Finds open browser tabs whose title or URL match :q:"
msgstr ""
"تب‌های باز مرورگر را می‌یابد که عنوان یا نشانی اینترنتی آن‌ها با :q: همخوانی"
" دارد"
