#: MainWindow/FeatureDialog.cpp:59
#, kde-format
msgid "<h1>Overview</h1><p>Optional features in KPhotoAlbum:</p>%1"
msgstr "<h1>نمای کلی</h1><p>ویژگی‌های اختیاری در KPhotoAlbum:</p>%1"

#: MainWindow/FeatureDialog.cpp:65
#, kde-format
msgid ""
"<h1>Build time features</h1><p>Build time features are optional features "
"that need to be enabled when building KPhotoAlbum.</p><p>If you built "
"KPhotoAlbum yourself, please check the <a "
"href=\"https://community.kde.org/KPhotoAlbum/build_instructions\">build "
"instructions</a> if you missed something. If you need help compiling "
"KPhotoAlbum, feel free to ask on the <a href=\"https://mail.kde.org/cgi-"
"bin/mailman/listinfo/kphotoalbum\">KPhotoAlbum mailing list</a> for "
"help.</p><p>If you installed KPhotoAlbum from the package manager or an app "
"store, you can file a bug report with the supplier of the package.</>"
msgstr ""
"<h1>ویژگی‌های زمان ساخت</h1><p>ویژگی‌های زمان ساخت، ویژگی‌های اختیاری هستند "
"که باید هنگام ساخت KPhotoAlbum فعال شوند.</p><p>اگر خودتان KPhotoAlbum را "
"می‌سازید، لطفاً <a "
"href=\"https://community.kde.org/KPhotoAlbum/build_instructions\">دستورالعمل‌های"
" ساخت</a> را بررسی کنید تا ببینید چیزی جا نمانده باشد. اگر برای کامپایل "
"KPhotoAlbum به کمک نیاز دارید، می‌توانید در <a "
"href=\"https://mail.kde.org/cgi-bin/mailman/listinfo/kphotoalbum\">فهرست "
"پستی KPhotoAlbum</a> درخواست کمک کنید.</p><p>اگر KPhotoAlbum را از مدیر "
"بسته‌ها یا فروشگاه برنامه نصب کرده‌اید، می‌توانید گزارش خطا را به "
"ارائه‌دهنده بسته ارسال کنید.</>"

#: MainWindow/FeatureDialog.cpp:79
#, kde-format
msgid ""
"<h2><a name=\"purpose\">Purpose plugin support</a></h2><p>KPhotoAlbum "
"supports the <em>Purpose</em> plugin system which is part of KDE "
"Frameworks.</p>"
msgstr ""
"<h2><a name=\"purpose\">پشتیبانی از افزونه Purpose</a></h2><p>برنامه "
"KPhotoAlbum از سامانه افزونه <em>Purpose</em> که بخشی از چارچوب‌های KDE است "
"پشتیبانی می‌کند.</p>"

#: MainWindow/FeatureDialog.cpp:83
#, kde-format
msgid ""
"<h2><a name=\"geomap\">Map view for geotagged images</a></h2><p>If "
"KPhotoAlbum has been built with support for Marble, KPhotoAlbum can show "
"images with GPS information on a map.</p>"
msgstr ""
"<h2><a name=\"geomap\">نمای نقشه برای تصاویر دارای برچسب "
"جغرافیایی</a></h2><p>اگر KPhotoAlbum با پشتیبانی از Marble ساخته شده باشد، "
"می‌تواند تصاویر دارای اطلاعات GPS را روی نقشه نمایش دهد.</p>"

#: MainWindow/FeatureDialog.cpp:88
#, kde-format
msgid ""
"<h1>Run time features</h1><p>Run time features are optional features that "
"depend on another package or program being available during runtime. I.e. "
"you can enable these features by installing the right package.</p>"
msgstr ""
"<h1>ویژگی‌های زمان اجرا</h1><p>ویژگی‌های زمان اجرا، ویژگی‌های اختیاری هستند "
"که به وجود بسته یا برنامه‌ای دیگر در طول زمان اجرا وابسته‌اند. یعنی "
"می‌توانید با نصب بسته مناسب، این ویژگی‌ها را فعال کنید.</p>"

#: MainWindow/FeatureDialog.cpp:94
#, kde-format
msgid ""
"<h2><a name=\"database\">SQLite database support</a></h2><p>KPhotoAlbum "
"allows you to search using a certain number of Exif tags.</p><p>This feature"
" is only available if the Qt SQLite driver is installed. On Debian-based "
"distributions this package is usually called libqt6sql6-sqlite.</p>"
msgstr ""
"<h2><a name=\"database\">پشتیبانی از پایگاه داده SQLite</a></h2><p>برنامه "
"KPhotoAlbum به شما امکان می‌دهد با استفاده از تعداد مشخصی برچسب Exif جستجو "
"کنید.</p><p>این ویژگی تنها در صورتی در دسترس است که درایور SQLite مربوط به "
"Qt نصب شده باشد. در توزیع‌های مبتنی بر دبیان، این بسته معمولاً "
"libqt6sql6-sqlite نامیده می‌شود.</p>"

#: MainWindow/FeatureDialog.cpp:102
#, kde-format
msgid ""
"<h2><a name=\"video\">Video support</a></h2><p>KPhotoAlbum relies on phonon "
"or VLC for displaying videos</p><h2><a name=\"videoPreview\">Video thumbnail"
" support</a></h2><p>KPhotoAlbum can use <tt>ffmpeg</tt> to extract "
"thumbnails from videos. These thumbnails are used to preview videos in the "
"thumbnail viewer.</p><p>This feature is only available if FFmpeg is "
"installed.</p><h2><a name=\"videoInfo\">Video metadata "
"support</a></h2><p>KPhotoAlbum can use <tt>ffprobe</tt> to extract length "
"information from videos. Correct length information is necessary for correct"
" rendering of video thumbnails.</p><p>This feature is only available if "
"ffprobe is installed. Usually, ffprobe is also part of the FFmpeg "
"package.</p>"
msgstr ""
"<h2><a name=\"video\">پشتیبانی از ویدیو</a></h2><p>برنامه KPhotoAlbum برای "
"نمایش ویدیوها به phonon یا VLC متکی است</p><h2><a "
"name=\"videoPreview\">پشتیبانی از بندانگشتی ویدیو</a></h2><p>برنامه "
"KPhotoAlbum می‌تواند از <tt>ffmpeg</tt> برای استخراج بندانگشتی از ویدیوها "
"استفاده کند. این تصاویر بندانگشتی برای پیش‌نمایش ویدیوها در نمایشگر "
"بندانگشتی‌ها استفاده می‌شوند.</p><p>این ویژگی تنها در صورتی موجود است که "
"FFmpeg نصب شده باشد.</p><h2><a name=\"videoInfo\">پشتیبانی از متاداده "
"ویدیو</a></h2><p>برنامه KPhotoAlbum می‌تواند از <tt>ffprobe</tt> برای "
"استخراج اطلاعات مدت‌زمان ویدیوها استفاده کند. اطلاعات دقیق مدت‌زمان برای "
"رندر صحیح بندانگشتی‌های ویدیویی لازم است.</p><p>این ویژگی تنها در صورتی "
"موجود است که ffprobe نصب شده باشد. معمولاً ffprobe بخشی از بسته FFmpeg "
"است.</p>"

