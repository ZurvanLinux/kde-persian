#: skgbasemodeler/skgdocument.cpp:627
#, kde-format
msgctxt "Something went wrong with SQL transactions"
msgid "A transaction cannot be started during execution of another one"
msgstr "شروع یک تراکنش در حین اجرای تراکنشی دیگر امکان‌پذیر نیست"

#: skgbasemodeler/skgdocument.cpp:661
#, kde-format
msgctxt "Something went wrong with SQL transactions"
