#: core/copyjob.cpp:197 kioworkers/file/file_unix.cpp:612
#, kde-format
msgctxt ""
"The first arg is the path to the symlink that couldn't be created, the "
"secondarg is the filesystem type (e.g. vfat, exfat)"
msgid ""
"Could not create symlink \"%1\".\n"
"The destination filesystem (%2) doesn't support symlinks."
msgstr ""
"ایجاد پیوند نمادین «%1» امکان‌پذیر نبود.\n"
"سامانهٔ پروندهٔ مقصد (%2) از پیوندهای نمادین پشتیبانی نمی‌کند."

#: core/copyjob.cpp:209
#, kde-format
msgid ""
"Could not create \"%1\".\n"
"The destination filesystem (%2) disallows the following characters in folder names: %3\n"
"Selecting Replace will replace any invalid characters (in the destination folder name) with an underscore \"_\"."
msgstr ""
"ایجاد «%1» امکان‌پذیر نبود.\n"
"سامانهٔ پروندهٔ مقصد (%2) نویسه‌های زیر را در نام پوشه‌ها مجاز نمی‌داند: %3\n"
"انتخاب جایگزینی، هر نویسهٔ نامعتبر (در نام پوشهٔ مقصد) را با زیرخط «_» جایگزین می‌کند."

#: core/copyjob.cpp:217
#, kde-format
msgid ""
"Could not create \"%1\".\n"
"The destination filesystem (%2) disallows the following characters in file names: %3\n"
"Selecting Replace will replace any invalid characters (in the destination file name) with an underscore \"_\"."
msgstr ""
"ایجاد «%1» امکان‌پذیر نبود.\n"
"سامانهٔ پروندهٔ مقصد (%2) نویسه‌های زیر را در نام پرونده‌ها مجاز نمی‌داند: %3\n"
"انتخاب جایگزینی، هر نویسهٔ نامعتبر (در نام پروندهٔ مقصد) را با زیرخط «_» جایگزین می‌کند."

