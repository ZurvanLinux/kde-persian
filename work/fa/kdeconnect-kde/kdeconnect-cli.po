msgstr "از قبل جفت شده است"

#: kdeconnect-cli.cpp:298
#, kde-format
msgid "Pair requested"
msgstr "درخواست جفت‌سازی ارسال شد"

#: kdeconnect-cli.cpp:308
#, kde-format
msgid "Already not paired"
msgstr "از قبل جفت نشده است"

