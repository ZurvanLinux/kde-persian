#: kdeconnect-cli.cpp:37
#, kde-format
msgid ""
"No device specified: Use -d <Device ID> or -n <Device Name> to specify a device. \n"
"Device ID's and names may be found using \"kdeconnect-cli -l\" \n"
"View complete help with --help option"
msgstr ""
"هیچ دستگاهی مشخص نشده است: از ‎-d <Device ID>‎ یا ‎-n <Device Name>‎ برای مشخص‌کردن یک دستگاه استفاده کنید.\n"
"شناسه‌ها و نام‌های دستگاه‌ها را می‌توان با استفاده از دستور «kdeconnect-cli -l» پیدا کرد.\n"
"برای مشاهده راهنمای کامل، گزینه ‎--help‎ را ببینید."

#: kdeconnect-cli.cpp:57
#, kde-format
msgid "KDE Connect CLI tool"
msgstr "ابزار خط فرمان کی‌دی‌ای کانکت"

#: kdeconnect-cli.cpp:59
#, kde-format
msgid "© 2015–2025, KDE Connect Team"
msgstr "© 2015–2025, KDE Connect Team"

#: kdeconnect-cli.cpp:60
#, kde-format
msgid "Aleix Pol Gonzalez"
msgstr "Aleix Pol Gonzalez"

#: kdeconnect-cli.cpp:61
#, kde-format
msgid "Albert Vaca Cintora"
msgstr "Albert Vaca Cintora"

#: kdeconnect-cli.cpp:67
#, kde-format
msgid "List all devices"
msgstr "فهرست‌کردن همه دستگاه‌ها"

#: kdeconnect-cli.cpp:69
#, kde-format
msgid "List available (paired and reachable) devices"
msgstr "فهرست‌کردن دستگاه‌های در دسترس (جفت‌شده و در دسترس)"

#: kdeconnect-cli.cpp:70
#, kde-format
msgid "List all backends and status"
msgstr "فهرست‌کردن همه پس‌انه‌ها و وضعیت آن‌ها"

#: kdeconnect-cli.cpp:71
#, kde-format
msgid "Enable the specified backend"
msgstr "فعال‌کردن پس‌انه مشخص‌شده"

#: kdeconnect-cli.cpp:71 kdeconnect-cli.cpp:72
#, kde-format
msgid "backend"
msgstr "پسانجام"

#: kdeconnect-cli.cpp:72
#, kde-format
msgid "Disable the specified backend"
msgstr "غیرفعال کردن پسانجام مشخص‌شده"

#: kdeconnect-cli.cpp:74
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices id, to ease "
"scripting"
msgstr ""
"تنظیم ‎--list-devices یا ‎--list-available برای چاپ فقط شناسهٔ دستگاه‌ها، "
"جهت تسهیل اسکریپت‌نویسی"

#: kdeconnect-cli.cpp:76
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices name, to ease"
" scripting"
msgstr ""
"تنظیم ‎--list-devices یا ‎--list-available برای چاپ فقط نام دستگاه‌ها، جهت "
"تسهیل اسکریپت‌نویسی"

#: kdeconnect-cli.cpp:78
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices id and name, "
"to ease scripting"
msgstr ""
"تنظیم ‎--list-devices یا ‎--list-available برای چاپ فقط شناسه و نام "
"دستگاه‌ها، جهت تسهیل اسکریپت‌نویسی"

#: kdeconnect-cli.cpp:79
#, kde-format
msgid "Search for devices in the network and re-establish connections"
msgstr "جستجوی دستگاه‌ها در شبکه و برقراری مجدد اتصالات"

#: kdeconnect-cli.cpp:80
#, kde-format
msgid "Request pairing with device"
msgstr "درخواست جفت‌شدن با دستگاه"

#: kdeconnect-cli.cpp:81
#, kde-format
msgid "Find device by ringing it"
msgstr "یافتن دستگاه با زنگ زدن به آن"

#: kdeconnect-cli.cpp:82
#, kde-format
msgid "Unpair from device"
msgstr "لغو جفت‌شدن با دستگاه"

#: kdeconnect-cli.cpp:83
#, kde-format
msgid "Send ping to device"
msgstr "ارسال پینگ به دستگاه"

#: kdeconnect-cli.cpp:84
#, kde-format
msgid "Same as ping but you can set the message to display"
msgstr "مشابه پینگ، با این تفاوت که می‌توانید پیام نمایشی را تنظیم کنید"

#: kdeconnect-cli.cpp:84 kdeconnect-cli.cpp:91
#, kde-format
msgid "message"
msgstr "پیام"

#: kdeconnect-cli.cpp:85
#, kde-format
msgid "Send clipboard to device"
msgstr "ارسال کلیپ‌بورد به دستگاه"

#: kdeconnect-cli.cpp:86
#, kde-format
msgid "Share file/URL to device"
msgstr "هم‌رسانی پرونده/نشانی وب با دستگاه"

#: kdeconnect-cli.cpp:87
#, kde-format
msgid "Share text to device"
msgstr "هم‌رسانی متن با دستگاه"

#: kdeconnect-cli.cpp:88
#, kde-format
msgid "Display notifications on device"
msgstr "نمایش اعلان‌ها در دستگاه"

#: kdeconnect-cli.cpp:89
#, kde-format
msgid "Lock the specified device"
msgstr "قفل کردن دستگاه مشخص‌شده"

#: kdeconnect-cli.cpp:90
#, kde-format
msgid "Unlock the specified device"
msgstr "باز کردن قفل دستگاه مشخص‌شده"

#: kdeconnect-cli.cpp:91
#, kde-format
msgid "Sends an SMS. Requires destination"
msgstr "پیامک می‌فرستد. نیازمند مقصد است"

#: kdeconnect-cli.cpp:92
#, kde-format
msgid "Phone number to send the message"
msgstr "شماره تلفن برای ارسال پیام"

#: kdeconnect-cli.cpp:92
#, kde-format
msgid "phone number"
msgstr "شمارهٔ تلفن"

#: kdeconnect-cli.cpp:94
#, kde-format
msgid ""
"File URLs to send attachments with the message (can be passed multiple "
"times)"
msgstr ""
"نشانی‌های اینترنتی فایل برای ارسال پیوست‌ها همراه با پیام (می‌تواند چند بار "
"وارد شود)"

#: kdeconnect-cli.cpp:95
#, kde-format
msgid "file URLs"
msgstr "نشانی‌های اینترنتی فایل"

#: kdeconnect-cli.cpp:96
#, kde-format
msgid "Device ID"
msgstr "شناسهٔ دستگاه"

#: kdeconnect-cli.cpp:97
#, kde-format
msgid "Device Name"
msgstr "نام دستگاه"

#: kdeconnect-cli.cpp:98
#, kde-format
msgid "Get encryption info about device"
msgstr "دریافت اطلاعات رمزگذاری دربارهٔ دستگاه"

#: kdeconnect-cli.cpp:99
#, kde-format
msgid "List remote commands and their ids"
msgstr "فهرست کردن دستورهای از راه دور و شناسه‌های آن‌ها"

#: kdeconnect-cli.cpp:100
#, kde-format
msgid "Execute remote command by id"
msgstr "اجرای فرمان از راه دور بر اساس شناسه"

#: kdeconnect-cli.cpp:101
#, kde-format
msgid "Send keys to device"
msgstr "ارسال کلیدها به دستگاه"

#: kdeconnect-cli.cpp:102
#, kde-format
msgid "Display this device's id and exit"
msgstr "نمایش شناسهٔ این دستگاه و خروج"

#: kdeconnect-cli.cpp:103
#, kde-format
msgid "Mount filesystem of a said device"
msgstr "سوار کردن سامانهٔ پرونده یک دستگاه مشخص"

#: kdeconnect-cli.cpp:104
#, kde-format
msgid "Print mount point for the filesystem of a said device"
msgstr "چاپ نقطهٔ سوار کردن برای سامانهٔ پرونده یک دستگاه مشخص"

#: kdeconnect-cli.cpp:153
#, kde-format
