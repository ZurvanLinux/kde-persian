#: kdeconnect-cli.cpp:281
#, kde-format
msgid "waiting for device…"
msgstr "در حال انتظار برای دستگاه…"

#: kdeconnect-cli.cpp:294
#, kde-format
msgid "Device not found"
msgstr "دستگاه پیدا نشد"

