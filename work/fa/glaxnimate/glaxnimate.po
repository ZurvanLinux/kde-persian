#: data/plugins/FrameByFrame/create_frames.ui:18
#, kde-format
msgid "Create frame layers"
msgstr "ایجاد لایه‌های فریم"

#. i18n: ectx: property (plainText), widget (QPlainTextEdit, plainTextEdit)
#: data/plugins/FrameByFrame/create_frames.ui:34
#, kde-format
msgid ""
"This dialog creates layer to help with frame by frame animation.\n"
"\n"
"You specify the time range you want to split into frames, and the number of frames you want.\n"
"\n"
"Then layers are created that appear in and out at uniform time intervals. You can use these layers for frame-by-frame animation."
msgstr ""
"این پنجره برای کمک به پویانمایی فریم‌به‌فریم، لایه ایجاد می‌کند.\n"
"\n"
"شما بازه زمانی مورد نظر برای تقسیم به فریم‌ها و تعداد فریم‌های دلخواه را مشخص می‌کنید.\n"
"\n"
"سپس لایه‌هایی ایجاد می‌شوند که در فواصل زمانی یکنواخت ظاهر و ناپدید می‌شوند. می‌توانید از این لایه‌ها برای پویانمایی فریم‌به‌فریم استفاده کنید."

#. i18n: ectx: property (text), widget (QLabel, label)
#: data/plugins/FrameByFrame/create_frames.ui:43
#, kde-format
msgid "Begin"
msgstr "شروع"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: data/plugins/FrameByFrame/create_frames.ui:60
#, kde-format
msgid "End"
msgstr "پایان"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#: data/plugins/FrameByFrame/create_frames.ui:77
#, kde-format
msgid "Number of frames"
msgstr "تعداد فریم‌ها"

