#. i18n: ectx: property (html), widget (QTextEdit, textEdit)
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:141
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">k-Means divides the colors into clusters and refines the assignment at every iteration.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br /></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This is the best option when tracing images with a lot of colors or shading.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br /></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">For pictures with a lot of colors increasing the number of iterations will yield better results but it might be slower.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br /></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The <span style=\" font-style:italic;\">Match</span> option performs some post-processing:</p>\n"
"<ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\"><li style=\"\" style=\" margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">None</span>: Don't perform any post-processing and return the means (note this might result in colors not present in the original image)</li>\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Closest</span>: Find the color in the original image that is the closest to the mean</li>\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Most Frequent</span>: Find the color in the cluster that appears most often in the source image</li></ul></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">روش k-Means رنگ‌ها را به خوشه‌ها تقسیم می‌کند و در هر تکرار تخصیص‌ها را بهبود می‌بخشد.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br /></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">این بهترین گزینه هنگام ردگیری تصاویری با رنگ‌های فراوان یا سایه‌روشن است.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br /></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">برای تصاویری با رنگ‌های بسیار، افزایش تعداد تکرارها نتایج بهتری به همراه خواهد داشت اما ممکن است سرعت پردازش را کاهش دهد.</p>\n"
"<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br /></p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">گزینهٔ <span style=\" font-style:italic;\">تطبیق</span> نوعی پس‌پردازش انجام می‌دهد:</p>\n"
"<ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\"><li style=\"\" style=\" margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">هیچ‌کدام</span>: هیچ پس‌پردازشی انجام نشود و میانگین‌ها برگردانده شوند (توجه کنید این کار ممکن است منجر به ایجاد رنگ‌هایی شود که در تصویر اصلی وجود ندارند)</li>\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">نزدیک‌ترین</span>: یافتن رنگی در تصویر اصلی که نزدیک‌ترین به مقدار میانگین است</li>\n"
"<li style=\"\" style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">بیشترین تکرار</span>: یافتن رنگی در خوشه که بیشترین فراوانی را در تصویر اصلی دارد</li></ul></body></html>"

#. i18n: ectx: property (plainText), widget (QPlainTextEdit, plainTextEdit)
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:159
#, kde-format
msgid ""
"k-Modes gives you the colors that appear most often in the source image.\n"
"\n"
"It's very fast but it does not give accurate colors for complex images.\n"
"\n"
"This is the best option when tracing images with flat colors."
msgstr ""
"الگوریتم k-Modes رنگ‌هایی را که بیشترین تکرار را در تصویر مبدأ دارند استخراج می‌کند.\n"
"\n"
"این روش بسیار سریع است اما رنگ‌های دقیقی برای تصاویر پیچیده ارائه نمی‌دهد.\n"
"\n"
"این بهترین گزینه برای ردگیری (ترِیس) تصاویری با رنگ‌های تخت (فلت) است."

#. i18n: ectx: property (html), widget (QTextEdit, textEdit_2)
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:178
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The Octree algorithm merges similar colors from the bottom up.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">It gives more accurate colors for complex images but it might result into colors that are not present in the source image.</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">الگوریتم Octree رنگ‌های مشابه را از پایین به بالا ادغام می‌کند.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">این روش رنگ‌های دقیق‌تری برای تصاویر پیچیده به دست می‌دهد اما ممکن است به تولید رنگ‌هایی منجر شود که در تصویر مبدأ وجود ندارند.</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, label_4)
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:189
#, kde-format
msgid "Min Frequency"
msgstr "حداقل فراوانی"

#. i18n: ectx: property (html), widget (QTextEdit, textEdit_3)
#: src/gui/widgets/dialogs/color_quantization_dialog.ui:205
#, kde-format
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Edge Exclusion Modes takes the most frequent color (mode) in the image, then excludes all pixels touching said area, then repeats the process until the appropriate number of colors has been found.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">This approach removes anti-aliased edges but it might cause small details to not be detected.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Min Frequency</span> refers to the minimum amount of pixels that a color must have to be considered (as a percentage of the total number of pixels in the image).</p></body></html>"
msgstr ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Noto Sans'; font-size:10pt; font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">حالت‌های Edge Exclusion پربسامدترین رنگ (نما یا مد) را در تصویر می‌گیرد، سپس همهٔ پیکسل‌های مجاور با آن ناحیه را حذف می‌کند و سپس این فرایند را تکرار می‌کند تا تعداد رنگ‌های مناسب پیدا شود.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">این رویکرد لبه‌های anti-alias شده را حذف می‌کند، اما ممکن است باعث شود جزئیات کوچک تشخیص داده نشوند.</p>\n"
"<p style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">حداقل فراوانی</span> به حداقل تعداد پیکسل‌هایی اشاره دارد که یک رنگ باید داشته باشد تا در نظر گرفته شود (به‌صورت درصدی از کل پیکسل‌های تصویر).</p></body></html>"

#. i18n: ectx: property (windowTitle), widget (QDialog,
#. DocumentMetadataDialog)
#: src/gui/widgets/dialogs/document_metadata_dialog.ui:21
#, kde-format
