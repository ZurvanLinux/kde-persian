#, kde-format
msgctxt "@action:button"
msgid "Retry"
msgstr "تلاش مجدد"

#: Archiver.cxx:981
#, kde-format
msgid "Could not write to archive. Maybe the medium is full."
msgstr "نوشتن در بایگانی امکان‌پذیر نبود. ممکن است رسانه پر باشد."

#: Archiver.cxx:985
#, kde-format
msgid ""
"Could not write to archive.\n"
"The operating system reports: %1"
msgstr ""
"نوشتن در بایگانی امکان‌پذیر نبود.\n"
"گزارش سیستم‌عامل: %1"

