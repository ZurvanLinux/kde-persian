#, kde-format
msgid "The file '%1' can not be opened for writing."
msgstr "پروندهٔ «%1» برای نوشتن باز نمی‌شود."

#: Archiver.cxx:959
#, kde-format
msgid ""
"The file '%1' can not be opened for writing.\n"
"\n"
"Do you want to retry?"
