#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "محمد شفیعی سروستانی"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "muhammad.shafiee@gmail.com"

#: dbmigrator.cpp:449
#, kde-format
msgctxt "@info:status"
msgid "Stopping Akonadi service..."
msgstr "در حال متوقف کردن سرویس آکونادی..."

#: dbmigrator.cpp:452
#, kde-format
msgctxt "@info:status"
msgid "Error: timeout while waiting for Akonadi to stop."
msgstr "خطا: اتمام مهلت زمانی در حین انتظار برای توقف آکونادی."

#: dbmigrator.cpp:459
#, kde-format
msgctxt "@info:status"
msgid "Error: couldn't acquire DBus lock for Akonadi."
msgstr "خطا: امکان دریافت قفل DBus برای آکونادی وجود نداشت."

#: dbmigrator.cpp:468
#, kde-format
msgctxt "@info:status"
msgid "Starting Akonadi service..."
msgstr "در حال شروع سرویس آکونادی..."

#: dbmigrator.cpp:481
#, kde-format
msgctxt "@info:status"
msgid "Database fsck completed"
msgstr "بررسی دیسک پایگاه‌داده (fsck) کامل شد"

#: dbmigrator.cpp:495
#, kde-format
msgctxt "@info:status"
msgid ""
"Invalid database engine \"%1\" - valid values are \"sqlite\", \"mysql\" and "
"\"postgres\"."
msgstr ""
"موتور پایگاه‌داده نامعتبر «%1» - مقادیر معتبر عبارتند از «sqlite»، «mysql» و"
" «postgres»."

#: dbmigrator.cpp:517
#, kde-format
msgctxt "@info:shell"
msgid "Error: failed to configure source database server."
msgstr "خطا: پیکربندی کارساز پایگاه‌داده مبدأ ناموفق بود."

#: dbmigrator.cpp:522
#, kde-format
msgctxt "@info:shell"
msgid "Source and destination database engines are the same."
msgstr "موتورهای پایگاه‌داده مبدأ و مقصد یکسان هستند."

#: dbmigrator.cpp:529
#, kde-format
msgctxt "@info:shell"
msgid ""
"Error: failed to obtain path to source database data file or directory."
msgstr "خطا: دریافت مسیر پروندهٔ داده یا پوشهٔ پایگاه‌دادهٔ مبدأ ناموفق بود."

#: dbmigrator.cpp:536
#, kde-format
msgctxt "@info:shell"
msgid "Error: failed to configure the new database server."
msgstr "خطا: پیکربندی کارساز پایگاه‌دادهٔ جدید ناموفق بود."

#: dbmigrator.cpp:542
#, kde-format
msgctxt "@info:shell"
msgid "Error: failed to open existing database to migrate data from."
msgstr "خطا: باز کردن پایگاه‌دادهٔ موجود برای مهاجرت داده‌ها ناموفق بود."

#: dbmigrator.cpp:547
#, kde-format
msgctxt "@info:shell"
msgid "Error: failed to open new database to migrate data to."
msgstr "خطا: باز کردن پایگاه‌دادهٔ جدید برای مهاجرت داده‌ها ناموفق بود."

#: dbmigrator.cpp:552
#, kde-format
msgctxt "@info:status"
msgid "Running fsck on the source database"
msgstr "در حال اجرای fsck روی پایگاه‌دادهٔ مبدأ"

#: dbmigrator.cpp:571
#, kde-format
msgctxt "@info:status %2 is error message"
msgid "Error: failed to remove temporary database directory %1: %2"
msgstr "خطا: حذف پوشهٔ موقت پایگاه‌داده %1 ناموفق بود: %2"

#: dbmigrator.cpp:578
#, kde-format
msgctxt "@info:shell"
msgid "Backing up original database..."
msgstr "در حال پشتیبان‌گیری از پایگاه‌دادهٔ اصلی..."

#: dbmigrator.cpp:586
#, kde-format
msgctxt "@info:status"
msgid "Restoring database from backup %1 to %2"
msgstr "در حال بازیابی پایگاه‌داده از نسخهٔ پشتیبان %1 به %2"

#: dbmigrator.cpp:588
#, kde-format
msgctxt "@info:status %1 is error message"
msgid "Error: failed to restore database from backup: %1"
msgstr "خطا: بازیابی پایگاه‌داده از نسخهٔ پشتیبان ناموفق بود: %1"

#: dbmigrator.cpp:620 dbmigrator.cpp:631
#, kde-format
msgctxt "@info:shell"
msgid "Error has occurred while migrating table %1"
msgstr "هنگام مهاجرت جدول %1 خطایی رخ داد"

#: dbmigrator.cpp:650
#, kde-format
msgctxt "@label"
msgid ""
"Backup directory already exists. Do you want to overwrite the previous "
"backup?"
msgstr ""
"پوشه پشتیبان از قبل وجود دارد. آیا می‌خواهید روی پشتیبان قبلی بازنویسی شود؟"

#: dbmigrator.cpp:655
#, kde-format
msgctxt "@info:shell"
msgid "Cannot proceed without backup. Migration interrupted."
msgstr "ادامه بدون پشتیبان‌گیری امکان‌پذیر نیست. مهاجرت متوقف شد."

#: dbmigrator.cpp:660
#, kde-format
msgctxt "@info:shell"
msgid "Failed to remove previous backup directory."
msgstr "حذف پوشه پشتیبان قبلی ناموفق بود."

#: dbmigrator.cpp:673
#, kde-format
msgctxt "@info:shell"
msgid "Failed to move database to backup location: %1"
msgstr "انتقال پایگاه داده به مکان پشتیبان ناموفق بود: %1"

#: dbmigrator.cpp:687
#, kde-format
msgctxt "@label"
msgid "Backup file %1 already exists. Overwrite?"
msgstr "پرونده پشتیبان %1 از قبل وجود دارد. بازنویسی شود؟"

#: dbmigrator.cpp:689
#, kde-format
msgctxt "@info:status"
msgid "Cannot proceed without backup. Migration interrupted."
msgstr "ادامه بدون پشتیبان‌گیری امکان‌پذیر نیست. مهاجرت متوقف شد."

#: dbmigrator.cpp:695
#, kde-format
msgctxt "@info:status"
msgid "Error: Failed to remove existing backup file %1: %2"
msgstr "خطا: حذف پرونده پشتیبان موجود %1 ناموفق بود: %2"

#: dbmigrator.cpp:702
#, kde-format
msgctxt "@info:status"
msgid "Failed to back up Akonadi Server configuration: %1"
msgstr "پشتیبان‌گیری از پیکربندی کارساز Akonadi ناموفق بود: %1"

#: dbmigrator.cpp:719
#, kde-format
msgctxt "@info:status %1 is error message"
msgid "Error: failed to move migrated database to the primary location: %1"
msgstr "خطا: انتقال پایگاه داده مهاجرت‌یافته به مکان اصلی ناموفق بود: %1"

#: dbmigrator.cpp:738
#, kde-format
msgctxt "@info:status %1 is error message"
msgid "Error: failed to remove original akonadiserverrc: %1"
msgstr "خطا: حذف akonadiserverrc اصلی ناموفق بود: %1"

#: dbmigrator.cpp:744
#, kde-format
msgctxt "@info:status %1 is error message"
msgid "Error: failed to move new akonadiserverrc to the primary location: %1"
msgstr "خطا: انتقال akonadiserverrc جدید به مکان اصلی ناموفق بود: %1"

#: dbmigrator.cpp:835
#, kde-format
msgctxt "@info:status"
msgid "Error: failed to update autoincrement value for table %1"
msgstr ""
"خطا: به‌روزرسانی مقدار افزایش خودکار (autoincrement) برای جدول %1 ناموفق بود"

#: dbmigrator.cpp:840
#, kde-format
msgctxt "@info:status"
msgid "Optimizing table %1..."
msgstr "در حال بهینه‌سازی جدول %1..."

#: dbmigrator.cpp:843
#, kde-format
msgctxt "@info:status"
msgid "Error: failed to optimize table %1"
msgstr "خطا: بهینه‌سازی جدول %1 ناموفق بود"

#: main.cpp:31
#, kde-format
msgctxt ""
"Options for user to input to command line prompt, parenthesis indicate which"
" letter to type, capitalized option is default"
msgid " [(y)es/(N)o] "
msgstr " [(y)بله/(N)خیر] "

#: main.cpp:36 main.cpp:55
#, kde-format
msgctxt "Letter for option \"(y)es\" prompted from command line"
msgid "y"
msgstr "y"

#: main.cpp:49
#, kde-format
msgctxt ""
"Options for user to input to command line prompt, parenthesis indicate which"
" letter to type, capitalized option is default"
msgid " [(y)es/(N)o/(s)kip] "
msgstr " [(y)بله/(N)خیر/(s)پرش] "

#: main.cpp:56
#, kde-format
msgctxt "Letter for option \"(s)kip\" prompted from command line"
msgid "s"
msgstr "s"

#: main.cpp:75 main.cpp:77
#, kde-format
msgid "Akonadi DB Migrator"
msgstr "مهاجرت‌دهنده پایگاه‌داده آکونادی"

#: main.cpp:79
#, kde-format
msgid "(c) 2024 g10 Code GmbH"
msgstr "© 2024 g10 Code GmbH"

#: main.cpp:85
#, kde-format
msgid ""
"The new DB engine to use. Possible values are  \"sqlite\", \"mysql\" and "
"\"postgres\""
msgstr ""
"موتور پایگاه‌داده جدید برای استفاده. مقادیر مجاز عبارتند از «sqlite»، "
"«mysql» و «postgres»"

#: main.cpp:92
#, kde-format
msgctxt "@info:shell"
msgid "Invalid target engine: %1."
msgstr "موتور مقصد نامعتبر است: %1."

#: main.cpp:106
#, kde-format
msgctxt "@info:status"
msgid "Migration completed successfully."
msgstr "مهاجرت با موفقیت به پایان رسید."

#: main.cpp:108
#, kde-format
msgctxt "@info:status"
msgid "Migration failed."
msgstr "مهاجرت ناموفق بود."

#: main.cpp:113
#, kde-format
msgctxt "@info:progress"
msgid "Migrating table %1 (%2/%3)..."
msgstr "در حال مهاجرت جدول %1 (%2/%3)..."

#: main.cpp:127
#, kde-format
msgctxt "@info:progress"
msgid "%1%..."
msgstr "٪%1..."
