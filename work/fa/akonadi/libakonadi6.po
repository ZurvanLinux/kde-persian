#: akonadictl/main.cpp:220
#, kde-format
msgid ""
"Akonadi server manipulation tool\n"
"\n"
"Commands:\n"
"  start          Starts the Akonadi server with all its processes\n"
"  stop           Stops the Akonadi server and all its processes cleanly\n"
"  restart        Restart Akonadi server with all its processes\n"
"  status         Shows a status overview of the Akonadi server\n"
"  instances      List all existing Akonadi instances\n"
"  vacuum         Vacuum internal storage (WARNING: needs a lot of time and disk\n"
"                 space!)\n"
"  fsck           Check (and attempt to fix) consistency of the internal storage\n"
"                 (can take some time)"
msgstr ""
"ابزار دست‌کاری کارساز آکونادی\n"
"\n"
"دستورها:\n"
"  start          راه‌اندازی کارساز آکونادی به همراه تمام فرایندهایش\n"
"  stop           متوقف‌کردن کامل کارساز آکونادی و تمام فرایندهایش\n"
"  restart        راه‌اندازی دوبارهٔ کارساز آکونادی به همراه تمام فرایندهایش\n"
"  status         نمایش نمای کلی از وضعیت کارساز آکونادی\n"
"  instances      فهرست‌کردن تمام نمونه‌های موجود آکونادی\n"
"  vacuum         پاک‌سازی و بهینه‌سازی حافظهٔ داخلی (هشدار: به زمان و فضای دیسک زیادی\n"
"                 نیاز دارد!)\n"
"  fsck           بررسی (و تلاش برای رفع) سازگاری حافظهٔ داخلی\n"
"                 (ممکن است مدتی طول بکشد)"

