#: attachmenthandler.cpp:126
#, kde-format
msgid ""
"The calendar invitation stored in this email message is broken in some way. "
"Unable to continue."
msgstr ""
"دعوت‌نامهٔ تقویم ذخیره‌شده در این پیام رایانامه به نوعی خراب است. ادامه "
"امکان‌پذیر نیست."

#: attachmenthandler.cpp:188 attachmenthandler.cpp:243
#, kde-format
msgid "Unable to create a temporary file for the attachment."
msgstr "امکان ایجاد پروندهٔ موقت برای پیوست وجود ندارد."

#: attachmenthandler.cpp:221
#, kde-format
msgctxt "@title:window"
msgid "Save Attachment"
msgstr "ذخیرهٔ پیوست"

