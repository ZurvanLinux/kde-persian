#: interpreter/executer.cpp:74
#, kde-format
msgid "Cannot return outside a function. "
msgstr "امکان بازگشت (return) در خارج از تابع وجود ندارد. "

#: interpreter/executer.cpp:411
#, kde-format
msgid "The %1 command accepts no parameters."
msgstr "دستور %1 هیچ پارامتری نمی‌پذیرد."

#: interpreter/executer.cpp:421
#, kde-format
msgid "The %2 command was called with %3 but needs 1 parameter."
msgid_plural "The %2 command was called with %3 but needs %1 parameters."
msgstr[0] "دستور %2 با %3 فراخوانی شد، اما به ۱ پارامتر نیاز دارد."
msgstr[1] "دستور %2 با %3 فراخوانی شد، اما به %1 پارامتر نیاز دارد."

#: interpreter/executer.cpp:429
#, kde-format
msgid "The %2 command was called with %3 but only accepts 1 parameter."
msgid_plural ""
"The %2 command was called with %3 but only accepts %1 parameters."
msgstr[0] "دستور %2 با %3 فراخوانی شد، اما تنها ۱ پارامتر می‌پذیرد."
msgstr[1] "دستور %2 با %3 فراخوانی شد، اما تنها %1 پارامتر می‌پذیرد."

#: interpreter/executer.cpp:452
#, kde-format
msgid "The %1 command only accepts a string as its parameter."
msgstr "دستور %1 تنها یک رشته را به عنوان پارامتر خود می‌پذیرد."

#: interpreter/executer.cpp:454
#, kde-format
msgid "The %1 command only accepts strings as its parameters."
msgstr "دستور %1 فقط رشته‌ها را به عنوان پارامتر می‌پذیرد."

#: interpreter/executer.cpp:459
#, kde-format
msgid "The %1 command only accepts a number as its parameter."
msgstr "دستور %1 فقط یک عدد را به عنوان پارامتر می‌پذیرد."

#: interpreter/executer.cpp:461
#, kde-format
msgid "The %1 command only accepts numbers as its parameters."
msgstr "دستور %1 فقط اعداد را به عنوان پارامتر می‌پذیرد."

#: interpreter/executer.cpp:466
#, kde-format
msgid "The %1 command only accepts an answer as its parameter."
msgstr "دستور %1 فقط یک پاسخ را به عنوان پارامتر می‌پذیرد."

#: interpreter/executer.cpp:468
#, kde-format
msgid "The %1 command only accepts answers as its parameters."
msgstr "دستور %1 فقط پاسخ‌ها را به عنوان پارامتر می‌پذیرد."

#: interpreter/executer.cpp:542
#, kde-format
msgid "The variable '%1' was used without first being assigned to a value"
msgstr "متغیر «%1» بدون مقداردهی اولیه استفاده شده است"

#: interpreter/executer.cpp:562
#, kde-format
msgid "An unknown function named '%1' was called"
msgstr "تابع ناشناخته‌ای به نام «%1» فراخوانی شد"

#: interpreter/executer.cpp:576
#, kde-format
msgid ""
"The function '%1' was called with %2, while it should be called with %3"
msgstr "تابع «%1» با %2 فراخوانی شد، در حالی که باید با %3 فراخوانی می‌شد"

#: interpreter/executer.cpp:578 interpreter/executer.cpp:580
#, kde-format
msgctxt ""
"The function '%1' was called with %2, while it should be called with %3"
msgid "1 parameter"
msgid_plural "%1 parameters"
msgstr[0] "1 پارامتر"
msgstr[1] "%1 پارامتر"

#: interpreter/executer.cpp:803
#, kde-format
msgid "ASSERT failed"
msgstr "ASSERT ناموفق بود"

#: interpreter/executer.cpp:810
#, kde-format
msgid "'And' needs two variables"
msgstr "عملگر «And» به دو متغیر نیاز دارد"

#: interpreter/executer.cpp:820
#, kde-format
msgid "'Or' needs two variables"
msgstr "عملگر «Or» به دو متغیر نیاز دارد"

#: interpreter/executer.cpp:831
#, kde-format
msgid "I need something to do a not on"
msgstr "برای اعمال عملگر not به مقداری نیاز است"

#: interpreter/executer.cpp:840
#, kde-format
msgid "I cannot do a '==' without 2 variables"
msgstr "اجرای '==' بدون ۲ متغیر ممکن نیست"

#: interpreter/executer.cpp:849
#, kde-format
msgid "I cannot do a '!=' without 2 variables"
msgstr "اجرای '!=' بدون ۲ متغیر ممکن نیست"

#: interpreter/executer.cpp:858
#, kde-format
msgid "I cannot do a '>' without 2 variables"
msgstr "اجرای '>' بدون ۲ متغیر ممکن نیست"

#: interpreter/executer.cpp:867
#, kde-format
msgid "I cannot do a '<' without 2 variables"
msgstr "اجرای '<' بدون ۲ متغیر ممکن نیست"

#: interpreter/executer.cpp:876
#, kde-format
msgid "I cannot do a '>=' without 2 variables"
msgstr "اجرای '>=' بدون ۲ متغیر ممکن نیست"

#: interpreter/executer.cpp:885
#, kde-format
msgid "I cannot do a '<=' without 2 variables"
msgstr "اجرای '<=' بدون ۲ متغیر ممکن نیست"

#: interpreter/executer.cpp:894
#, kde-format
msgid "You need two numbers or string to do an addition"
msgstr "برای انجام جمع به دو عدد یا رشته نیاز دارید"

#: interpreter/executer.cpp:907
#, kde-format
msgid "You need two numbers to subtract"
msgstr "برای تفریق به دو عدد نیاز دارید"

#: interpreter/executer.cpp:914
#, kde-format
msgid "You tried to subtract from a non-number, '%1'"
msgstr "شما تلاش کردید از یک مقدار غیرعددی تفریق کنید: «%1»"

#: interpreter/executer.cpp:916
#, kde-format
msgid "You tried to subtract a non-number, '%1'"
msgstr "شما تلاش کردید یک مقدار غیرعددی را تفریق کنید: «%1»"

#: interpreter/executer.cpp:923
#, kde-format
msgid "You need two numbers to multiplicate"
msgstr "برای ضرب به دو عدد نیاز دارید"

#: interpreter/executer.cpp:930
#, kde-format
msgid "You tried to multiplicate a non-number, '%1'"
msgstr "شما تلاش کردید یک مقدار غیرعددی را ضرب کنید: «%1»"

#: interpreter/executer.cpp:932
#, kde-format
msgid "You tried to multiplicate by a non-number, '%1'"
msgstr "شما تلاش کردید در یک مقدار غیرعددی ضرب کنید: «%1»"

#: interpreter/executer.cpp:939
#, kde-format
msgid "You need two numbers to divide"
msgstr "برای تقسیم به دو عدد نیاز دارید"

#: interpreter/executer.cpp:944
#, kde-format
msgid "You tried to divide by zero"
msgstr "شما تلاش کردید بر صفر تقسیم کنید"

#: interpreter/executer.cpp:950
#, kde-format
msgid "You tried to divide a non-number, '%1'"
msgstr "شما تلاش کردید یک مقدار غیرعددی را تقسیم کنید: «%1»"

#: interpreter/executer.cpp:952
#, kde-format
msgid "You tried to divide by a non-number, '%1'"
msgstr "شما تلاش کردید بر یک مقدار غیرعددی تقسیم کنید: «%1»"

#: interpreter/executer.cpp:959
#, kde-format
msgid "You need two numbers to raise a power"
msgstr "برای محاسبهٔ توان به دو عدد نیاز دارید"

#: interpreter/executer.cpp:970
#, kde-format
msgid "The result of an exponentiation was too large"
msgstr "نتیجهٔ به توان رساندن بسیار بزرگ بود"

#: interpreter/executer.cpp:976
#, kde-format
msgid "You tried to raise a non-number to a power, '%1'"
msgstr "سعی کردید یک مقدار غیرعددی را به توان برسانید، «%1»"

#: interpreter/executer.cpp:978
#, kde-format
msgid "You tried to raise the power of a non-number, '%1'"
msgstr "سعی کردید توان یک مقدار غیرعددی را افزایش دهید، «%1»"

#: interpreter/executer.cpp:985
#, kde-format
msgid "You need one variable and a value or variable to do a '='"
msgstr "برای استفاده از «=» به یک متغیر و یک مقدار یا متغیر دیگر نیاز دارید"

#: interpreter/executer.cpp:1004
#, kde-format
msgid "The function '%1' is already defined."
msgstr "تابع «%1» از قبل تعریف شده است."

#: interpreter/executer.cpp:1073
#, kde-format
msgid ""
"Polygon needs between 2 and 4 parameters: corners, size, and optionally "
"rotation and spoke ratio"
msgstr ""
"چندضلعی به ۲ تا ۴ پارامتر نیاز دارد: گوشه‌ها، اندازه، و به صورت اختیاری چرخش"
" و نسبت پره‌ها"

#: interpreter/executer.cpp:1086
#, kde-format
msgid "A polygon must have between 3 and 10 corners"
msgstr "یک چندضلعی باید بین ۳ تا ۱۰ گوشه داشته باشد"

#: interpreter/executer.cpp:1091
#, kde-format
msgid "Polygon side must not be negative"
msgstr "ضلع چندضلعی نباید منفی باشد"

#: interpreter/executer.cpp:1096
#, kde-format
msgid "Spoke ratio must be greater than 0 and at most 1"
msgstr "نسبت پره‌ها باید بزرگ‌تر از ۰ و حداکثر ۱ باشد"

#: interpreter/executer.cpp:1107
#, kde-format
msgid ""
"Ellipse needs between 1 and 3 parameters: width, optionally height, and "
"optionally rotation"
msgstr ""
"بیضی بین ۱ تا ۳ پارامتر نیاز دارد: عرض، در صورت تمایل ارتفاع، و در صورت "
"تمایل چرخش"

#: interpreter/executer.cpp:1119
#, kde-format
msgid "Ellipse width and height must not be negative"
msgstr "عرض و ارتفاع بیضی نباید منفی باشند"

#: interpreter/executer.cpp:1130
#, kde-format
msgid ""
"Rectangle needs 2 or 3 parameters: width, height, and optionally rotation"
msgstr "مستطیل به ۲ یا ۳ پارامتر نیاز دارد: عرض، ارتفاع، و در صورت تمایل چرخش"

#: interpreter/executer.cpp:1142
#, kde-format
msgid "Rectangle width and height must not be negative"
msgstr "عرض و ارتفاع مستطیل نباید منفی باشند"

#: interpreter/executer.cpp:1153
#, kde-format
msgid ""
"Triangle needs 3 or 4 parameters: sideA, sideB, sideC, and optionally "
"rotation"
msgstr ""
"مثلث به ۳ یا ۴ پارامتر نیاز دارد: sideA، sideB، sideC، و در صورت تمایل چرخش"

#: interpreter/executer.cpp:1166
#, kde-format
msgid "Triangle side lengths must be positive numbers"
msgstr "طول اضلاع مثلث باید اعدادی مثبت باشند"

#: interpreter/executer.cpp:1171
#, kde-format
msgid "The given side lengths cannot form a triangle"
msgstr "طول اضلاع داده‌شده نمی‌توانند یک مثلث تشکیل دهند"

#: interpreter/executer.cpp:1244 interpreter/executer.cpp:1272
#, kde-format
msgid "The command %1 takes either a string or %2 numbers"
msgstr "دستور %1 یا یک رشته می‌گیرد یا %2 عدد"

#: interpreter/executer.cpp:1445
#, kde-format
msgid "Can't do a sqrt of a negative number"
msgstr "امکان محاسبهٔ جذر عدد منفی وجود ندارد"

#: interpreter/parser.cpp:39
#, kde-format
msgid "Expected a command, instead got '%1'"
msgstr "انتظار یک دستور می‌رفت، اما «%1» دریافت شد"

#: interpreter/parser.cpp:70
#, kde-format
msgid "Could not understand '%1'"
msgstr "«%1» قابل درک نبود"

#: interpreter/parser.cpp:105
#, kde-format
msgid "A comma was expected here..."
msgstr "در اینجا انتظار ویرگول می‌رفت..."

#: interpreter/parser.cpp:108
#, kde-format
msgid "Did not expect '%1', instead expected the line to end after %2"
msgstr "«%1» انتظار نمی‌رفت، در عوض انتظار می‌رفت خط پس از %2 پایان یابد"

#: interpreter/parser.cpp:111
#, kde-format
msgid "Expected an assignment, '=', after the variable '%1'"
msgstr "انتظار انتساب، «=»، بعد از متغیر «%1» می‌رفت"

#: interpreter/parser.cpp:114
#, kde-format
msgid "Did not expect '%1', instead expected a closing parenthesis, ')'"
msgstr "«%1» انتظار نمی‌رفت، در عوض انتظار پرانتز بسته، «)»، می‌رفت"

#: interpreter/parser.cpp:117
#, kde-format
msgid "Expected 'to' after 'for'"
msgstr "انتظار «to» بعد از «for» می‌رفت"

#: interpreter/parser.cpp:120
#, kde-format
msgid "Expected a name for a command after 'learn' command"
msgstr "انتظار نامی برای دستور پس از دستور «learn» می‌رفت"

#: interpreter/parser.cpp:282
#, kde-format
msgid "You cannot put '%1' here."
msgstr "نمی‌توانید «%1» را اینجا قرار دهید."

#: interpreter/parser.cpp:317
#, kde-format
msgid ""
"Text string was not properly closed, expected a double quote, ' \" ', to "
"close the string."
msgstr ""
"رشته متنی به‌درستی بسته نشده بود، برای بستن رشته انتظار یک گیومه، ' \" '، "
"می‌رفت."

#: interpreter/parser.cpp:644
#, kde-format
msgid "'for' was called wrongly"
msgstr "«for» به‌نادرستی فراخوانی شد"

#: interpreter/parser.cpp:715
#, kde-format
msgid "Expected a scope after the 'learn' command"
msgstr "انتظار یک دامنه پس از دستور «learn» می‌رفت"

#: interpreter/translator.cpp:94
#, kde-format
