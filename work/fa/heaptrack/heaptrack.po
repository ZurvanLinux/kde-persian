#: gui/flamegraph.cpp:243
#, kde-format
msgctxt ""
"%1: peak consumption in bytes, %2: relative number, %3: function label"
msgid "%1 (%2%) contribution to peak consumption in %3 and below."
msgstr "%1 (%2٪) سهم در اوج مصرف در %3 و پایین‌تر."

