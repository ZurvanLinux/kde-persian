#: gui/treemodel.cpp:80
#, kde-format
msgid ""
"<qt>The number of times an allocation function was called from this "
"location.</qt>"
msgstr "<qt>تعداد دفعاتی که یک تابع تخصیص از این مکان فراخوانی شده است.</qt>"

#: gui/treemodel.cpp:83
#, kde-format
msgid ""
"<qt>The number of temporary allocations. These allocations are directly "
"followed by a free without any other allocations in-between.</qt>"
msgstr ""
"<qt>تعداد تخصیص‌های موقت. بلافاصله پس از این تخصیص‌ها یک آزادسازی (free) "
"بدون هیچ تخصیص دیگری در این میان رخ داده است.</qt>"

#: gui/treemodel.cpp:87
#, kde-format
msgid ""
"<qt>The contributions from a given location to the maximum heap memory "
"consumption in bytes. This takes deallocations into account.</qt>"
msgstr ""
"<qt>سهم یک مکان مشخص در حداکثر مصرف حافظهٔ هیپ به بایت. این مقدار "
"آزادسازی‌ها را نیز در نظر می‌گیرد.</qt>"

#: gui/treemodel.cpp:94
#, kde-format
msgid ""
"<qt>The location from which an allocation function was called. Function "
"symbol and file information may be unknown when debug information was "
"missing when heaptrack was run.</qt>"
msgstr ""
"<qt>مکانی که تابع تخصیص از آن فراخوانی شده است. در صورت نبود اطلاعات "
"اشکال‌زدایی هنگام اجرای heaptrack، نماد تابع و اطلاعات پرونده ممکن است "
"ناشناخته باشند.</qt>"

