#: src/notifier.cpp:22
#, kde-format
msgid "Upgrade available"
msgstr "ارتقا موجود است"

#: src/notifier.cpp:23
#, kde-format
msgctxt "For example, 'KDE neon 24.04 is available.'"
msgid "%1 %2 is available."
msgstr "%1 %2 موجود است."

#: src/notifier.cpp:25
#, kde-format
msgid ""
"\n"
"Your device will stop receiving updates and security fixes in 1 day — please upgrade when possible."
msgid_plural ""
"\n"
"Your device will stop receiving updates and security fixes in %1 days — please upgrade when possible."
msgstr[0] ""
"\n"
"دستگاه شما تا ۱ روز دیگر دریافت به‌روزرسانی‌ها و رفع‌های امنیتی را متوقف خواهد کرد — لطفاً در اولین فرصت ارتقا دهید."
msgstr[1] ""
"\n"
"دستگاه شما تا %1 روز دیگر دریافت به‌روزرسانی‌ها و رفع‌های امنیتی را متوقف خواهد کرد — لطفاً در اولین فرصت ارتقا دهید."

#: src/notifier.cpp:30
#, kde-format
msgid ""
"\n"
"Your device is no longer receiving updates or security fixes — please upgrade now."
msgstr ""
"\n"
"دستگاه شما دیگر به‌روزرسانی‌ها یا رفع‌های امنیتی را دریافت نمی‌کند — لطفاً اکنون ارتقا دهید."

#: src/notifier.cpp:49
#, kde-format
msgctxt "@action:button"
msgid "Upgrade"
msgstr "ارتقا"

#: src/screensaverinhibitor.cpp:24
#, kde-format
msgctxt "Screensaver inhibition reason"
msgid "Upgrading Operating System"
msgstr "در حال ارتقای سیستم‌عامل"

#: src/upgraderprocess.cpp:98
#, kde-format
msgctxt "@title/window upgrade failure dialog"
msgid "Upgrade Failed"
msgstr "ارتقا ناموفق بود"

#: src/upgraderprocess.cpp:104
#, kde-format
msgctxt "@title title widget above process output"
msgid "Upgrade failed with the following output:"
msgstr "ارتقا با خروجی زیر ناموفق بود:"
