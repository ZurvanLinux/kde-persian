#: core/operationstack.cpp:101
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Deleting a partition just created: Undoing the operation to create the "
"partition."
msgstr "حذف پارتیشن تازه ایجادشده: لغو عملیات ایجاد پارتیشن."

#: core/operationstack.cpp:119
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Resizing a partition just created: Updating start and end in existing "
"operation."
msgstr ""
"تغییر اندازه پارتیشن تازه ایجادشده: به‌روزرسانی ابتدا و انتها در عملیات "
"موجود."

#: core/operationstack.cpp:139
#, kde-kuit-format
msgctxt "@info:status"
msgid "Copying a new partition: Creating a new partition instead."
msgstr "رونوشت از پارتیشن جدید: ایجاد یک پارتیشن جدید به جای آن."

#: core/operationstack.cpp:156
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing label for a new partition: No new operation required."
msgstr "تغییر برچسب برای پارتیشن جدید: به عملیات جدیدی نیاز نیست."

#: core/operationstack.cpp:169
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing file system for a new partition: No new operation required."
msgstr "تغییر سامانه پرونده برای پارتیشن جدید: به عملیات جدیدی نیاز نیست."

#: core/operationstack.cpp:188
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Checking file systems is automatically done when creating them: No new "
"operation required."
msgstr ""
"بررسی سامانه‌های پرونده هنگام ایجادشان به طور خودکار انجام می‌شود: به عملیات"
" جدیدی نیاز نیست."

#: core/operationstack.cpp:235
#, kde-kuit-format
msgctxt "@info:status"
msgid "Deleting a partition just copied: Removing the copy."
msgstr "حذف پارتیشنی که به تازگی رونوشت شده است: در حال حذف رونوشت."

#: core/operationstack.cpp:240
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Deleting a partition just copied over an existing partition: Removing the "
"copy and deleting the existing partition."
msgstr ""
"حذف پارتیشنی که به تازگی روی یک پارتیشن موجود رونوشت شده است: در حال حذف "
"رونوشت و پاک کردن پارتیشن موجود."

#: core/operationstack.cpp:253
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Copying a partition that is itself a copy: Copying the original source "
"partition instead."
msgstr ""
"رونوشت از پارتیشنی که خود یک رونوشت است: در عوض، رونوشت از پارتیشن مبدأ اصلی"
" انجام می‌شود."

#: core/operationstack.cpp:282
#, kde-kuit-format
msgctxt "@info:status"
msgid "Deleting a partition just restored: Removing the restore operation."
msgstr "حذف پارتیشنی که به تازگی بازیابی شده است: در حال حذف عملیات بازیابی."

#: core/operationstack.cpp:287
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Deleting a partition just restored to an existing partition: Removing the "
"restore operation and deleting the existing partition."
msgstr ""
"حذف پارتیشنی که به تازگی روی یک پارتیشن موجود بازیابی شده است: در حال حذف "
"عملیات بازیابی و پاک کردن پارتیشن موجود."

#: core/operationstack.cpp:320
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing flags again for the same partition: Removing old operation."
msgstr "تغییر مجدد پرچم‌ها برای همان پارتیشن: در حال حذف عملیات قبلی."

#: core/operationstack.cpp:351
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing label again for the same partition: Removing old operation."
msgstr "تغییر مجدد برچسب برای همان پارتیشن: در حال حذف عملیات قبلی."

#: core/operationstack.cpp:377
#, kde-kuit-format
msgctxt "@info:status"
msgid "Creating new partition table, discarding previous operation on device."
msgstr "ایجاد جدول پارتیشن جدید، نادیده گرفتن عملیات قبلی روی دستگاه."

#: core/operationstack.cpp:397
#, kde-kuit-format
msgctxt "@info:status"
msgid "Resizing Volume Group, nothing to do."
msgstr "تغییر اندازهٔ گروه حجم، کاری برای انجام دادن وجود ندارد."

