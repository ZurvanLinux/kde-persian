#: fs/clustersize.cpp:107
#, kde-kuit-format
msgctxt "@info"
msgid "Choosing the cluster size is not supported for this file system."
msgstr "انتخاب اندازهٔ کلاستر برای این سامانهٔ پرونده پشتیبانی نمی‌شود."

#: fs/clustersize.cpp:111
#, kde-kuit-format
msgctxt "@info"
msgid "The cluster size must be given as an integer number of bytes."
msgstr "اندازهٔ کلاستر باید به‌صورت یک عدد صحیح از بایت‌ها مشخص شود."

#: fs/clustersize.cpp:115
#, kde-kuit-format
msgctxt "@info"
msgid "The cluster size (%1 bytes) must be a positive number."
msgstr "اندازهٔ کلاستر (%1 بایت) باید یک عدد مثبت باشد."

#: fs/clustersize.cpp:117
#, kde-kuit-format
msgctxt "@info"
msgid "The cluster size (%1 bytes) must be a power of two."
msgstr "اندازهٔ کلاستر (%1 بایت) باید توانی از دو باشد."

#: fs/clustersize.cpp:125
#, kde-kuit-format
msgctxt "@info"
msgid "The requested FAT sector size is not an integer power of two."
msgstr "اندازهٔ سکتور FAT درخواست‌شده، توانی صحیح از دو نیست."

#: fs/clustersize.cpp:128
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The requested FAT sector size (%1 bytes) must be between 512 and 32768."
msgstr "اندازهٔ سکتور FAT درخواست‌شده (%1 بایت) باید بین ۵۱۲ تا ۳۲۷۶۸ باشد."

#: fs/clustersize.cpp:134
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The requested FAT sectors-per-cluster value is not an integer power of two "
"from 1 to 128."
msgstr ""
"مقدار «سکتور بر کلاستر» FAT درخواست‌شده، توانی صحیح از دو بین ۱ تا ۱۲۸ نیست."

#: fs/clustersize.cpp:137 fs/clustersize.cpp:146
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The cluster size (%1 bytes) must be a whole multiple of the sector size (%2 "
"bytes)."
msgstr ""
"اندازهٔ کلاستر (%1 بایت) باید مضرب صحیحی از اندازهٔ سکتور (%2 بایت) باشد."

#: fs/clustersize.cpp:141
#, kde-kuit-format
msgctxt "@info"
msgid ""
"A cluster size of %1 bytes maps to %2 sectors of %3 bytes per cluster, which"
" mkfs.fat cannot use (it must be a power of two from 1 to 128)."
msgstr ""
"اندازهٔ کلاستر %1 بایت به %2 سکتورِ %3 بایتی در هر کلاستر نگاشت می‌شود که "
"mkfs.fat نمی‌تواند از آن استفاده کند (باید توانی از دو بین ۱ تا ۱۲۸ باشد)."

#: fs/clustersize.cpp:143
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The requested cluster size (%1 bytes) and sectors-per-cluster value (%2) do "
"not agree."
msgstr ""
"اندازهٔ کلاستر درخواست‌شده (%1 بایت) و مقدار سکتور بر کلاستر (%2) با یکدیگر "
"همخوانی ندارند."

#: fs/clustersize.cpp:152
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The cluster size (%1 bytes) is outside the range this file system supports "
"(%2 to %3 bytes)."
msgstr ""
"اندازهٔ کلاستر (%1 بایت) خارج از محدودهٔ پشتیبانی‌شده توسط این سامانهٔ "
"پرونده است (%2 تا %3 بایت)."

#: fs/clustersize.cpp:155
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The cluster size (%1 bytes) is larger than the whole file system (%2 bytes)."
msgstr "اندازهٔ کلاستر (%1 بایت) بزرگ‌تر از کل سامانهٔ پرونده (%2 بایت) است."

#: fs/clustersize.cpp:160
#, kde-kuit-format
msgctxt "@info"
msgid ""
"A cluster size of %1 bytes leaves fewer than the 4085 data clusters a FAT16 "
"file system needs. Choose a smaller cluster size."
msgstr ""
"اندازهٔ کلاستر %1 بایت باعث می‌شود تعداد کلاسترهای داده از ۴۰۸۵ کلاستر "
"موردنیاز سامانهٔ پروندهٔ FAT16 کمتر شود. اندازهٔ کلاستر کوچک‌تری را انتخاب "
"کنید."

#: fs/clustersize.cpp:162
#, kde-kuit-format
msgctxt "@info"
msgid ""
"A cluster size of %1 bytes leaves fewer than the 65525 data clusters a FAT32"
" file system needs. Choose a smaller cluster size."
msgstr ""
"اندازهٔ کلاستر %1 بایت باعث می‌شود تعداد کلاسترهای داده از ۶۵۵۲۵ کلاستر "
"موردنیاز سامانهٔ پروندهٔ FAT32 کمتر شود. اندازهٔ کلاستر کوچک‌تری را انتخاب "
"کنید."

