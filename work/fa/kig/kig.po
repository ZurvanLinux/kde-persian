#, kde-format
msgid "Circle by Center && Line"
msgstr "دایره با مرکز و خط"

#, kde-format
msgid "A circle constructed by its center and tangent to a given line"
msgstr "دایره‌ای ساخته‌شده با مرکز خود و مماس بر یک خط مفروض"

#, kde-format
msgid "Construct a circle tangent to this line"
msgstr "ساخت دایرهٔ مماس بر این خط"

#, kde-format
msgid "Select the line that the new circle should be tangent to..."
msgstr "انتخاب خطی که دایرهٔ جدید باید بر آن مماس باشد..."

#, kde-format
msgid "Circle by Point && Segment (as the Diameter)"
msgstr "دایره با نقطه و پاره‌خط (به‌عنوان قطر)"

#, kde-format
msgid ""
"A circle defined by its center and the length of a segment as the diameter"
msgstr "دایره‌ای تعریف‌شده با مرکزش و طول یک پاره‌خط به‌عنوان قطر"

#, kde-format
msgid ""
"Construct a circle with the diameter given by the length of this segment"
msgstr "ساخت دایره‌ای با قطری برابر با طول این پاره‌خط"

#, kde-format
msgid ""
"Select the segment whose length gives the diameter of the new circle..."
msgstr "پاره‌خطی را انتخاب کنید که طول آن قطر دایرهٔ جدید باشد..."

#, kde-format
msgid "Equilateral Triangle"
msgstr "مثلث متساوی‌الاضلاع"

#, kde-format
msgid "Equilateral triangle with given two vertices"
msgstr "مثلث متساوی‌الاضلاع با دو رأس معلوم"

#, kde-format
msgid "Evolute"
msgstr "گسترنده"

#, kde-format
msgid "Evolute of a curve"
msgstr "گسترنده یک منحنی"

#, kde-format
msgid "Evolute of this curve"
msgstr "گسترنده این منحنی"

#, kde-format
msgid "Osculating Circle"
msgstr "دایره بوسان"

#, kde-format
msgid "Osculating circle of a curve at a point"
msgstr "دایره بوسان یک منحنی در یک نقطه"

#, kde-format
msgid "Osculating circle of this curve"
msgstr "دایره بوسان این منحنی"

#, kde-format
msgid "Osculating circle at this point"
msgstr "دایره بوسان در این نقطه"

#, kde-format
msgid "Select the point..."
msgstr "انتخاب نقطه..."

#, kde-format
msgid "Square"
msgstr "مربع"

#, kde-format
msgid "Square with two given adjacent vertices"
msgstr "مربع با دو رأس مجاور داده‌شده"

#, kde-format
msgid "Vector Difference"
msgstr "تفاضل برداری"

#, kde-format
msgid "Construct the vector difference of two vectors."
msgstr "رسم تفاضل برداری دو بردار."

#, kde-format
msgid "Construct the vector difference of this vector and another one."
msgstr "رسم تفاضل برداری این بردار و برداری دیگر."

#, kde-format
msgid "Construct the vector difference of the other vector and this one."
msgstr "رسم تفاضل برداری بردار دیگر و این بردار."

#, kde-format
msgid "Construct the vector difference starting at this point."
msgstr "رسم تفاضل برداری با شروع از این نقطه."

#, kde-format
msgid ""
"Select the first of the two vectors of which you want to construct the "
"difference..."
msgstr ""
"بردار اول از دو برداری که می‌خواهید تفاضلشان را رسم کنید انتخاب کنید..."

#, kde-format
msgid ""
"Select the other of the two vectors of which you want to construct the "
"difference..."
msgstr ""
"بردار دیگر از دو برداری که می‌خواهید تفاضلشان را رسم کنید انتخاب کنید..."

#, kde-format
msgid "Select the point to construct the difference vector in..."
msgstr "نقطه‌ای را برای رسم بردار تفاضل در آن انتخاب کنید..."

