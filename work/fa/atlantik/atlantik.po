#: client/atlantik.cpp:919
#, kde-format
msgid ""
"You are currently part of an active game. Are you sure you want to close "
"Atlantik? If you do, you forfeit the game."
msgstr ""
"شما در حال حاضر در یک بازی فعال حضور دارید. آیا مطمئنید می‌خواهید Atlantik "
"را ببندید؟ در این صورت، بازی را واگذار خواهید کرد."

#: client/atlantik.cpp:919
#, kde-format
msgid "Close & Forfeit?"
msgstr "بستن و واگذاری؟"

#: client/atlantik.cpp:919
#, kde-format
msgid "Close && Forfeit"
msgstr "بستن و واگذاری"

#: client/atlantik.cpp:952
#, kde-format
