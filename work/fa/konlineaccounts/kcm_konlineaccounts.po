#: ui/Account.qml:31
#, kde-format
msgid "Remove"
msgstr "حذف"

#: ui/Account.qml:41
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "These applications are authorized to use %1:"
msgstr "این برنامه‌ها مجاز به استفاده از %1 هستند:"

#: ui/Account.qml:63
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "No applications are authorized to use %1"
msgstr "هیچ برنامه‌ای مجاز به استفاده از %1 نیست"

#: ui/AddAccountDialog.qml:23
#, kde-format
msgctxt "@title:window"
msgid "Create Account"
msgstr "ایجاد حساب"

#: ui/App.qml:28
#, kde-format
msgctxt "as in 'allow relevant apps to access your account'"
msgid "Give access to relevant apps:"
msgstr "دادن دسترسی به برنامه‌های مرتبط:"

#: ui/App.qml:68
#, kde-format
msgid "No relevant apps found"
msgstr "هیچ برنامهٔ مرتبطی یافت نشد"

#: ui/App.qml:74
#, kde-format
msgctxt "@action:button"
msgid "Finish"
msgstr "پایان"

#: ui/Error.qml:25
#, kde-format
msgctxt "%1 is an error message"
msgid "Setup failed: %1"
msgstr "راه‌اندازی ناموفق بود: %1"

#: ui/Error.qml:29
#, kde-format
msgctxt "@action:button"
msgid "OK"
msgstr "تأیید"

#: ui/main.qml:26
#, kde-format
msgid "Add Account…"
msgstr "افزودن حساب…"

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"This feature is under development and is still considered experimental. "
"Report all issues <link url='%1'>here</link>."
msgstr ""
"این ویژگی در دست توسعه است و هنوز آزمایشی در نظر گرفته می‌شود. همهٔ مشکلات "
"را در <link url='%1'>اینجا</link> گزارش کنید."

#: ui/main.qml:60
#, kde-format
msgid "Online accounts service is not running"
msgstr "سرویس حساب‌های برخط در حال اجرا نیست"

#: ui/main.qml:67
#, kde-format
msgid "No accounts configured"
msgstr "هیچ حسابی پیکربندی نشده است"
