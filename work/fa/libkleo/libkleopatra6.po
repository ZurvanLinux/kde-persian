#: utils/formatting.cpp:2016
#, kde-format
msgctxt "@info"
msgid "Ask the sender to resend the message."
msgstr "از فرستنده بخواهید پیام را دوباره ارسال کند."

#: utils/formatting.cpp:2017
#, kde-format
msgctxt "@info"
msgid "Ask the sender to resend the data."
msgstr "از فرستنده بخواهید داده‌ها را دوباره ارسال کند."

