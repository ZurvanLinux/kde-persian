msgid "Enable RDP server"
msgstr "فعال‌سازی کارساز RDP"

#: ui/main.qml:119
#, kde-format
msgctxt "@info:status"
msgid "Systemd not found. krdpserver will require manual activation."
msgstr "‏Systemd یافت نشد. krdpserver نیازمند فعال‌سازی دستی خواهد بود."

#: ui/main.qml:128
#, kde-kuit-format
