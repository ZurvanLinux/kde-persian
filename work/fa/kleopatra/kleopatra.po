#: src/main.cpp:179
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para><application>Kleopatra</application> cannot be run as administrator "
"without breaking file permissions in the GnuPG data folder.</para><para>To "
"manage keys for other users please manage them as a normal user and copy the"
" <filename>%APPDATA%\\gnupg*</filename> directory with proper "
"permissions.</para>"
msgstr ""
"<para>اجرای <application>کلئوپاترا</application> با دسترسی مدیر، بدون آسیب "
"زدن به مجوزهای پرونده در پوشهٔ دادهٔ GnuPG امکان‌پذیر نیست.</para><para>برای"
" مدیریت کلیدهای سایر کاربران، لطفاً آن‌ها را به‌عنوان یک کاربر معمولی مدیریت"
" کنید و شاخهٔ <filename>%APPDATA%\\gnupg*</filename> را با مجوزهای مناسب "
"رونوشت کنید.</para>"

#: src/main.cpp:183
#, kde-kuit-format
msgctxt "@info"
msgid "<para>Are you sure that you want to continue at your own risk?</para>"
msgstr "<para>آیا مطمئنید که می‌خواهید با مسئولیت خودتان ادامه دهید؟</para>"

#: src/main.cpp:184 src/main.cpp:200
#, kde-format
msgctxt "@title"
msgid "Running as Administrator"
msgstr "در حال اجرا با دسترسی مدیر (Administrator)"

#: src/main.cpp:195
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para><application>Kleopatra</application> should not be run as "
"administrator.</para><para>If you still want to run the application as "
"administrator at your own risk then set the registry value "
"<filename>%1</filename> to <icode>%2</icode>.</para>"
msgstr ""
"<para><application>کلئوپاترا</application> نباید با دسترسی مدیر اجرا "
"شود.</para><para>اگر همچنان می‌خواهید برنامه را با مسئولیت خودتان به‌عنوان "
"مدیر اجرا کنید، مقدار رجیستری <filename>%1</filename> را روی "
"<icode>%2</icode> تنظیم کنید.</para>"

#: src/main.cpp:260
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The version of the <application>GpgME</application> library you are "
"running against is older than the one that the "
"<application>GpgME++</application> library was built "
"against.</para><para><application>Kleopatra</application> will not function "
"in this setting.</para><para>Please ask your administrator for help in "
"resolving this issue.</para>"
msgstr ""
"<para>نسخهٔ کتابخانهٔ <application>GpgME</application> که برنامه از آن "
"استفاده می‌کند قدیمی‌تر از نسخه‌ای است که کتابخانهٔ "
"<application>GpgME++</application> بر پایهٔ آن ساخته شده "
"است.</para><para><application>کلئوپاترا</application> در این پیکربندی کار "
"نخواهد کرد.</para><para>لطفاً برای حل این مشکل از مدیر سیستم خود کمک "
"بگیرید.</para>"

