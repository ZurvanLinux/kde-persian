#: kwatchgnupgmainwin.cpp:69
#, kde-format
msgid "[%1] Log cleared"
msgstr "[%1] گزارش پاک شد"

#: kwatchgnupgmainwin.cpp:76
#, kde-format
msgid "C&lear History"
msgstr "پاک‌کردن تاریخچه"

#: kwatchgnupgmainwin.cpp:105
#, kde-format
msgid "[%1] Log stopped"
msgstr "[%1] گزارش متوقف شد"

#: kwatchgnupgmainwin.cpp:110
#, kde-format
msgid ""
"The watchgnupg logging program could not be found.\n"
"Please make sure that watchgnupg is installed."
msgstr ""
"برنامهٔ گزارش‌گیری watchgnupg پیدا نشد.\n"
"لطفاً مطمئن شوید که watchgnupg نصب شده است."

#: kwatchgnupgmainwin.cpp:112 kwatchgnupgmainwin.cpp:125
#, kde-format
msgctxt "[<timestamp>] Failed to start <path_of_watchgnupg>"
msgid "[%1] Failed to start %2"
msgstr "[%1] راه‌اندازی %2 ناموفق بود"

#: kwatchgnupgmainwin.cpp:123
#, kde-format
msgid ""
"The watchgnupg logging process could not be started.\n"
"Please make sure that watchgnupg is installed properly."
msgstr ""
"فرایند گزارش‌گیری watchgnupg راه‌اندازی نشد.\n"
"لطفاً مطمئن شوید که watchgnupg به‌درستی نصب شده است."

#: kwatchgnupgmainwin.cpp:131
#, kde-format
msgid "[%1] Log started"
msgstr "[%1] گزارش آغاز شد"

#: kwatchgnupgmainwin.cpp:140
#, kde-format
msgid ""
"The watchgnupg logging process died.\n"
"Do you want to try to restart it?"
msgstr ""
"فرایند گزارش‌گیری watchgnupg متوقف شد.\n"
"آیا می‌خواهید راه‌اندازی دوبارهٔ آن را امتحان کنید؟"

#: kwatchgnupgmainwin.cpp:142
#, kde-format
msgctxt "@action:button"
msgid "Try Restart"
msgstr "تلاش برای راه‌اندازی مجدد"

#: kwatchgnupgmainwin.cpp:143
#, kde-format
msgctxt "@action:button"
msgid "Do Not Try"
msgstr "تلاش نشود"

#: kwatchgnupgmainwin.cpp:145
#, kde-format
msgid "====== Restarting logging process ====="
msgstr "====== در حال راه‌اندازی مجدد فرایند گزارش‌گیری ====="

#: kwatchgnupgmainwin.cpp:149
#, kde-format
msgid ""
"The watchgnupg logging process is not running.\n"
"This log window is unable to display any useful information."
msgstr ""
"فرایند گزارش‌گیری watchgnupg در حال اجرا نیست.\n"
"این پنجرهٔ گزارش قادر به نمایش اطلاعات مفیدی نیست."

#: kwatchgnupgmainwin.cpp:173
#, kde-format
msgid "Save Log to File"
msgstr "ذخیرهٔ گزارش در پرونده"

#: kwatchgnupgmainwin.cpp:181
#, kde-format
msgid "Could not save file %1: %2"
msgstr "امکان ذخیرهٔ پروندهٔ %1 وجود ندارد: %2"

