#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "محمد شفیعی سروستانی"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "muhammad.shafiee@gmail.com"

#: kdesu.cpp:92
#, kde-format
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:94
#, kde-format
msgid "Runs a program with elevated privileges."
msgstr "اجرای یک برنامه با دسترسی‌های ارتقایافته."

#: kdesu.cpp:96
#, kde-format
msgid "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"
msgstr "حق نشر (c) ۱۹۹۸-۲۰۰۰ Geert Jansen، Pietro Iglio"

#: kdesu.cpp:97
#, kde-format
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdesu.cpp:97
#, kde-format
msgid "Maintainer"
msgstr "نگه‌دارنده"

#: kdesu.cpp:98
#, kde-format
msgid "Pietro Iglio"
msgstr "Pietro Iglio"

#: kdesu.cpp:98
#, kde-format
msgid "Original author"
msgstr "نویسندهٔ اصلی"

#: kdesu.cpp:107
#, kde-format
msgid "Specifies the command to run as separate arguments"
msgstr "دستور را برای اجرا به عنوان آرگومان‌های جداگانه مشخص می‌کند"

#: kdesu.cpp:108
#, kde-format
msgid "Specifies the command to run as one string"
msgstr "دستور را برای اجرا به صورت یک رشته مشخص می‌کند"

#: kdesu.cpp:109
#, kde-format
msgid "Run command under target uid if <file> is not writable"
msgstr ""
"اجرای دستور تحت شناسه کاربری (uid) هدف، در صورتی که <file> قابل نوشتن نباشد"

#: kdesu.cpp:110
#, kde-format
msgid "Specifies the target uid"
msgstr "شناسه کاربری (uid) هدف را مشخص می‌کند"

#: kdesu.cpp:111
#, kde-format
msgid "Do not keep password"
msgstr "گذرواژه ذخیره نشود"

#: kdesu.cpp:112
#, kde-format
msgid "Stop the daemon (forgets all passwords)"
msgstr "توقف دیمِن (فراموش کردن همه گذرواژه‌ها)"

#: kdesu.cpp:113
#, kde-format
msgid "Enable terminal output (no password keeping)"
msgstr "فعال‌سازی خروجی پایانه (بدون ذخیره گذرواژه)"

#: kdesu.cpp:115
#, kde-format
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "تنظیم مقدار اولویت: ‎0 <= prio <= 100‎، صفر کمترین است"

#: kdesu.cpp:116
#, kde-format
msgid "Use realtime scheduling"
msgstr "استفاده از زمان‌بندی بی‌درنگ (realtime)"

#: kdesu.cpp:117
#, kde-format
msgid "Do not display ignore button"
msgstr "دکمه نادیده‌گرفتن نمایش داده نشود"

#: kdesu.cpp:118
#, kde-format
msgid "Specify icon to use in the password dialog"
msgstr "نماد مورد استفاده در کادر گفتگوی گذرواژه را مشخص کنید"

#: kdesu.cpp:119
#, kde-format
msgid "Do not show the command to be run in the dialog"
msgstr "دستور در حال اجرا در کادر محاوره نشان داده نشود"

#: kdesu.cpp:126
#, kde-format
msgctxt ""
"Transient means that the kdesu app will be attached to the app specified by "
"the winid so that it is like a dialog box rather than some separate program"
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "کادر محاوره را وابسته به برنامهٔ X مشخص‌شده توسط winid می‌کند"

#: kdesu.cpp:128
#, kde-format
msgid "Embed into a window"
msgstr "قراردادن در یک پنجره"

#: kdesu.cpp:155
#, kde-format
msgid "Cannot execute command '%1'."
msgstr "اجرای دستور «%1» امکان‌پذیر نیست."

#: kdesu.cpp:158
#, kde-format
msgid "Cannot execute command '%1'. It contains invalid characters."
msgstr "اجرای دستور «%1» امکان‌پذیر نیست. حاوی نویسه‌های نامعتبر است."

#: kdesu.cpp:232
#, kde-format
msgid "Illegal priority: %1"
msgstr "اولویت غیرمجاز: %1"

#: kdesu.cpp:253
#, kde-format
msgid "No command specified."
msgstr "هیچ دستوری مشخص نشده است."

#: kdesu.cpp:356
#, kde-format
msgid "Su returned with an error.\n"
msgstr "دستور su با خطا مواجه شد.\n"

#: kdesu.cpp:384
#, kde-format
msgid "Command:"
msgstr "دستور:"

#: kdesu.cpp:393
#, kde-format
msgid "realtime: "
msgstr "بلادرنگ: "

#: kdesu.cpp:397
#, kde-format
msgid "Priority:"
msgstr "اولویت:"

#: sudlg.cpp:27
#, kde-format
msgid "Run as %1"
msgstr "اجرا به عنوان %1"

#: sudlg.cpp:31
#, kde-format
msgid "Please enter your password below."
msgstr "لطفاً گذرواژهٔ خود را در زیر وارد کنید."

#: sudlg.cpp:36
#, kde-format
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below or click Ignore to continue with your current "
"privileges."
msgstr ""
"اقدام درخواستی شما به <b>امتیازات ریشه (root)</b> نیاز دارد. لطفاً گذرواژهٔ "
"<b>ریشه</b> را در زیر وارد کنید، یا برای ادامه با امتیازات فعلی خود روی "
"نادیده‌گرفتن کلیک کنید."

#: sudlg.cpp:42
#, kde-format
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below."
msgstr ""
"اقدام درخواستی شما به <b>امتیازات ریشه (root)</b> نیاز دارد. لطفاً گذرواژهٔ "
"<b>ریشه</b> را در زیر وارد کنید."

#: sudlg.cpp:49
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below or click Ignore to continue with your current "
"privileges."
msgstr ""
"اقدام درخواستی شما به امتیازات اضافی نیاز دارد. لطفاً گذرواژهٔ <b>%1</b> را "
"در زیر وارد کنید، یا برای ادامه با امتیازات فعلی خود روی نادیده‌گرفتن کلیک "
"کنید."

#: sudlg.cpp:56
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below."
msgstr ""
"اقدام درخواستی شما به امتیازات اضافی نیاز دارد. لطفاً گذرواژهٔ <b>%1</b> را "
"در زیر وارد کنید."

#: sudlg.cpp:79
#, kde-format
msgid "Conversation with su failed."
msgstr "ارتباط با su ناموفق بود."

#: sudlg.cpp:86
#, kde-format
msgid ""
"The program 'su' could not be found.<br />Ensure your PATH is set correctly."
msgstr ""
"برنامهٔ «su» یافت نشد.<br />اطمینان حاصل کنید که متغیر PATH شما به درستی "
"تنظیم شده باشد."

#: sudlg.cpp:97
#, kde-format
msgid ""
"Permission denied.<br />Possibly incorrect password, please try again.<br "
"/>On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"دسترسی رد شد.<br />احتمالاً گذرواژه نادرست است، لطفاً دوباره تلاش کنید.<br "
"/>در برخی سیستم‌ها، برای استفاده از این برنامه باید در گروه خاصی (معمولاً: "
"wheel) عضو باشید."

#: sudlg.cpp:105
#, kde-format
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "خطای داخلی: مقدار بازگشتی غیرمجاز از SuProcess::checkInstall()"
