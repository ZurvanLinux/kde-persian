#: kioclient.cpp:56
#, kde-format
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"نحو:\n"

#: kioclient.cpp:58
#, kde-format
msgctxt "The argument is the command \"kioclient openProperties\""
msgid ""
"  %1 'url'\n"
"            # Opens a properties dialog of 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # پنجره ویژگی‌های 'url' را باز می‌کند\n"
"\n"

#: kioclient.cpp:65
#, kde-format
msgctxt "The argument is the command \"kioclient exec\""
msgid ""
"  %1 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the application\n"
"            # associated with it in KDE. You may omit 'mimetype'.\n"
"            # In that case the mimetype is determined automatically.\n"
"            # 'url' can be the URL of a document, a *.desktop file,\n"
"            # or an executable.\n"
msgstr ""
"  %1 'url' ['mimetype']\n"
"            # تلاش می‌کند سندی را که به 'url' اشاره دارد، در برنامه مرتبط با آن\n"
"            # در KDE باز کند. می‌توانید 'mimetype' را حذف کنید.\n"
"            # در این صورت نوع mime به طور خودکار تعیین می‌شود.\n"
"            # 'url' می‌تواند نشانی یک سند، یک پرونده ‎*.desktop‎\n"
"            # یا یک پرونده اجرایی باشد.\n"

#: kioclient.cpp:76
#, kde-format
msgctxt "The argument is the command \"kioclient move\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   'dest' may be \"trash:/\" to move the files to the trash.\n"
"            #   The short version 'kioclient mv' is also available.\n"
"\n"
msgstr ""
"  %1 'src' 'dest'\n"
"            # نشانی 'src' را به 'dest' منتقل می‌کند.\n"
"            #   'src' می‌تواند فهرستی از نشانی‌ها باشد.\n"
"            #   'dest' می‌تواند \"trash:/\" باشد تا پرونده‌ها به سطل زباله منتقل شوند.\n"
"            #   نسخه کوتاه 'kioclient mv' نیز در دسترس است.\n"
"\n"

#: kioclient.cpp:86
#, kde-format
msgctxt "The argument is the command \"kioclient download\""
msgid ""
"  %1 ['src']\n"
"            # Copies the URL 'src' to a user-specified location.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  %1 ['src']\n"
"            # نشانی 'src' را به مکان مشخص‌شده توسط کاربر رونوشت می‌کند.\n"
"            #   'src' می‌تواند فهرستی از نشانی‌ها باشد، اگر وجود نداشته باشد\n"
"            #   یک نشانی درخواست خواهد شد.\n"
"\n"

#: kioclient.cpp:95
#, kde-format
msgctxt "The argument is the command \"kioclient copy\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   The short version 'kioclient cp' is also available.\n"
"\n"
msgstr ""
"  %1 'src' 'dest'\n"
"            # نشانی 'src' را به 'dest' رونوشت می‌کند.\n"
"            #   'src' می‌تواند فهرستی از نشانی‌ها باشد.\n"
"            #   نسخه کوتاه 'kioclient cp' نیز در دسترس است.\n"
"\n"

#: kioclient.cpp:104
#, kde-format
msgctxt "The argument is the command \"kioclient cat\""
msgid ""
"  %1 'url'\n"
"            # Prints the contents of the file 'url' to the standard output\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # محتویات پرونده 'url' را در خروجی استاندارد چاپ می‌کند\n"
"\n"

#: kioclient.cpp:111
#, kde-format
msgctxt "The argument is the command \"kioclient ls\""
msgid ""
"  %1 'url'\n"
"            # Lists the contents of the directory 'url' to stdout\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # فهرست محتویات شاخه 'url' را در خروجی استاندارد (stdout) نمایش می‌دهد\n"
"\n"

#: kioclient.cpp:118
#, kde-format
msgctxt "The argument is the command \"kioclient remove\""
msgid ""
"  %1 'url'\n"
"            # Removes the URL\n"
"            #   'url' may be a list of URLs.\n"
"            #   The short version 'kioclient rm' is also available.\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # نشانی وب (URL) را حذف می‌کند\n"
"            #   'url' می‌تواند فهرستی از نشانی‌ها باشد.\n"
"            #   نسخهٔ کوتاه 'kioclient rm' نیز در دسترس است.\n"
"\n"

#: kioclient.cpp:127
#, kde-format
msgctxt "The argument is the command \"kioclient mkdir\""
msgid ""
"  %1 'url'\n"
"            # Creates a directory at 'url'\n"
msgstr ""
"  %1 'url'\n"
"            # شاخه‌ای در 'url' ایجاد می‌کند\n"

#: kioclient.cpp:134
#, kde-format
msgctxt "The argument is the command \"kioclient stat\""
msgid ""
"  %1 'url'\n"
"            # Shows all of the available information for 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # تمام اطلاعات موجود را برای 'url' نشان می‌دهد\n"
"\n"

#: kioclient.cpp:141
#, kde-format
msgctxt "The argument is the command \"kioclient appmenu\""
msgid ""
"  %1\n"
"            # Opens a basic application launcher\n"
"\n"
msgstr ""
"  %1\n"
"            # یک راه‌انداز پایهٔ برنامه‌ها را باز می‌کند\n"
"\n"

#: kioclient.cpp:147
#, kde-format
msgid "*** Examples:\n"
msgstr "*** مثال‌ها:\n"

#: kioclient.cpp:148
#, kde-format
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with the default application associated\n"
"             // with this MimeType\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // پرونده را با برنامهٔ پیش‌فرض مرتبط با\n"
"             // این نوع Mime باز می‌کند\n"
"\n"

#: kioclient.cpp:153
#, kde-format
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens URL with the default handler for ftp:// scheme\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             // نشانی را با گردانندهٔ پیش‌فرض شیوه‌نامهٔ //:ftp باز می‌کند\n"
"\n"

#: kioclient.cpp:157
#, kde-format
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // برنامهٔ emacs را اجرا می‌کند\n"
"\n"

#: kioclient.cpp:161
#, kde-format
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory in the default\n"
"             // file manager. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // شاخهٔ جاری را در مدیر پروندهٔ پیش‌فرض\n"
"             // باز می‌کند. بسیار راحت است.\n"
"\n"

