msgstr "             # ارسال درخواست «Check» به دستگاه متناظر با «udi».\n"

#: tools/solid-hardware/solid-hardware.cpp:286
msgctxt "solid-hardware|"
msgid ""
"             # Send \"CanRepair\" request to the device corresponding to "
