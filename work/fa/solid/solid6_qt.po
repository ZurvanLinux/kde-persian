#: tools/solid-hardware/solid-hardware.cpp:218
#: tools/solid-hardware/solid-hardware.cpp:341
msgctxt "solid-hardware|"
msgid "Device udi"
msgstr "شناسهٔ udi دستگاه"

#: tools/solid-hardware/solid-hardware.cpp:230
msgctxt "solid-hardware|"
msgid "Syntax:"
msgstr "نحو:"

#: tools/solid-hardware/solid-hardware.cpp:233
msgctxt "solid-hardware|"
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # فهرست کردن سخت‌افزارهای موجود در سامانه.\n"
"             # - اگر گزینهٔ 'nonportableinfo' مشخص شده باشد، ویژگی‌های دستگاه\n"
"             # فهرست می‌شوند (توجه داشته باشید، در این حالت نام ویژگی‌ها\n"
"             # به پشتیبان وابسته است)،\n"
"             # - اگر گزینهٔ 'details' مشخص شده باشد، رابط‌های دستگاه\n"
"             # و ویژگی‌های متناظر به‌گونه‌ای مستقل از پلتفرم\n"
"             # فهرست می‌شوند،\n"
"             # - در غیر این صورت، تنها UDIهای دستگاه‌ها فهرست می‌شوند.\n"

#: tools/solid-hardware/solid-hardware.cpp:245
msgctxt "solid-hardware|"
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # نمایش همهٔ رابط‌ها و ویژگی‌های دستگاه متناظر\n"
"             # با 'udi' به‌گونه‌ای مستقل از پلتفرم.\n"

#: tools/solid-hardware/solid-hardware.cpp:251
msgctxt "solid-hardware|"
msgid ""
"             # Display all the properties of the device corresponding to 'udi'\n"
"             # (be careful, in this case property names are backend dependent).\n"
msgstr ""
"             # نمایش همهٔ ویژگی‌های دستگاه متناظر با 'udi'\n"
"             # (توجه داشته باشید، در این حالت نام ویژگی‌ها به پشتیبان وابسته است).\n"

#: tools/solid-hardware/solid-hardware.cpp:257
msgctxt "solid-hardware|"
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # فهرست کردن UDI دستگاه‌های منطبق با 'predicate'.\n"
"             # - اگر 'parentUdi' مشخص شده باشد، جست‌وجو به شاخهٔ\n"
"             # دستگاه متناظر محدود می‌شود،\n"
"             # - در غیر این صورت، جست‌وجو روی همهٔ دستگاه‌ها انجام می‌پذیرد.\n"

#: tools/solid-hardware/solid-hardware.cpp:265
msgctxt "solid-hardware|"
msgid "             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr ""
"             # در صورت امکان، سوار کردن (mount) دستگاه متناظر با 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:268
msgctxt "solid-hardware|"
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr ""
"             # در صورت امکان، پیاده کردن (unmount) دستگاه متناظر با 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:271
msgctxt "solid-hardware|"
msgid "             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr ""
"             # در صورت امکان، بیرون دادن (eject) دستگاه متناظر با 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:274
msgctxt "solid-hardware|"
msgid "             # Listen to all add/remove events on supported hardware.\n"
msgstr ""
"             # شنود همهٔ رویدادهای افزودن/حذف در سخت‌افزارهای "
"پشتیبانی‌شده.\n"

#: tools/solid-hardware/solid-hardware.cpp:277
msgctxt "solid-hardware|"
msgid "             # Monitor devices for changes.\n"
msgstr "             # پایش دستگاه‌ها برای تغییرات.\n"

#: tools/solid-hardware/solid-hardware.cpp:280
msgctxt "solid-hardware|"
msgid ""
"             # Send \"CanCheck\" request to the device corresponding to "
"'udi'.\n"
msgstr "             # ارسال درخواست «CanCheck» به دستگاه متناظر با «udi».\n"

