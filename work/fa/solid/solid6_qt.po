msgstr "             # ارسال درخواست «CanRepair» به دستگاه متناظر با «udi».\n"

#: tools/solid-hardware/solid-hardware.cpp:289
msgctxt "solid-hardware|"
msgid ""
"             # Send \"Repair\" request to the device corresponding to "
"'udi'.\n"
msgstr "             # ارسال درخواست «Repair» به دستگاه متناظر با «udi».\n"

