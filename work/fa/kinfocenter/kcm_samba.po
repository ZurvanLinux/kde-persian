#: ui/main.qml:18
#, kde-format
msgctxt "@title heading above listview"
msgid "User-Created Shares"
msgstr "اشتراک‌های ایجادشده توسط کاربر"

#: ui/main.qml:23
#, kde-format
msgctxt "@title heading above listview"
msgid "Remote Share Mounts"
msgstr "سوارکردن‌های اشتراک دوردست"

#: ui/main.qml:54
#, kde-format
msgctxt "@info place holder for empty listview"
msgid "There are no directories shared by users"
msgstr "هیچ شاخه‌ای توسط کاربران به اشتراک گذاشته نشده است"

#: ui/main.qml:92
#, kde-format
msgctxt "@info place holder for empty listview"
msgid "There are no Samba shares mounted on this system"
msgstr "هیچ اشتراک سامبایی روی این سامانه سوار نشده است"

#: ui/ShareListItem.qml:24
#, kde-format
msgctxt "@label local file system path"
msgid "Path:"
msgstr "مسیر:"

#: ui/ShareListItem.qml:40
#, kde-format
msgctxt "@label labels a samba url or path"
msgid "Shared at:"
msgstr "به‌اشتراک‌گذاشته‌شده در:"

#: ui/ShareListItem.qml:69
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid "Open folder properties to change share settings"
msgstr "ویژگی‌های پوشه را باز کنید تا تنظیمات اشتراک‌گذاری تغییر یابد"
