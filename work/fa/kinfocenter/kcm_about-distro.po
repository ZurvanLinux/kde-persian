#: MemoryEntry.cpp:129
#, kde-format
msgctxt ""
"@label, %1 is the total amount of installed system memory, %2 is the amount "
"of which is usable, both expressed as 7.7 GiB"
msgid "%1 of RAM (%2 usable)"
msgstr "%1 رم (%2 قابل استفاده)"

#: MemoryEntry.cpp:137
#, kde-format
msgctxt ""
"@label, %1 is the amount of installed system memory expressed as 7.7 GiB"
msgid "%1 of RAM"
msgstr "%1 رم"

#: MemoryEntry.cpp:144
#, kde-format
msgctxt ""
"@label, %1 is the amount of usable system memory expressed as 7.7 GiB"
msgid "%1 of usable RAM"
msgstr "%1 رم قابل استفاده"

#: MemoryEntry.cpp:150
#, kde-format
msgctxt "@label, Unknown amount of system memory"
msgid "Unknown"
msgstr "ناشناخته"

#: MemoryEntry.cpp:158
#, kde-format
msgctxt "@info:tooltip, referring to system memory or RAM"
msgid ""
"Some memory is reserved for use by the kernel or system hardware such as "
"integrated graphics memory."
msgstr ""
"بخشی از حافظه برای استفاده توسط هسته یا سخت‌افزار سیستم مانند حافظهٔ گرافیکی"
" یکپارچه رزرو شده است."

#: MemoryEntry.cpp:166
#, kde-format
msgctxt "@info:tooltip, referring to system memory or RAM"
msgid ""
"The amount of usable memory may be lower than the displayed amount because "
"some memory is reserved for use by the kernel or system hardware, such as "
"integrated graphics memory."
msgstr ""
"میزان حافظهٔ قابل استفاده ممکن است کمتر از مقدار نمایش‌داده‌شده باشد، زیرا "
"بخشی از حافظه برای استفاده توسط هسته یا سخت‌افزار سیستم، مانند حافظهٔ "
"گرافیکی یکپارچه رزرو شده است."

#: MemoryEntry.cpp:175
#, kde-format
msgctxt "@info:tooltip, referring to system memory or RAM"
msgid ""
"The amount of memory displayed may be lower than the installed amount "
"because some memory is reserved for use by the kernel or system hardware, "
"such as integrated graphics memory."
msgstr ""
"میزان حافظهٔ نمایش‌داده‌شده ممکن است کمتر از مقدار نصب‌شده باشد، زیرا بخشی "
"از حافظه برای استفاده توسط هسته یا سخت‌افزار سیستم، مانند حافظهٔ گرافیکی "
"یکپارچه رزرو شده است."

