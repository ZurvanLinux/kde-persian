#: files/plasma-setup.desktop.in:9 src/auth/org.kde.plasmasetup.actions:8
msgctxt "Name"
msgid "Plasma Setup"
msgstr "راه‌اندازی پلاسما"

#: files/plasma-setup.desktop.in:49
msgctxt "Comment"
msgid "Run the initial system setup for KDE"
msgstr "اجرای برپایی اولیه سامانه برای KDE"

#: src/auth/org.kde.plasmasetup.actions:52
msgctxt "Name"
msgid "Create User"
msgstr "ایجاد کاربر"

#: src/auth/org.kde.plasmasetup.actions:92
msgctxt "Description"
msgid "Create the initial user account"
msgstr "ایجاد حساب کاربری اولیه"

#: src/auth/org.kde.plasmasetup.actions:134
msgctxt "Name"
msgid "Create Completion Flag File"
msgstr "ایجاد پروندهٔ پرچم تکمیل"

#: src/auth/org.kde.plasmasetup.actions:172
msgctxt "Description"
msgid "Write the /etc/plasma-setup-done marker to prevent rerunning setup"
msgstr ""
"نوشتن نشانگر etc/plasma-setup-done/ برای جلوگیری از اجرای مجدد راه‌اندازی"

#: src/auth/org.kde.plasmasetup.actions:213
msgctxt "Name"
msgid "Create New User Autostart Hook"
msgstr "ایجاد قلاب آغاز خودکار کاربر جدید"

#: src/auth/org.kde.plasmasetup.actions:252
msgctxt "Description"
msgid "Create an autostart hook for the newly created user"
msgstr "ایجاد یک قلاب آغاز خودکار برای کاربر تازه ایجادشده"

#: src/auth/org.kde.plasmasetup.actions:294
msgctxt "Name"
msgid "Remove Autologin"
msgstr "حذف ورود خودکار"

#: src/auth/org.kde.plasmasetup.actions:333
msgctxt "Description"
msgid "Remove Display Manager autologin configuration"
msgstr "حذف پیکربندی ورود خودکار مدیر نمایش"

#: src/auth/org.kde.plasmasetup.actions:374
msgctxt "Name"
msgid "Set New User Global Theme"
msgstr "تنظیم پوستهٔ سراسری کاربر جدید"

#: src/auth/org.kde.plasmasetup.actions:413
msgctxt "Description"
msgid "Set the global theme for the new user"
msgstr "تنظیم پوستهٔ سراسری برای کاربر جدید"

#: src/auth/org.kde.plasmasetup.actions:455
msgctxt "Name"
msgid "Set New User Display Scaling"
msgstr "تنظیم مقیاس‌بندی صفحهٔ نمایش کاربر جدید"

#: src/auth/org.kde.plasmasetup.actions:494
msgctxt "Description"
msgid "Set display scaling for the new user"
msgstr "تنظیم مقیاس‌بندی صفحهٔ نمایش برای کاربر جدید"

#: src/auth/org.kde.plasmasetup.actions:535
msgctxt "Name"
msgid "Set New User Home Directory Ownership"
msgstr "تنظیم مالکیت شاخهٔ خانگی کاربر جدید"

#: src/auth/org.kde.plasmasetup.actions:574
msgctxt "Description"
msgid ""
"Set ownership of the new users home directory to the newly created user"
msgstr "تنظیم مالکیت شاخهٔ خانگی کاربر جدید برای کاربر تازه‌ایجادشده"

#: src/auth/org.kde.plasmasetup.actions:615
msgctxt "Name"
msgid "Set New User Temporary Autologin"
msgstr "تنظیم ورود خودکار موقت کاربر جدید"

#: src/auth/org.kde.plasmasetup.actions:653
msgctxt "Description"
msgid ""
"Set display manager temporary autologin configuration for the newly created "
"user"
msgstr "تنظیم پیکربندی ورود خودکار موقت مدیر نمایش برای کاربر تازه‌ایجادشده"
