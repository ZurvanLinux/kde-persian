#: modules/account/metadata.json
msgctxt "Name"
msgid "About You"
msgstr "دربارهٔ شما"

#: modules/cellular/metadata.json
msgctxt "Name"
msgid "Cellular"
msgstr "شبکهٔ همراه"

#: modules/finished/metadata.json
msgctxt "Name"
msgid "Completed!"
msgstr "کامل شد!"

#: modules/hostname/metadata.json
msgctxt "Name"
msgid "Hostname"
msgstr "نام میزبان"

#: modules/keyboard/metadata.json
msgctxt "Name"
msgid "Keyboard Layout"
msgstr "چیدمان صفحه‌کلید"

#: modules/language/metadata.json
msgctxt "Name"
msgid "Language"
msgstr "زبان"

#: modules/prepare/metadata.json
msgctxt "Name"
msgid "Before we get started…"
msgstr "پیش از شروع…"

#: modules/time/metadata.json
msgctxt "Name"
msgid "Time and Date"
msgstr "زمان و تاریخ"

#: modules/wifi/metadata.json
msgctxt "Name"
msgid "Network"
msgstr "شبکه"

#: modules/account/metadata.json
msgctxt "Description"
msgid "Allow the user to set the account name."
msgstr "اجازه دادن به کاربر برای تنظیم نام حساب."

#: modules/cellular/metadata.json
msgctxt "Description"
msgid "Allow the user to configure the cellular network."
msgstr "به کاربر اجازه می‌دهد شبکهٔ تلفن همراه را پیکربندی کند."

#: modules/finished/metadata.json
msgctxt "Description"
msgid ""
"Shown when the initial system setup is completed, and the user can commit "
"the changes."
msgstr ""
"زمانی نمایش داده می‌شود که راه‌اندازی اولیهٔ سیستم کامل شده باشد و کاربر "
"بتواند تغییرات را اعمال کند."

#: modules/hostname/metadata.json
msgctxt "Description"
msgid "Allow the user to set the system hostname."
msgstr "به کاربر اجازه می‌دهد نام میزبان سیستم را تعیین کند."

#: modules/keyboard/metadata.json
msgctxt "Description"
msgid "Allow the user to choose the keyboard layout."
msgstr "به کاربر اجازه می‌دهد چیدمان صفحه‌کلید را انتخاب کند."

#: modules/language/metadata.json
msgctxt "Description"
msgid "Allow the user to set the system language."
msgstr "به کاربر اجازه می‌دهد زبان سیستم را تنظیم کند."

#: modules/prepare/metadata.json
msgctxt "Description"
msgid "Allows the user to configure the environment before using it."
msgstr "به کاربر اجازه می‌دهد محیط را پیش از استفاده پیکربندی کند."

#: modules/time/metadata.json
msgctxt "Description"
msgid "Allow the user to set the timezone."
msgstr "به کاربر اجازه می‌دهد منطقهٔ زمانی را تنظیم کند."

#: modules/wifi/metadata.json
msgctxt "Description"
msgid "Allow the user to connect to a Wi-Fi network."
msgstr "به کاربر اجازه می‌دهد به یک شبکهٔ Wi-Fi متصل شود."

#: modules/account/metadata.json modules/prepare/metadata.json
