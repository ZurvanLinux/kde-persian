#: utils/katecmds.cpp:53
#, kde-format
msgid "<p>indent</p><p>Indents the selected lines or the current line</p>"
msgstr "<p>indent</p><p>خط‌های انتخاب‌شده یا خط فعلی را دندانه‌دار می‌کند</p>"

#: utils/katecmds.cpp:58
#, kde-format
msgid "<p>unindent</p><p>Unindents the selected lines or current line.</p>"
msgstr ""
"<p>unindent</p><p>دندانه‌گذاری خط‌های انتخاب‌شده یا خط فعلی را حذف "
"می‌کند.</p>"

#: utils/katecmds.cpp:63
#, kde-format
msgid ""
"<p>cleanindent</p><p>Cleans up the indentation of the selected lines or "
"current line according to the indentation settings in the document. </p>"
msgstr ""
"<p>cleanindent</p><p>دندانه‌گذاری خط‌های انتخاب‌شده یا خط فعلی را بر اساس "
"تنظیمات دندانه‌گذاری سند مرتب می‌کند.</p>"

#: utils/katecmds.cpp:68
#, kde-format
msgid ""
"<p>comment</p><p>Inserts comment markers to make the selection or selected "
"lines or current line a comment according to the text format as defined by "
"the syntax highlight definition for the document.</p>"
msgstr ""
"<p>comment</p><p>نشانه‌های توضیح را درج می‌کند تا بخش انتخابی، خط‌های "
"انتخاب‌شده یا خط فعلی با توجه به قالب متن تعریف‌شده در برجسته‌سازی نحو سند، "
"تبدیل به توضیح (کامنت) شوند.</p>"

#: utils/katecmds.cpp:74
#, kde-format
msgid ""
"<p>uncomment</p><p>Removes comment markers from the selection or selected "
"lines or current line according to the text format as defined by the syntax "
"highlight definition for the document.</p>"
msgstr ""
"<p>uncomment</p><p>نشانه‌های توضیح را از بخش انتخابی، خط‌های انتخاب‌شده یا "
"خط فعلی با توجه به قالب متن تعریف‌شده در برجسته‌سازی نحو سند حذف می‌کند.</p>"

#: utils/katecmds.cpp:80
#, kde-format
msgid ""
"<p>goto <b>line number</b></p><p>This command navigates to the specified "
"line number.</p>"
msgstr ""
"<p>goto <b>line number</b></p><p>این دستور به شماره سطر مشخص‌شده می‌رود.</p>"

#: utils/katecmds.cpp:85
#, kde-format
msgid ""
"<p>set-indent-pasted-text <b>enable</b></p><p>If enabled, indentation of "
"text pasted from the clipboard is adjusted using the current "
"indenter.</p><p>Possible true values: 1 on true<br/>possible false values: 0"
" off false</p>"
msgstr ""
"<p>set-indent-pasted-text <b>enable</b></p><p>در صورت فعال بودن، تورفتگی متن"
" جای‌گذاری‌شده از کلیپ‌بورد با استفاده از تنظیمات تورفتگی فعلی تنظیم "
"می‌شود.</p><p>مقادیر ممکن برای درست: 1 on true<br/>مقادیر ممکن برای نادرست: "
"0 off false</p>"

#: utils/katecmds.cpp:91
#, kde-format
msgid "Deletes the current line."
msgstr "سطر فعلی را حذف می‌کند."

#: utils/katecmds.cpp:95
#, kde-format
msgid ""
"<p>set-tab-width <b>width</b></p><p>Sets the tab width to the number "
"<b>width</b></p>"
msgstr ""
"<p>set-tab-width <b>width</b></p><p>عرض تب را روی عدد <b>width</b> تنظیم "
"می‌کند</p>"

#: utils/katecmds.cpp:100
#, kde-format
msgid ""
"<p>set-replace-tab <b>enable</b></p><p>If enabled, tabs are replaced with "
"spaces as you type.</p><p>Possible true values: 1 on true<br/>possible false"
" values: 0 off false</p>"
msgstr ""
"<p>set-replace-tab <b>enable</b></p><p>در صورت فعال بودن، هنگام تایپ تب‌ها "
"با فاصله جایگزین می‌شوند.</p><p>مقادیر ممکن برای درست: 1 on true<br/>مقادیر "
"ممکن برای نادرست: 0 off false</p>"

#: utils/katecmds.cpp:107
#, kde-format
msgid ""
"<p>set-show-tabs <b>enable</b></p><p>If enabled, TAB characters and trailing"
" whitespace will be visualized by a small dot.</p><p>Possible true values: 1"
" on true<br/>possible false values: 0 off false</p>"
msgstr ""
"<p>set-show-tabs <b>enable</b></p><p>در صورت فعال بودن، نویسه‌های TAB و "
"فاصله‌های خالی انتهایی با یک نقطه کوچک نمایش داده می‌شوند.</p><p>مقادیر ممکن"
" برای درست: 1 on true<br/>مقادیر ممکن برای نادرست: 0 off false</p>"

#: utils/katecmds.cpp:114
#, kde-format
msgid ""
"<p>set-remove-trailing-spaces <b>mode</b></p><p>Removes the trailing spaces "
"in the document depending on the <b>mode</b>.</p><p>Possible "
"values:<ul><li><b>none</b>: never remove trailing "
"spaces.</li><li><b>modified</b>: remove trailing spaces only of modified "
"lines.</li><li><b>all</b>: remove trailing spaces in the entire "
"document.</li></ul></p>"
msgstr ""
"<p>set-remove-trailing-spaces <b>mode</b></p><p>فاصله‌های خالی انتهای سطرها "
"را در سند بر اساس <b>mode</b> حذف می‌کند.</p><p>مقادیر "
"ممکن:<ul><li><b>none</b>: هرگز فاصله‌های انتهایی را حذف "
"نکن.</li><li><b>modified</b>: فاصله‌های انتهایی را فقط در سطرهای تغییریافته "
"حذف کن.</li><li><b>all</b>: فاصله‌های انتهایی را در کل سند حذف "
"کن.</li></ul></p>"

#: utils/katecmds.cpp:125
#, kde-format
msgid ""
"<p>set-indent-width <b>width</b></p><p>Sets the indentation width to the "
"number <b>width</b>. Used only if you are indenting with spaces.</p>"
msgstr ""
"<p>set-indent-width <b>width</b></p><p>عرض تورفتگی را روی عدد <b>width</b> "
"تنظیم می‌کند. فقط در صورتی استفاده می‌شود که با فاصله تورفتگی ایجاد "
"کنید.</p>"

#: utils/katecmds.cpp:130
#, kde-format
msgid ""
"<p>set-indent-mode <b>mode</b></p><p>The mode parameter is a value as seen "
"in the Tools - Indentation menu</p>"
msgstr ""
"<p>set-indent-mode <b>mode</b></p><p>پارامتر حالت، مقداری است که در منوی "
"ابزارها - تورفتگی دیده می‌شود</p>"

#: utils/katecmds.cpp:135
#, kde-format
msgid ""
"<p>set-auto-indent <b>enable</b></p><p>Enable or disable "
"autoindentation.</p><p>possible true values: 1 on true<br/>possible false "
"values: 0 off false</p>"
msgstr ""
"<p>set-auto-indent <b>enable</b></p><p>فعال یا غیرفعال کردن تورفتگی "
"خودکار.</p><p>مقادیر ممکن برای درست: 1 on true<br/>مقادیر ممکن برای نادرست: "
"0 off false</p>"

#: utils/katecmds.cpp:142
#, kde-format
msgid ""
"<p>set-line-numbers <b>enable</b></p><p>Sets the visibility of the line "
"numbers pane.</p><p> possible true values: 1 on true<br/>possible false "
"values: 0 off false</p>"
msgstr ""
"<p>set-line-numbers <b>enable</b></p><p>نمایانی پانل شماره‌های خط را تنظیم "
"می‌کند.</p><p> مقادیر معتبر true: 1 on true<br/>مقادیر معتبر false: 0 off "
"false</p>"

#: utils/katecmds.cpp:149
#, kde-format
msgid ""
"<p>set-folding-markers <b>enable</b></p><p>Sets the visibility of the "
"folding markers pane.</p><p> possible true values: 1 on true<br/>possible "
"false values: 0 off false</p>"
msgstr ""
"<p>set-folding-markers <b>enable</b></p><p>نمایانی پانل نشانگرهای تاشو را "
"تنظیم می‌کند.</p><p> مقادیر معتبر true: 1 on true<br/>مقادیر معتبر false: 0 "
"off false</p>"

#: utils/katecmds.cpp:156
#, kde-format
msgid ""
"<p>set-icon-border <b>enable</b></p><p>Sets the visibility of the icon "
"border.</p><p> possible true values: 1 on true<br/>possible false values: 0 "
"off false</p>"
msgstr ""
"<p>set-icon-border <b>enable</b></p><p>نمایانی حاشیهٔ آیکون را تنظیم "
"می‌کند.</p><p> مقادیر معتبر true: 1 on true<br/>مقادیر معتبر false: 0 off "
"false</p>"

#: utils/katecmds.cpp:163
#, kde-format
msgid ""
"<p>set-word-wrap <b>enable</b></p><p>Enables dynamic word wrap according to "
"<b>enable</b></p><p> possible true values: 1 on true<br/>possible false "
"values: 0 off false</p>"
msgstr ""
"<p>set-word-wrap <b>enable</b></p><p>شکست خط پویا را طبق <b>enable</b> فعال "
"می‌کند</p><p> مقادیر معتبر true: 1 on true<br/>مقادیر معتبر false: 0 off "
"false</p>"

#: utils/katecmds.cpp:170
#, kde-format
msgid ""
"<p>set-word-wrap-column <b>width</b></p><p>Sets the line width for hard "
"wrapping to <b>width</b>. This is used if you are having your text wrapped "
"automatically.</p>"
msgstr ""
"<p>set-word-wrap-column <b>width</b></p><p>عرض خط برای شکست سخت را روی "
"<b>width</b> تنظیم می‌کند. این در صورتی استفاده می‌شود که متن شما به‌طور "
"خودکار شکسته شود.</p>"

#: utils/katecmds.cpp:175
#, kde-format
msgid ""
"<p>set-replace-tabs-save <b>enable</b></p><p>When enabled, tabs will be "
"replaced with whitespace whenever the document is saved.</p><p> possible "
"true values: 1 on true<br/>possible false values: 0 off false</p>"
msgstr ""
"<p>set-replace-tabs-save <b>enable</b></p><p>در صورت فعال بودن، هر بار که "
"سند ذخیره می‌شود، تب‌ها با فاصله جایگزین می‌شوند.</p><p> مقادیر معتبر true: "
"1 on true<br/>مقادیر معتبر false: 0 off false</p>"

#: utils/katecmds.cpp:182
#, kde-format
msgid ""
"<p>set-highlight <b>highlight</b></p><p>Sets the syntax highlighting system "
"for the document. The argument must be a valid highlight name, as seen in "
"the Tools → Highlighting menu. This command provides an autocompletion list "
"for its argument.</p>"
msgstr ""
"<p>set-highlight <b>highlight</b></p><p>سیستم پررنگ‌سازی نحو را برای سند "
"تنظیم می‌کند. آرگومان باید یک نام پررنگ‌سازی معتبر باشد، همان‌طور که در منوی"
" «ابزارها ← پررنگ‌سازی» دیده می‌شود. این فرمان یک فهرست تکمیل خودکار برای "
"آرگومان خود ارائه می‌دهد.</p>"

#: utils/katecmds.cpp:188
#, kde-format
msgid ""
"<p>set-mode <b>mode</b></p><p>Sets the mode as seen in Tools - Mode</p>"
msgstr ""
"<p>set-mode <b>mode</b></p><p>حالت را مطابق با آنچه در «ابزارها - حالت» دیده"
" می‌شود تنظیم می‌کند</p>"

#: utils/katecmds.cpp:193
#, kde-format
msgid ""
"<p>set-show-indent <b>enable</b></p><p>If enabled, indentation will be "
"visualized by a vertical dotted line.</p><p> possible true values: 1 on "
"true<br/>possible false values: 0 off false</p>"
msgstr ""
"<p>set-show-indent <b>enable</b></p><p>در صورت فعال بودن، فرورفتگی با یک خط "
"نقطه‌چین عمودی نمایش داده می‌شود.</p><p> مقادیر معتبر true: 1 on "
"true<br/>مقادیر معتبر false: 0 off false</p>"

#: utils/katecmds.cpp:199
#, kde-format
msgid "<p>Open the Print dialog to print the current document.</p>"
msgstr "<p>کادر محاوره‌ای چاپ را برای چاپ سند فعلی باز می‌کند.</p>"

