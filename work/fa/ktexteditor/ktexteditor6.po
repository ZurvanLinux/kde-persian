msgstr "تنها برخی از اسناد روی دیسک نوشته شدند"

#: vimode/appcommands.cpp:79
#, kde-format
msgid "Document written to disk"
msgstr "سند در دیسک نوشته شد"

#: vimode/appcommands.cpp:212
#, kde-format
msgid ""
"<p><b>w/wa &mdash; write document(s) to disk</b></p><p>Usage: "
"<tt><b>w[a]</b></tt></p><p>Writes the current document(s) to disk. It can be"
" called in two ways:<br /> <tt>w</tt> &mdash; writes the current document to"
" disk<br /> <tt>wa</tt> &mdash; writes all documents to disk.</p><p>If no "
"file name is associated with the document, a file dialog will be shown.</p>"
msgstr ""
"<p><b>w/wa &mdash; نوشتن سند(ها) روی دیسک</b></p><p>کاربرد: "
"<tt><b>w[a]</b></tt></p><p>سند(های) فعلی را روی دیسک می‌نویسد. این دستور به "
"دو روش قابل فراخوانی است:<br /> <tt>w</tt> &mdash; سند فعلی را روی دیسک "
"می‌نویسد<br /> <tt>wa</tt> &mdash; تمام اسناد را روی دیسک "
"می‌نویسد.</p><p>اگر نام پرونده‌ای به سند اختصاص داده نشده باشد، یک کادر "
"گفتگوی پرونده نمایش داده خواهد شد.</p>"

#: vimode/appcommands.cpp:223
#, kde-format
msgid ""
"<p><b>q/qa/wq/wqa &mdash; [write and] quit</b></p><p>Usage: "
"<tt><b>[w]q[a]</b></tt></p><p>Quits the application. If <tt>w</tt> is "
"prepended, it also writes the document(s) to disk. This command can be "
"called in several ways:<br /> <tt>q</tt> &mdash; closes the current view.<br"
" /> <tt>qa</tt> &mdash; closes all views, effectively quitting the "
"application.<br /> <tt>wq</tt> &mdash; writes the current document to disk "
"and closes its view.<br /> <tt>wqa</tt> &mdash; writes all documents to disk"
" and quits.</p><p>In all cases, if the view being closed is the last view, "
"the application quits. If no file name is associated with the document and "
"it should be written to disk, a file dialog will be shown.</p>"
msgstr ""
"<p><b>q/qa/wq/wqa &mdash; [نوشتن و] خروج</b></p><p>کاربرد: "
"<tt><b>[w]q[a]</b></tt></p><p>از برنامه خارج می‌شود. اگر <tt>w</tt> در ابتدا"
" اضافه شود، سند(ها) را نیز روی دیسک می‌نویسد. این دستور به چندین روش قابل "
"فراخوانی است:<br /> <tt>q</tt> &mdash; نمای فعلی را می‌بندد.<br /> "
"<tt>qa</tt> &mdash; تمام نماها را می‌بندد که در عمل منجر به خروج از برنامه "
"می‌شود.<br /> <tt>wq</tt> &mdash; سند فعلی را روی دیسک می‌نویسد و نمای آن را"
" می‌بندد.<br /> <tt>wqa</tt> &mdash; تمام اسناد را روی دیسک می‌نویسد و خارج "
"می‌شود.</p><p>در تمام موارد، اگر نمایی که بسته می‌شود آخرین نما باشد، برنامه"
" بسته می‌شود. اگر نام پرونده‌ای به سند اختصاص داده نشده باشد و باید روی دیسک"
" نوشته شود، یک کادر گفتگوی پرونده نمایش داده خواهد شد.</p>"

#: vimode/appcommands.cpp:238
#, kde-format
msgid ""
"<p><b>x/xa &mdash; write and quit</b></p><p>Usage: "
"<tt><b>x[a]</b></tt></p><p>Saves document(s) and quits (e<b>x</b>its). This "
"command can be called in two ways:<br /> <tt>x</tt> &mdash; closes the "
"current view.<br /> <tt>xa</tt> &mdash; closes all views, effectively "
"quitting the application.</p><p>In all cases, if the view being closed is "
"the last view, the application quits. If no file name is associated with the"
" document and it should be written to disk, a file dialog will be "
"shown.</p><p>Unlike the 'w' commands, this command only writes the document "
"if it is modified.</p>"
msgstr ""
"<p><b>x/xa &mdash; نوشتن و خروج</b></p><p>کاربرد: "
"<tt><b>x[a]</b></tt></p><p>سند(ها) را ذخیره کرده و خارج می‌شود "
"(e<b>x</b>its). این دستور به دو روش قابل فراخوانی است:<br /> <tt>x</tt> "
"&mdash; نمای فعلی را می‌بندد.<br /> <tt>xa</tt> &mdash; تمام نماها را "
"می‌بندد که در عمل منجر به خروج از برنامه می‌شود.</p><p>در تمام موارد، اگر "
"نمایی که بسته می‌شود آخرین نما باشد، برنامه بسته می‌شود. اگر نام پرونده‌ای "
"به سند اختصاص داده نشده باشد و باید روی دیسک نوشته شود، یک کادر گفتگوی "
"پرونده نمایش داده خواهد شد.</p><p>برخلاف دستورهای «w»، این دستور تنها در "
"صورتی سند را می‌نویسد که تغییر یافته باشد.</p>"

#: vimode/appcommands.cpp:252
#, kde-format
msgid ""
"<p><b>sp,split&mdash; Split horizontally the current view into "
"two</b></p><p>Usage: <tt><b>sp[lit]</b></tt></p><p>The result is two views "
"on the same document.</p>"
msgstr ""
"<p><b>sp,split&mdash; تقسیم افقی نمای فعلی به دو بخش</b></p><p>کاربرد: "
"<tt><b>sp[lit]</b></tt></p><p>نتیجه دو نما از یک سند یکسان خواهد بود.</p>"

#: vimode/appcommands.cpp:258
#, kde-format
msgid ""
"<p><b>vs,vsplit&mdash; Split vertically the current view into "
"two</b></p><p>Usage: <tt><b>vs[plit]</b></tt></p><p>The result is two views "
"on the same document.</p>"
msgstr ""
"<p><b>vs,vsplit&mdash; تقسیم عمودی نمای فعلی به دو بخش</b></p><p>کاربرد: "
"<tt><b>vs[plit]</b></tt></p><p>نتیجه دو نما از یک سند یکسان خواهد بود.</p>"

#: vimode/appcommands.cpp:264
#, kde-format
msgid ""
"<p><b>clo[se]&mdash; Close the current view</b></p><p>Usage: "
"<tt><b>clo[se]</b></tt></p><p>After executing it, the current view will be "
"closed.</p>"
msgstr ""
"<p><b>clo[se]&mdash; بستن نمای فعلی</b></p><p>کاربرد: "
"<tt><b>clo[se]</b></tt></p><p>پس از اجرای آن، نمای فعلی بسته خواهد شد.</p>"

#: vimode/appcommands.cpp:270
#, kde-format
msgid ""
"<p><b>[v]new &mdash; split view and create new document</b></p><p>Usage: "
"<tt><b>[v]new</b></tt></p><p>Splits the current view and opens a new "
"document in the new view. This command can be called in two ways:<br /> "
"<tt>new</tt> &mdash; splits the view horizontally and opens a new "
"document.<br /> <tt>vnew</tt> &mdash; splits the view vertically and opens a"
" new document.<br /></p>"
msgstr ""
"<p><b>[v]new &mdash; تقسیم نما و ایجاد سند جدید</b></p><p>کاربرد: "
"<tt><b>[v]new</b></tt></p><p>نمای فعلی را تقسیم کرده و سندی جدید در نمای "
"تازه باز می‌کند. این دستور به دو روش قابل فراخوانی است:<br /> <tt>new</tt> "
"&mdash; نما را به صورت افقی تقسیم کرده و یک سند جدید باز می‌کند.<br /> "
"<tt>vnew</tt> &mdash; نما را به صورت عمودی تقسیم کرده و یک سند جدید باز "
"می‌کند.<br /></p>"

#: vimode/appcommands.cpp:280
#, kde-format
msgid ""
"<p><b>e[dit] &mdash; reload current document</b></p><p>Usage: "
"<tt><b>e[dit]</b></tt></p><p>Starts <b>e</b>diting the current document "
"again. This is useful to re-edit the current file, when it was modified on "
"disk.</p>"
msgstr ""
"<p><b>e[dit] &mdash; بارگذاری مجدد سند فعلی</b></p><p>کاربرد: "
"<tt><b>e[dit]</b></tt></p><p><b>و</b>یرایش مجدد سند فعلی را آغاز می‌کند. این"
" برای ویرایش دوباره پرونده فعلی در صورتی که روی دیسک تغییر یافته باشد مفید "
"است.</p>"

#: vimode/appcommands.cpp:528
#, kde-format
msgid ""
"<p><b>b,buffer &mdash; Edit document N from the document "
"list</b></p><p>Usage: <tt><b>b[uffer] [N]</b></tt></p>"
msgstr ""
"<p><b>b,buffer &mdash; ویرایش سند N از فهرست اسناد</b></p><p>کاربرد: "
"<tt><b>b[uffer] [N]</b></tt></p>"

#: vimode/appcommands.cpp:533
#, kde-format
msgid ""
"<p><b>bp,bprev &mdash; previous buffer</b></p><p>Usage: <tt><b>bp[revious] "
"[N]</b></tt></p><p>Goes to <b>[N]</b>th previous document "
"(\"<b>b</b>uffer\") in document list. </p><p> <b>[N]</b> defaults to one. "
"</p><p>Wraps around the start of the document list.</p>"
msgstr ""
"<p><b>bp,bprev &mdash; میان‌گیر قبلی</b></p><p>کاربرد: <tt><b>bp[revious] "
"[N]</b></tt></p><p>به <b>[N]</b>اُمین سند قبلی («میان‌گیر» یا <b>b</b>uffer)"
" در فهرست اسناد می‌رود.</p><p>مقدار پیش‌فرض <b>[N]</b> یک است.</p><p>از "
"ابتدای فهرست اسناد به انتها بازمی‌گردد.</p>"

#: vimode/appcommands.cpp:541
#, kde-format
msgid ""
"<p><b>bn,bnext &mdash; switch to next document</b></p><p>Usage: "
"<tt><b>bn[ext] [N]</b></tt></p><p>Goes to <b>[N]</b>th next document "
"(\"<b>b</b>uffer\") in document list.<b>[N]</b> defaults to one. "
"</p><p>Wraps around the end of the document list.</p>"
msgstr ""
"<p><b>bn,bnext &mdash; رفتن به سند بعدی</b></p><p>کاربرد: <tt><b>bn[ext] "
"[N]</b></tt></p><p>به <b>[N]</b>اُمین سند بعدی («میان‌گیر» یا <b>b</b>uffer)"
" در فهرست اسناد می‌رود. مقدار پیش‌فرض <b>[N]</b> یک است.</p><p>از انتهای "
"فهرست اسناد به ابتدا بازمی‌گردد.</p>"

#: vimode/appcommands.cpp:549
#, kde-format
msgid ""
"<p><b>bf,bfirst &mdash; first document</b></p><p>Usage: "
"<tt><b>bf[irst]</b></tt></p><p>Goes to the <b>f</b>irst document "
"(\"<b>b</b>uffer\") in document list.</p>"
msgstr ""
"<p><b>bf,bfirst &mdash; سند اول</b></p><p>کاربرد: "
"<tt><b>bf[irst]</b></tt></p><p>به <b>اولین</b> سند («میان‌گیر» یا "
"<b>b</b>uffer) در فهرست اسناد می‌رود.</p>"

#: vimode/appcommands.cpp:555
#, kde-format
msgid ""
"<p><b>bl,blast &mdash; last document</b></p><p>Usage: "
"<tt><b>bl[ast]</b></tt></p><p>Goes to the <b>l</b>ast document "
"(\"<b>b</b>uffer\") in document list.</p>"
msgstr ""
"<p><b>bl,blast &mdash; سند آخر</b></p><p>کاربرد: "
"<tt><b>bl[ast]</b></tt></p><p>به <b>آخرین</b> سند («میان‌گیر» یا "
"<b>b</b>uffer) در فهرست اسناد می‌رود.</p>"

#: vimode/appcommands.cpp:561
#, kde-format
msgid "<p><b>ls</b></p><p>list current buffers<p>"
msgstr "<p><b>ls</b></p><p>فهرست‌کردن میان‌گیرهای فعلی<p>"

