msgstr "دریافت جدید…"

#: ui/main.qml:55
#, kde-format
msgctxt "@info:tooltip"
msgid "Remove boot splash screen"
msgstr "حذف صفحهٔ شروع راه‌اندازی"

#: ui/main.qml:57
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete the active boot splash screen"
msgstr "امکان حذف صفحهٔ راه‌اندازی فعال وجود ندارد"

#: ui/main.qml:59
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot delete system-installed boot splash screens"
