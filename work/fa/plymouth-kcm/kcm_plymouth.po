#: helper.cpp:57 helper.cpp:110 helper.cpp:138 helper.cpp:324
#, kde-format
msgid "Cannot start update-alternatives."
msgstr "امکان اجرای update-alternatives وجود ندارد."

#: helper.cpp:62 helper.cpp:115 helper.cpp:143 helper.cpp:329
#, kde-format
msgid "update-alternatives failed to run."
msgstr "اجرای update-alternatives با شکست مواجه شد."

#: helper.cpp:69 helper.cpp:123 helper.cpp:150 helper.cpp:337
#, kde-format
msgid "update-alternatives returned with error condition %1."
msgstr "دستور update-alternatives با وضعیت خطای %1 پایان یافت."

#: helper.cpp:82
#, kde-format
msgid "No theme specified in helper parameters."
msgstr "هیچ پوسته‌ای در پارامترهای کمکی مشخص نشده است."

#: helper.cpp:100 helper.cpp:268 helper.cpp:314
#, kde-format
msgid "Theme corrupted: .plymouth file not found inside theme."
msgstr "پوسته خراب است: پروندهٔ ‎.plymouth درون پوسته یافت نشد."

#: helper.cpp:162
#, kde-format
msgid "Cannot start initramfs."
msgstr "امکان اجرای initramfs وجود ندارد."

#: helper.cpp:171
#, kde-format
msgid "Cannot start mkinitcpio."
msgstr "امکان اجرای mkinitcpio وجود ندارد."

#: helper.cpp:180
#, kde-format
msgid "Initramfs failed to run."
msgstr "اجرای initramfs با شکست مواجه شد."

#: helper.cpp:190
#, kde-format
msgid "Initramfs returned with error condition %1."
msgstr "دستور initramfs با وضعیت خطای %1 پایان یافت."

#: helper.cpp:298
#, kde-format
msgid "Theme folder %1 does not exist."
msgstr "پوشهٔ پوستهٔ %1 وجود ندارد."

#: helper.cpp:304
#, kde-format
msgid "Theme %1 does not exist."
msgstr "پوستهٔ %1 وجود ندارد."

#: kcm.cpp:193 kcm.cpp:213
#, kde-format
msgid "Unable to authenticate/execute the action: %1 (%2)"
msgstr "احراز هویت/اجرای کنش ناموفق بود: %1 (%2)"

#: kcm.cpp:217
#, kde-format
msgid "Theme uninstalled successfully."
msgstr "پوسته با موفقیت حذف نصب شد."

#: kplymouththemeinstaller.cpp:32
#, kde-format
msgid "Plymouth theme installer"
msgstr "نصب‌کنندهٔ پوستهٔ پلیموت"

#: kplymouththemeinstaller.cpp:38
#, kde-format
msgid "Install a theme."
msgstr "نصب یک پوسته."

#: kplymouththemeinstaller.cpp:39
#, kde-format
msgid "Uninstall a theme."
msgstr "حذف نصب یک پوسته."

#: kplymouththemeinstaller.cpp:41
#, kde-format
msgid "The theme to install, must be an existing archive file."
msgstr "پوسته برای نصب، باید یک پروندهٔ آرشیو موجود باشد."

#: kplymouththemeinstaller.cpp:113
#, kde-format
msgid "Unable to authenticate/execute the action: %1, %2"
