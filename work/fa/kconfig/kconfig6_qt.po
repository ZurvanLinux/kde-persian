#: kconf_update/kconf_update.cpp:368
msgctxt "main|"
msgid "KDE Tool for updating user configuration files"
msgstr "ابزار KDE برای به‌روزرسانی پرونده‌های پیکربندی کاربر"

#: kconf_update/kconf_update.cpp:370
msgctxt "main|"
msgid "Keep output results from scripts"
msgstr "نگه‌داشتن نتایج خروجی کدنوشته‌ها"

#: kconf_update/kconf_update.cpp:373
msgctxt "main|"
msgid ""
"For unit tests only: do not write the done entries, so that with every re-"
"run, the scripts are executed again"
msgstr ""
"فقط برای آزمون‌های واحد: ورودی‌های انجام‌شده را ننویس، تا با هر بار اجرای "
"دوباره، کدنوشته‌ها مجدداً اجرا شوند"

#: kconf_update/kconf_update.cpp:375
msgctxt "main|"
msgid "Check whether config file itself requires updating"
msgstr "بررسی این که آیا خود پروندهٔ پیکربندی نیاز به به‌روزرسانی دارد یا خیر"

#: kconf_update/kconf_update.cpp:378
msgctxt "main|"
msgid "File(s) to read update instructions from"
msgstr "پرونده(ها) برای خواندن دستورالعمل‌های به‌روزرسانی از آن"

#: kconfig_compiler/kconfig_compiler.cpp:739
msgctxt "main|"
msgid "Directory to generate files in [.]"
msgstr "پوشه برای تولید پرونده‌ها در آن [.]"

#: kconfig_compiler/kconfig_compiler.cpp:740
msgctxt "main|"
msgid "directory"
msgstr "پوشه"

#: kconfig_compiler/kconfig_compiler.cpp:744
msgctxt "main|"
msgid "Display software license."
msgstr "نمایش مجوز نرم‌افزار."

#: kreadconfig/kreadconfig.cpp:46 kreadconfig/kwriteconfig.cpp:25
msgctxt "main|"
msgid "Use <file> instead of global config"
msgstr "استفاده از <file> به‌جای پیکربندی سراسری"

#: kreadconfig/kreadconfig.cpp:49 kreadconfig/kwriteconfig.cpp:28
msgctxt "main|"
msgid ""
"Group to look in. Use \"<default>\" for the root group, or use repeatedly "
"for nested groups."
msgstr ""
"گروه مورد نظر برای جست‌وجو. برای گروه ریشه از «<default>» استفاده کنید، یا "
"برای گروه‌های تودرتو آن را تکرار کنید."

#: kreadconfig/kreadconfig.cpp:52 kreadconfig/kwriteconfig.cpp:31
msgctxt "main|"
msgid "Key to look for"
msgstr "کلید برای جست‌وجو"

#: kreadconfig/kreadconfig.cpp:53
msgctxt "main|"
msgid "Default value"
msgstr "مقدار پیش‌فرض"

#: kreadconfig/kreadconfig.cpp:54
msgctxt "main|"
msgid "Type of variable"
msgstr "نوع متغیر"

#: kreadconfig/kreadconfig.cpp:55
msgctxt "main|"
msgid "Dump all entries"
msgstr "تخلیهٔ تمام مدخل‌ها"

#: kreadconfig/kreadconfig.cpp:56
msgctxt "main|"
msgid "Dump default values of all entries"
msgstr "تخلیهٔ مقادیر پیش‌فرض همهٔ مدخل‌ها"

#: kreadconfig/kreadconfig.cpp:59
msgctxt "main|"
msgid ""
"Include globals; by default, the global config files are not read if a file "
"is specified"
msgstr ""
"شامل‌کردن سراسری‌ها؛ در صورت مشخص‌شدن پرونده، پرونده‌های پیکربندی سراسری "
"به‌طور پیش‌فرض خوانده نمی‌شوند"

#: kreadconfig/kreadconfig.cpp:92 kreadconfig/kwriteconfig.cpp:71
msgctxt "main|"
msgid "Group name cannot be empty, use \"<default>\" for the root group"
msgstr ""
"نام گروه نمی‌تواند خالی باشد، از «‎<default>‎» برای گروه ریشه استفاده کنید"

#: kreadconfig/kwriteconfig.cpp:34
msgctxt "main|"
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"نوع متغیر. برای بولی از «bool» استفاده کنید، در غیر این صورت به‌عنوان رشته "
"در نظر گرفته می‌شود"

#: kreadconfig/kwriteconfig.cpp:36
msgctxt "main|"
msgid "Delete the designated key if enabled"
msgstr "حذف کلید تعیین‌شده در صورت فعال بودن"

#: kreadconfig/kwriteconfig.cpp:37
msgctxt "notify|"
msgid "Notify applications of the change"
msgstr "اطلاع‌دادن تغییر به برنامه‌ها"

#: kreadconfig/kwriteconfig.cpp:38
msgctxt "main|"
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr ""
"مقداری که باید نوشته شود. اجباری است، در شل برای خالی بودن از '' استفاده "
"کنید"
