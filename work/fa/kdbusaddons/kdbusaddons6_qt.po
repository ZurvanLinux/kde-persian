#: tools/kquitapp/kquitapp.cpp:19
msgctxt "main|"
msgid "Quit a D-Bus enabled application easily"
msgstr "خروج آسان از برنامه‌ای که D-Bus را فعال کرده است"

#: tools/kquitapp/kquitapp.cpp:21
msgctxt "main|"
msgid "Full service name, overrides application name provided"
msgstr "نام کامل سرویس، بر نام برنامهٔ ارائه‌شده برتری دارد"

#: tools/kquitapp/kquitapp.cpp:24
msgctxt "main|"
msgid "Path in the D-Bus interface to use"
msgstr "مسیر در رابط D-Bus برای استفاده"

#: tools/kquitapp/kquitapp.cpp:27
msgctxt "main|"
msgid "The name of the application to quit"
msgstr "نام برنامه‌ای که باید بسته شود"

#: tools/kquitapp/kquitapp.cpp:45
#, qt-format
msgctxt "main|"
msgid "Application %1 could not be found using service %2 and path %3."
msgstr "برنامهٔ %1 با استفاده از سرویس %2 و مسیر %3 یافت نشد."

#: tools/kquitapp/kquitapp.cpp:52
#, qt-format
msgctxt "main|"
msgid ""
"Quitting application %1 failed. Error reported was:\n"
"\n"
"     %2 : %3"
msgstr ""
"خروج از برنامهٔ %1 ناموفق بود. خطای گزارش‌شده:\n"
"\n"
"     %2 : %3"
