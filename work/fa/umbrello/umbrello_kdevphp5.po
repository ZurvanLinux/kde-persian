#. i18n: ectx: label, entry (phpDocLocation), group (PHP Documentation)
#: docs/phpdocssettings.kcfg:10
#, kde-format
msgid "Specifies the location of the PHP documentation to use."
msgstr "مکان مستندات PHP مورد استفاده را مشخص می‌کند."

#. i18n: ectx: tooltip, entry (phpDocLocation), group (PHP Documentation)
#: docs/phpdocssettings.kcfg:13
#, kde-format
msgid ""
"The location of the PHP documentation to use. You can either use a remote\n"
"                 location like https://php.net or a local directory which contains the\n"
"                 PHP documentation in HTML format with many files."
msgstr ""
"مکان مستندات PHP مورد استفاده. می‌توانید از یک مکان دوردست مانند "
"https://php.net یا یک شاخهٔ محلی شامل مستندات PHP در قالب HTML چندفایلی "
"استفاده کنید."

#. i18n: ectx: whatsthis, entry (phpDocLocation), group (PHP Documentation)
#: docs/phpdocssettings.kcfg:15
#, kde-format
msgid ""
"Make sure local copies are downloaded in HTML format with many files.\n"
"        "
msgstr ""
"مطمئن شوید نسخه‌های محلی در قالب HTML چندفایلی بارگیری شده‌اند.\n"
"        "

#: docs/phpdocumentationwidget.cpp:56
#, kde-format
msgid "...loading documentation..."
msgstr "...در حال بارگذاری مستندات..."

#: duchain/builders/contextbuilder.cpp:397
#, kde-format
msgid "Circular inheritance of %1 and %2"
msgstr "وراثت چرخشی %1 و %2"

#: duchain/builders/declarationbuilder.cpp:321
#, kde-format
msgid "Access type for interface method %1 must be omitted."
msgstr "نوع دسترسی برای متد رابط %1 باید حذف شود."

#: duchain/builders/declarationbuilder.cpp:325
#, kde-format
msgid "Interface function %1 cannot contain body."
msgstr "تابع رابط %1 نمی‌تواند دارای بدنه باشد."

#: duchain/builders/declarationbuilder.cpp:337
#, kde-format
msgid ""
"Class %1 contains abstract method %2 and must therefore be declared abstract"
" or implement the method."
msgstr ""
"کلاس %1 شامل متد انتزاعی %2 است و بنابراین باید به صورت انتزاعی (abstract) "
"تعریف شود یا این متد را پیاده‌سازی کند."

#: duchain/builders/declarationbuilder.cpp:343
#, kde-format
msgid "Abstract function %1 cannot contain body."
msgstr "تابع انتزاعی (abstract) %1 نمی‌تواند بدنه داشته باشد."

#: duchain/builders/declarationbuilder.cpp:346
#, kde-format
msgid "Cannot use the final modifier on an abstract class member."
msgstr ""
"نمی‌توان از اصلاح‌کنندهٔ final در یک عضو کلاس انتزاعی (abstract) استفاده "
"کرد."

#: duchain/builders/declarationbuilder.cpp:356
#, kde-format
msgid "Non-abstract method %1 must contain body."
msgstr "متد غیرانتزاعی (non-abstract) %1 باید دارای بدنه باشد."

#: duchain/builders/declarationbuilder.cpp:374
#, kde-format
msgid "Properties cannot be declared final."
msgstr "ویژگی‌ها نمی‌توانند به‌صورت final تعریف شوند."

#: duchain/builders/declarationbuilder.cpp:377
#, kde-format
msgid "Properties cannot be declared abstract."
msgstr "ویژگی‌ها نمی‌توانند به‌صورت abstract تعریف شوند."

#: duchain/builders/declarationbuilder.cpp:423
#, kde-format
msgid ""
"Trait method %1 has not been applied, because there are collisions with "
"other trait methods on %2"
msgstr ""
"متد صفت (trait) %1 اعمال نشد، زیرا با سایر متدهای صفت در %2 تداخل دارد."

#: duchain/builders/declarationbuilder.cpp:577
#, kde-format
msgid "Cannot redeclare private property %1 from this context."
msgstr "امکان بازتعریف ویژگی خصوصی %1 از این زمینه (context) وجود ندارد."

#: duchain/builders/declarationbuilder.cpp:583
#, kde-format
msgid "Cannot redeclare protected property %1 from this context."
msgstr "امکان بازتعریف ویژگی محافظت‌شده %1 از این زمینه (context) وجود ندارد."

#: duchain/builders/declarationbuilder.cpp:616
#, kde-format
msgid "Traits cannot have constants."
msgstr "صفت‌ها (Traits) نمی‌توانند ثابت (constant) داشته باشند."

#: duchain/builders/declarationbuilder.cpp:657
#, kde-format
msgid ""
"Only booleans, ints, floats and strings are allowed for class constants."
msgstr ""
"برای ثابت‌های کلاس فقط مقادیر بولی، عدد صحیح، عدد اعشاری و رشته مجاز هستند."

#: duchain/builders/declarationbuilder.cpp:709
#, kde-format
msgid "Cannot use 'final' as method modifier"
msgstr "نمی‌توان از «final» به‌عنوان اصلاح‌کننده متد استفاده کرد"

#: duchain/builders/declarationbuilder.cpp:712
#, kde-format
msgid "Cannot use 'static' as method modifier"
msgstr "نمی‌توان از «static» به‌عنوان اصلاح‌کننده متد استفاده کرد"

#: duchain/builders/declarationbuilder.cpp:760
#, kde-format
msgid "Default value for parameters with a class type hint can only be NULL."
msgstr ""
"مقدار پیش‌فرض برای پارامترهایی با مشخصه نوع کلاس فقط می‌تواند NULL باشد."

#: duchain/builders/declarationbuilder.cpp:763
#, kde-format
msgid "Following parameters must have a default value assigned."
msgstr "پارامترهای زیر باید مقدار پیش‌فرض داشته باشند."

#: duchain/builders/declarationbuilder.cpp:870
#, kde-format
msgid "Cannot redeclare PHP internal %1."
msgstr "نمی‌توان %1 داخلی PHP را دوباره اعلان کرد."

#: duchain/builders/declarationbuilder.cpp:873
#, kde-format
msgid ""
"%1 and %2 define the same property (%3) in the composition of %1. This might"
" be incompatible, to improve maintainability consider using accessor methods"
" in traits instead."
msgstr ""
"%1 و %2 ویژگی یکسانی (%3) را در ترکیب %1 تعریف می‌کنند. این ممکن است "
"ناسازگار باشد؛ برای بهبود قابلیت نگهداری، استفاده از متدهای دستیاب "
"(accessor) در traitها را در نظر بگیرید."

#: duchain/builders/declarationbuilder.cpp:881
#, kde-format
msgid "Cannot redeclare %1, already declared in %2 on line %3."
msgstr "نمی‌توان %1 را دوباره اعلان کرد، قبلاً در %2 در خط %3 اعلان شده است."

#: duchain/builders/declarationbuilder.cpp:967
#, kde-format
msgid ""
"Class %1 contains %2 abstract methods and must therefore be declared "
"abstract or implement the remaining methods."
msgstr ""
"کلاس %1 حاوی %2 متد انتزاعی (abstract) است و بنابراین باید به صورت انتزاعی "
"اعلان شود یا متدهای باقی‌مانده را پیاده‌سازی کند."

#: duchain/builders/declarationbuilder.cpp:974
#, kde-format
msgid "Cannot re-assign $this."
msgstr "امکان انتساب مجدد ‎$this‎ وجود ندارد."

#: duchain/builders/declarationbuilder.cpp:1410
#, kde-format
msgid "The use statement with non-compound name '%1' has no effect."
msgstr "دستور use با نام غیرترکیبی '%1' هیچ تأثیری ندارد."

#: duchain/builders/declarationbuilder.cpp:1434
#, kde-format
msgid "Cannot use '%1' as '%2' because the name is already in use."
msgstr ""
"نمی‌توان از '%1' با عنوان '%2' استفاده کرد زیرا این نام در حال حاضر در حال "
"استفاده است."

#: duchain/builders/usebuilder.cpp:191
#, kde-format
msgid "Usage of %1 is deprecated."
msgstr "استفاده از %1 منسوخ شده است."

#: duchain/builders/usebuilder.cpp:193
#, kde-format
msgid "Declaration not found: %1"
msgstr "اعلان پیدا نشد: %1"

