#: src/helper/kcmgrub2.actions:2
msgctxt "Name"
msgid "GRUB2 Bootloader Control Module"
msgstr "پیمانهٔ کنترل بارگذار بوت GRUB2"

#: src/helper/kcmgrub2.actions:55
msgctxt "Name"
msgid "Restore the default GRUB2 Bootloader settings"
msgstr "بازیابی تنظیمات پیش‌فرض بارگذار بوت GRUB2"

#: src/helper/kcmgrub2.actions:104
msgctxt "Description"
msgid ""
"Administrator authorization is required to restore the default GRUB2 "
"Bootloader settings"
msgstr ""
"برای بازیابی تنظیمات پیش‌فرض بارگذار بوت GRUB2، به مجوز مدیر سیستم نیاز است"

#: src/helper/kcmgrub2.actions:156
msgctxt "Name"
msgid "Install the GRUB2 Bootloader"
msgstr "نصب بارگذار بوت GRUB2"

#: src/helper/kcmgrub2.actions:207
msgctxt "Description"
msgid ""
"Administrator authorization is required to install the GRUB2 Bootloader"
msgstr "برای نصب بارگذار بوت GRUB2، به مجوز مدیر سیستم نیاز است"

#: src/helper/kcmgrub2.actions:260
msgctxt "Name"
msgid "Load the GRUB2 Bootloader settings"
msgstr "بارگذاری تنظیمات بارگذار بوت GRUB2"

#: src/helper/kcmgrub2.actions:310
msgctxt "Description"
msgid ""
"Administrator authorization is required to load the GRUB2 Bootloader "
"settings"
msgstr "برای بارگذاری تنظیمات بارگذار بوت GRUB2، به مجوز مدیر سیستم نیاز است"

#: src/helper/kcmgrub2.actions:363
msgctxt "Name"
msgid "Save the GRUB2 Bootloader settings"
msgstr "ذخیرهٔ تنظیمات بارگذار بوت GRUB2"

#: src/helper/kcmgrub2.actions:413
msgctxt "Description"
msgid ""
"Administrator authorization is required to save the GRUB2 Bootloader "
"settings"
msgstr "برای ذخیرهٔ تنظیمات بارگذار بوت GRUB2، به مجوز مدیر سیستم نیاز است"
