#: kded_bolt.cpp:67
#, kde-format
msgid "New Thunderbolt Device Detected"
msgstr "دستگاه تاندربولت جدید شناسایی شد"

#: kded_bolt.cpp:68
#, kde-format
msgid ""
"Unauthorized Thunderbolt device <b>%1</b> was detected. Do you want to "
"authorize it?"
msgstr ""
"دستگاه تاندربولت غیرمجاز <b>%1</b> شناسایی شد. آیا می‌خواهید به آن اجازهٔ "
"دسترسی دهید؟"

#: kded_bolt.cpp:70
#, kde-format
msgid ""
"%1 unauthorized Thunderbolt device was detected. Do you want to authorize "
"it?"
msgid_plural ""
"%1 unauthorized Thunderbolt devices were detected. Do you want to authorize "
"them?"
msgstr[0] ""
"%1 دستگاه تاندربولت غیرمجاز شناسایی شد. آیا می‌خواهید به آن اجازهٔ دسترسی "
"دهید؟"
msgstr[1] ""
"%1 دستگاه تاندربولت غیرمجاز شناسایی شدند. آیا می‌خواهید به آن‌ها اجازهٔ "
"دسترسی دهید؟"

#: kded_bolt.cpp:78
#, kde-format
msgid "Authorize Now"
msgstr "اجازه‌دادن اکنون"

#: kded_bolt.cpp:83
#, kde-format
msgid "Authorize Permanently"
msgstr "اجازه‌دادن دائمی"

#: kded_bolt.cpp:131
#, kde-format
msgid "Thunderbolt Device Authorization Error"
msgstr "خطای مجوز دستگاه تاندربولت"

#: kded_bolt.cpp:132
#, kde-format
msgid "Failed to authorize Thunderbolt device <b>%1</b>: %2"
msgstr "اجازه‌دادن به دستگاه تاندربولت <b>%1</b> ناموفق بود: %2"
